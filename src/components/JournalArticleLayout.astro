---
import '../styles/research-studio-landing.css';
import '../styles/journal-reading.css';
import '../styles/studio-room-surfaces.css';
import '../styles/ember-circuit-library.css';
import HearthNavigation from './HearthNavigation.astro';

interface Heading { depth: number; slug: string; text: string; }
interface Claim { claim: string; label: string; source: string; }
interface Props {
  title: string;
  date: string;
  description: string;
  tags: string[];
  sources: string[];
  headings: Heading[];
  labels: string[];
  claims: Claim[];
  featuredImage?: string;
  featuredImageAlt?: string;
  readingTimeMinutes?: number;
  publicationNote?: string;
  slug: string;
}

const {
  title,
  date,
  description,
  tags,
  sources,
  headings,
  labels,
  claims,
  featuredImage,
  featuredImageAlt,
  readingTimeMinutes,
  publicationNote,
  slug,
} = Astro.props;

const displayDate = new Date(`${date}T00:00:00`).toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});
const sourceEntries = sources.map((source) => {
  const match = source.match(/https?:\/\/[^\s)]+/);
  if (!match) return { label: source, href: undefined };
  const href = match[0].replace(/[.,;]+$/, '');
  const label = source.replace(match[0], '').replace(/[:\s]+$/, '').trim();
  try {
    const url = new URL(href);
    if (!['https:', 'http:'].includes(url.protocol)) return { label: source, href: undefined };
    return { label: label || new URL(href).hostname, href };
  } catch {
    return { label: source, href: undefined };
  }
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0e1114" />
    <title>{title} · Field Journal · Hearth &amp; Code</title>
  </head>
  <body class="studio-room-body studio-room-body--notes studio-article-body">
    <a class="research-skip" href="#journal-article">Skip to article</a>
    <HearthNavigation current="library" context="Field Journal / local review candidate" />
    <main id="journal-article" class="journal-article-shell">
      <article class:list={['journal-article', { 'journal-article--hcan': slug === 'hcan-condensed-symbolic-language' }]}>
        <header class="journal-article__header">
          <p class="research-eyebrow">Field Journal / local revision candidate</p>
          <h1>{title}</h1>
          <p class="journal-article__deck">{description}</p>
          <p class="journal-article__review-notice" role="note">This locally revised copy is a candidate and remains review-required. It has not been approved or republished. {publicationNote ?? 'The date below is the earlier publication date.'}</p>
          <dl class="journal-article__meta">
            <div><dt>{publicationNote ? 'Source publication state' : 'Earlier publication'}</dt><dd>{publicationNote ? 'Conflicting records · unresolved' : <time datetime={date}>{displayDate}</time>}</dd></div>
            {readingTimeMinutes && <div><dt>Reading time</dt><dd>{readingTimeMinutes} minutes</dd></div>}
            <div><dt>Current revision</dt><dd>Local candidate · review required</dd></div>
          </dl>
        </header>

        {featuredImage && <figure class="journal-article__hero"><img src={featuredImage} alt={featuredImageAlt ?? ''} width="1024" height="576" loading="eager" /></figure>}

        <section class="studio-article-reading-field">
          {headings.length > 1 && <nav class="journal-article__guide" aria-label="On this page"><p>On this page</p><ol>{headings.filter((heading) => heading.depth === 2).map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></nav>}

          <div class={slug === 'hcan-condensed-symbolic-language' ? 'hcan-reading-body' : 'journal-article__body'}><slot /></div>

          <footer class="journal-article__evidence">
          <section>
            <p class="research-eyebrow">Article labels</p>
            <ul class="journal-article__labels">{labels.map((label) => <li>{label.replace('-', ' ')}</li>)}</ul>
            {tags.length > 0 && <ul class="journal-article__labels journal-article__labels--tags">{tags.map((tag) => <li>{tag}</li>)}</ul>}
          </section>
          {claims.length > 0 && <section class="journal-article__claims"><p class="research-eyebrow">Claim map · eight epistemic classes</p><ol>{claims.map((claim) => <li><strong>{claim.label.replace('-', ' ')}</strong><span>{claim.claim}</span><small>{claim.source}</small></li>)}</ol></section>}
          <section class="journal-article__sources"><p class="research-eyebrow">Named source context</p><ul>{sourceEntries.map((source) => <li>{source.label}{source.href && <> · <a href={source.href} rel="external noopener noreferrer" aria-label={`Open source: ${source.label}`}>Open source</a></>}</li>)}</ul></section>
          </footer>
        </section>
      </article>
      <nav class="journal-article__return" aria-label="Field Journal return path"><a href="/journal/">← All Field Journal entries</a></nav>
    </main>
  </body>
</html>
