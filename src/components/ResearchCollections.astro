  'M-20': { scenario: 'A request to “redesign the learning layer” contains research, copy, interface, and review work.', artifact: 'a decomposition board of four inspectable artifacts with dependencies', check: 'whether every subtask has a distinct output and return point' },
  'M-21': { scenario: 'A technique description needs to be machine-readable without hiding human uncertainty.', artifact: 'a minimal output schema with source, claim class, limit, and next gate fields', check: 'whether the schema validates shape without pretending to decide meaning' },
  'M-22': { scenario: 'A reader needs to learn the difference between an evidence card and a promotional claim.', artifact: 'a paired example and near-miss with the material difference annotated', check: 'whether the counterexample could plausibly fool a rushed reader' },
  'M-23': { scenario: 'A polished landing-page paragraph reads smoothly but may flatten source limits.', artifact: 'an adversarial copy review identifying overclaim, omission, privacy, and ambiguity risks', check: 'whether the critique returns concrete revisions rather than generic caution' },
  'M-24': { scenario: 'A research task could inspect local files, call a provider, or edit a public page.', artifact: 'a tool-boundary table naming allowed inspection, prohibited effects, and human gates', check: 'whether every named tool has an explicit effect boundary' },
  'M-25': { scenario: 'A build receipt is being described in a public article.', artifact: 'three calibrated versions of the statement: observation, interpretation, and prohibited overclaim', check: 'whether the final language says no more than the build actually checked' },
  'M-26': { scenario: 'A new prompt pattern claims to improve source-grounded summarization.', artifact: 'a small fixture plan with a positive case, contrast case, and pass predicate', check: 'whether a passing fixture is being mistaken for general effectiveness' },
  'M-27': { scenario: 'A public agent workflow may lose context, overstate confidence, or cross a privacy boundary.', artifact: 'a failure-mode inventory with signal, consequence, containment, and recovery', check: 'whether the plan names a safe stop for each consequential failure' },
  'M-28': { scenario: 'Several method candidates need comparison without collapsing into a single quality score.', artifact: 'a multidimensional scorecard for fidelity, utility, testability, transfer, novelty, and control', check: 'whether any blank dimension has been honestly left unevaluated' },
  'M-29': { scenario: 'A new public module is ready for design review but not yet for publication.', artifact: 'a preflight sheet covering source, privacy, audience, authority, cost, and rollback', check: 'whether a failed boundary prevents the dependent release step' },
  'M-30': { scenario: 'A field note is revised after a reader points out an overstated sentence.', artifact: 'a revision delta showing wording changed, reason, supporting evidence, and remaining uncertainty', check: 'whether the delta makes the correction legible without rewriting history' },
  'M-31': { scenario: 'A generated candidate is ready for a human choice but has several viable dispositions.', artifact: 'a disposition packet offering accept, revise, withhold, and retire with consequences', check: 'whether the agent has refrained from selecting the outcome' },
  'M-32': { scenario: 'A visitor wants to adapt one Hearth & Code method in a different workspace.', artifact: 'a portable method receipt describing inputs, transformation, check, limits, and adaptation notes', check: 'whether the receipt makes transfer limits as visible as the method itself' },
};
const methodDetail = (entry: Entry, set: Set) => {
  const frame = methodFrames[set.id];
  const brief = techniqueBriefs[entry.id];
  return {
    aim: frame.aim,
    useWhen: frame.useWhen,
    steps: [`Frame: ${brief.scenario}`, `Make: ${brief.artifact}`, `Check: ${brief.check}`],
    prompt: `Hearth & Code field task — ${entry.id}: ${entry.title}\n\nStudio context\nYou are helping an independent research lab make a public learning surface that is warm, precise, and corrigible. The work connects semantic orientation, Operational Intelligence, prompt practice, and human-held governance.\n\nSituation\n${brief.scenario}\n\nYour assignment\nProduce ${brief.artifact}.\n\nWorking posture\n- Use only the materials explicitly named in the task; treat all other material as unavailable.\n- Preserve the distinction between direct source, observation, interpretation, hypothesis, and proposal.\n- Keep private material, provider actions, publication, and consequential decisions outside this task.\n- Write in a Hearthside voice: calm, concrete, technically literate, and free of oracle language.\n\nReturn format\n1. The decision this field card helps a person make.\n2. The working artifact, with a short rationale.\n3. A named check: ${brief.check}.\n4. What the check cannot prove.\n5. The next human-held disposition.`,
  };
};
const articleRoutes: Record<string, string> = {
  'N-05': '/notes/meaning-before-machinery/',
  'N-06': '/notes/uncertainty-is-a-room/',
  'N-07': '/notes/a-humane-theory-of-provenance/',
  'N-08': '/notes/tools-in-a-bounded-room/',
  'N-09': '/notes/typed-context-for-real-work/',
  'N-10': '/notes/knowledge-representation-without-a-black-box/',
  'N-11': '/notes/operational-intelligence-as-comparison-practice/',
  'N-12': '/notes/prompting-as-interface-design/',
};
const data: Partial<Record<Route, Set[]>> = { methods, programs, notes, evidence };
const sets = data[route as Route];
---

{sets && <section class="research-collections" aria-labelledby={`${route}-collections-title`}>
  <header class="research-collections__header">
    <div>
      <p class="research-eyebrow">Research collection / public learning modules</p>
      <h2 id={`${route}-collections-title`}>{route === 'methods' ? '32 field cards, arranged as four working lenses.' : route === 'programs' ? '32 modules, organized for inspection.' : '16 modules, organized for return.'}</h2>
    </div>
    <p>These public learning modules are derived from named research homes. They do not claim that the underlying private working materials, frameworks, or source-only programs are published, adopted, or operational.</p>
  </header>

  <PanelTabs client:load scope="collection" items={sets.map((set) => ({ id: set.id, label: set.title, detail: `${set.entries.length} modules` }))} label={`${route} collection sections`} />

  <div class="research-collection-sets">
    {sets.map((set, index) => <section id={`collection-panel-${set.id}`} data-collection-panel={set.id} class:list={['research-collection-set', route === 'methods' && 'research-collection-set--method']} aria-labelledby={`collection-tab-${set.id}`} role="tabpanel">
      <header>
        <p class="research-eyebrow">Set {String(index + 1).padStart(2, '0')} / {set.source}</p>
        <h3 id={`${set.id}-title`}>{set.title}</h3>
        <p>{set.framing}</p>
      </header>
      <ol class:list={['research-collection-grid', route === 'methods' && 'research-collection-grid--methods']}>
        {set.entries.map((entry) => <li id={entry.id.toLowerCase()}>
          <span class="research-collection-grid__id">{entry.id}</span>
          <p class="research-collection-grid__form">{entry.form}</p>
          <h4>{entry.title}</h4>
          <p>{entry.note}</p>
          {route === 'notes' && articleRoutes[entry.id] && <a class="research-essay-link" href={articleRoutes[entry.id]}>Read the article →</a>}
          <small><b>Limit</b> {entry.boundary}</small>
          {route === 'methods' && <>
            <button class="research-technique-open" type="button" data-technique-open={entry.id.toLowerCase()} aria-haspopup="dialog">Open technique field card <span aria-hidden="true">↗</span></button>
            <dialog id={`technique-${entry.id.toLowerCase()}`} class="research-technique-dialog" aria-labelledby={`technique-title-${entry.id.toLowerCase()}`}>
              <form method="dialog"><button class="research-technique-close" aria-label={`Close ${entry.title} field card`}>×</button></form>
              <p class="research-eyebrow">{entry.id} / {set.title} / practical field card</p>
              <h3 id={`technique-title-${entry.id.toLowerCase()}`}>{entry.title}</h3>
              <p class="research-technique-dialog__lede">{entry.note}</p>
              <dl class="research-technique-spec"><div><dt>Purpose</dt><dd>{methodDetail(entry, set).aim}</dd></div><div><dt>Use when</dt><dd>{methodDetail(entry, set).useWhen}</dd></div><div><dt>Boundary</dt><dd>{entry.boundary}</dd></div></dl>
              <section><p class="research-eyebrow">Field procedure</p><ol>{methodDetail(entry, set).steps.map((step, index) => <li><span>{String(index + 1).padStart(2, '0')}</span>{step}</li>)}</ol></section>
              <section><p class="research-eyebrow">Practical agent prompt / candidate</p><pre><code>{methodDetail(entry, set).prompt}</code></pre></section>
              <p class="research-technique-dialog__note">Adapt the prompt to your own source, authority, privacy, and tool boundaries. It is a teaching example, not a command to take action.</p>
            </dialog>
          </>}
        </li>)}
      </ol>
    </section>)}
  </div>
</section>}

<script>
  const openTechnique = (identifier: string | null) => {
    const dialog = identifier ? document.querySelector(`#technique-${identifier}`) : null;
    if (dialog instanceof HTMLDialogElement && !dialog.open) dialog.showModal();
  };
  document.querySelectorAll('[data-technique-open]').forEach((control) => {
    control.addEventListener('click', () => {
      openTechnique(control.getAttribute('data-technique-open'));
    });
  });
  if (window.location.hash.startsWith('#technique-')) openTechnique(window.location.hash.replace('#technique-', ''));
</script>
