    { id: 'E-15', title: 'Retired candidate', form: 'Lifecycle state', note: 'A preserved record of a proposal that no longer carries forward, with the reason and successor if known.', boundary: 'Retirement is not deletion of evidence.' },
    { id: 'E-16', title: 'Review intake', form: 'Return interface', note: 'A route for a reader to point to a source, claim, accessibility barrier, or correction need.', boundary: 'Intake is not automatic change or publication.' },
  ] },
];

const methodFrames: Record<string, { aim: string; useWhen: string; steps: string[] }> = {
  'semantic-orientation': { aim: 'Select language and relations without converting a vocabulary into a verdict about a person or system.', useWhen: 'A task has several near-neighbor concepts and the wording will shape the decision.', steps: ['Locate the exact phrase or source object.', 'Name the smallest relevant neighborhood and one boundary.', 'Keep literal wording separate from public normalization.', 'Return the selection with an uncertainty or omission note.'] },
  'operational-intelligence': { aim: 'Compare forms and transitions while leaving authority with their actual owners.', useWhen: 'Two workflows, records, or systems appear related and need a disciplined comparison.', steps: ['Name the source owner and the object being compared.', 'Describe the transition rather than declaring replacement.', 'Record what is preserved, omitted, or still unknown.', 'Return a candidate next decision to a person.'] },
  'prompt-practice': { aim: 'Turn a request into an inspectable agent task with inputs, boundaries, and a useful return.', useWhen: 'An agent can assist with a bounded transformation, synthesis, or check.', steps: ['State the task, source set, and exclusion boundary.', 'Request one named artifact rather than a general answer.', 'Require claim classes, limits, and counterevidence.', 'Stop before any unapproved external or consequential effect.'] },
  'evaluation-return': { aim: 'Test one narrow predicate, preserve what it does not prove, and leave a legible next move.', useWhen: 'A candidate needs review before its language or handling becomes more consequential.', steps: ['Name the smallest predicate worth checking.', 'Choose an input, fixture, or contrast case.', 'Record observation separately from interpretation.', 'Offer accept, revise, withhold, or retire as human-held dispositions.'] },
};
