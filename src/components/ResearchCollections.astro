---
import PanelTabs from './PanelTabs';
type Route = 'programs' | 'methods' | 'notes' | 'evidence';
interface Props { route: Route | 'lab' | 'questions' | 'dossier' | 'correspondence'; }
interface Entry { id: string; title: string; form: string; note: string; boundary: string; }
interface Set { id: string; title: string; source: string; framing: string; entries: Entry[]; }
const { route } = Astro.props;

const methods: Set[] = [
  { id: 'semantic-orientation', title: 'Semantic orientation', source: 'Candidate semantic-orientation catalog', framing: 'How a practice selects vocabulary, scope, and relations without treating a vocabulary as an authority grant.', entries: [
    { id: 'M-01', title: 'Literal before normalized', form: 'Reading discipline', note: 'Keep an exact source phrase distinct from the public wording that makes it easier to discuss.', boundary: 'Normalization remains candidate language until author review.' },
    { id: 'M-02', title: 'The bounded neighborhood', form: 'Selection pattern', note: 'Return the few concepts needed for a question, plus the nearest boundary, rather than an entire lexicon.', boundary: 'Selection is a reading aid, not a personality assessment.' },
    { id: 'M-03', title: 'Orientation is not a score', form: 'Interpretation check', note: 'Describe a way of attending to a problem without inferring ability, diagnosis, or a stable trait.', boundary: 'No public profile should turn an orientation into a ranking.' },
    { id: 'M-04', title: 'Relationship, named', form: 'Relation card', note: 'State whether one idea supports, constrains, contrasts with, or merely resembles another.', boundary: 'A visible relation is still open to review.' },
    { id: 'M-05', title: 'The analogy boundary', form: 'Transfer note', note: 'Borrow a mechanism from another field while leaving that field’s authority and context in place.', boundary: 'Analogy cannot prove a claim by association.' },
    { id: 'M-06', title: 'Unknowns stay addressable', form: 'Ambiguity ledger', note: 'Give contradiction, absence, and uncertainty their own place in the representation.', boundary: 'A gap is not filled merely to complete a pattern.' },
    { id: 'M-07', title: 'Trigger without expansion', form: 'Prompt cue', note: 'Use a cue to retrieve a bounded source set rather than silently widening the task.', boundary: 'A trigger does not permit new access or action.' },
    { id: 'M-08', title: 'Projection keeps a tether', form: 'Publication rule', note: 'A public explanation should retain the identity and limits of the source it derives from.', boundary: 'The projection never replaces its source record.' },
  ] },
  { id: 'operational-intelligence', title: 'Operational intelligence', source: 'Operational Intelligence Exocore Meta-Framework', framing: 'A coordination grammar for comparing forms and transitions without centralizing authority, identity, or permission.', entries: [
    { id: 'M-09', title: 'Source-owner boundary', form: 'Coordination rule', note: 'Name who owns the source before composing it into a new working view.', boundary: 'Composition does not transfer ownership.' },
    { id: 'M-10', title: 'Form before function', form: 'Comparison lens', note: 'Compare the structure of two practices before declaring that one can replace the other.', boundary: 'Similarity is not interoperability.' },
    { id: 'M-11', title: 'Transition as an object', form: 'State map', note: 'Make the move from source to candidate, check, review, and release visible as a sequence.', boundary: 'A planned transition does not execute itself.' },
    { id: 'M-12', title: 'Role, capability, permission', form: 'Separation test', note: 'Distinguish who is involved, what a system can do, and what it has been allowed to do.', boundary: 'Capability never implies permission.' },
    { id: 'M-13', title: 'Loss register', form: 'Projection receipt', note: 'Record what a transformation preserves, omits, simplifies, or makes less certain.', boundary: 'Convenient summaries cannot hide loss.' },
    { id: 'M-14', title: 'Frozen comparison lane', form: 'Evaluation setup', note: 'Hold a stable reference condition when comparing a revised process or representation.', boundary: 'A comparison result is bounded to its stated fixture.' },
    { id: 'M-15', title: 'Exception has a contract', form: 'Governance pattern', note: 'When a rule must be narrowed or set aside, name the exact reason, owner, scope, and expiry.', boundary: 'An exception cannot become ambient permission.' },
    { id: 'M-16', title: 'Return packet', form: 'Handoff form', note: 'End a piece of work with its current state, open risk, evidence, and next human decision.', boundary: 'A handoff is not acceptance or release.' },
  ] },
  { id: 'prompt-practice', title: 'Prompt and context practice', source: 'Prompt, Context, and Agentic Technique Atlas', framing: 'A public-safe, technique-level reading of prompt engineering: contracts, constraints, evaluation, and revision rather than oracle language.', entries: [
    { id: 'M-17', title: 'Task contract first', form: 'Prompt scaffold', note: 'State purpose, inputs, outputs, constraints, and the condition that should stop the attempt.', boundary: 'A well-formed request still needs human judgment.' },
    { id: 'M-18', title: 'Bounded context packet', form: 'Context selection', note: 'Choose a small source set with an ordering, omission note, freshness rule, and token budget.', boundary: 'More context is not automatically better context.' },
    { id: 'M-19', title: 'Separate evidence from instruction', form: 'Input hygiene', note: 'Treat source material as evidence to interpret, not as executable command text.', boundary: 'Embedded text has no independent authority.' },
    { id: 'M-20', title: 'Decompose by artifact', form: 'Workflow pattern', note: 'Ask for one inspectable object at a time—map, critique, check, or draft—rather than an undifferentiated answer.', boundary: 'Decomposition should not erase the underlying question.' },
    { id: 'M-21', title: 'Schema as a lens', form: 'Output contract', note: 'Use fields to expose missing source, uncertainty, owner, and next gate.', boundary: 'A valid shape is not semantic truth.' },
    { id: 'M-22', title: 'Example and counterexample', form: 'Teaching pair', note: 'Show a useful pattern alongside a near miss so the reader can see the material difference.', boundary: 'An example is illustrative, not universal.' },
    { id: 'M-23', title: 'Adversarial read', form: 'Revision pass', note: 'Ask what could be overstated, conflated, private, or untestable before carrying a draft forward.', boundary: 'Critique identifies risk; it does not settle it.' },
    { id: 'M-24', title: 'Tool boundary', form: 'Execution guard', note: 'Name which tools may inspect, transform, or validate and which effects remain human-gated.', boundary: 'A named tool is not permission to use it.' },
  ] },
  { id: 'evaluation-return', title: 'Evaluation and return', source: 'Prompt Technique Atlas + Operational Intelligence', framing: 'Small review instruments for finding whether a technique has met its own stated boundary.', entries: [
    { id: 'M-25', title: 'Claim calibration', form: 'Copy check', note: 'Match the language of a result to the strength and scope of the evidence beneath it.', boundary: 'Fluent tone does not raise confidence.' },
    { id: 'M-26', title: 'Fixture before conclusion', form: 'Test setup', note: 'Use a named example or contrast case to check a narrow predicate before generalizing.', boundary: 'One fixture proves only its predicate.' },
    { id: 'M-27', title: 'Failure mode inventory', form: 'Risk sheet', note: 'Name the ways a pattern can distort context, lose provenance, or create false confidence.', boundary: 'Known failure modes do not make an approach safe by default.' },
    { id: 'M-28', title: 'Reviewable scorecard', form: 'Assessment frame', note: 'Keep fidelity, utility, testability, transfer, novelty, and control as separate dimensions.', boundary: 'No aggregate score is implied.' },
    { id: 'M-29', title: 'Constraint rehearsal', form: 'Preflight', note: 'Test the intended method against privacy, source, time, and authority constraints before the main attempt.', boundary: 'Passing preflight does not release a consequential action.' },
    { id: 'M-30', title: 'Revision delta', form: 'Change record', note: 'Describe what changed, why it changed, and which evidence or feedback caused the revision.', boundary: 'A delta does not prove the new version is better.' },
    { id: 'M-31', title: 'Human disposition', form: 'Decision gate', note: 'Return the candidate with clear options: accept, revise, withhold, or retire.', boundary: 'The system does not choose its own disposition.' },
    { id: 'M-32', title: 'Method receipt', form: 'Learning artifact', note: 'Leave enough trace for another person to understand the attempt, its checks, and its non-claims.', boundary: 'A receipt is process history, not proof of value.' },
  ] },
];

const programs: Set[] = [
  { id: 'tccp', title: 'TCCP research program', source: 'TCCP Research Program coordination home', framing: 'A public learning view of research into typed representations, interaction compilation, and evaluation—without collapsing their separate owners.', entries: [
    { id: 'P-01', title: 'Question packet', form: 'Program entry', note: 'Begin with the concern, audience, source scope, and a bounded criterion for progress.', boundary: 'A project question is not yet a research result.' },
    { id: 'P-02', title: 'Typed representation', form: 'Research object', note: 'Give a concept a declared class so source, claim, proposal, and receipt cannot silently blend.', boundary: 'Type labels do not determine meaning.' },
    { id: 'P-03', title: 'Context as condition', form: 'Modeling lens', note: 'Treat the setting, constraint, audience, and authority around an artifact as part of its working meaning.', boundary: 'Context models are necessarily partial.' },
    { id: 'P-04', title: 'Relation grammar', form: 'Connection map', note: 'Express how representations connect, constrain, translate, or return to their sources.', boundary: 'A mapped relation remains reviewable.' },
    { id: 'P-05', title: 'Interaction compilation', form: 'Translation study', note: 'Study how a source-bound representation may become a prompt, interface, or teaching surface.', boundary: 'Compilation does not license execution.' },
    { id: 'P-06', title: 'Notation for uncertainty', form: 'Research instrument', note: 'Use explicit marks for unknown, contested, provisional, and withheld material.', boundary: 'Notation should clarify rather than manufacture certainty.' },
    { id: 'P-07', title: 'Evaluation seam', form: 'Falsification frame', note: 'Attach a candidate representation to a small check that could expose a mismatch or failure.', boundary: 'A test result has a limited domain.' },
    { id: 'P-08', title: 'Functional ownership', form: 'Program boundary', note: 'Coordinate related research without absorbing every linked record into a single program home.', boundary: 'Coordination is not centralization.' },
  ] },
  { id: 'ekrp', title: 'EKRP', source: 'Exocore Knowledge Representation Profile source home', framing: 'A source-only application-profile program for human-readable, review-gated knowledge representation and provenance work.', entries: [
    { id: 'P-09', title: 'Application profile', form: 'Program frame', note: 'Select and explain how established representation and governance references might meet one local setting.', boundary: 'EKRP is not a replacement standards stack.' },
    { id: 'P-10', title: 'Readable source home', form: 'Information architecture', note: 'Keep charter, evidence packets, synthesis, and unresolved questions together without inventing a runtime.', boundary: 'A source home owns documents, not services.' },
    { id: 'P-11', title: 'Evidence packet', form: 'Research bundle', note: 'Group a bounded set of source observations, interpretations, limits, and review questions.', boundary: 'Evidence packets remain re-reviewable.' },
    { id: 'P-12', title: 'Semantic document architecture', form: 'Design study', note: 'Explore the shape of a document system before building a query service or knowledge graph.', boundary: 'Architecture synthesis is not an implementation.' },
    { id: 'P-13', title: 'Tiered identity', form: 'Candidate direction', note: 'Study identifiers and review states that preserve local readability and traceability.', boundary: 'A design direction is not a deployed grammar.' },
    { id: 'P-14', title: 'Provenance chain', form: 'Trace model', note: 'Connect source, context, decision, and subsequent projection as separate records.', boundary: 'A chain may still have omissions.' },
    { id: 'P-15', title: 'Standards crosswalk', form: 'Compatibility study', note: 'Compare a local profile to wider reference vocabularies without claiming conformance by resemblance.', boundary: 'Crosswalks require their own review.' },
    { id: 'P-16', title: 'Review-gated next slice', form: 'Program handoff', note: 'Move from research to a narrowly specified next artifact only after the responsible review gate closes.', boundary: 'No implementation authority is implied.' },
  ] },
  { id: 'exocore', title: 'Exocore', source: 'Exocore platform and engineering research', framing: 'A systems research frame for the ecology around agents, knowledge, governance, and creative practice—not a claim of a deployed autonomous system.', entries: [
    { id: 'P-17', title: 'System ecology', form: 'Orientation map', note: 'Read a working environment as relationships among people, records, tools, policies, and interfaces.', boundary: 'An ecology map does not automate its participants.' },
    { id: 'P-18', title: 'Memory with boundaries', form: 'Knowledge concern', note: 'Study what should persist, who may read it, and how it returns with source and freshness context.', boundary: 'Memory is not permission to retain everything.' },
    { id: 'P-19', title: 'Agent harness', form: 'Operational surface', note: 'Define a bounded environment for task context, tools, stop conditions, and human return.', boundary: 'A harness does not grant autonomy or authority.' },
    { id: 'P-20', title: 'Governance as interface', form: 'Design premise', note: 'Make rules, gates, and source boundaries legible at the moment a person needs them.', boundary: 'An interface cannot replace accountable review.' },
    { id: 'P-21', title: 'Continuity packet', form: 'Resumption object', note: 'Leave a future reader the state, sources, limits, and next decision needed to resume work safely.', boundary: 'Continuity does not promise a complete history.' },
    { id: 'P-22', title: 'Creative prototype', form: 'World-building method', note: 'Use a designed world or system fiction to make a tradeoff experiential and discussable.', boundary: 'Fictional examples are not operational evidence.' },
    { id: 'P-23', title: 'Operational observability', form: 'Inspection question', note: 'Ask what a person can see about a process without exposing private material or treating logs as truth.', boundary: 'Visibility must respect privacy and interpretation limits.' },
    { id: 'P-24', title: 'Human return', form: 'Control point', note: 'Place consequential judgments where a person can inspect, amend, defer, or withhold the next transition.', boundary: 'No system is authorized to self-release.' },
  ] },
  { id: 'program-workbench', title: 'Program workbench', source: 'Cross-program candidate synthesis', framing: 'Practical public artifacts that let a reader study the programs without mistaking this site for the private working environment.', entries: [
    { id: 'P-25', title: 'Program map', form: 'Public module', note: 'A compact map of question, source families, candidate artifacts, and unresolved edges.', boundary: 'The map is a projection, not the program’s canonical state.' },
    { id: 'P-26', title: 'Concept card', form: 'Educational object', note: 'A short definition with nearest distinction, example, and explicit non-claim.', boundary: 'A card cannot carry every context.' },
    { id: 'P-27', title: 'Protocol sketch', form: 'Teaching artifact', note: 'A small sequence readers can adapt to their own environment: orient, bound, attempt, check, return.', boundary: 'Adaptation remains the reader’s responsibility.' },
    { id: 'P-28', title: 'Fictional walkthrough', form: 'Worked example', note: 'A clearly imaginary scenario that demonstrates a method without representing a client or private project.', boundary: 'No fictional example establishes efficacy.' },
    { id: 'P-29', title: 'Decision record', form: 'Governance object', note: 'A public-safe record of a question, options, rationale, limits, and later review point.', boundary: 'Public records exclude protected operational detail.' },
    { id: 'P-30', title: 'Source shelf', form: 'Reading route', note: 'A selected set of public references with their relevance and the question each one informs.', boundary: 'Citation is not endorsement or adoption.' },
    { id: 'P-31', title: 'Open question ledger', form: 'Research interface', note: 'A list of unresolved questions linked to the public materials that frame them.', boundary: 'Open questions remain open until evidence changes them.' },
    { id: 'P-32', title: 'Release packet', form: 'Editorial gate', note: 'A pre-publication bundle for checking audience, source fidelity, privacy, and exact wording.', boundary: 'The packet itself does not publish anything.' },
  ] },
];

const notes: Set[] = [
  { id: 'field-notes', title: 'Field notes', source: 'Studio editorial practice', framing: 'Short observations made public after private working context has been removed.', entries: [
    { id: 'N-01', title: 'Context is part of the artifact', form: 'Field note', note: 'A useful record explains the conditions that make its reading appropriate.', boundary: 'Public practice; not a universal rule.' },
    { id: 'N-02', title: 'The smallest useful structure', form: 'Field note', note: 'A system need not be grand to remember a decision, source, and next question.', boundary: 'Public practice; not a universal rule.' },
    { id: 'N-03', title: 'Return paths are interfaces', form: 'Field note', note: 'Correction, resumption, and disagreement deserve design attention equal to entry points.', boundary: 'Public practice; not a workflow guarantee.' },
    { id: 'N-04', title: 'Vocabulary carries temperature', form: 'Field note', note: 'The names chosen for a system shape whether people can inhabit and question it.', boundary: 'Public practice; no private-language disclosure.' },
  ] },
  { id: 'essays', title: 'Essay shelf', source: 'Semantic orientation + operational intelligence', framing: 'Public essays that bridge rigorous systems work and accessible language.', entries: [
    { id: 'N-05', title: 'Meaning before machinery', form: 'Hearthside essay', note: 'Why representation, purpose, and human consequence should be clear before automation is discussed.', boundary: 'A practice perspective, not a universal prescription.' },
    { id: 'N-06', title: 'The craft of keeping uncertainty visible', form: 'Hearthside essay', note: 'How a research surface can remain candid without becoming vague or inert.', boundary: 'A practice perspective, not an evidence guarantee.' },
    { id: 'N-07', title: 'A humane theory of provenance', form: 'Hearthside essay', note: 'How source, context, and correction can make a public claim more accountable and readable.', boundary: 'A practice perspective, not an audit standard.' },
    { id: 'N-08', title: 'Tools in a bounded room', form: 'Hearthside essay', note: 'A public account of agent harnesses as constrained work environments rather than independent actors.', boundary: 'A practice perspective, not a claim of autonomy.' },
  ] },
  { id: 'articles', title: 'Technical articles', source: 'TCCP, EKRP, Exocore research homes', framing: 'Article frames that translate program concepts into technical, public-friendly explanations.', entries: [
    { id: 'N-09', title: 'Typed context for real work', form: 'Technical article', note: 'A practical introduction to separating source, claim, proposal, decision, and receipt in a working system.', boundary: 'No claim of a universal standard.' },
    { id: 'N-10', title: 'Knowledge representation without a black box', form: 'Technical article', note: 'A readable tour of application profiles, evidence packets, projections, and review-gated synthesis.', boundary: 'No deployed-service claim.' },
    { id: 'N-11', title: 'Operational intelligence as a comparison practice', form: 'Technical article', note: 'How to compare operations and transitions without centralizing the authorities that govern them.', boundary: 'Framework remains open to review.' },
    { id: 'N-12', title: 'Prompting as interface design', form: 'Technical article', note: 'A practitioner’s guide to inputs, output contracts, tool boundaries, checks, and revision.', boundary: 'No efficacy guarantee.' },
  ] },
];

const evidence: Set[] = [
  { id: 'source-forms', title: 'Source forms', source: 'Hub provenance and semantic orientation boundaries', framing: 'Different kinds of source material deserve different treatment before they become public learning material.', entries: [
    { id: 'E-01', title: 'Direct source', form: 'Evidence class', note: 'Material directly inspected at a stated locator, with its revision and relevant scope noted.', boundary: 'Direct access does not settle interpretation.' },
    { id: 'E-02', title: 'Source absence', form: 'Evidence class', note: 'A named gap where a needed source, owner, or permission has not been established.', boundary: 'Absence never becomes permission by default.' },
    { id: 'E-03', title: 'Derived projection', form: 'Evidence class', note: 'A public-facing transformation that names what it carries forward and what it leaves behind.', boundary: 'A projection is not its source.' },
    { id: 'E-04', title: 'Fictional teaching case', form: 'Evidence class', note: 'An explicitly imaginary example used to explain a pattern or tradeoff.', boundary: 'Fiction is not evidence of live practice.' },
  ] },
  { id: 'claim-forms', title: 'Claim forms', source: 'Evidence and ambiguity ledger discipline', framing: 'A sentence is more useful when readers can see what kind of statement it is trying to be.', entries: [
    { id: 'E-05', title: 'Observation', form: 'Claim class', note: 'What was directly seen, measured, or inspected under stated conditions.', boundary: 'Observations can still be incomplete.' },
    { id: 'E-06', title: 'Interpretation', form: 'Claim class', note: 'A plausible reading of an observation, with the relation to that observation made visible.', boundary: 'Interpretation is not fact by tone.' },
