---
/**
 * LicenseIcon - license type atom
 * Knowledge primitive (k-atom): k-license
 */
interface Props {
  license: 'CC-BY' | 'CC-BY-SA' | 'CC-BY-NC' | 'MIT' | 'Apache-2.0' | 'GPL-3.0' | 'BSD-3' | 'CC0' | 'proprietary' | 'unknown';
  href?: string;
  class?: string;
}
const { license, href, class: className = '' } = Astro.props;
const Tag = href ? 'a' : 'span';
const tagProps = href ? { href } : {};
---
<Tag class:list={['kc-license', `kc-license--${license}`, className]} title={license} {...tagProps}>
  <span class="kc-license__icon" aria-hidden="true">©</span>
  <span class="kc-license__label">{license}</span>
</Tag>

<style>
  .kc-license {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    padding: 0.1em 0.5em;
    border-radius: var(--radius-sm);
    background: var(--color-surface-raised);
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.05em;
    border: 1px solid var(--color-surface-rule);
    text-decoration: none;
  }
  a.kc-license:hover { color: var(--color-accent-signal); border-color: var(--color-accent-signal); }
  .kc-license__icon {
    color: var(--color-accent-gold);
    font-size: 1em;
  }
  .kc-license--CC0 { color: var(--color-state-success); }
  .kc-license--CC0 .kc-license__icon { color: var(--color-state-success); }
  .kc-license--proprietary { color: var(--color-state-caution); }
  .kc-license--unknown { color: var(--color-text-secondary); }
</style>
