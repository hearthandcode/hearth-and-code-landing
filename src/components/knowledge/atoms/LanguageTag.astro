---
/**
 * LanguageTag - code language tag atom
 * Knowledge primitive (k-atom): k-language-tag
 */
interface Props {
  language: string;
  variant?: 'plain' | 'compact' | 'minimal';
  class?: string;
}
const { language, variant = 'plain', class: className = '' } = Astro.props;
const colors: Record<string, string> = {
  python: 'var(--color-accent-signal)',
  typescript: 'var(--color-accent-plasma)',
  javascript: 'var(--color-accent-gold)',
  rust: 'var(--color-accent-ember)',
  yaml: 'var(--color-accent-violet)',
  json: 'var(--color-text-secondary)',
  bash: 'var(--color-state-success)',
  markdown: 'var(--color-text-display)',
  sql: 'var(--color-state-caution)',
  go: 'var(--color-accent-plasma)',
};
const color = colors[language.toLowerCase()] ?? 'var(--color-text-secondary)';
---
<span
  class:list={['kc-language-tag', `kc-language-tag--${variant}`, className]}
  style={`--lang-color: ${color};`}
>
  <span class="kc-language-tag__pip" aria-hidden="true"></span>
  {variant !== 'minimal' && <span class="kc-language-tag__label">{language}</span>}
</span>

<style>
  .kc-language-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.1em 0.5em;
    border-radius: var(--radius-sm);
    background: var(--color-surface-recessed);
    color: var(--lang-color, var(--color-text-secondary));
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: lowercase;
    letter-spacing: 0.05em;
    border: 1px solid var(--color-surface-rule);
  }
  .kc-language-tag__pip {
    width: 0.45em;
    height: 0.45em;
    border-radius: 50%;
    background: var(--lang-color, var(--color-text-secondary));
  }
  .kc-language-tag--minimal { padding: 0.1em; }
  .kc-language-tag--compact { padding: 0.05em 0.35em; font-size: 0.625rem; }
</style>
