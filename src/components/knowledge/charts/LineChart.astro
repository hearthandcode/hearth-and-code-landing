---
/**
 * LineChart - D3 line chart with smooth path
 * Knowledge chart: k-chart-line
 */
import * as d3 from 'd3';
interface Point { x: number | string; y: number; }
interface Series { name: string; data: Point[]; color?: string; }
interface Props {
  series: Series[];
  height?: number;
  xLabel?: string;
  yLabel?: string;
  showPoints?: boolean;
  smooth?: boolean;
  class?: string;
}
const {
  series, height = 240, xLabel, yLabel, showPoints = true, smooth = true, class: className = '',
} = Astro.props;
const chartId = `kc-line-${Math.random().toString(36).slice(2, 9)}`;
const width = 320;
const margin = { top: 12, right: 12, bottom: xLabel ? 32 : 24, left: 32 };
const innerW = width - margin.left - margin.right;
const innerH = height - margin.top - margin.bottom;
const allPoints = series.flatMap(s => s.data);
const xVals = allPoints.map(p => p.x);
const xIsNumeric = xVals.every(v => typeof v === 'number');
---
<div class:list={['kc-d3-line', className]} data-chart-id={chartId}>
  <svg viewBox={`0 0 ${width} ${height}`} xmlns="http://www.w3.org/2000/svg" class="kc-d3-line__svg"></svg>
  <div class="kc-d3-line__legend">
    {series.map((s, i) => (
      <span><span class="kc-d3-line__swatch" style={`background: ${s.color || ['var(--color-accent-signal)', 'var(--color-accent-ember)', 'var(--color-accent-violet)', 'var(--color-accent-gold)'][i % 4]}`}></span>{s.name}</span>
    ))}
  </div>
</div>

<script define:vars={{ chartId, series, width, height, margin, innerW, innerH, xLabel, yLabel, showPoints, smooth, xIsNumeric }}>
  import('d3').then((d3) => {
    document.querySelectorAll(`[data-chart-id="${chartId}"]`).forEach((container) => {
      const svg = d3.select(container).select('svg');
      svg.selectAll('*').remove();
      const g = svg.append('g').attr('transform', `translate(${margin.left},${margin.top})`);
      const all = series.flatMap(s => s.data);
      const xDomain = xIsNumeric
        ? d3.extent(all, d => d.x as number) as [number, number]
        : Array.from(new Set(all.map(d => d.x as string)));
      const x = xIsNumeric ? d3.scaleLinear().domain(xDomain).range([0, innerW]) : d3.scalePoint().domain(xDomain as string[]).range([0, innerW]);
      const y = d3.scaleLinear().domain([0, d3.max(all, d => d.y) || 1]).nice().range([innerH, 0]);
      const line = smooth ? d3.line().x(d => (x(d.x) ?? 0) + (xIsNumeric ? 0 : (x.bandwidth?.() ?? 0) / 2)).y(d => y(d.y)).curve(d3.curveMonotoneX) : d3.line().x(d => (x(d.x) ?? 0) + (xIsNumeric ? 0 : (x.bandwidth?.() ?? 0) / 2)).y(d => y(d.y));
      series.forEach((s, i) => {
        const color = s.color || ['var(--color-accent-signal)', 'var(--color-accent-ember)', 'var(--color-accent-violet)', 'var(--color-accent-gold)'][i % 4];
        g.append('path').datum(s.data).attr('fill', 'none').attr('stroke', color).attr('stroke-width', 2).attr('d', line);
        if (showPoints) {
          g.selectAll(`circle.kc-line-pt-${i}`).data(s.data).enter().append('circle')
            .attr('class', `kc-line-pt-${i}`)
            .attr('cx', d => (x(d.x) ?? 0) + (xIsNumeric ? 0 : (x.bandwidth?.() ?? 0) / 2))
            .attr('cy', d => y(d.y)).attr('r', 3).attr('fill', color);
        }
      });
      const xAxis = xIsNumeric ? d3.axisBottom(x).ticks(5) : d3.axisBottom(x);
      g.append('g').attr('transform', `translate(0,${innerH})`).call(xAxis)
        .selectAll('text').attr('fill', 'var(--color-text-secondary)').attr('font-family', 'var(--font-mono)').attr('font-size', '9');
      g.append('g').call(d3.axisLeft(y).ticks(4))
        .selectAll('text').attr('fill', 'var(--color-text-secondary)').attr('font-family', 'var(--font-mono)').attr('font-size', '9');
      g.selectAll('.domain, .tick line').attr('stroke', 'var(--color-surface-rule)');
    });
  });
</script>

<style>
  .kc-d3-line { background: var(--color-surface-recessed); border-radius: var(--radius-sm); padding: var(--space-2); }
  .kc-d3-line__svg { width: 100%; height: auto; display: block; }
  .kc-d3-line__legend {
    display: flex; gap: var(--space-3); flex-wrap: wrap; margin-top: var(--space-2);
    font-family: var(--font-mono); font-size: 0.6875rem; color: var(--color-text-secondary);
  }
  .kc-d3-line__legend span { display: inline-flex; align-items: center; gap: 0.3em; }
  .kc-d3-line__swatch { width: 0.7rem; height: 0.7rem; border-radius: 2px; }
</style>
