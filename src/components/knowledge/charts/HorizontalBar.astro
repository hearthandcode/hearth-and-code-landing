---
/**
 * HorizontalBar - D3 horizontal bar chart
 * Knowledge chart: k-chart-hbar
 */
import * as d3 from 'd3';
interface Datum { label: string; value: number; color?: string; }
interface Props {
  data: Datum[];
  height?: number;
  showValues?: boolean;
  class?: string;
}
const { data, height = 240, showValues = true, class: className = '' } = Astro.props;
const chartId = `kc-hbar-${Math.random().toString(36).slice(2, 9)}`;
const width = 320;
const margin = { top: 4, right: 28, bottom: 4, left: 90 };
const innerW = width - margin.left - margin.right;
const innerH = height - margin.top - margin.bottom;
const max = Math.max(...data.map((d) => d.value), 1);
const rowH = innerH / Math.max(1, data.length);
---
<div class:list={['kc-d3-hbar', className]} data-chart-id={chartId}>
  <svg viewBox={`0 0 ${width} ${height}`} xmlns="http://www.w3.org/2000/svg" class="kc-d3-hbar__svg"></svg>
</div>

<script define:vars={{ chartId, data, width, height, margin, innerW, innerH, max, rowH, showValues }}>
  import('d3').then((d3) => {
    document.querySelectorAll(`[data-chart-id="${chartId}"]`).forEach((container) => {
      const svg = d3.select(container).select('svg');
      svg.selectAll('*').remove();
      const g = svg.append('g').attr('transform', `translate(${margin.left},${margin.top})`);
      const yScale = d3.scaleBand().domain(data.map(d => d.label)).range([0, innerH]).padding(0.2);
      const xScale = d3.scaleLinear().domain([0, max * 1.1]).range([0, innerW]);

      g.selectAll('rect.kc-hbar')
        .data(data)
        .enter()
        .append('rect')
        .attr('class', 'kc-hbar')
        .attr('x', 0)
        .attr('y', (d) => yScale(d.label) ?? 0)
        .attr('width', (d) => xScale(d.value))
        .attr('height', yScale.bandwidth())
        .attr('fill', (d, i) => d.color || ['var(--color-accent-signal)', 'var(--color-accent-ember)', 'var(--color-accent-violet)'][i % 3])
        .attr('rx', 2);

      g.selectAll('text.kc-hbar-label')
        .data(data)
        .enter()
        .append('text')
        .attr('class', 'kc-hbar-label')
        .attr('x', -6)
        .attr('y', (d) => (yScale(d.label) ?? 0) + yScale.bandwidth() / 2)
        .attr('dy', '0.35em')
        .attr('text-anchor', 'end')
        .attr('fill', 'var(--color-text-display)')
        .attr('font-family', 'var(--font-mono)')
        .attr('font-size', '10')
        .text((d) => d.label);

      if (showValues) {
        g.selectAll('text.kc-hbar-value')
          .data(data)
          .enter()
          .append('text')
          .attr('class', 'kc-hbar-value')
          .attr('x', (d) => xScale(d.value) + 4)
          .attr('y', (d) => (yScale(d.label) ?? 0) + yScale.bandwidth() / 2)
          .attr('dy', '0.35em')
          .attr('fill', 'var(--color-text-display)')
          .attr('font-family', 'var(--font-mono)')
          .attr('font-size', '10')
          .text((d) => d.value);
      }
    });
  });
</script>

<style>
  .kc-d3-hbar { background: var(--color-surface-recessed); border-radius: var(--radius-sm); padding: var(--space-2); }
  .kc-d3-hbar__svg { width: 100%; height: auto; display: block; }
</style>
