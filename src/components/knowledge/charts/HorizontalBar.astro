---
/**
 * HorizontalBar - D3 horizontal bar chart
 * Knowledge chart: k-chart-hbar
 */
import * as d3 from 'd3';
interface Datum { label: string; value: number; color?: string; }
interface Props {
  data: Datum[];
  height?: number;
  showValues?: boolean;
  class?: string;
}
const { data, height = 240, showValues = true, class: className = '' } = Astro.props;
const chartId = `kc-hbar-${Math.random().toString(36).slice(2, 9)}`;
const width = 320;
const margin = { top: 4, right: 28, bottom: 4, left: 90 };
const innerW = width - margin.left - margin.right;
const innerH = height - margin.top - margin.bottom;
const max = Math.max(...data.map((d) => d.value), 1);
const rowH = innerH / Math.max(1, data.length);
---
<div class:list={['kc-d3-hbar', className]} data-chart-id={chartId} data-props={JSON.stringify({ data: data, height: height, showValues: showValues })}>
  <svg viewBox={`0 0 ${width} ${height}`} xmlns="http://www.w3.org/2000/svg" class="kc-d3-hbar__svg"></svg>
</div>


  <script type="application/json" id={`props-${chartId}`} set:html={JSON.stringify({ data: data, height: height, showValues: showValues })}></script>
<style>
  .kc-d3-hbar { background: var(--color-surface-recessed); border-radius: var(--radius-sm); padding: var(--space-2); }
  .kc-d3-hbar__svg { width: 100%; height: auto; display: block; }
</style>
