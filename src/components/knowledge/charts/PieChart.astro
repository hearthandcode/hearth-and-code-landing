---
/**
 * PieChart - D3 pie chart
 * Knowledge chart: k-chart-pie
 */
import * as d3 from 'd3';
interface Datum { label: string; value: number; color?: string; }
interface Props {
  data: Datum[];
  size?: number;
  showLabels?: boolean;
  class?: string;
}
const { data, size = 240, showLabels = true, class: className = '' } = Astro.props;
const chartId = `kc-pie-${Math.random().toString(36).slice(2, 9)}`;
const radius = size / 2 - 8;
const palette = ['var(--color-accent-ember)', 'var(--color-accent-signal)', 'var(--color-accent-violet)', 'var(--color-accent-gold)', 'var(--color-accent-plasma)'];
---
<div class:list={['kc-d3-pie', className]} data-chart-id={chartId} data-props={JSON.stringify({ data: data, size: size, showLabels: showLabels })}>
  <svg viewBox={`0 0 ${size} ${size}`} xmlns="http://www.w3.org/2000/svg" class="kc-d3-pie__svg"></svg>
  <div class="kc-d3-pie__legend">
    {data.map((d, i) => (
      <span><span class="kc-d3-pie__swatch" style={`background: ${d.color || palette[i % 5]}`}></span>{d.label} ({((d.value / data.reduce((s, x) => s + x.value, 0)) * 100).toFixed(0)}%)</span>
    ))}
  </div>
</div>


  <script type="application/json" id={`props-${chartId}`} set:html={JSON.stringify({ data: data, size: size, showLabels: showLabels })}></script>
<style>
  .kc-d3-pie { background: var(--color-surface-recessed); border-radius: var(--radius-sm); padding: var(--space-2); display: flex; gap: var(--space-3); align-items: center; }
  .kc-d3-pie__svg { width: 50%; height: auto; display: block; flex-shrink: 0; }
  .kc-d3-pie__legend { flex: 1; display: flex; flex-direction: column; gap: 0.3em; font-family: var(--font-mono); font-size: 0.6875rem; color: var(--color-text-secondary); }
  .kc-d3-pie__legend span { display: inline-flex; align-items: center; gap: 0.3em; }
  .kc-d3-pie__swatch { width: 0.7rem; height: 0.7rem; border-radius: 2px; flex-shrink: 0; }
</style>
