---
/**
 * Treemap - D3 treemap (nested rectangles)
 * Knowledge chart: k-chart-treemap
 */
import * as d3 from 'd3';
interface Datum { name: string; value: number; color?: string; children?: Datum[]; }
interface Props {
  data: Datum;
  height?: number;
  class?: string;
}
const { data, height = 240, class: className = '' } = Astro.props;
const chartId = `kc-treemap-${Math.random().toString(36).slice(2, 9)}`;
const width = 320;
const palette = ['var(--color-accent-ember)', 'var(--color-accent-signal)', 'var(--color-accent-violet)', 'var(--color-accent-gold)', 'var(--color-accent-plasma)'];
---
<div class:list={['kc-d3-treemap', className]} data-chart-id={chartId} data-props={JSON.stringify({ data: data, height: height })}>
  <svg viewBox={`0 0 ${width} ${height}`} xmlns="http://www.w3.org/2000/svg" class="kc-d3-treemap__svg"></svg>
</div>


  <script type="application/json" id={`props-${chartId}`} set:html={JSON.stringify({ data: data, height: height })}></script>
<style>
  .kc-d3-treemap { background: var(--color-surface-recessed); border-radius: var(--radius-sm); padding: var(--space-2); }
  .kc-d3-treemap__svg { width: 100%; height: auto; display: block; }
</style>
