---
/**
 * Treemap - D3 treemap (nested rectangles)
 * Knowledge chart: k-chart-treemap
 */
import * as d3 from 'd3';
interface Datum { name: string; value: number; color?: string; children?: Datum[]; }
interface Props {
  data: Datum;
  height?: number;
  class?: string;
}
const { data, height = 240, class: className = '' } = Astro.props;
const chartId = `kc-treemap-${Math.random().toString(36).slice(2, 9)}`;
const width = 320;
const palette = ['var(--color-accent-ember)', 'var(--color-accent-signal)', 'var(--color-accent-violet)', 'var(--color-accent-gold)', 'var(--color-accent-plasma)'];
---
<div class:list={['kc-d3-treemap', className]} data-chart-id={chartId}>
  <svg viewBox={`0 0 ${width} ${height}`} xmlns="http://www.w3.org/2000/svg" class="kc-d3-treemap__svg"></svg>
</div>

<script define:vars={{ chartId, data, width, height, palette }}>
  import('d3').then((d3) => {
    document.querySelectorAll(`[data-chart-id="${chartId}"]`).forEach((container) => {
      const svg = d3.select(container).select('svg');
      svg.selectAll('*').remove();
      const root = d3.hierarchy<Datum>(data).sum(d => d.value || 0);
      d3.treemap<Datum>().size([width, height]).padding(2).round(true)(root);
      const flatColors = new Map<string, string>();
      let colorIdx = 0;
      svg.selectAll('rect').data(root.leaves()).enter().append('rect')
        .attr('x', d => (d).x0).attr('y', d => (d).y0)
        .attr('width', d => (d).x1 - (d).x0).attr('height', d => (d).y1 - (d).y0)
        .attr('fill', d => {
          if (!flatColors.has(d.data.name)) flatColors.set(d.data.name, palette[colorIdx++ % 5]);
          return d.data.color || flatColors.get(d.data.name);
        }).attr('rx', 2);
      svg.selectAll('text').data(root.leaves()).enter().append('text')
        .attr('x', d => (d).x0 + 4).attr('y', d => (d).y0 + 14)
        .attr('fill', 'var(--color-surface-primary)').attr('font-family', 'var(--font-mono)')
        .attr('font-size', '10').attr('font-weight', 'bold').text(d => d.data.name);
      svg.selectAll('text.value').data(root.leaves()).enter().append('text')
        .attr('class', 'value')
        .attr('x', d => (d).x0 + 4).attr('y', d => (d).y0 + 26)
        .attr('fill', 'var(--color-surface-primary)').attr('font-family', 'var(--font-mono)')
        .attr('font-size', '9').attr('opacity', 0.8).text(d => d.data.value || '');
    });
  });
</script>

<style>
  .kc-d3-treemap { background: var(--color-surface-recessed); border-radius: var(--radius-sm); padding: var(--space-2); }
  .kc-d3-treemap__svg { width: 100%; height: auto; display: block; }
</style>
