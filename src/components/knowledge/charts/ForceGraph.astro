---
/**
 * ForceGraph - D3 force-directed graph
 * Knowledge chart: k-chart-force
 *
 * Standalone chart variant of the knowledge graph. For interactive
 * graph exploration, see KnowledgeGraphView template.
 */
import * as d3 from 'd3';
interface Node { id: string; label: string; type?: string; }
interface Edge { source: string; target: string; }
interface Props {
  nodes: Node[];
  edges: Edge[];
  height?: number;
  class?: string;
}
const { nodes, edges, height = 320, class: className = '' } = Astro.props;
const chartId = `kc-force-${Math.random().toString(36).slice(2, 9)}`;
const width = 320;
const colors: Record<string, string> = {
  concept: 'var(--color-accent-signal)',
  claim: 'var(--color-accent-ember)',
  source: 'var(--color-accent-violet)',
  task: 'var(--color-accent-gold)',
};
---
<div class:list={['kc-d3-force', className]} data-chart-id={chartId} data-props={JSON.stringify({ nodes: nodes, edges: edges, height: height })}>
  <svg viewBox={`0 0 ${width} ${height}`} xmlns="http://www.w3.org/2000/svg" class="kc-d3-force__svg"></svg>
</div>


  <script type="application/json" id={`props-${chartId}`} set:html={JSON.stringify({ nodes: nodes, edges: edges, height: height })}></script>
<style>
  .kc-d3-force { background: var(--color-surface-recessed); border-radius: var(--radius-sm); padding: var(--space-2); }
  .kc-d3-force__svg { width: 100%; height: auto; display: block; }
</style>
