---
/**
 * ForceGraph - D3 force-directed graph
 * Knowledge chart: k-chart-force
 *
 * Standalone chart variant of the knowledge graph. For interactive
 * graph exploration, see KnowledgeGraphView template.
 */
import * as d3 from 'd3';
interface Node { id: string; label: string; type?: string; }
interface Edge { source: string; target: string; }
interface Props {
  nodes: Node[];
  edges: Edge[];
  height?: number;
  class?: string;
}
const { nodes, edges, height = 320, class: className = '' } = Astro.props;
const chartId = `kc-force-${Math.random().toString(36).slice(2, 9)}`;
const width = 320;
const colors: Record<string, string> = {
  concept: 'var(--color-accent-signal)',
  claim: 'var(--color-accent-ember)',
  source: 'var(--color-accent-violet)',
  task: 'var(--color-accent-gold)',
};
---
<div class:list={['kc-d3-force', className]} data-chart-id={chartId}>
  <svg viewBox={`0 0 ${width} ${height}`} xmlns="http://www.w3.org/2000/svg" class="kc-d3-force__svg"></svg>
</div>

<script define:vars={{ chartId, nodes, edges, width, height, colors }}>
  import('d3').then((d3) => {
    document.querySelectorAll(`[data-chart-id="${chartId}"]`).forEach((container) => {
      const svg = d3.select(container).select('svg');
      svg.selectAll('*').remove();
      const N = nodes.map(n => ({ ...n }));
      const L = edges.map(e => ({ source: e.source, target: e.target }));
      const sim = d3.forceSimulation(N)
        .force('link', d3.forceLink(L).id((d: any) => d.id).distance(80))
        .force('charge', d3.forceManyBody().strength(-200))
        .force('center', d3.forceCenter(width / 2, height / 2))
        .alpha(0.5);
      const link = svg.append('g').attr('stroke', 'var(--color-surface-rule)').attr('stroke-width', 1)
        .selectAll('line').data(L).enter().append('line');
      const node = svg.append('g').selectAll('g').data(N).enter().append('g');
      node.append('circle').attr('r', 18).attr('fill', (d: any) => colors[d.type || 'concept'] || 'var(--color-accent-signal)').attr('opacity', 0.7).attr('stroke', 'var(--color-surface-recessed)').attr('stroke-width', 1.5);
      node.append('text').attr('text-anchor', 'middle').attr('dy', '0.35em')
        .attr('fill', 'var(--color-text-display)').attr('font-family', 'var(--font-mono)').attr('font-size', '8').text((d: any) => d.label);
      sim.on('tick', () => {
        link.attr('x1', (d: any) => d.source.x).attr('y1', (d: any) => d.source.y).attr('x2', (d: any) => d.target.x).attr('y2', (d: any) => d.target.y);
        node.attr('transform', (d: any) => `translate(${d.x},${d.y})`);
      });
    });
  });
</script>

<style>
  .kc-d3-force { background: var(--color-surface-recessed); border-radius: var(--radius-sm); padding: var(--space-2); }
  .kc-d3-force__svg { width: 100%; height: auto; display: block; }
</style>
