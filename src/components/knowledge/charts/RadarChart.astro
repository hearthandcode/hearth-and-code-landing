---
/**
 * RadarChart - D3 radar/spider chart
 * Knowledge chart: k-chart-radar
 */
import * as d3 from 'd3';
interface Axis { label: string; min?: number; max?: number; }
interface Datum { label: string; values: number[]; color?: string; }
interface Props {
  axes: Axis[];
  data: Datum[];
  size?: number;
  class?: string;
}
const { axes, data, size = 260, class: className = '' } = Astro.props;
const chartId = `kc-radar-${Math.random().toString(36).slice(2, 9)}`;
const radius = size / 2 - 30;
const angle = (i: number) => (i / axes.length) * 2 * Math.PI - Math.PI / 2;
const palette = ['var(--color-accent-ember)', 'var(--color-accent-signal)', 'var(--color-accent-violet)'];
---
<div class:list={['kc-d3-radar', className]} data-chart-id={chartId} data-props={JSON.stringify({ axes: axes, data: data, size: size })}>
  <svg viewBox={`0 0 ${size} ${size}`} xmlns="http://www.w3.org/2000/svg" class="kc-d3-radar__svg"></svg>
  <div class="kc-d3-radar__legend">
    {data.map((d, i) => (
      <span><span class="kc-d3-radar__swatch" style={`background: ${d.color || palette[i % 3]}`}></span>{d.label}</span>
    ))}
  </div>
</div>


  <script type="application/json" id={`props-${chartId}`} set:html={JSON.stringify({ axes: axes, data: data, size: size })}></script>
<style>
  .kc-d3-radar { background: var(--color-surface-recessed); border-radius: var(--radius-sm); padding: var(--space-2); display: flex; flex-direction: column; gap: var(--space-2); align-items: center; }
  .kc-d3-radar__svg { width: 100%; max-width: 16rem; height: auto; display: block; }
  .kc-d3-radar__legend { display: flex; gap: var(--space-3); flex-wrap: wrap; font-family: var(--font-mono); font-size: 0.6875rem; color: var(--color-text-secondary); }
  .kc-d3-radar__legend span { display: inline-flex; align-items: center; gap: 0.3em; }
  .kc-d3-radar__swatch { width: 0.7rem; height: 0.7rem; border-radius: 2px; }
</style>
