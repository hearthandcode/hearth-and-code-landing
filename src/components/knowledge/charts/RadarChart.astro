---
/**
 * RadarChart - D3 radar/spider chart
 * Knowledge chart: k-chart-radar
 */
import * as d3 from 'd3';
interface Axis { label: string; min?: number; max?: number; }
interface Datum { label: string; values: number[]; color?: string; }
interface Props {
  axes: Axis[];
  data: Datum[];
  size?: number;
  class?: string;
}
const { axes, data, size = 260, class: className = '' } = Astro.props;
const chartId = `kc-radar-${Math.random().toString(36).slice(2, 9)}`;
const radius = size / 2 - 30;
const angle = (i: number) => (i / axes.length) * 2 * Math.PI - Math.PI / 2;
const palette = ['var(--color-accent-ember)', 'var(--color-accent-signal)', 'var(--color-accent-violet)'];
---
<div class:list={['kc-d3-radar', className]} data-chart-id={chartId}>
  <svg viewBox={`0 0 ${size} ${size}`} xmlns="http://www.w3.org/2000/svg" class="kc-d3-radar__svg"></svg>
  <div class="kc-d3-radar__legend">
    {data.map((d, i) => (
      <span><span class="kc-d3-radar__swatch" style={`background: ${d.color || palette[i % 3]}`}></span>{d.label}</span>
    ))}
  </div>
</div>

<script define:vars={{ chartId, axes, data, size, radius, palette, angle }}>
  import('d3').then((d3) => {
    document.querySelectorAll(`[data-chart-id="${chartId}"]`).forEach((container) => {
      const svg = d3.select(container).select('svg');
      svg.selectAll('*').remove();
      const g = svg.append('g').attr('transform', `translate(${size / 2},${size / 2})`);
      // Axes
      const levels = 4;
      for (let i = 1; i <= levels; i++) {
        const r = (radius / levels) * i;
        const points = axes.map((_, j) => `${r * Math.cos(angle(j))},${r * Math.sin(angle(j))}`).join(' ');
        g.append('polygon').attr('points', points).attr('fill', 'none')
          .attr('stroke', 'var(--color-surface-rule)').attr('stroke-width', 0.5);
      }
      axes.forEach((axis, j) => {
        g.append('line').attr('x1', 0).attr('y1', 0)
          .attr('x2', radius * Math.cos(angle(j))).attr('y2', radius * Math.sin(angle(j)))
          .attr('stroke', 'var(--color-surface-rule)').attr('stroke-width', 0.5);
        g.append('text').attr('x', (radius + 8) * Math.cos(angle(j))).attr('y', (radius + 8) * Math.sin(angle(j)))
          .attr('dy', '0.35em').attr('text-anchor', 'middle')
          .attr('fill', 'var(--color-text-secondary)').attr('font-family', 'var(--font-mono)').attr('font-size', '10')
          .text(axis.label);
      });
      // Data polygons
      data.forEach((d, i) => {
        const color = d.color || palette[i % 3];
        const points = axes.map((axis, j) => {
          const val = d.values[j] ?? 0;
          const max = axis.max ?? 1;
          const min = axis.min ?? 0;
          const r = ((val - min) / (max - min)) * radius;
          return `${r * Math.cos(angle(j))},${r * Math.sin(angle(j))}`;
        }).join(' ');
        g.append('polygon').attr('points', points)
          .attr('fill', color).attr('fill-opacity', 0.2)
          .attr('stroke', color).attr('stroke-width', 2);
      });
    });
  });
</script>

<style>
  .kc-d3-radar { background: var(--color-surface-recessed); border-radius: var(--radius-sm); padding: var(--space-2); display: flex; flex-direction: column; gap: var(--space-2); align-items: center; }
  .kc-d3-radar__svg { width: 100%; max-width: 16rem; height: auto; display: block; }
  .kc-d3-radar__legend { display: flex; gap: var(--space-3); flex-wrap: wrap; font-family: var(--font-mono); font-size: 0.6875rem; color: var(--color-text-secondary); }
  .kc-d3-radar__legend span { display: inline-flex; align-items: center; gap: 0.3em; }
  .kc-d3-radar__swatch { width: 0.7rem; height: 0.7rem; border-radius: 2px; }
</style>
