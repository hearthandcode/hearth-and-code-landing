---
/**
 * GroupedBar - D3 grouped bar chart
 * Knowledge chart: k-chart-grouped-bar
 */
import * as d3 from 'd3';
interface GroupedDatum { category: string; series: string; value: number; }
interface Props {
  data: GroupedDatum[];
  seriesNames?: string[];
  height?: number;
  class?: string;
}
const { data, seriesNames, height = 240, class: className = '' } = Astro.props;
const chartId = `kc-gbar-${Math.random().toString(36).slice(2, 9)}`;
const width = 320;
const margin = { top: 16, right: 12, bottom: 36, left: 36 };
const innerW = width - margin.left - margin.right;
const innerH = height - margin.top - margin.bottom;
const series = seriesNames ?? Array.from(new Set(data.map(d => d.series)));
const categories = Array.from(new Set(data.map(d => d.category)));
const palette = ['var(--color-accent-ember)', 'var(--color-accent-signal)', 'var(--color-accent-violet)', 'var(--color-accent-gold)'];
const max = Math.max(...data.map(d => d.value), 1);
---
<div class:list={['kc-d3-gbar', className]} data-chart-id={chartId} data-props={JSON.stringify({ data: data, seriesNames: seriesNames, height: height })}>
  <svg viewBox={`0 0 ${width} ${height}`} xmlns="http://www.w3.org/2000/svg" class="kc-d3-gbar__svg"></svg>
  <div class="kc-d3-gbar__legend">
    {series.map((s, i) => (
      <span><span class="kc-d3-gbar__swatch" style={`background: ${palette[i % 4]}`}></span>{s}</span>
    ))}
  </div>
</div>


  <script type="application/json" id={`props-${chartId}`} set:html={JSON.stringify({ data: data, seriesNames: seriesNames, height: height })}></script>
<style>
  .kc-d3-gbar { background: var(--color-surface-recessed); border-radius: var(--radius-sm); padding: var(--space-2); }
  .kc-d3-gbar__svg { width: 100%; height: auto; display: block; }
  .kc-d3-gbar__legend {
    display: flex; gap: var(--space-3); flex-wrap: wrap; margin-top: var(--space-2);
    font-family: var(--font-mono); font-size: 0.6875rem; color: var(--color-text-secondary);
  }
  .kc-d3-gbar__legend span { display: inline-flex; align-items: center; gap: 0.3em; }
  .kc-d3-gbar__swatch { width: 0.7rem; height: 0.7rem; border-radius: 2px; }
</style>
