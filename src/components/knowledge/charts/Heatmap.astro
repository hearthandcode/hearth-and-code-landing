---
/**
 * Heatmap - D3 heatmap (grid colored by value)
 * Knowledge chart: k-chart-heatmap
 */
import * as d3 from 'd3';
interface Cell { row: string; col: string; value: number; }
interface Props {
  data: Cell[];
  rowLabel?: string;
  colLabel?: string;
  class?: string;
}
const { data, rowLabel, colLabel, class: className = '' } = Astro.props;
const chartId = `kc-heatmap-${Math.random().toString(36).slice(2, 9)}`;
const rows = Array.from(new Set(data.map(d => d.row)));
const cols = Array.from(new Set(data.map(d => d.col)));
const cellSize = Math.min(36, Math.floor(280 / cols.length));
const width = cols.length * cellSize + 60;
const height = rows.length * cellSize + 40;
---
<div class:list={['kc-d3-heatmap', className]} data-chart-id={chartId}>
  <svg viewBox={`0 0 ${width} ${height}`} xmlns="http://www.w3.org/2000/svg" class="kc-d3-heatmap__svg"></svg>
</div>

<script define:vars={{ chartId, data, rows, cols, cellSize, width, height, rowLabel, colLabel }}>
  import('d3').then((d3) => {
    document.querySelectorAll(`[data-chart-id="${chartId}"]`).forEach((container) => {
      const svg = d3.select(container).select('svg');
      svg.selectAll('*').remove();
      const max = d3.max(data, d => d.value) || 1;
      const color = d3.scaleSequential(d3.interpolateOranges).domain([0, max]);
      svg.append('g').attr('transform', 'translate(50,20)')
        .selectAll('rect').data(data).enter().append('rect')
        .attr('x', d => cols.indexOf(d.col) * cellSize)
        .attr('y', d => rows.indexOf(d.row) * cellSize)
        .attr('width', cellSize - 1).attr('height', cellSize - 1)
        .attr('fill', d => color(d.value));
      svg.append('g').attr('transform', 'translate(50,20)')
        .selectAll('text.cell-val').data(data).enter().append('text')
        .attr('class', 'cell-val')
        .attr('x', d => cols.indexOf(d.col) * cellSize + cellSize / 2)
        .attr('y', d => rows.indexOf(d.row) * cellSize + cellSize / 2)
        .attr('dy', '0.35em').attr('text-anchor', 'middle')
        .attr('font-family', 'var(--font-mono)').attr('font-size', '9')
        .attr('fill', 'var(--color-surface-primary)').text(d => d.value);
      svg.append('g').selectAll('text.row-label').data(rows).enter().append('text')
        .attr('class', 'row-label')
        .attr('x', 46).attr('y', (_, i) => 20 + i * cellSize + cellSize / 2)
        .attr('dy', '0.35em').attr('text-anchor', 'end')
        .attr('font-family', 'var(--font-mono)').attr('font-size', '9')
        .attr('fill', 'var(--color-text-secondary)').text(d => d);
      svg.append('g').selectAll('text.col-label').data(cols).enter().append('text')
        .attr('class', 'col-label')
        .attr('x', (_, i) => 50 + i * cellSize + cellSize / 2)
        .attr('y', 14)
        .attr('text-anchor', 'middle')
        .attr('font-family', 'var(--font-mono)').attr('font-size', '9')
        .attr('fill', 'var(--color-text-secondary)').text(d => d);
    });
  });
</script>

<style>
  .kc-d3-heatmap { background: var(--color-surface-recessed); border-radius: var(--radius-sm); padding: var(--space-2); }
  .kc-d3-heatmap__svg { width: 100%; height: auto; display: block; }
</style>
