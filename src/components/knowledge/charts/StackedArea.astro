---
/**
 * StackedArea - D3 stacked area chart (multiple series)
 * Knowledge chart: k-chart-stacked-area
 */
import * as d3 from 'd3';
interface Series { name: string; data: { x: number; y: number }[]; color?: string; }
interface Props {
  series: Series[];
  height?: number;
  class?: string;
}
const { series, height = 240, class: className = '' } = Astro.props;
const chartId = `kc-sarea-${Math.random().toString(36).slice(2, 9)}`;
const width = 320;
const margin = { top: 12, right: 12, bottom: 28, left: 36 };
const innerW = width - margin.left - margin.right;
const innerH = height - margin.top - margin.bottom;
const allData = series.flatMap(s => s.data);
const palette = ['var(--color-accent-ember)', 'var(--color-accent-signal)', 'var(--color-accent-violet)', 'var(--color-accent-gold)'];
---
<div class:list={['kc-d3-sarea', className]} data-chart-id={chartId} data-props={JSON.stringify({ series: series, height: height })}>
  <svg viewBox={`0 0 ${width} ${height}`} xmlns="http://www.w3.org/2000/svg" class="kc-d3-sarea__svg"></svg>
  <div class="kc-d3-sarea__legend">
    {series.map((s, i) => (
      <span><span class="kc-d3-sarea__swatch" style={`background: ${s.color || palette[i % 4]}`}></span>{s.name}</span>
    ))}
  </div>
</div>


  <script type="application/json" id={`props-${chartId}`} set:html={JSON.stringify({ series: series, height: height })}></script>
<style>
  .kc-d3-sarea { background: var(--color-surface-recessed); border-radius: var(--radius-sm); padding: var(--space-2); }
  .kc-d3-sarea__svg { width: 100%; height: auto; display: block; }
  .kc-d3-sarea__legend {
    display: flex; gap: var(--space-3); flex-wrap: wrap; margin-top: var(--space-2);
    font-family: var(--font-mono); font-size: 0.6875rem; color: var(--color-text-secondary);
  }
  .kc-d3-sarea__legend span { display: inline-flex; align-items: center; gap: 0.3em; }
  .kc-d3-sarea__swatch { width: 0.7rem; height: 0.7rem; border-radius: 2px; }
</style>
