---
/**
 * CitationChain - linear chain of citations
 * Knowledge composite (k-composite): k-citation-chain
 *
 * Renders a sequence of citations connected by arrows.
 */
interface Citation {
  author: string;
  year: number | string;
  locator?: string;
  href?: string;
}
interface Props {
  citations: Citation[];
  label?: string;
  separator?: 'arrow' | 'pipe' | 'dot';
  class?: string;
}
const { citations, label, separator = 'arrow', class: className = '' } = Astro.props;
const seps = { arrow: '→', pipe: '│', dot: '·' };
---
<ol class:list={['kc-citation-chain', `kc-citation-chain--${separator}`, className]}>
  {label && <p class="kc-citation-chain__label">{label}</p>}
  <div class="kc-citation-chain__list">
    {citations.map((c, i) => (
      <li class="kc-citation-chain__item">
        <span class="kc-citation-chain__index">{i + 1}</span>
        <span class="kc-citation-chain__ref">
          <a href={c.href} class="kc-citation-chain__link">
            <span class="kc-citation-chain__author">{c.author}</span>
            <span class="kc-citation-chain__year">({c.year})</span>
            {c.locator && <span class="kc-citation-chain__locator">{c.locator}</span>}
          </a>
        </span>
        {i < citations.length - 1 && (
          <span class="kc-citation-chain__sep" aria-hidden="true">{seps[separator]}</span>
        )}
      </li>
    ))}
  </div>
</ol>

<style>
  .kc-citation-chain {
    padding: var(--space-3);
    background: var(--color-surface-raised);
    border: 1px solid var(--color-surface-rule);
    border-radius: var(--radius-md);
  }
  .kc-citation-chain__label {
    margin: 0 0 var(--space-2) 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-secondary);
  }
  .kc-citation-chain__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .kc-citation-chain__item {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
  }
  .kc-citation-chain__index {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    background: var(--color-accent-signal);
    color: var(--color-surface-primary);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: var(--font-weight-bold);
    flex-shrink: 0;
  }
  .kc-citation-chain__link {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-text-display);
    text-decoration: none;
    border-bottom: 1px solid var(--color-surface-rule);
  }
  .kc-citation-chain__link:hover { color: var(--color-accent-plasma); border-color: var(--color-accent-plasma); }
  .kc-citation-chain__year { color: var(--color-text-secondary); margin-left: 0.2em; }
  .kc-citation-chain__locator {
    color: var(--color-accent-signal);
    margin-left: 0.2em;
    font-weight: var(--font-weight-medium);
  }
  .kc-citation-chain__sep {
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    margin: 0 0.2em;
  }
</style>
