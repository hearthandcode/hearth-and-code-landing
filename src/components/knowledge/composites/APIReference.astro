---
/**
 * APIReference - endpoint table (method/path/params/response)
 * Knowledge composite (k-composite): k-api-reference
 */
interface Endpoint {
  method: 'GET' | 'POST' | 'PUT' | 'PATCH' | 'DELETE';
  path: string;
  description: string;
  params?: { name: string; in: 'path' | 'query' | 'body'; type: string; required: boolean; description: string }[];
  response?: { status: number; description: string };
}
interface Props {
  endpoint: Endpoint;
  class?: string;
}
const { endpoint, class: className = '' } = Astro.props;
const methodColors: Record<string, string> = {
  GET: 'var(--color-state-success)',
  POST: 'var(--color-accent-plasma)',
  PUT: 'var(--color-accent-gold)',
  PATCH: 'var(--color-accent-violet)',
  DELETE: 'var(--color-state-error)',
};
---
<article class:list={['kc-api-ref', className]}>
  <header class="kc-api-ref__header">
    <span class="kc-api-ref__method" style={`color: ${methodColors[endpoint.method]}`}>{endpoint.method}</span>
    <code class="kc-api-ref__path">{endpoint.path}</code>
  </header>
  <p class="kc-api-ref__desc">{endpoint.description}</p>
  {endpoint.params && endpoint.params.length > 0 && (
    <section class="kc-api-ref__section">
      <h5 class="kc-api-ref__label">Parameters</h5>
      <table class="kc-api-ref__table">
        <thead>
          <tr><th>Name</th><th>In</th><th>Type</th><th>Description</th></tr>
        </thead>
        <tbody>
          {endpoint.params.map((p) => (
            <tr>
              <td>
                <code class="kc-api-ref__pname">{p.name}</code>
                {p.required && <span class="kc-api-ref__preq" title="required">*</span>}
              </td>
              <td><span class="kc-api-ref__pin">{p.in}</span></td>
              <td><code>{p.type}</code></td>
              <td>{p.description}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  )}
  {endpoint.response && (
    <section class="kc-api-ref__section">
      <h5 class="kc-api-ref__label">Response</h5>
      <div class="kc-api-ref__response">
        <span class="kc-api-ref__status">{endpoint.response.status}</span>
        <span>{endpoint.response.description}</span>
      </div>
    </section>
  )}
</article>

<style>
  .kc-api-ref {
    padding: var(--space-4);
    background: var(--color-surface-raised);
    border: 1px solid var(--color-surface-rule);
    border-radius: var(--radius-md);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }
  .kc-api-ref__header {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-surface-rule);
  }
  .kc-api-ref__method {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: var(--font-weight-bold);
    padding: 0.15em 0.5em;
    border: 1px solid currentColor;
    border-radius: var(--radius-sm);
    flex-shrink: 0;
  }
  .kc-api-ref__path {
    color: var(--color-text-display);
    font-size: 0.875rem;
    word-break: break-all;
  }
  .kc-api-ref__desc {
    margin: var(--space-3) 0;
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }
  .kc-api-ref__section { margin-top: var(--space-3); }
  .kc-api-ref__label {
    margin: 0 0 var(--space-2) 0;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent-signal);
  }
  .kc-api-ref__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.75rem;
  }
  .kc-api-ref__table th,
  .kc-api-ref__table td {
    padding: var(--space-2);
    text-align: left;
    border-bottom: 1px solid var(--color-surface-rule);
    vertical-align: top;
  }
  .kc-api-ref__table th {
    color: var(--color-text-secondary);
    font-weight: var(--font-weight-medium);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.625rem;
  }
  .kc-api-ref__pname { color: var(--color-text-display); font-weight: var(--font-weight-bold); }
  .kc-api-ref__preq { color: var(--color-state-error); margin-left: 0.2em; }
  .kc-api-ref__pin {
    color: var(--color-accent-gold);
    font-size: 0.6875rem;
    text-transform: uppercase;
  }
  .kc-api-ref__table code {
    background: var(--color-surface-recessed);
    color: var(--color-accent-plasma);
    padding: 0.1em 0.4em;
    border-radius: var(--radius-sm);
    font-size: 0.75rem;
  }
  .kc-api-ref__response {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    font-family: var(--font-body);
    color: var(--color-text-display);
  }
  .kc-api-ref__status {
    font-family: var(--font-mono);
    font-weight: var(--font-weight-bold);
    color: var(--color-state-success);
    padding: 0.1em 0.4em;
    background: rgba(143, 163, 149, 0.12);
    border-radius: var(--radius-sm);
  }
</style>
