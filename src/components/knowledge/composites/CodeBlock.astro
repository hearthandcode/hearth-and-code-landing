---
/**
 * CodeBlock - syntax-highlighted code with copy button
 * Knowledge composite (k-composite): k-code-block
 *
 * Interactive: copy to clipboard, optional line highlighting.
 * Highlighter: Shiki (TextMate grammar) for production-quality highlighting.
 */
import { codeToHtml } from 'shiki';

interface Props {
  code: string;
  language: 'python' | 'typescript' | 'javascript' | 'rust' | 'yaml' | 'json' | 'bash' | 'sql' | 'markdown' | 'tsx' | 'jsx' | 'css' | 'html';
  filename?: string;
  highlightLines?: number[];
  showLineNumbers?: boolean;
  theme?: 'github-dark' | 'github-light';
  class?: string;
}
const {
  code,
  language,
  filename,
  highlightLines = [],
  showLineNumbers = true,
  theme = 'github-dark',
  class: className = '',
} = Astro.props;
const blockId = `kc-code-${Math.random().toString(36).slice(2, 9)}`;

// Map our language aliases to Shiki's bundled language ids
const shikiLangMap: Record<string, string> = {
  python: 'python',
  typescript: 'typescript',
  javascript: 'javascript',
  rust: 'rust',
  yaml: 'yaml',
  json: 'json',
  bash: 'bash',
  sql: 'sql',
  markdown: 'markdown',
  tsx: 'tsx',
  jsx: 'jsx',
  css: 'css',
  html: 'html',
};
const shikiLang = shikiLangMap[language] || 'text';

// Highlight via Shiki. We strip Shiki's outer <pre> and keep only the inner content
// so our surrounding styles can apply uniformly.
let highlightedHtml: string;
try {
  highlightedHtml = await codeToHtml(code, {
    lang: shikiLang,
    theme,
  });
} catch (e) {
  // Fallback to plain escaped text if the grammar isn't loaded
  highlightedHtml = `<pre><code>${code.replace(/&/g, '&').replace(/</g, '<').replace(/>/g, '>')}</code></pre>`;
}

// Extract the inner <code>...</code> from Shiki output so we control the wrapping
// Shiki returns: <pre class="shiki ..."><code><span class="line">...</span></code></pre>
// We replace each <span class="line">...</span> with our own line wrapper that includes
// line numbers and highlight-line styling.
const lines = code.split('\n');
const lineHtml = lines
  .map((_, i) => {
    const num = i + 1;
    const isHi = highlightLines.includes(num);
    return `<span class="kc-code-block__line${isHi ? ' is-highlighted' : ''}" data-linenum="${num}">${showLineNumbers ? `<span class="kc-code-block__linenum">${num}</span>` : ''}<span class="kc-code-block__content"></span></span>`;
  })
  .join('');

// Build the final HTML by combining the Shiki inner spans (per-line) with our wrappers.
// Shiki produces spans with class "line" inside <code>; we map each line's inner HTML
// by index. Since Shiki output is deterministic, the simplest approach is to parse
// each line from Shiki output. We do that via simple regex.
const shikiLines = highlightedHtml.match(/<span class="line">(.*?)<\/span>(?=\s*<span class="line"|<\/code>|<\/pre>)/gs) || [];
const innerHtml = lines.map((_, i) => {
  const num = i + 1;
  const isHi = highlightLines.includes(num);
  const inner = shikiLines[i] ? shikiLines[i].replace(/^<span class="line">/, '').replace(/<\/span>$/, '') : '';
  return `<span class="kc-code-block__line${isHi ? ' is-highlighted' : ''}" data-linenum="${num}">${showLineNumbers ? `<span class="kc-code-block__linenum">${num}</span>` : ''}<span class="kc-code-block__content">${inner}</span></span>`;
}).join('');

const lineCount = lines.length;
---
<div class:list={['kc-code-block', className]} data-code-id={blockId}>
  {(filename || language) && (
    <header class="kc-code-block__header">
      <span class="kc-code-block__filename">{filename || language}</span>
      <span class="kc-code-block__lang">{language}</span>
      <span class="kc-code-block__lines">{lineCount} {lineCount === 1 ? 'line' : 'lines'}</span>
      <button class="kc-code-block__copy" data-copy-btn>
        <span data-copy-default>Copy</span>
        <span data-copy-done hidden>Copied</span>
      </button>
    </header>
  )}
  <pre class:list={['kc-code-block__pre', showLineNumbers && 'has-line-nums']}><code set:html={innerHtml} /></pre>
</div>

<script>
  document.querySelectorAll('.kc-code-block').forEach((block) => {
    const btn = block.querySelector('.kc-code-block__copy');
    if (!btn) return;
    btn.addEventListener('click', async () => {
      // Reconstruct the original code from each line's text content
      const code = Array.from(block.querySelectorAll('.kc-code-block__content'))
        .map((s) => (s.textContent || ''))
        .join('\n');
      try {
        await navigator.clipboard.writeText(code);
        const def = block.querySelector('[data-copy-default]');
        const done = block.querySelector('[data-copy-done]');
        if (def && done) {
          def.hidden = true;
          done.hidden = false;
          setTimeout(() => { def.hidden = false; done.hidden = true; }, 1200);
        }
      } catch (e) {
        console.error('Copy failed', e);
      }
    });
  });
</script>

<style>
  .kc-code-block {
    background: var(--color-surface-recessed);
    border: 1px solid var(--color-surface-rule);
    border-radius: var(--radius-md);
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }
  .kc-code-block__header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--color-surface-rule);
    background: var(--color-surface-raised);
  }
  .kc-code-block__filename {
    color: var(--color-text-display);
    font-weight: var(--font-weight-medium);
  }
  .kc-code-block__lang {
    color: var(--color-text-secondary);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .kc-code-block__lines {
    color: var(--color-text-secondary);
    font-size: 0.625rem;
    margin-left: auto;
  }
  .kc-code-block__copy {
    padding: 0.2em 0.6em;
    background: transparent;
    border: 1px solid var(--color-surface-rule);
    border-radius: var(--radius-sm);
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    cursor: pointer;
  }
  .kc-code-block__copy:hover {
    color: var(--color-accent-signal);
    border-color: var(--color-accent-signal);
  }
  .kc-code-block__pre {
    margin: 0;
    padding: var(--space-3);
    overflow-x: auto;
    line-height: 1.5;
    color: var(--color-text-display);
  }
  .kc-code-block__line {
    display: flex;
    gap: var(--space-3);
  }
  .kc-code-block__line.is-highlighted {
    background: rgba(63, 224, 208, 0.08);
    border-left: 2px solid var(--color-accent-plasma);
    margin-left: -0.5rem;
    padding-left: 0.5rem;
  }
  .kc-code-block__linenum {
    color: var(--color-text-secondary);
    opacity: 0.5;
    user-select: none;
    min-width: 2em;
    text-align: right;
    flex-shrink: 0;
  }
  .kc-code-block__content { flex: 1; }
  /* Shiki spans inherit color */
  .kc-code-block :global(.shiki) { background: transparent !important; }
  .kc-code-block :global(.shiki span) { color: var(--shiki-color, currentColor); }
</style>
