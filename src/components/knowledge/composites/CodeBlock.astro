---
/**
 * CodeBlock - syntax-highlighted code with copy button
 * Knowledge composite (k-composite): k-code-block
 *
 * Interactive: copy to clipboard, optional line highlighting
 */
interface Props {
  code: string;
  language: 'python' | 'typescript' | 'javascript' | 'rust' | 'yaml' | 'json' | 'bash' | 'sql' | 'markdown';
  filename?: string;
  highlightLines?: number[];
  showLineNumbers?: boolean;
  class?: string;
}
const {
  code, language, filename, highlightLines = [], showLineNumbers = true, class: className = '',
} = Astro.props;
const blockId = `kc-code-${Math.random().toString(36).slice(2, 9)}`;

// Simple token highlighting — replace with a real highlighter if available
function tokenize(src: string, lang: string): string {
  const keywords: Record<string, string[]> = {
    python: ['def', 'class', 'import', 'from', 'return', 'if', 'else', 'elif', 'for', 'in', 'while', 'try', 'except', 'with', 'as', 'yield', 'lambda', 'pass', 'break', 'continue', 'None', 'True', 'False'],
    typescript: ['const', 'let', 'var', 'function', 'return', 'if', 'else', 'for', 'while', 'class', 'interface', 'type', 'import', 'export', 'from', 'as', 'async', 'await', 'new', 'this'],
    javascript: ['const', 'let', 'var', 'function', 'return', 'if', 'else', 'for', 'while', 'class', 'import', 'export', 'from', 'as', 'async', 'await', 'new', 'this'],
    rust: ['fn', 'let', 'mut', 'pub', 'use', 'mod', 'struct', 'enum', 'impl', 'trait', 'for', 'while', 'if', 'else', 'match', 'return', 'self', 'Self'],
    yaml: [],
    json: [],
    bash: ['if', 'then', 'else', 'fi', 'for', 'do', 'done', 'while', 'case', 'esac', 'function'],
    sql: ['SELECT', 'FROM', 'WHERE', 'JOIN', 'LEFT', 'RIGHT', 'INNER', 'OUTER', 'ON', 'GROUP', 'BY', 'ORDER', 'LIMIT', 'INSERT', 'INTO', 'VALUES', 'UPDATE', 'SET', 'DELETE'],
    markdown: [],
  };
  const kw = keywords[lang] || [];
  return src
    .replace(/&/g, '&')
    .replace(/</g, '<')
    .replace(/>/g, '>')
    .replace(/("[^"]*"|'[^']*'|`[^`]*`)/g, '<span class="kc-code__string">$1</span>')
    .replace(/\b(\d+\.?\d*)\b/g, '<span class="kc-code__number">$1</span>')
    .replace(/(\/\/.*$|#.*$)/gm, '<span class="kc-code__comment">$1</span>')
    .replace(new RegExp(`\\b(${kw.join('|')})\\b`, 'g'), '<span class="kc-code__keyword">$1</span>');
}

const lines = code.split('\n');
---
<div class:list={['kc-code-block', className]} data-code-id={blockId}>
  {(filename || language) && (
    <header class="kc-code-block__header">
      <span class="kc-code-block__filename">{filename || language}</span>
      <span class="kc-code-block__lang">{language}</span>
      <button class="kc-code-block__copy" data-copy-btn>
        <span data-copy-default>Copy</span>
        <span data-copy-done hidden>Copied</span>
      </button>
    </header>
  )}
  <pre class:list={['kc-code-block__pre', showLineNumbers && 'has-line-nums']}><code>{
    lines.map((line, i) => (
      <span class:list={['kc-code-block__line', highlightLines.includes(i + 1) && 'is-highlighted']}>
        {showLineNumbers && <span class="kc-code-block__linenum">{i + 1}</span>}
        <span class="kc-code-block__content" set:html={tokenize(line, language)}></span>
      </span>
    ))
  }</code></pre>
</div>

<script>
  document.querySelectorAll('.kc-code-block').forEach((block) => {
    const btn = block.querySelector('.kc-code-block__copy');
    if (!btn) return;
    btn.addEventListener('click', async () => {
      const code = Array.from(block.querySelectorAll('.kc-code-block__content')).map((s) => (s as HTMLElement).innerText).join('\n');
      try {
        await navigator.clipboard.writeText(code);
        const def = block.querySelector('[data-copy-default]') as HTMLElement;
        const done = block.querySelector('[data-copy-done]') as HTMLElement;
        if (def && done) {
          def.hidden = true; done.hidden = false;
          setTimeout(() => { def.hidden = false; done.hidden = true; }, 1200);
        }
      } catch (e) {
        console.error('Copy failed', e);
      }
    });
  });
</script>

<style>
  .kc-code-block {
    background: var(--color-surface-recessed);
    border: 1px solid var(--color-surface-rule);
    border-radius: var(--radius-md);
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }
  .kc-code-block__header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--color-surface-rule);
    background: var(--color-surface-raised);
  }
  .kc-code-block__filename {
    color: var(--color-text-display);
    font-weight: var(--font-weight-medium);
  }
  .kc-code-block__lang {
    color: var(--color-text-secondary);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-left: auto;
  }
  .kc-code-block__copy {
    padding: 0.2em 0.6em;
    background: transparent;
    border: 1px solid var(--color-surface-rule);
    border-radius: var(--radius-sm);
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    cursor: pointer;
  }
  .kc-code-block__copy:hover {
    color: var(--color-accent-signal);
    border-color: var(--color-accent-signal);
  }
  .kc-code-block__pre {
    margin: 0;
    padding: var(--space-3);
    overflow-x: auto;
    line-height: 1.5;
    color: var(--color-text-display);
  }
  .kc-code-block__line {
    display: flex;
    gap: var(--space-3);
  }
  .kc-code-block__line.is-highlighted { background: rgba(63, 224, 208, 0.06); }
  .kc-code-block.has-line-nums .kc-code-block__line {
    padding-left: 0;
  }
  .kc-code-block__linenum {
    color: var(--color-text-secondary);
    opacity: 0.5;
    user-select: none;
    min-width: 2em;
    text-align: right;
    flex-shrink: 0;
  }
  .kc-code-block__content { flex: 1; }
  .kc-code-block :global(.kc-code__keyword) { color: var(--color-accent-violet); font-weight: var(--font-weight-bold); }
  .kc-code-block :global(.kc-code__string) { color: var(--color-state-success); }
  .kc-code-block :global(.kc-code__number) { color: var(--color-accent-gold); }
  .kc-code-block :global(.kc-code__comment) { color: var(--color-text-secondary); font-style: italic; }
</style>
