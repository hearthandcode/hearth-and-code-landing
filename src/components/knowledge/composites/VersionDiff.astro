---
/**
 * VersionDiff - side-by-side version comparison
 * Knowledge composite (k-composite): k-version-diff
 */
interface Line {
  kind: 'added' | 'removed' | 'unchanged' | 'context';
  text: string;
}
interface Props {
  before: { version: string; lines: Line[] };
  after: { version: string; lines: Line[] };
  class?: string;
}
const { before, after, class: className = '' } = Astro.props;
---
<div class:list={['kc-version-diff', className]}>
  <div class="kc-version-diff__pane kc-version-diff__pane--before">
    <header class="kc-version-diff__header">
      <span class="kc-version-diff__label">Before</span>
      <span class="kc-version-diff__version">v{before.version}</span>
    </header>
    <pre class="kc-version-diff__lines"><code>{
      before.lines.map((l) => (
        <span class:list={['kc-version-diff__line', `kc-version-diff__line--${l.kind}`]}>
          <span class="kc-version-diff__sigil">{
            l.kind === 'added' ? '+' : l.kind === 'removed' ? '-' : ' '
          }</span>
          <span class="kc-version-diff__text">{l.text}</span>
        </span>
      ))
    }</code></pre>
  </div>
  <div class="kc-version-diff__pane kc-version-diff__pane--after">
    <header class="kc-version-diff__header">
      <span class="kc-version-diff__label">After</span>
      <span class="kc-version-diff__version">v{after.version}</span>
    </header>
    <pre class="kc-version-diff__lines"><code>{
      after.lines.map((l) => (
        <span class:list={['kc-version-diff__line', `kc-version-diff__line--${l.kind}`]}>
          <span class="kc-version-diff__sigil">{
            l.kind === 'added' ? '+' : l.kind === 'removed' ? '-' : ' '
          }</span>
          <span class="kc-version-diff__text">{l.text}</span>
        </span>
      ))
    }</code></pre>
  </div>
</div>

<style>
  .kc-version-diff {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--color-surface-rule);
    border: 1px solid var(--color-surface-rule);
    border-radius: var(--radius-md);
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }
  .kc-version-diff__pane {
    background: var(--color-surface-recessed);
    display: flex;
    flex-direction: column;
  }
  .kc-version-diff__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--color-surface-rule);
    background: var(--color-surface-raised);
  }
  .kc-version-diff__label {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-secondary);
  }
  .kc-version-diff__version {
    font-weight: var(--font-weight-bold);
    color: var(--color-text-display);
  }
  .kc-version-diff__lines {
    margin: 0;
    padding: var(--space-2);
    overflow-x: auto;
    line-height: 1.5;
  }
  .kc-version-diff__line {
    display: flex;
    gap: 0.5em;
    padding: 0.05em 0.3em;
  }
  .kc-version-diff__line--added { background: rgba(143, 163, 149, 0.12); color: var(--color-state-success); }
  .kc-version-diff__line--removed { background: rgba(194, 90, 42, 0.12); color: var(--color-state-error); }
  .kc-version-diff__line--context { color: var(--color-text-secondary); }
  .kc-version-diff__sigil {
    color: inherit;
    font-weight: var(--font-weight-bold);
    flex-shrink: 0;
  }
</style>
