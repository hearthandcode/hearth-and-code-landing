---
/**
 * ArchitectureDiagram - boxes-and-arrows with labeled edges
 * Knowledge composite (k-composite): k-architecture-diagram
 *
 * NOTE: Hand-coded SVG. For production, integrate D3.js,
 * mxGraph, or React Flow for richer interaction.
 */
interface Node {
  id: string;
  label: string;
  type?: 'service' | 'data' | 'user' | 'external' | 'queue';
}
interface Edge {
  from: string;
  to: string;
  label?: string;
  direction?: 'forward' | 'bidirectional';
}
interface Props {
  nodes: Node[];
  edges: Edge[];
  class?: string;
}
const { nodes, edges, class: className = '' } = Astro.props;
// Position nodes in a simple 3-column grid
const colWidth = 100 / Math.min(3, nodes.length);
---
<div class:list={['kc-arch-diagram', className]}>
  <svg viewBox="0 0 600 200" xmlns="http://www.w3.org/2000/svg" class="kc-arch-diagram__svg">
    <defs>
      <marker id="kc-arch-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--color-text-secondary)" />
      </marker>
    </defs>
    {nodes.map((n, i) => {
      const col = i % 3;
      const row = Math.floor(i / 3);
      const x = 100 + col * 200;
      const y = 50 + row * 100;
      const fill = {
        service: 'var(--color-accent-signal)',
        data: 'var(--color-accent-violet)',
        user: 'var(--color-accent-ember)',
        external: 'var(--color-accent-gold)',
        queue: 'var(--color-accent-plasma)',
      }[n.type || 'service'];
      return (
        <g class="kc-arch-diagram__node">
          <rect x={x - 70} y={y - 20} width="140" height="40" rx="4" fill="var(--color-surface-recessed)" stroke={fill} stroke-width="1.5" />
          <text x={x} y={y + 4} text-anchor="middle" fill="var(--color-text-display)" font-family="var(--font-mono)" font-size="11">{n.label}</text>
        </g>
      );
    })}
    {edges.map((e) => {
      const fromIdx = nodes.findIndex((n) => n.id === e.from);
      const toIdx = nodes.findIndex((n) => n.id === e.to);
      if (fromIdx === -1 || toIdx === -1) return null;
      const fromCol = fromIdx % 3;
      const fromRow = Math.floor(fromIdx / 3);
      const toCol = toIdx % 3;
      const toRow = Math.floor(toIdx / 3);
      const x1 = 100 + fromCol * 200 + 70;
      const y1 = 50 + fromRow * 100;
      const x2 = 100 + toCol * 200 - 70;
      const y2 = 50 + toRow * 100;
      const midX = (x1 + x2) / 2;
      return (
        <g class="kc-arch-diagram__edge">
          <path d={`M ${x1} ${y1} C ${midX} ${y1}, ${midX} ${y2}, ${x2} ${y2}`} fill="none" stroke="var(--color-text-secondary)" stroke-width="1" marker-end="url(#kc-arch-arrow)" />
          {e.label && (
            <text x={midX} y={(y1 + y2) / 2 - 4} text-anchor="middle" fill="var(--color-accent-gold)" font-family="var(--font-mono)" font-size="9">{e.label}</text>
          )}
        </g>
      );
    })}
  </svg>
  <div class="kc-arch-diagram__legend">
    {Array.from(new Set(nodes.map((n) => n.type || 'service'))).map((t) => (
      <span class="kc-arch-diagram__legend-item">
        <span class={`kc-arch-diagram__legend-swatch kc-arch-diagram__legend-swatch--${t}`}></span>
        {t}
      </span>
    ))}
  </div>
</div>

<style>
  .kc-arch-diagram {
    padding: var(--space-3);
    background: var(--color-surface-raised);
    border: 1px solid var(--color-surface-rule);
    border-radius: var(--radius-md);
  }
  .kc-arch-diagram__svg {
    width: 100%;
    height: auto;
    display: block;
  }
  .kc-arch-diagram__legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-surface-rule);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-text-secondary);
  }
  .kc-arch-diagram__legend-item { display: inline-flex; align-items: center; gap: 0.4em; }
  .kc-arch-diagram__legend-swatch {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 2px;
  }
  .kc-arch-diagram__legend-swatch--service { background: var(--color-accent-signal); }
  .kc-arch-diagram__legend-swatch--data { background: var(--color-accent-violet); }
  .kc-arch-diagram__legend-swatch--user { background: var(--color-accent-ember); }
  .kc-arch-diagram__legend-swatch--external { background: var(--color-accent-gold); }
  .kc-arch-diagram__legend-swatch--queue { background: var(--color-accent-plasma); }
</style>
