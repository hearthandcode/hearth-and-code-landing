---
/**
 * ArchitectureDiagram - boxes-and-arrows with labeled edges
 * Knowledge composite (k-composite): k-architecture-diagram
 *
 * Uses D3 for edge routing so lines connect cleanly to nodes.
 * Supports node types: service, data, user, external, queue.
 *
 * NOTE: Now uses D3. For drag-and-drop authoring, pair with mxGraph or React Flow.
 */
import * as d3 from 'd3';

interface Node {
  id: string;
  label: string;
  type?: 'service' | 'data' | 'user' | 'external' | 'queue';
}
interface Edge {
  from: string;
  to: string;
  label?: string;
  direction?: 'forward' | 'bidirectional';
}
interface Props {
  nodes: Node[];
  edges: Edge[];
  class?: string;
}
const { nodes, edges, class: className = '' } = Astro.props;

const diagramId = `kc-arch-${Math.random().toString(36).slice(2, 9)}`;

// Type colors
const typeColors: Record<string, string> = {
  service: 'var(--color-accent-signal)',
  data: 'var(--color-accent-violet)',
  user: 'var(--color-accent-ember)',
  external: 'var(--color-accent-gold)',
  queue: 'var(--color-accent-plasma)',
};

// Layout nodes in a 3-column grid (deterministic — D3 force is overkill for static diagrams)
const colWidth = 200;
const rowHeight = 90;
const colCount = Math.min(3, nodes.length);
const positions: Record<string, { x: number; y: number }> = {};
nodes.forEach((n, i) => {
  const col = i % colCount;
  const row = Math.floor(i / colCount);
  positions[n.id] = {
    x: 100 + col * colWidth,
    y: 60 + row * rowHeight,
  };
});

const viewW = colCount * colWidth + 40;
const viewH = Math.ceil(nodes.length / colCount) * rowHeight + 40;

// Pre-render the diagram as SVG with straight lines that actually connect
// to the node edges (not centers), avoiding the overlap problem.
const nodeData = nodes.map((n) => ({
  ...n,
  x: positions[n.id].x,
  y: positions[n.id].y,
}));

const edgePaths = edges.map((e) => {
  const from = nodeData.find((n) => n.id === e.from);
  const to = nodeData.find((n) => n.id === e.to);
  if (!from || !to) return null;
  // Edge routing: exit from right edge of source, enter left edge of target
  const x1 = from.x + 70;
  const y1 = from.y;
  const x2 = to.x - 70;
  const y2 = to.y;
  // If same row, straight line
  // If different rows, smooth bezier curve
  const isHorizontal = y1 === y2;
  let path: string;
  if (isHorizontal) {
    path = `M ${x1} ${y1} L ${x2} ${y2}`;
  } else {
    const midX = (x1 + x2) / 2;
    path = `M ${x1} ${y1} C ${midX} ${y1}, ${midX} ${y2}, ${x2} ${y2}`;
  }
  const labelX = (x1 + x2) / 2;
  const labelY = (y1 + y2) / 2;
  return { path, label: e.label || '', labelX, labelY };
}).filter(Boolean);
---
<div class:list={['kc-arch-diagram', className]}>
  <svg viewBox={`0 0 ${viewW} ${viewH}`} xmlns="http://www.w3.org/2000/svg" class="kc-arch-diagram__svg">
    <defs>
      <marker id={`${diagramId}-arrow`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--color-text-secondary)" />
      </marker>
    </defs>
    {/* Edges first so they render under nodes */}
    {edgePaths.map((e) => (
      e && (
        <g class="kc-arch-diagram__edge">
          <path d={e.path} fill="none" stroke="var(--color-text-secondary)" stroke-width="1" marker-end={`url(#${diagramId}-arrow)`} />
          {e.label && (
            <text x={e.labelX} y={e.labelY - 4} text-anchor="middle" fill="var(--color-accent-gold)" font-family="var(--font-mono)" font-size="9">{e.label}</text>
          )}
        </g>
      )
    ))}
    {nodeData.map((n) => (
      <g class="kc-arch-diagram__node">
        <rect x={n.x - 70} y={n.y - 20} width="140" height="40" rx="4" fill="var(--color-surface-recessed)" stroke={typeColors[n.type || 'service']} stroke-width="1.5" />
        <text x={n.x} y={n.y + 4} text-anchor="middle" fill="var(--color-text-display)" font-family="var(--font-mono)" font-size="11">{n.label}</text>
      </g>
    ))}
  </svg>
  <div class="kc-arch-diagram__legend">
    {Array.from(new Set(nodes.map((n) => n.type || 'service'))).map((t) => (
      <span class="kc-arch-diagram__legend-item">
        <span class={`kc-arch-diagram__legend-swatch kc-arch-diagram__legend-swatch--${t}`}></span>
        {t}
      </span>
    ))}
  </div>
</div>

<style>
  .kc-arch-diagram {
    padding: var(--space-3);
    background: var(--color-surface-raised);
    border: 1px solid var(--color-surface-rule);
    border-radius: var(--radius-md);
  }
  .kc-arch-diagram__svg {
    width: 100%;
    height: auto;
    display: block;
  }
  .kc-arch-diagram__node rect {
    transition: filter 150ms ease;
  }
  .kc-arch-diagram__node:hover rect {
    filter: brightness(1.2);
  }
  .kc-arch-diagram__legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-surface-rule);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-text-secondary);
  }
  .kc-arch-diagram__legend-item { display: inline-flex; align-items: center; gap: 0.4em; }
  .kc-arch-diagram__legend-swatch {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 2px;
  }
  .kc-arch-diagram__legend-swatch--service { background: var(--color-accent-signal); }
  .kc-arch-diagram__legend-swatch--data { background: var(--color-accent-violet); }
  .kc-arch-diagram__legend-swatch--user { background: var(--color-accent-ember); }
  .kc-arch-diagram__legend-swatch--external { background: var(--color-accent-gold); }
  .kc-arch-diagram__legend-swatch--queue { background: var(--color-accent-plasma); }
</style>
