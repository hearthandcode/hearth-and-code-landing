---
/**
 * ComponentPlayground - Storybook-style live prop controls
 * Knowledge template (k-template): k-component-playground
 *
 * Renders a component with editable prop controls.
 * Click "Code" to see the JSON prop tree.
 * Click "Reset" to restore defaults.
 *
 * Usage:
 *   <ComponentPlayground component={SomeComponent} props={...} labels={...} />
 */
interface PropMeta {
  name: string;
  type: 'string' | 'number' | 'boolean' | 'select';
  options?: string[];
  default?: any;
}
interface Props {
  componentName: string;
  initialProps: Record<string, any>;
  propMeta: PropMeta[];
  previewHtml: string; // SSR'd HTML of the rendered component
  class?: string;
}
const {
  componentName,
  initialProps,
  propMeta,
  previewHtml,
  class: className = '',
} = Astro.props;

const playgroundId = `kc-pg-${Math.random().toString(36).slice(2, 9)}`;
---
<div class:list={['kc-playground', className]} data-playground-id={playgroundId}>
  <header class="kc-playground__header">
    <span class="kc-playground__name">{componentName}</span>
    <div class="kc-playground__tabs">
      <button class="kc-playground__tab is-active" data-pg-tab="preview">Preview</button>
      <button class="kc-playground__tab" data-pg-tab="props">Props</button>
      <button class="kc-playground__tab" data-pg-tab="code">Code</button>
    </div>
  </header>

  <!-- Preview tab -->
  <div class="kc-playground__panel" data-pg-panel="preview" set:html={previewHtml} />

  <!-- Props tab -->
  <div class="kc-playground__panel kc-playground__panel--controls" data-pg-panel="props" hidden>
    <div class="kc-playground__props">
      {propMeta.map((meta) => {
        const value = initialProps[meta.name];
        return (
          <label class="kc-playground__prop">
            <span class="kc-playground__prop-label">{meta.name}</span>
            <span class="kc-playground__prop-type">{meta.type}</span>
            {meta.type === 'select' && (
              <select class="kc-playground__prop-input" data-prop={meta.name}>
                {meta.options?.map((opt) => (
                  <option value={opt} selected={value === opt}>{opt}</option>
                ))}
              </select>
            )}
            {meta.type === 'string' && (
              <input
                type="text"
                class="kc-playground__prop-input"
                data-prop={meta.name}
                value={value ?? ''}
              />
            )}
            {meta.type === 'number' && (
              <input
                type="number"
                class="kc-playground__prop-input"
                data-prop={meta.name}
                value={value ?? 0}
              />
            )}
            {meta.type === 'boolean' && (
              <label class="kc-playground__toggle">
                <input type="checkbox" data-prop={meta.name} checked={!!value} />
                <span>{value ? 'true' : 'false'}</span>
              </label>
            )}
          </label>
        );
      })}
    </div>
    <button class="kc-playground__reset" data-pg-reset>Reset to defaults</button>
  </div>

  <!-- Code tab -->
  <div class="kc-playground__panel kc-playground__panel--code" data-pg-panel="code" hidden>
    <pre class="kc-playground__code"><code>{`<${componentName}
  ${Object.entries(initialProps).map(([k, v]) => {
    const valStr = typeof v === 'string' ? `"${v}"` : JSON.stringify(v);
    return `${k}={${valStr}}`;
  }).join('\n  ')}
/>`}</code></pre>
  </div>
</div>

<script define:vars={{ playgroundId, componentName, initialProps, propMeta }}>
  // Component playground - tab switching + prop state display
  document.querySelectorAll(`[data-playground-id="${playgroundId}"]`).forEach((pg) => {
    const state = { ...initialProps };

    // Tab switching
    pg.addEventListener('click', (e) => {
      const target = e.target;
      const tabBtn = target.closest('[data-pg-tab]');
      if (tabBtn) {
        const tab = tabBtn.getAttribute('data-pg-tab');
        pg.querySelectorAll('[data-pg-tab]').forEach((b) => b.classList.toggle('is-active', b === tabBtn));
        pg.querySelectorAll('[data-pg-panel]').forEach((p) => {
          p.hidden = p.getAttribute('data-pg-panel') !== tab;
        });
        return;
      }
      // Reset button
      if (target.closest('[data-pg-reset]')) {
        Object.assign(state, initialProps);
        pg.querySelectorAll('[data-prop]').forEach((input) => {
          const name = input.getAttribute('data-prop');
          const meta = propMeta.find((m) => m.name === name);
          if (!meta) return;
          if (meta.type === 'boolean') {
            input.checked = !!initialProps[name];
          } else {
            input.value = initialProps[name] ?? '';
          }
        });
        updateCode();
        return;
      }
    });

    // Prop changes
    pg.addEventListener('input', (e) => {
      const input = e.target.closest('[data-prop]');
      if (!input) return;
      const name = input.getAttribute('data-prop');
      const meta = propMeta.find((m) => m.name === name);
      if (!meta) return;
      if (meta.type === 'boolean') {
        state[name] = input.checked;
      } else if (meta.type === 'number') {
        state[name] = Number(input.value);
      } else {
        state[name] = input.value;
      }
      updateCode();
    });

    function updateCode() {
      const codeLines = Object.entries(state).map(([k, v]) => {
        const val = typeof v === 'string' ? `"${v}"` : JSON.stringify(v);
        return `  ${k}={${val}}`;
      }).join('\n');
      const codeEl = pg.querySelector('.kc-playground__code code');
      if (codeEl) codeEl.textContent = `<${componentName}\n${codeLines}\n/>`;
    }
  });
</script>

<style>
  .kc-playground {
    background: var(--color-surface-raised);
    border: 1px solid var(--color-surface-rule);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .kc-playground__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-2) var(--space-3);
    background: var(--color-surface-recessed);
    border-bottom: 1px solid var(--color-surface-rule);
  }
  .kc-playground__name {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: var(--font-weight-bold);
    color: var(--color-accent-signal);
  }
  .kc-playground__tabs {
    display: flex;
    gap: 0.2em;
  }
  .kc-playground__tab {
    padding: 0.3em 0.7em;
    background: transparent;
    border: 1px solid var(--color-surface-rule);
    border-radius: var(--radius-sm);
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
  }
  .kc-playground__tab.is-active {
    background: var(--color-accent-signal);
    color: var(--color-surface-primary);
    border-color: var(--color-accent-signal);
  }
  .kc-playground__panel {
    padding: var(--space-4);
    background: var(--color-surface-primary);
    min-height: 6rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .kc-playground__panel--controls {
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    gap: var(--space-2);
  }
  .kc-playground__panel--code {
    align-items: flex-start;
    justify-content: flex-start;
  }
  .kc-playground__props {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: var(--space-2);
    width: 100%;
  }
  .kc-playground__prop {
    display: grid;
    grid-template-columns: auto auto 1fr;
    gap: 0.4em;
    align-items: center;
    padding: var(--space-2);
    background: var(--color-surface-recessed);
    border-radius: var(--radius-sm);
    font-size: 0.75rem;
  }
  .kc-playground__prop-label {
    color: var(--color-text-display);
    font-weight: var(--font-weight-medium);
  }
  .kc-playground__prop-type {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    text-transform: lowercase;
    color: var(--color-text-secondary);
  }
  .kc-playground__prop-input {
    padding: 0.3em 0.5em;
    background: var(--color-surface-primary);
    border: 1px solid var(--color-surface-rule);
    border-radius: var(--radius-sm);
    color: var(--color-text-display);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    width: 100%;
  }
  .kc-playground__toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    cursor: pointer;
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
  }
  .kc-playground__reset {
    padding: 0.4em 0.8em;
    background: transparent;
    border: 1px solid var(--color-surface-rule);
    border-radius: var(--radius-sm);
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    cursor: pointer;
  }
  .kc-playground__reset:hover {
    color: var(--color-accent-signal);
    border-color: var(--color-accent-signal);
  }
  .kc-playground__code {
    margin: 0;
    width: 100%;
    padding: var(--space-3);
    background: var(--color-surface-recessed);
    border-radius: var(--radius-sm);
    color: var(--color-text-display);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.5;
    overflow-x: auto;
    white-space: pre;
  }
</style>
