---
/**
 * PolicyDocument - formal policy document
 * Knowledge template (k-template): k-policy-document
 */
import HumanGate from '../composites/HumanGate.astro';
interface Section {
  id: string;
  title: string;
  body: string;
}
interface Props {
  id: string;
  title: string;
  effectiveDate: string;
  reviewDate: string;
  owner: string;
  sections: Section[];
  gates?: any[]; // HumanGate props
  class?: string;
}
const { id, title, effectiveDate, reviewDate, owner, sections, gates = [], class: className = '' } = Astro.props;
---
<article class:list={['kc-policy-doc', className]}>
  <header class="kc-policy-doc__cover">
    <p class="kc-policy-doc__eyebrow">Policy Document</p>
    <h2 class="kc-policy-doc__title">{title}</h2>
    <p class="kc-policy-doc__id">{id}</p>
    <dl class="kc-policy-doc__meta">
      <div><dt>Effective</dt><dd>{effectiveDate}</dd></div>
      <div><dt>Review</dt><dd>{reviewDate}</dd></div>
      <div><dt>Owner</dt><dd>{owner}</dd></div>
    </dl>
  </header>
  <div class="kc-policy-doc__body">
    {sections.map((s) => (
      <section id={`${id}-${s.id}`} class="kc-policy-doc__section">
        <h3 class="kc-policy-doc__section-title">{s.title}</h3>
        <p>{s.body}</p>
      </section>
    ))}
  </div>
  {gates.length > 0 && (
    <section class="kc-policy-doc__gates">
      <h3 class="kc-policy-doc__section-title">Approval gates</h3>
      <div class="kc-policy-doc__gate-list">
        {gates.map((g) => <HumanGate {...g} />)}
      </div>
    </section>
  )}
  <footer class="kc-policy-doc__footer">
    <p>This policy is governed by Hearth & Code's studio charter. Changes require human gate approval.</p>
  </footer>
</article>

<style>
  .kc-policy-doc {
    background: var(--color-surface-raised);
    border: 1px solid var(--color-surface-rule);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .kc-policy-doc__cover {
    padding: var(--space-7);
    background: var(--color-surface-recessed);
    border-bottom: 3px solid var(--color-accent-ember);
  }
  .kc-policy-doc__eyebrow {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-accent-gold);
  }
  .kc-policy-doc__title {
    margin: 0.5em 0;
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: var(--font-weight-bold);
    color: var(--color-text-display);
    line-height: 1.2;
  }
  .kc-policy-doc__id {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-accent-signal);
    background: rgba(31, 182, 168, 0.1);
    display: inline-block;
    padding: 0.15em 0.5em;
    border-radius: var(--radius-sm);
    margin: 0 0 1em 0;
  }
  .kc-policy-doc__meta {
    margin: 1em 0 0 0;
    display: flex;
    gap: var(--space-5);
    flex-wrap: wrap;
  }
  .kc-policy-doc__meta div { display: flex; flex-direction: column; gap: 0.2em; }
  .kc-policy-doc__meta dt {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-secondary);
  }
  .kc-policy-doc__meta dd {
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-text-display);
  }
  .kc-policy-doc__body {
    padding: var(--space-5) var(--space-7);
  }
  .kc-policy-doc__section {
    margin-bottom: var(--space-5);
    padding-bottom: var(--space-3);
    border-bottom: 1px dashed var(--color-surface-rule);
  }
  .kc-policy-doc__section:last-child { border-bottom: none; }
  .kc-policy-doc__section-title {
    margin: 0 0 var(--space-2) 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: var(--font-weight-bold);
    color: var(--color-text-display);
  }
  .kc-policy-doc__section p {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }
  .kc-policy-doc__gates {
    padding: var(--space-5) var(--space-7);
    border-top: 1px solid var(--color-surface-rule);
  }
  .kc-policy-doc__gate-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .kc-policy-doc__footer {
    padding: var(--space-4) var(--space-7);
    background: var(--color-surface-recessed);
    border-top: 1px solid var(--color-surface-rule);
    text-align: center;
  }
  .kc-policy-doc__footer p {
    margin: 0;
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    font-style: italic;
  }
</style>
