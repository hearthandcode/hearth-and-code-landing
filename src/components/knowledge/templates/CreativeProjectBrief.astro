---
/**
 * CreativeProjectBrief - narrative/dialogue project layout
 * Knowledge template (k-template): k-creative-project-brief
 */
import NarrativeArc from '../composites/NarrativeArc.astro';
import DialogueTree from '../composites/DialogueTree.astro';
interface Props {
  title: string;
  premise: string;
  arc: any[];
  sampleDialogue: any[];
  characters: { name: string; role: string; description: string }[];
  class?: string;
}
const { title, premise, arc, sampleDialogue, characters, class: className = '' } = Astro.props;
---
<article class:list={['kc-creative-brief', className]}>
  <header class="kc-creative-brief__cover">
    <p class="kc-creative-brief__eyebrow">Creative Project Brief</p>
    <h2 class="kc-creative-brief__title">{title}</h2>
    <p class="kc-creative-brief__premise">{premise}</p>
  </header>
  <div class="kc-creative-brief__body">
    <section class="kc-creative-brief__section">
      <h3>Characters</h3>
      <ul class="kc-creative-brief__chars">
        {characters.map((c) => (
          <li>
            <strong>{c.name}</strong>
            <span class="kc-creative-brief__char-role">{c.role}</span>
            <p>{c.description}</p>
          </li>
        ))}
      </ul>
    </section>
    <section class="kc-creative-brief__section">
      <h3>Narrative arc</h3>
      <NarrativeArc beats={arc} />
    </section>
    <section class="kc-creative-brief__section">
      <h3>Sample dialogue</h3>
      <DialogueTree nodes={sampleDialogue} rootId={sampleDialogue[0]?.id} />
    </section>
  </div>
</article>

<style>
  .kc-creative-brief {
    background: var(--color-surface-raised);
    border: 1px solid var(--color-surface-rule);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .kc-creative-brief__cover {
    padding: var(--space-7);
    background: var(--color-surface-recessed);
    border-bottom: 2px solid var(--color-accent-ember);
  }
  .kc-creative-brief__eyebrow {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-accent-gold);
  }
  .kc-creative-brief__title {
    margin: 0.5em 0;
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: var(--font-weight-bold);
    color: var(--color-text-display);
  }
  .kc-creative-brief__premise {
    margin: 0;
    font-family: var(--font-display);
    font-style: italic;
    color: var(--color-text-secondary);
    font-size: 1rem;
    line-height: 1.5;
    max-width: 40rem;
  }
  .kc-creative-brief__body {
    padding: var(--space-5) var(--space-7);
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
  }
  .kc-creative-brief__section h3 {
    margin: 0 0 var(--space-3) 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--color-text-display);
  }
  .kc-creative-brief__chars {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: var(--space-3);
  }
  .kc-creative-brief__chars li {
    padding: var(--space-3);
    background: var(--color-surface-recessed);
    border-radius: var(--radius-sm);
    border-left: 2px solid var(--color-accent-ember);
  }
  .kc-creative-brief__chars strong {
    display: block;
    color: var(--color-text-display);
    font-family: var(--font-display);
    font-size: 1rem;
  }
  .kc-creative-brief__char-role {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent-signal);
    margin: 0.2em 0;
  }
  .kc-creative-brief__chars p {
    margin: 0.3em 0 0 0;
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    line-height: 1.4;
  }
</style>
