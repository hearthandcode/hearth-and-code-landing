---
/**
 * KnowledgeGraphView - interactive graph of concepts
 * Knowledge template (k-template): k-knowledge-graph-view
 *
 * Server-side renders an initial SVG (positions from props), then D3
 * force simulation runs client-side to allow interaction.
 *
 * NOTE: For richer interactivity, pair with D3 drag handlers or
 * migrate to React Flow for React apps. Cytoscape.js offers built-in
 * graph algorithms (shortest path, centrality, etc).
 */
import * as d3 from 'd3';

interface Node {
  id: string;
  label: string;
  type?: 'concept' | 'claim' | 'source' | 'task';
  x: number;
  y: number;
}
interface Edge {
  from: string;
  to: string;
  label?: string;
}
interface Props {
  nodes: Node[];
  edges: Edge[];
  class?: string;
}
const { nodes, edges, class: className = '' } = Astro.props;

const graphId = `kc-graph-${Math.random().toString(36).slice(2, 9)}`;

const typeColors: Record<string, string> = {
  concept: 'var(--color-accent-signal)',
  claim: 'var(--color-accent-ember)',
  source: 'var(--color-accent-violet)',
  task: 'var(--color-accent-gold)',
};

const nodeData = nodes.map((n) => ({ ...n, fx: n.x, fy: n.y }));
const edgeData = edges.map((e) => ({ ...e }));
---
<div class:list={['kc-graph-view', className]} data-graph-id={graphId}>
  <svg viewBox="0 0 600 400" xmlns="http://www.w3.org/2000/svg" class="kc-graph-view__svg">
    <defs>
      <marker id={`${graphId}-arrow`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--color-text-secondary)" />
      </marker>
    </defs>
    {/* Edges */}
    <g class="kc-graph-view__edges">
      {edgeData.map((e, i) => {
        const from = nodeData.find((n) => n.id === e.from);
        const to = nodeData.find((n) => n.id === e.to);
        if (!from || !to) return null;
        return (
          <g class="kc-graph-view__edge" data-edge-id={i}>
            <line x1={from.x} y1={from.y} x2={to.x} y2={to.y} stroke="var(--color-surface-rule)" stroke-width="1" marker-end={`url(#${graphId}-arrow)`} class="kc-graph-view__edge-line" />
            {e.label && (
              <text x={(from.x + to.x) / 2} y={(from.y + to.y) / 2 - 4} text-anchor="middle" fill="var(--color-text-secondary)" font-family="var(--font-mono)" font-size="9" class="kc-graph-view__edge-label">{e.label}</text>
            )}
          </g>
        );
      })}
    </g>
    {/* Nodes */}
    <g class="kc-graph-view__nodes">
      {nodeData.map((n) => (
        <g class="kc-graph-view__node" data-node-id={n.id} transform={`translate(${n.x}, ${n.y})`}>
          <circle r="22" fill="var(--color-surface-recessed)" stroke={typeColors[n.type || 'concept']} stroke-width="2" class="kc-graph-view__node-circle" />
          <text y="4" text-anchor="middle" fill="var(--color-text-display)" font-family="var(--font-mono)" font-size="9" class="kc-graph-view__node-label">{n.label}</text>
        </g>
      ))}
    </g>
  </svg>
  <div class="kc-graph-view__hint">Drag nodes to rearrange. Connections follow.</div>
  <div class="kc-graph-view__legend">
    <span><span class="kc-graph-view__swatch kc-graph-view__swatch--concept"></span>Concept</span>
    <span><span class="kc-graph-view__swatch kc-graph-view__swatch--claim"></span>Claim</span>
    <span><span class="kc-graph-view__swatch kc-graph-view__swatch--source"></span>Source</span>
    <span><span class="kc-graph-view__swatch kc-graph-view__swatch--task"></span>Task</span>
  </div>
</div>

<script>
  import * as d3 from 'd3';

  // Find every graph view on the page and run the force simulation
  document.querySelectorAll('.kc-graph-view').forEach((gv) => {
    const svg = d3.select(gv).select('svg');
    const nodeElements = svg.select('.kc-graph-view__nodes').selectAll('.kc-graph-view__node').nodes();
    if (nodeElements.length === 0) return;

    const nodesG = nodeElements.map((n) => {
      const t = (n as Element).getAttribute('transform')?.match(/translate\(([\d.]+),\s*([\d.]+)\)/);
      return {
        id: (n as Element).getAttribute('data-node-id'),
        x: +(t?.[1] ?? '0'), y: +(t?.[2] ?? '0'),
        elem: n,
      };
    });
    const edgesG = Array.from(gv.querySelectorAll('.kc-graph-view__edge'));
    const links = edgesG.map((edge) => ({
      source: nodesG.findIndex((n) => {
        const line = edge.querySelector('line');
        return line && Math.abs(+(line.getAttribute('x1') ?? '0') - n.x) < 1 && Math.abs(+(line.getAttribute('y1') ?? '0') - n.y) < 1;
      }),
      target: nodesG.findIndex((n) => {
        const line = edge.querySelector('line');
        return line && Math.abs(+(line.getAttribute('x2') ?? '0') - n.x) < 1 && Math.abs(+(line.getAttribute('y2') ?? '0') - n.y) < 1;
      }),
      elem: edge,
    })).filter((l) => l.source !== -1 && l.target !== -1);

    const simulation = d3.forceSimulation(nodesG)
      .force('link', d3.forceLink(links).id((d: any) => d.id).distance(120))
      .force('charge', d3.forceManyBody().strength(-300))
      .force('center', d3.forceCenter(300, 200))
      .alpha(0.6)
      .alphaDecay(0.02);

    const drag = d3.drag()
      .on('start', (event: any, d: any) => {
        if (!event.active) simulation.alphaTarget(0.3).restart();
        d.fx = d.x; d.fy = d.y;
      })
      .on('drag', (event: any, d: any) => {
        d.fx = event.x; d.fy = event.y;
      })
      .on('end', (event: any, d: any) => {
        if (!event.active) simulation.alphaTarget(0);
        d.fx = null; d.fy = null;
      });

    svg.selectAll<SVGGElement, any>('.kc-graph-view__node').call(drag);

    simulation.on('tick', () => {
      svg.selectAll('.kc-graph-view__node').attr('transform', (d: any) => `translate(${d.x}, ${d.y})`);
      edgesG.forEach((edge, i) => {
        const line = edge.querySelector('line');
        const label = edge.querySelector('.kc-graph-view__edge-label');
        const link = links[i];
        if (!line || !link || link.source === -1 || link.target === -1) return;
        const s = nodesG[link.source];
        const t = nodesG[link.target];
        line.setAttribute('x1', String(s.x));
        line.setAttribute('y1', String(s.y));
        line.setAttribute('x2', String(t.x));
        line.setAttribute('y2', String(t.y));
        if (label) {
          label.setAttribute('x', String((s.x + t.x) / 2));
          label.setAttribute('y', String((s.y + t.y) / 2 - 4));
        }
      });
    });
  });
</script>

<style>
  .kc-graph-view {
    padding: var(--space-4);
    background: var(--color-surface-raised);
    border: 1px solid var(--color-surface-rule);
    border-radius: var(--radius-md);
  }
  .kc-graph-view__svg { width: 100%; height: auto; display: block; cursor: grab; }
  .kc-graph-view__node { cursor: grab; }
  .kc-graph-view__node:active { cursor: grabbing; }
  .kc-graph-view__node-circle { transition: filter 150ms ease; }
  .kc-graph-view__node:hover .kc-graph-view__node-circle { filter: brightness(1.3); }
  .kc-graph-view__hint {
    margin-top: var(--space-2);
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-text-secondary);
    font-style: italic;
  }
  .kc-graph-view__legend {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-2);
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-surface-rule);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-text-secondary);
  }
  .kc-graph-view__swatch {
    display: inline-block;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    margin-right: 0.3em;
    vertical-align: middle;
  }
  .kc-graph-view__swatch--concept { background: var(--color-accent-signal); }
  .kc-graph-view__swatch--claim { background: var(--color-accent-ember); }
  .kc-graph-view__swatch--source { background: var(--color-accent-violet); }
  .kc-graph-view__swatch--task { background: var(--color-accent-gold); }
</style>
