---
/**
 * DecisionWorkspace - ADR authoring interface
 * Knowledge template (k-template): k-decision-workspace
 *
 * Interactive: form for authoring ADRs with live preview
 */
interface Props {
  initialADR?: { number?: string; title?: string; status?: string; date?: string; context?: string; decision?: string; consequences?: string[] };
  class?: string;
}
const { initialADR, class: className = '' } = Astro.props;
const wsId = `kc-dw-${Math.random().toString(36).slice(2, 9)}`;
const initial = initialADR || {
  number: '0042',
  title: 'New ADR',
  status: 'proposed',
  date: new Date().toISOString().slice(0, 10),
  context: '',
  decision: '',
  consequences: [],
};
---
<section class:list={['kc-decision-ws', className]} data-ws-id={wsId}>
  <div class="kc-decision-ws__pane kc-decision-ws__pane--form">
    <h3 class="kc-decision-ws__pane-title">Author</h3>
    <div class="kc-decision-ws__field">
      <label>Number</label>
      <input type="text" data-bind="number" value={initial.number} />
    </div>
    <div class="kc-decision-ws__field">
      <label>Title</label>
      <input type="text" data-bind="title" value={initial.title} />
    </div>
    <div class="kc-decision-ws__field">
      <label>Status</label>
      <select data-bind="status">
        <option value="proposed" selected={initial.status === 'proposed'}>proposed</option>
        <option value="accepted" selected={initial.status === 'accepted'}>accepted</option>
        <option value="rejected" selected={initial.status === 'rejected'}>rejected</option>
        <option value="superseded" selected={initial.status === 'superseded'}>superseded</option>
      </select>
    </div>
    <div class="kc-decision-ws__field">
      <label>Date</label>
      <input type="date" data-bind="date" value={initial.date} />
    </div>
    <div class="kc-decision-ws__field">
      <label>Context</label>
      <textarea data-bind="context" rows="3" placeholder="What is the context?">{initial.context}</textarea>
    </div>
    <div class="kc-decision-ws__field">
      <label>Decision</label>
      <textarea data-bind="decision" rows="2" placeholder="What was decided?">{initial.decision}</textarea>
    </div>
    <div class="kc-decision-ws__field">
      <label>Consequences (one per line)</label>
      <textarea data-bind="consequences" rows="3" placeholder="Trade-offs and consequences">{(initial.consequences || []).join('\n')}</textarea>
    </div>
  </div>
  <div class="kc-decision-ws__pane kc-decision-ws__pane--preview">
    <h3 class="kc-decision-ws__pane-title">Preview</h3>
    <article class="kc-decision-ws__preview" data-preview-target>
      <header class="kc-decision-ws__preview-header">
        <div class="kc-decision-ws__preview-id">
          <span data-preview="number">{initial.number}</span>
          <span data-preview="status" class={`kc-decision-ws__preview-status kc-decision-ws__preview-status--${initial.status}`}>{initial.status}</span>
        </div>
        <h4 data-preview="title">{initial.title}</h4>
        <time data-preview="date">{initial.date}</time>
      </header>
      <section>
        <h5>Context</h5>
        <p data-preview="context">{initial.context || '—'}</p>
      </section>
      <section>
        <h5>Decision</h5>
        <p data-preview="decision">{initial.decision || '—'}</p>
      </section>
      <section>
        <h5>Consequences</h5>
        <ul data-preview="consequences"></ul>
      </section>
    </article>
  </div>
</section>

<script>
  document.querySelectorAll('.kc-decision-ws').forEach((ws) => {
    const update = () => {
      ws.querySelectorAll('[data-bind]').forEach((input) => {
        const key = input.getAttribute('data-bind');
        if (!key) return;
        const value = (input as HTMLInputElement).value;
        const targets = ws.querySelectorAll(`[data-preview="${key}"]`);
        targets.forEach((t) => {
          if (key === 'consequences') {
            t.innerHTML = '';
            value.split('\n').filter((l) => l.trim()).forEach((line) => {
              const li = document.createElement('li');
              li.textContent = line;
              t.appendChild(li);
            });
          } else if (key === 'status') {
            t.textContent = value;
            t.className = `kc-decision-ws__preview-status kc-decision-ws__preview-status--${value}`;
          } else {
            t.textContent = value;
          }
        });
      });
    };
    ws.querySelectorAll('[data-bind]').forEach((input) => {
      input.addEventListener('input', update);
    });
    update();
  });
</script>

<style>
  .kc-decision-ws {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    padding: var(--space-4);
    background: var(--color-surface-raised);
    border: 1px solid var(--color-surface-rule);
    border-radius: var(--radius-md);
  }
  .kc-decision-ws__pane {
    background: var(--color-surface-recessed);
    padding: var(--space-3);
    border-radius: var(--radius-sm);
  }
  .kc-decision-ws__pane-title {
    margin: 0 0 var(--space-3) 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-secondary);
  }
  .kc-decision-ws__field {
    margin-bottom: var(--space-2);
    display: flex;
    flex-direction: column;
    gap: 0.2em;
  }
  .kc-decision-ws__field label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-text-secondary);
  }
  .kc-decision-ws__field input,
  .kc-decision-ws__field select,
  .kc-decision-ws__field textarea {
    padding: 0.3em 0.5em;
    background: var(--color-surface-primary);
    border: 1px solid var(--color-surface-rule);
    border-radius: var(--radius-sm);
    color: var(--color-text-display);
    font-family: var(--font-body);
    font-size: 0.8125rem;
  }
  .kc-decision-ws__field textarea { font-family: var(--font-mono); resize: vertical; }
  .kc-decision-ws__preview {
    background: var(--color-surface-primary);
    border: 1px solid var(--color-surface-rule);
    border-radius: var(--radius-sm);
    padding: var(--space-3);
  }
  .kc-decision-ws__preview-header {
    display: flex;
    flex-direction: column;
    gap: 0.3em;
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-surface-rule);
    margin-bottom: var(--space-2);
  }
  .kc-decision-ws__preview-id {
    display: flex;
    align-items: baseline;
    gap: 0.5em;
    font-family: var(--font-mono);
  }
  .kc-decision-ws__preview h4 { margin: 0; color: var(--color-text-display); font-family: var(--font-display); }
  .kc-decision-ws__preview time { font-size: 0.75rem; color: var(--color-text-secondary); }
  .kc-decision-ws__preview-status {
    font-size: 0.625rem;
    text-transform: uppercase;
    padding: 0.1em 0.4em;
    border-radius: var(--radius-sm);
  }
  .kc-decision-ws__preview-status--proposed { color: var(--color-accent-gold); background: rgba(244, 184, 96, 0.12); }
  .kc-decision-ws__preview-status--accepted { color: var(--color-state-success); background: rgba(143, 163, 149, 0.12); }
  .kc-decision-ws__preview-status--rejected { color: var(--color-state-error); background: rgba(194, 90, 42, 0.12); }
  .kc-decision-ws__preview h5 {
    margin: 0 0 0.2em 0;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent-signal);
  }
  .kc-decision-ws__preview p { margin: 0 0 0.5em 0; font-size: 0.8125rem; color: var(--color-text-secondary); }
  .kc-decision-ws__preview ul { margin: 0; padding-left: 1.2em; font-size: 0.8125rem; color: var(--color-text-secondary); }
</style>
