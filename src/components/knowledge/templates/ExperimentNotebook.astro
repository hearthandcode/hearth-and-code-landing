---
/**
 * ExperimentNotebook - multi-experiment dashboard
 * Knowledge template (k-template): k-experiment-notebook
 */
import ExperimentCard from '../composites/ExperimentCard.astro';
interface Experiment {
  id: string;
  title: string;
  hypothesis: string;
  method: string;
  results: string;
  conclusion: string;
  outcome?: 'confirmed' | 'refuted' | 'inconclusive' | 'in-progress';
}
interface Props {
  title: string;
  experiments: Experiment[];
  class?: string;
}
const { title, experiments, class: className = '' } = Astro.props;
const counts = {
  confirmed: experiments.filter((e) => e.outcome === 'confirmed').length,
  refuted: experiments.filter((e) => e.outcome === 'refuted').length,
  inProgress: experiments.filter((e) => e.outcome === 'in-progress').length,
};
---
<section class:list={['kc-exp-notebook', className]}>
  <header class="kc-exp-notebook__header">
    <h3 class="kc-exp-notebook__title">{title}</h3>
    <div class="kc-exp-notebook__counts">
      <span class="kc-exp-notebook__count kc-exp-notebook__count--confirmed">{counts.confirmed} confirmed</span>
      <span class="kc-exp-notebook__count kc-exp-notebook__count--refuted">{counts.refuted} refuted</span>
      <span class="kc-exp-notebook__count kc-exp-notebook__count--progress">{counts.inProgress} in progress</span>
    </div>
  </header>
  <div class="kc-exp-notebook__list">
    {experiments.map((e) => <ExperimentCard {...e} />)}
  </div>
</section>

<style>
  .kc-exp-notebook {
    padding: var(--space-4);
    background: var(--color-surface-raised);
    border: 1px solid var(--color-surface-rule);
    border-radius: var(--radius-md);
  }
  .kc-exp-notebook__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-surface-rule);
  }
  .kc-exp-notebook__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: var(--font-weight-bold);
    color: var(--color-text-display);
  }
  .kc-exp-notebook__counts {
    display: flex;
    gap: 0.3em;
    flex-wrap: wrap;
  }
  .kc-exp-notebook__count {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    padding: 0.15em 0.5em;
    border-radius: var(--radius-sm);
  }
  .kc-exp-notebook__count--confirmed { color: var(--color-state-success); background: rgba(143, 163, 149, 0.15); }
  .kc-exp-notebook__count--refuted { color: var(--color-state-error); background: rgba(194, 90, 42, 0.15); }
  .kc-exp-notebook__count--progress { color: var(--color-accent-plasma); background: rgba(63, 224, 208, 0.15); }
  .kc-exp-notebook__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
</style>
