---
import '../styles/research-studio-landing.css';
import '../styles/research-collections.css';
import '../styles/notes-journal.css';
import '../styles/dossier-sheet.css';
import '../styles/research-portfolio.css';
import '../styles/notes-article-ledger.css';
import '../styles/correspondence-intake.css';
import '../styles/studio-room-surfaces.css';
import '../styles/ember-circuit-library.css';
import HearthNavigation from './HearthNavigation.astro';
import ResearchCollections from './ResearchCollections.astro';
import FieldJournalLatest from './FieldJournalLatest.astro';
import NotesArticleLedger from './NotesArticleLedger.astro';
import DossierSheet from './DossierSheet.astro';
import ProgramDossier from './ProgramDossier.astro';
import CorrespondenceIntake from './CorrespondenceIntake.astro';
import ProductHorizon from './ProductHorizon.astro';
import TechnicalReportShelf from './TechnicalReportShelf.astro';
import { routeContexts, routeVoice } from '../data/research-studio-content';

type Route = 'lab' | 'questions' | 'portfolio' | 'programs' | 'methods' | 'notes' | 'evidence' | 'dossier' | 'correspondence' | 'workbench';
interface Props { route: Route; journal?: boolean; }
const { route, journal = false } = Astro.props;

const routeMeta = {
  lab: { key: 'orientation', index: '01', context: 'The Lab / independent research practice', lead: 'I build the room around', accent: 'the question.', tail: '', deck: 'Hearth & Code is my public research workbench for making the structures behind knowledge, software, agents, and creative practice available for inspection.', action: ['Choose a research question', '/questions/'] },
  questions: { key: 'builder', index: '02', context: 'Research Questions / open inquiry portfolio', lead: 'I begin with', accent: 'questions', tail: 'before claims.', deck: 'I keep a field of live questions around what must remain visible when a system changes, who can revise it, and how its reasoning can be returned to.', action: ['Read my methods', '/methods/'] },
  portfolio: { key: 'exocore', index: '03', context: 'Portfolio / selected research and systems work', lead: 'I use the portfolio as', accent: 'a trail,', tail: 'not a trophy case.', deck: 'This is where research programs, knowledge architecture, software, publication, and design meet without hiding the posture or limits of each body of work.', action: ['Browse selected work', '#selected-work'] },
  programs: { key: 'exocore', index: '04', context: 'Programs & Prototypes / system field guide', lead: 'I give questions somewhere to become', accent: 'working systems.', tail: '', deck: 'A program is a bounded place for turning an inquiry into a map, protocol, prototype, report, or public artifact without pretending that every experiment is already a product.', action: ['Inspect the report shelf', '#technical-reports'] },
  methods: { key: 'workbench', index: '05', context: 'Methods & Instruments / educational practice', lead: 'I build methods that leave', accent: 'a way back.', tail: '', deck: 'I keep these learning patterns small enough to try, explicit enough to challenge, and structured enough to return an honest account of what happened.', action: ['Open the field cards', '#methods-collections-title'] },
  notes: { key: 'library', index: '06', context: 'Published Works / Field Journal and essays', lead: 'I write to leave', accent: 'a thread', tail: 'I can return to.', deck: 'Field Journal entries, essays, and technical articles collect research in motion without turning a working observation into a finished conclusion.', action: ['Read the Field Journal', '#field-journal'] },
  evidence: { key: 'atlas', index: '07', context: 'Artifacts / evidence and correction', lead: 'I want every claim to carry', accent: 'its way back.', tail: '', deck: 'The Evidence Desk keeps source, claim, check, decision, omission, and correction visible. A check earns only the confidence its named scope can support.', action: ['Inspect the evidence ledger', '#evidence-collections-title'] },
  dossier: { key: 'method', index: '08', context: 'Dossier / Hearthside Meta-Architect', lead: 'I call this working archetype the', accent: 'Hearthside Meta-Architect.', tail: '', deck: 'This self-authored field character sheet describes how I try to join forge and hearth in my work. It is a creative working archetype, not a diagnosis or credential.', action: ['Open the case file', '#dossier-index'] },
  correspondence: { key: 'return', index: '09', context: 'Correspondence / public return path', lead: 'I want the conversation to remain', accent: 'revisable.', tail: '', deck: 'This is my route for reading onward, discussing a real project, or offering a correction with enough context to be useful and enough boundary to remain humane.', action: ['Open correspondence intake', '#intake'] },
  workbench: { key: 'workbench', index: '10', context: 'Workbench / technical system orientation', lead: 'I build technical surfaces for', accent: 'inspectable work.', tail: '', deck: 'The Workbench is the software-facing edge of my studio: a bounded web tier, Rust service authority, PostgreSQL catalog, and source-only Kubernetes delivery candidate.', action: ['Inspect the runtime map', '#runtime-map'] },
} as const;

const meta = routeMeta[route];
const roomIndex = routeContexts[route].items;
const voice = routeVoice[route];

const questions = [
  ['Q-01', 'Systems', 'What is the smallest structure that preserves what matters?', 'Methods · minimum viable institutions · program boundaries'],
  ['Q-02', 'Provenance', 'What must travel with a claim so a later reader can challenge it?', 'Source identity · transformation · omission · correction'],
  ['Q-03', 'Knowledge', 'How can uncertainty remain represented instead of silently becoming absence?', 'Evidence desk · field notes · decision records'],
  ['Q-04', 'Creative practice', 'When does world-building become a useful systems prototype?', 'Programs · design · public learning artifacts'],
  ['Q-05', 'Agents', 'What makes delegated work inspectable without pretending the agent owns the decision?', 'Roles · permissions · receipts · human release'],
  ['Q-06', 'Interfaces', 'How can an interface expose the conditions that shaped its answer?', 'Context · provenance · state · return'],
  ['Q-07', 'Institutions', 'How much governance is enough to preserve meaning without producing theatre?', 'Authority · review · reversibility · scale'],
  ['Q-08', 'Continuity', 'What should a future reader inherit when the present work is interrupted?', 'Current state · sources · open risk · next action'],
] as const;

const tensions = [
  ['Exploration', 'Convergence', 'Open the field, then choose the smallest structure that can carry the decision.'],
  ['Autonomy', 'Accountability', 'Allow bounded initiative while leaving authority and release with people.'],
  ['Imagination', 'Evidence', 'Let metaphor discover relationships; let checks qualify the claim.'],
  ['Depth', 'Completion', 'Preserve the larger architecture while finishing a public-sized piece.'],
] as const;

const questionGuide = [
  ['01', 'Situation', 'Where is this question living?', 'Name the people, setting, present condition, and source boundary before reaching for a universal problem.'],
  ['02', 'Tension', 'What must remain visible together?', 'Place the values, constraints, or competing needs side by side without forcing an early resolution.'],
  ['03', 'Inquiry', 'What relationship is genuinely unknown?', 'Ask about a condition, difference, mechanism, or consequence that evidence could clarify without deciding the answer in advance.'],
  ['04', 'Return', 'What would make the inquiry useful?', 'Name the smallest map, comparison, prototype, or record that could sharpen the next human decision.'],
] as const;

const selectedWork = [
  ['01', 'Research program', 'Typed Context & Control Protocol', 'Typed representations, context conditions, interaction compilation, and explicit proof obligations.', 'Research architecture · public guide · evaluation instruments', '/programs/'],
  ['02', 'Knowledge architecture', 'EKRP', 'A source-governed application profile for human-readable knowledge representation, provenance, and review.', 'Semantic documents · evidence packets · standards crosswalks', '/programs/'],
  ['03', 'Software system', 'Exocore', 'A local-first systems direction connecting agents, knowledge, governance, observability, and human return.', 'Rust services · TypeScript interfaces · operational boundaries', '/workbench/'],
  ['04', 'Methods practice', 'Prompt & Context Atlas', 'Technique-level practice for prompts, context selection, tool boundaries, evaluation, and revision.', '34 field cards · prompt scaffolds · failure-mode checks', '/methods/'],
  ['05', 'Publication', 'Field Journal', 'Long-form research notes, essays, and technical writing with visible claim and source context.', 'Research essays · technical articles · correction path', '/notes/'],
  ['06', 'Research communication', 'Ember Circuit', 'A warm technical visual language for making complex system boundaries and evidence states legible.', 'Visual grammar · research figures · interface foundations', '/evidence/'],
] as const;

const programs = [
  ['01', 'TCCP', 'How can context and control become typed, inspectable parts of a workflow?', 'Protocol research'],
  ['02', 'EKRP', 'How can knowledge remain human-readable while retaining source and revision identity?', 'Architecture research'],
  ['03', 'Exocore', 'How might agents, knowledge, governance, tools, and return paths remain legible together?', 'Platform direction'],
  ['04', 'Core32', 'How can method and role performance be compared without collapsing into one score?', 'Evaluation research'],
] as const;

const methodLoop = [
  ['01', 'Orient', 'Name the decision and closest sources.'], ['02', 'Bound', 'Set scope, authority, and no-touch edges.'],
  ['03', 'Classify', 'Separate source, evidence, inference, and proposal.'], ['04', 'Compose', 'Build the smallest useful context and artifact.'],
  ['05', 'Build', 'Make the candidate inspectable.'], ['06', 'Check', 'Test one named predicate and seek counterevidence.'],
  ['07', 'Decide', 'Keep consequential meaning and release human-held.'], ['08', 'Return', 'Record state, limits, and next responsible action.'],
] as const;

const instruments = [
  ['01', 'Source ledger', 'What was consulted, in what role, with what omission or freshness limit.'],
  ['02', 'Claim card', 'What is being said, which evidence supports it, and what it does not establish.'],
  ['03', 'Check receipt', 'What was tested, on which input, with which outcome, and what remains unproven.'],
  ['04', 'Return record', 'Current state, owner, uncertainty, and one reliable way back in.'],
] as const;

const relation = [
  ['01', 'Source', 'Named material, currentness, and disclosure boundary.'],
  ['02', 'Claim', 'Observation, interpretation, hypothesis, or proposal.'],
  ['03', 'Check', 'One named predicate with a visible scope.'],
  ['04', 'Decision', 'Human-owned disposition, never automatic promotion.'],
  ['05', 'Return', 'Correction, revision, and next responsible action.'],
] as const;

const claims = [
  ['Candidate pattern', 'A source ledger can make a task’s information boundary easier to inspect.', 'Method candidate · not an efficacy claim'],
  ['Named check', 'The local build completed for the stated source revision.', 'Build success · not usability, approval, or release'],
  ['Fictional example', 'A worked case illustrates a possible route through the method.', 'Teaching example · not a client or production result'],
] as const;

const correspondence = [
  ['01', 'Reading trail', 'I am following an idea and want a useful next object.', '/notes/'],
  ['02', 'Project conversation', 'I have a real situation, constraint, or research question.', '/questions/'],
  ['03', 'Collaboration or work', 'I want to discuss a possible way of working together.', '/dossier/'],
  ['04', 'Correction', 'I want to point to a claim, source, route, or access barrier.', '/evidence/#correction'],
] as const;

const runtime = [
  ['01 / WEB', 'TypeScript projection', 'Responsive catalog, explicit loading and unavailable states, one same-origin request.', 'Two-replica candidate'],
  ['02 / API', 'Rust authority', 'Health, readiness, typed catalog, narrow routing, and internal metrics.', 'Two-replica candidate'],
  ['03 / DATA', 'PostgreSQL catalog', 'One bounded catalog table with idempotent migration and seed.', 'Single-instance candidate'],
  ['04 / OPS', 'Kubernetes delivery', 'Network policy, probes, resources, disruption budgets, alerts, and backup source.', 'Source only · not active'],
] as const;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={meta.deck} />
    <meta name="theme-color" content="#0e1114" />
    <title>{meta.context.split(' / ')[0]} · Hearth &amp; Code</title>
  </head>
  <body class={`studio-room-body studio-room-body--${route}`}>
    <a class="studio-skip" href="#main-content">Skip to content</a>
    <HearthNavigation current={meta.key} context={meta.context} />
    <main id="main-content" class="studio-room-main">
      <section class="studio-room-threshold" aria-labelledby="page-title">
        <div class="studio-room-threshold__copy">
          <p class="studio-room-kicker"><span>H+C / {meta.index}</span><span>{meta.context.split(' / ')[0]}</span></p>
          <h1 id="page-title">{meta.lead} <em>{meta.accent}</em>{meta.tail && <> {meta.tail}</>}</h1>
          <p>{meta.deck}</p>
          <a class="studio-room-action" href={meta.action[1]}>{meta.action[0]} <span aria-hidden="true">→</span></a>
        </div>
        <aside class="studio-room-locator" aria-label="Page index">
          <header><span>Room index</span><strong>What is on this surface?</strong></header>
          <ol>{roomIndex.map((item, index) => <li><a href={item.href}><span>{String(index + 1).padStart(2, '0')}</span><strong>{item.title}</strong><small>{item.detail}</small></a></li>)}</ol>
          <p><i></i> Public research surface · reviewable</p>
        </aside>
      </section>

      <section class="studio-room-thought" aria-labelledby="studio-thought-title">
        <div><p>From my workbench</p><span>{voice.posture}</span></div>
        <blockquote><strong id="studio-thought-title">{voice.title}</strong><p>{voice.note}</p></blockquote>
        <a href="/dossier/">Read the working archetype →</a>
      </section>

      {route === 'lab' && <section class="studio-room-field studio-room-field--paper studio-room-entry" aria-labelledby="lab-entry-title"><header><p class="studio-room-kicker">01 / Ways into the work</p><h2 id="lab-entry-title">Choose the kind of question you are carrying.</h2></header><div class="studio-room-card-grid studio-room-card-grid--four"><a href="/questions/"><span>01</span><h3>Follow a question</h3><p>Start with an open inquiry and its tensions.</p></a><a href="/programs/"><span>02</span><h3>Inspect a program</h3><p>See where an inquiry becomes a bounded system.</p></a><a href="/methods/"><span>03</span><h3>Adapt a method</h3><p>Take one instrument into your own environment.</p></a><a href="/dossier/"><span>04</span><h3>Meet the steward</h3><p>Read the working archetype behind the studio.</p></a></div></section>}

      {route === 'questions' && <>
        <section class="studio-room-field studio-room-field--paper" aria-labelledby="question-ledger"><header><p class="studio-room-kicker">01 / Inquiry ledger</p><h2 id="question-ledger">Eight questions I am holding open on purpose.</h2><p>I use this field to orient research, not to manufacture certainty. Each question points toward methods and artifacts that can make it more inspectable.</p></header><ol class="studio-room-ledger">{questions.map(([id, area, question, related]) => <li><span>{id} / {area}</span><h3>{question}</h3><p>{related}</p></li>)}</ol></section>
        <section class="studio-room-field studio-room-field--dark" aria-labelledby="tension-title"><header><p class="studio-room-kicker">02 / Working tensions</p><h2 id="tension-title">I do not resolve these by slogan.</h2></header><dl class="studio-room-tensions">{tensions.map(([left, right, note]) => <div><dt>{left}</dt><dd>{right}</dd><p>{note}</p></div>)}</dl></section>
        <section class="studio-room-field studio-room-field--fog" aria-labelledby="question-anatomy">
          <header>
            <p class="studio-room-kicker">03 / Question guide</p>
            <h2 id="question-anatomy">I shape a question until it can guide work without deciding the answer.</h2>
            <p>This is the small anatomy I use when an interesting thought needs to become a bounded inquiry. It keeps the field open while giving the work somewhere concrete to return.</p>
          </header>
          <ol class="studio-room-question-guide">
            {questionGuide.map(([id, title, prompt, note]) => <li><span>{id}</span><h3>{title}</h3><strong>{prompt}</strong><p>{note}</p></li>)}
          </ol>
          <aside class="studio-room-question-example" aria-label="Worked question frame">
            <div><p class="studio-room-kicker">Worked frame</p><strong>From a broad concern to an inspectable return</strong></div>
            <blockquote>What must travel with an AI-assisted claim so another reader can understand, challenge, and revise it?</blockquote>
            <dl>
              <div><dt>Keeps open</dt><dd>The useful form may differ across writing, software, research, and collaboration.</dd></div>
              <div><dt>Could return</dt><dd>A source list, transformation note, uncertainty label, and correction path tested against one public artifact.</dd></div>
            </dl>
          </aside>
        </section>
      </>}

      {route === 'portfolio' && <>
        <section id="selected-work" class="studio-room-field studio-room-field--paper" aria-labelledby="selected-work-title"><header><p class="studio-room-kicker">01 / Selected work</p><h2 id="selected-work-title">Six bodies of work, presented with their boundaries intact.</h2><p>I use this portfolio to show how inquiry becomes a program, artifact, software surface, method, or public record—not to manufacture case-study outcomes.</p></header><div class="studio-room-work-grid">{selectedWork.map(([id, form, title, summary, objects, href]) => <article><p><span>{id}</span>{form}</p><h3><a href={href}>{title}</a></h3><p>{summary}</p><small>{objects}</small></article>)}</div></section>
        <section class="studio-room-field studio-room-field--dark"><ProductHorizon /></section>
        <section class="studio-room-field studio-room-field--fog studio-room-return"><p class="studio-room-kicker">03 / Practice behind the portfolio</p><h2>The work is connected by a way of seeing.</h2><p>The Hearthside Meta-Architect dossier describes the practice without turning private context into a public claim.</p><a href="/dossier/">Open my working dossier →</a></section>
      </>}

      {route === 'programs' && <>
        <section class="studio-room-field studio-room-field--paper" aria-labelledby="program-ledger"><header><p class="studio-room-kicker">01 / Program map</p><h2 id="program-ledger">A program is a question with a boundary.</h2><p>These program homes coordinate different research objects while preserving their own source, maturity, and release posture.</p></header><div class="studio-room-card-grid studio-room-card-grid--four">{programs.map(([id, title, question, posture]) => <article><span>{id}</span><h3>{title}</h3><p>{question}</p><small>{posture}</small></article>)}</div><div class="studio-room-sequence" aria-label="Program research sequence"><span>Question</span><i></i><span>Source</span><i></i><span>Method</span><i></i><span>Artifact</span><i></i><span>Return</span></div></section>
        <section class="studio-room-field studio-room-field--dark"><TechnicalReportShelf /></section>
        <section class="studio-room-field studio-room-field--fog"><ProgramDossier /></section>
        <section class="studio-room-field studio-room-field--paper"><ResearchCollections route={route} /></section>
      </>}

      {route === 'methods' && <>
        <section class="studio-room-field studio-room-field--paper" aria-labelledby="loop-title"><header><p class="studio-room-kicker">01 / Method loop</p><h2 id="loop-title">Eight moves for work that remains answerable.</h2><p>The loop is deliberately finite. It begins by orienting and ends by returning enough state for another person to inspect or resume the work.</p></header><ol class="studio-room-loop">{methodLoop.map(([id, title, note]) => <li><span>{id}</span><h3>{title}</h3><p>{note}</p></li>)}</ol></section>
        <section id="instruments" class="studio-room-field studio-room-field--dark" aria-labelledby="instrument-title"><header><p class="studio-room-kicker">02 / Instrument shelf</p><h2 id="instrument-title">Small tools that clarify before they scale.</h2></header><div class="studio-room-card-grid studio-room-card-grid--four">{instruments.map(([id, title, note]) => <article><span>{id}</span><h3>{title}</h3><p>{note}</p></article>)}</div></section>
        <section class="studio-room-field studio-room-field--paper"><ResearchCollections route={route} /></section>
        <section class="studio-room-field studio-room-field--ember studio-room-return"><p class="studio-room-kicker">04 / Fictional teaching case</p><h2>A small system boundary under review.</h2><p>Should a document-indexing concern become its own module? Bind its imports and failures, define the no-touch storage boundary, draft a port, check isolation, and return the decision for human review. This illustrates a method; it is not a client result or released system.</p></section>
      </>}

      {route === 'notes' && !journal && <>
        <section class="studio-room-field studio-room-field--paper"><FieldJournalLatest /></section>
        <section class="studio-room-field studio-room-field--dark"><NotesArticleLedger /></section>
        <section class="studio-room-field studio-room-field--fog"><ResearchCollections route={route} /></section>
      </>}
      {route === 'notes' && journal && <section class="studio-room-field studio-room-field--paper studio-room-journal-index"><slot /></section>}

      {route === 'evidence' && <>
        <section class="studio-room-field studio-room-field--paper" aria-labelledby="relation-title"><header><p class="studio-room-kicker">01 / Relation grammar</p><h2 id="relation-title">A public claim needs a route through the work.</h2><p>I treat evidence as a relation, not a decorative citation added after the interesting work is finished.</p></header><ol class="studio-room-relation">{relation.map(([id, title, note]) => <li><span>{id}</span><h3>{title}</h3><p>{note}</p></li>)}</ol></section>
        <section class="studio-room-field studio-room-field--dark" aria-labelledby="claim-title"><header><p class="studio-room-kicker">02 / Claim cards</p><h2 id="claim-title">Three examples of calibrated language.</h2></header><div class="studio-room-claim-grid">{claims.map(([label, claim, limit]) => <article><span>{label}</span><blockquote>{claim}</blockquote><small>{limit}</small></article>)}</div></section>
        <section class="studio-room-field studio-room-field--paper"><ResearchCollections route={route} /></section>
        <section id="correction" class="studio-room-field studio-room-field--ember studio-room-return"><p class="studio-room-kicker">04 / Correction desk</p><h2>Public work should be able to receive a better reading.</h2><p>If a source is missing, a claim is too broad, a term is unclear, or an accessibility barrier appears, bring the route, section, and reason to Correspondence. A correction enters review; it is not an automatic change.</p><a href="/correspondence/">Open correspondence →</a></section>
      </>}

      {route === 'dossier' && <section class="studio-room-field studio-room-field--paper studio-room-dossier"><DossierSheet /></section>}

      {route === 'correspondence' && <>
        <section id="return-paths" class="studio-room-field studio-room-field--paper" aria-labelledby="return-paths-title"><header><p class="studio-room-kicker">01 / Return paths</p><h2 id="return-paths-title">Choose the conversation that gives the work enough context.</h2></header><div class="studio-room-card-grid studio-room-card-grid--four">{correspondence.map(([id, title, note, href]) => <a href={href}><span>{id}</span><h3>{title}</h3><p>{note}</p></a>)}</div></section>
        <section class="studio-room-field studio-room-field--dark studio-room-message-guide" aria-labelledby="correspondence-title"><div><p class="studio-room-kicker">02 / A small protocol</p><h2 id="correspondence-title">A useful first message names its situation.</h2></div><ol><li>What are you trying to understand, make, or correct?</li><li>What constraints or source material already shape the work?</li><li>What decision, artifact, or conversation would make the next step useful?</li></ol></section>
        <section class="studio-room-field studio-room-field--paper"><CorrespondenceIntake /></section>
      </>}

      {route === 'workbench' && <>
        <section id="technical-surface" class="studio-room-field studio-room-field--paper" aria-labelledby="technical-surface-title"><header><p class="studio-room-kicker">01 / Public technical boundary</p><h2 id="technical-surface-title">A narrow service edge. A private operating interior.</h2><p>The public tier reads a small catalog projection. It does not receive private Hub content, retain visitor profiles, expose cluster-internal services, or treat a payment identifier as personal identity.</p></header><dl class="studio-room-boundaries"><div><dt>Public</dt><dd>Static research pages and a TypeScript catalog projection.</dd></div><div><dt>Service</dt><dd>Rust owns validation, readiness, policy, and catalog responses.</dd></div><div><dt>Data</dt><dd>PostgreSQL holds catalog records only in the current candidate.</dd></div><div><dt>Private</dt><dd>Operations, source systems, agents, and dashboards remain network-bounded.</dd></div></dl></section>
        <section id="runtime-map" class="studio-room-field studio-room-field--dark" aria-labelledby="runtime-map-title"><header><p class="studio-room-kicker">02 / Runtime map</p><h2 id="runtime-map-title">Four layers, four responsibilities.</h2><p>The implementation is deliberately small: presentation cannot own native effects, the service cannot infer identity, and the database cannot become a shadow profile store.</p></header><ol class="studio-room-runtime">{runtime.map(([id, title, note, posture]) => <li><span>{id}</span><h3>{title}</h3><p>{note}</p><strong>{posture}</strong></li>)}</ol></section>
        <section id="delivery-posture" class="studio-room-field studio-room-field--fog studio-room-return"><p class="studio-room-kicker">03 / Delivery posture</p><h2>Built for review before release.</h2><p>The application and deployment sources have local test evidence, but no immutable images have been published and no Argo application, DNS record, or live cluster release has been created. This surface explains the architecture; it is not a production-status claim.</p><nav><a href="/evidence/">Read the evidence posture →</a><a href="/correspondence/">Discuss the system →</a></nav></section>
      </>}
    </main>
    <footer class="studio-room-footer"><span>Hearth &amp; Code · Hearthside Meta-Architect</span><span>Public research · source-aware · correction-friendly</span></footer>
  </body>
</html>
