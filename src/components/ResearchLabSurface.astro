---
import '../styles/research-lab.css';
import HearthNavigation from './HearthNavigation.astro';

type Route = 'lab' | 'questions' | 'programs' | 'methods' | 'notes' | 'evidence' | 'dossier' | 'correspondence';
interface Props { route: Route; }
const { route } = Astro.props;
const routeMeta = {
  lab: { key: 'orientation', index: '01', context: 'The Lab / independent research practice', title: 'A research studio for making complex systems legible.', deck: 'Hearth & Code studies the structures that shape how knowledge, software, agents, and creative work come into being—and makes those structures available for inspection.', action: ['Choose a research question', '/questions/'] },
  questions: { key: 'builder', index: '02', context: 'Research Questions / open inquiry portfolio', title: 'Questions before claims.', deck: 'The research agenda is a field of live questions: what must remain visible when a system changes, who can revise it, and how its reasoning can be returned to.', action: ['Read the methods', '/methods/'] },
  programs: { key: 'exocore', index: '03', context: 'Programs & Prototypes / system field guide', title: 'Where questions become working systems.', deck: 'Programs are bounded places for turning an inquiry into a map, a protocol, a prototype, or a public artifact—without pretending that every experiment is a product.', action: ['Inspect the evidence desk', '/evidence/'] },
  methods: { key: 'workbench', index: '04', context: 'Methods & Instruments / educational practice', title: 'A practical method for building work that can return.', deck: 'The studio’s methods are public learning patterns: small enough to try, explicit enough to challenge, and structured enough to leave an honest path back.', action: ['Open the instrument shelf', '#instruments'] },
  notes: { key: 'library', index: '05', context: 'Field Notes & Reading Room / editorial shelf', title: 'A reading room for research in motion.', deck: 'Field notes, pattern sheets, and reading trails collect the durable vocabulary of the studio without confusing a working note for a finished conclusion.', action: ['Follow a reading trail', '#trails'] },
  evidence: { key: 'atlas', index: '06', context: 'Evidence Desk / provenance and correction', title: 'Claims should carry their way back.', deck: 'Evidence Desk makes the relationship between source, claim, check, decision, and correction visible. A check earns only the confidence its scope can support.', action: ['See the correction path', '#correction'] },
  dossier: { key: 'method', index: '07', context: 'Studio Dossier / Hearthside Meta-Architect', title: 'The Hearthside Meta-Architect.', deck: 'A self-authored field character sheet for the person behind the studio: a creative working archetype, not a diagnosis, credential, or autonomous persona.', action: ['Read the dossier', '#dossier-file'] },
  correspondence: { key: 'return', index: '08', context: 'Correspondence / return path', title: 'Continue the conversation carefully.', deck: 'The work remains revisable. This is the route for reading onward, proposing a project, discussing work, or offering a correction with enough context to be useful.', action: ['Choose a return path', '#return-paths'] },
} as const;
const meta = routeMeta[route];
const dossier = [
  ['D-01', 'Builder of structures behind structures', 'Sees the protocols, permissions, and contexts that generate visible work.', 'Ask what conditions produced the artifact.'],
  ['D-02', 'Hearthside orientation', 'Makes complex machinery inhabitable through names, routes, and human-scale surfaces.', 'Make the difficult thing findable.'],
  ['D-03', 'Divergence and convergence', 'Lets a field widen before reducing it to the smallest useful structure.', 'Explore without losing the decision.'],
  ['D-04', 'Meaning needs an interface', 'Treats representation as an engineering and human concern.', 'Give the idea a form that can be challenged.'],
  ['D-05', 'Uncertainty as structured state', 'Keeps unknowns and contradictions present rather than smoothing them into confidence.', 'Name what remains unresolved.'],
  ['D-06', 'Intuition with a precision filter', 'Lets intuition propose; asks sources, checks, and review to ratify.', 'Separate discovery from decision.'],
  ['D-07', 'Relational systems sight', 'Notices interfaces, dependencies, and feedback before isolated parts.', 'Draw the relation, not just the inventory.'],
  ['D-08', 'Minimum viable institutions', 'Builds enough governance to preserve meaning without premature bureaucracy.', 'Fit the structure to the pressure.'],
  ['D-09', 'Plural minds, singular accountability', 'Uses collaboration and tools while keeping consequential judgment human-held.', 'Keep responsibility legible.'],
  ['D-10', 'Archetypes as semantic handles', 'Uses memorable roles to compress recurring practices without making them authority.', 'Name a pattern without mythologizing it.'],
  ['D-11', 'World-building as systems prototyping', 'Uses imaginative worlds to test coherence, experience, and relation.', 'Let a world reveal a system.'],
  ['D-12', 'Constitutional autonomy', 'Prefers bounded permission, explicit release, and visible stop conditions.', 'Freedom inside a legible envelope.'],
  ['D-13', 'Continuity through time', 'Designs records and handoffs for a future reader as well as the current one.', 'Leave a path back.'],
  ['D-14', 'Revision-bearing theory', 'Builds systems that expose the conditions for their own correction.', 'Make revision part of the design.'],
  ['D-15', 'Shadow: infinite architecture', 'Recognizes recursive design as a strength that needs a stopping heuristic.', 'Let architecture discharge into experience.'],
  ['D-16', 'Integrated archetype', 'Holds forge and hearth together: rigor around imagination without extinguishing it.', 'Make imagination answerable, not smaller.'],
] as const;
---
<!doctype html>
<html lang="en">
  <head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content={meta.deck} /><meta name="theme-color" content="#161411" /><title>{meta.context.split(' / ')[0]} · Hearth &amp; Code</title></head>
  <body class={`research-body research-body--${route}`}>
    <a class="research-skip" href="#main-content">Skip to content</a>
    <HearthNavigation current={meta.key} context={meta.context} />
    <main id="main-content" class="research-main">
      <section class="research-threshold" aria-labelledby="page-title"><div class="research-threshold__copy"><p class="research-eyebrow">{meta.index} / {meta.context.split(' / ')[0]}</p><h1 id="page-title">{meta.title}</h1><p>{meta.deck}</p><a class="research-primary-action" href={meta.action[1]}>{meta.action[0]} <span aria-hidden="true">→</span></a></div><aside class="research-status" aria-label="Public reading posture"><p>Public reading posture</p><strong>Candidate learning surface</strong><span>Source-aware · reviewable · no automatic write-back</span></aside></section>
      {route === 'lab' && <>
        <section class="research-spread" aria-labelledby="lab-field"><header><p class="research-eyebrow">Research threshold</p><h2 id="lab-field">Choose the kind of question you are carrying.</h2></header><div class="research-paths"><a href="/questions/"><span>01</span><strong>Follow a question</strong><p>Start with an open inquiry and its tensions.</p></a><a href="/programs/"><span>02</span><strong>Inspect a program</strong><p>See where an inquiry becomes a bounded system.</p></a><a href="/methods/"><span>03</span><strong>Adapt a method</strong><p>Take one instrument into your own environment.</p></a><a href="/dossier/"><span>04</span><strong>Meet the steward</strong><p>Read the working archetype behind the studio.</p></a></div></section>
        <section class="research-seam" aria-labelledby="lab-seam"><div><p class="research-eyebrow">Evidence seam</p><h2 id="lab-seam">What this place is—and is not.</h2></div><div><p>Hearth &amp; Code is an independent creative-technology research practice. It shares public learning material, candidate methods, and selected artifacts; it does not claim an institutional mandate, universal method efficacy, or access to private working context.</p><a href="/evidence/">Read the evidence posture →</a></div></section>
      </>}
      {route === 'questions' && <>
        <section class="research-ledger" aria-labelledby="question-ledger"><header><p class="research-eyebrow">Inquiry ledger</p><h2 id="question-ledger">Current questions are held open on purpose.</h2></header><ol><li><span>Systems</span><strong>What is the smallest structure that preserves what matters?</strong><p>Related: methods, minimum viable institutions, program boundaries.</p></li><li><span>Provenance</span><strong>What must travel with a claim so a later reader can challenge it?</strong><p>Related: source identity, transformation, omission, correction.</p></li><li><span>Knowledge</span><strong>How can uncertainty remain represented instead of silently becoming absence?</strong><p>Related: evidence desk, field notes, decision records.</p></li><li><span>Creative practice</span><strong>When does world-building become a useful systems prototype?</strong><p>Related: programs, design, public learning artifacts.</p></li></ol></section>
        <section class="research-tensions" aria-labelledby="tension-title"><div><p class="research-eyebrow">Working tensions</p><h2 id="tension-title">The studio does not resolve these by slogan.</h2></div><dl><div><dt>Exploration</dt><dd>Convergence</dd><p>Open the field, then choose the smallest structure that can carry the decision.</p></div><div><dt>Autonomy</dt><dd>Accountability</dd><p>Allow bounded initiative while leaving authority and release with people.</p></div><div><dt>Imagination</dt><dd>Evidence</dd><p>Let metaphor discover relationships; let checks qualify the claim.</p></div></dl></section>
      </>}
      {route === 'programs' && <>
        <section class="research-program-ledger" aria-labelledby="program-ledger"><header><p class="research-eyebrow">Program ledger</p><h2 id="program-ledger">A program is a question with a boundary.</h2></header><div class="research-program-table"><div><span>Program</span><span>Question</span><span>Public posture</span></div><article><strong>Exocore</strong><p>How might systems, knowledge, governance, and return paths remain legible together?</p><span>Candidate program frame</span></article><article><strong>Minimum viable institutions</strong><p>What is enough governance to preserve meaning without erecting a theatre of process?</p><span>Research frame</span></article><article><strong>Worlds as prototypes</strong><p>How can a designed world expose the texture of an operating system?</p><span>Conceptual study</span></article></div></section>
        <section class="research-ecology" aria-labelledby="ecology-title"><header><p class="research-eyebrow">System ecology</p><h2 id="ecology-title">A public map of relation, not a product architecture diagram.</h2></header><div class="research-ecology__map"><span>Question</span><i></i><span>Source</span><i></i><span>Method</span><i></i><span>Artifact</span><i></i><span>Return</span></div><p>Each relation is a prompt to inspect the boundary: what informs what, what was checked, and where a reader can return with correction.</p></section>
      </>}
      {route === 'methods' && <>
        <section class="research-loop" aria-labelledby="loop-title"><header><p class="research-eyebrow">The learning loop</p><h2 id="loop-title">Eight moves for work that remains answerable.</h2></header><ol><li><strong>01 / Orient</strong><span>Name the decision and closest sources.</span></li><li><strong>02 / Bound</strong><span>Set scope, authority, and no-touch edges.</span></li><li><strong>03 / Classify</strong><span>Separate source, evidence, inference, and proposal.</span></li><li><strong>04 / Compose</strong><span>Build the smallest useful context and artifact.</span></li><li><strong>05 / Build</strong><span>Make the candidate inspectable.</span></li><li><strong>06 / Check</strong><span>Test one named predicate and seek counterevidence.</span></li><li><strong>07 / Decide</strong><span>Keep consequential meaning and release human-held.</span></li><li><strong>08 / Return</strong><span>Record state, limits, and next responsible action.</span></li></ol></section>
        <section id="instruments" class="research-instruments" aria-labelledby="instrument-title"><header><p class="research-eyebrow">Instrument shelf</p><h2 id="instrument-title">Small tools that clarify before they scale.</h2></header><div><article><span>Source ledger</span><p>What was consulted, in what role, with what omission or freshness limit.</p></article><article><span>Claim card</span><p>What is being said, which evidence supports it, and what it does not establish.</p></article><article><span>Check receipt</span><p>What was tested, on which input, with which outcome, and what remains unproven.</p></article><article><span>Return record</span><p>Current state, owner, uncertainty, and one reliable way back in.</p></article></div></section>
        <section class="research-fiction" aria-labelledby="fiction-title"><p class="research-eyebrow">Fictional teaching case</p><h2 id="fiction-title">A small system boundary under review.</h2><p><strong>Question:</strong> should a document-indexing concern become its own module? Bind the current imports and failures, define the no-touch storage boundary, draft a port, check isolation, and return the decision for a human review. This illustrates a method; it is not a client result or a released system.</p></section>
      </>}
      {route === 'notes' && <>
        <section class="research-shelf" aria-labelledby="shelf-title"><header><p class="research-eyebrow">Reading shelf</p><h2 id="shelf-title">Notes that retain their question.</h2></header><div><article><span>Pattern sheet</span><h3>Context-gardening</h3><p>Represent context as a tended field: selected, bounded, refreshed, and explicit about what it leaves out.</p><a href="/methods/">Related method →</a></article><article><span>Field note</span><h3>Uncertainty as represented state</h3><p>Unknown coverage is not zero results. Contradiction is not a request for forced consensus.</p><a href="/evidence/">Related evidence desk →</a></article><article><span>Field note</span><h3>Return paths are a design responsibility</h3><p>A useful result leaves enough context for another person or future self to understand the next step.</p><a href="/correspondence/">Related return path →</a></article></div></section>
        <section id="trails" class="research-trails" aria-labelledby="trails-title"><p class="research-eyebrow">Reading trails</p><h2 id="trails-title">Start small. Adapt locally.</h2><ol><li><strong>For a builder:</strong> Method → Evidence Desk → one fictional worked case.</li><li><strong>For a researcher:</strong> Questions → Field Notes → provenance relation.</li><li><strong>For a collaborator:</strong> The Lab → Studio Dossier → Correspondence.</li></ol></section>
      </>}
      {route === 'evidence' && <>
        <section class="research-relation" aria-labelledby="relation-title"><header><p class="research-eyebrow">Relation grammar</p><h2 id="relation-title">A public claim needs a route through the work.</h2></header><ol><li><strong>Source</strong><span>Named material, currentness, and disclosure boundary.</span></li><li><strong>Claim</strong><span>Observation, interpretation, hypothesis, or proposal.</span></li><li><strong>Check</strong><span>One named predicate with a visible scope.</span></li><li><strong>Decision</strong><span>Human-owned disposition, not an automatic promotion.</span></li><li><strong>Return</strong><span>Correction, revision, and next action.</span></li></ol></section>
        <section class="research-claim-samples" aria-labelledby="claim-title"><header><p class="research-eyebrow">Claim cards</p><h2 id="claim-title">Examples of calibrated language.</h2></header><div><article><span>Candidate pattern</span><p>“A source ledger can make a task’s information boundary easier to inspect.”</p><small>Limit: this is a method candidate, not an efficacy claim.</small></article><article><span>Named check</span><p>“The local build completed for the stated source revision.”</p><small>Limit: build success does not prove usability, approval, or release readiness.</small></article><article><span>Fictional example</span><p>“A worked case illustrates a possible route through the method.”</p><small>Limit: it does not represent a client, production deployment, or real-world result.</small></article></div></section>
        <section id="correction" class="research-correction" aria-labelledby="correction-title"><div><p class="research-eyebrow">Correction desk</p><h2 id="correction-title">Public work should be able to receive a better reading.</h2></div><div><p>If a source is missing, a claim is too broad, a term is unclear, or an accessibility barrier appears, bring the route, section, and reason to Correspondence. A correction is intake for review; it is not an automatic change.</p><a href="/correspondence/">Open correspondence →</a></div></section>
      </>}
      {route === 'dossier' && <>
        <section id="dossier-file" class="research-character-sheet" aria-labelledby="dossier-title"><header><div><p class="research-eyebrow">Field character sheet / self-authored candidate</p><h2 id="dossier-title">Creative systems steward.</h2></div><p>Classification: public-facing working archetype · exact wording review required · not a credential, diagnosis, or performance score.</p></header><dl><div><dt>Central question</dt><dd>What is the smallest structure that preserves what matters?</dd></div><div><dt>Primary moves</dt><dd>Orient · classify · compose · check · decide · return</dd></div><div><dt>Working instruments</dt><dd>Ledger · atlas · protocol · notebook · correction path</dd></div><div><dt>Watch condition</dt><dd>Infinite architecture: more structure must eventually discharge into experience.</dd></div></dl></section>
        <section class="research-dossier-grid" aria-label="Sixteen dossier sections"><header><p class="research-eyebrow">Dossier entries / D-01 to D-16</p><h2>Attributes, practices, tensions, and safeguards.</h2></header><ol>{dossier.map(([id, title, strength, practice]) => <li id={id.toLowerCase()}><span>{id}</span><h3>{title}</h3><p>{strength}</p><strong>{practice}</strong></li>)}</ol></section>
        <section class="research-dossier-note"><p class="research-eyebrow">Reading note</p><p>The character-sheet form is a way to make a working posture relational and memorable. It remains a creative projection of authorial material; readers should not infer professional qualification, biography beyond published source, or claims of autonomous agency from it.</p></section>
      </>}
      {route === 'correspondence' && <>
        <section id="return-paths" class="research-letters" aria-labelledby="letter-title"><header><p class="research-eyebrow">Return paths</p><h2 id="letter-title">Choose the conversation that gives the work enough context.</h2></header><div><a href="/notes/"><span>01 / Reading</span><strong>Follow a trail through the notes.</strong><p>Start with a question, pattern, or field note.</p></a><a href="/questions/"><span>02 / Project discussion</span><strong>Bring a real question and its constraints.</strong><p>Define the problem before prescribing a system.</p></a><a href="/dossier/"><span>03 / Work opportunities</span><strong>Read the studio posture and working direction.</strong><p>Use a conventional role-specific channel for formal applications.</p></a><a href="/evidence/#correction"><span>04 / Correction</span><strong>Point to a claim, route, source, or barrier.</strong><p>Corrections enter review; they do not auto-publish.</p></a></div></section>
        <section class="research-correspondence-note" aria-labelledby="correspondence-title"><div><p class="research-eyebrow">A small protocol</p><h2 id="correspondence-title">A useful first message names its situation.</h2></div><ol><li>What are you trying to understand, make, or correct?</li><li>What constraints or source material already shape the work?</li><li>What decision, artifact, or conversation would make the next step useful?</li></ol></section>
      </>}
    </main>
    <footer class="research-footer"><span>Hearth &amp; Code · independent research lab candidate</span><span>Public projection · source-aware · correction-friendly</span><a href="/">Return to The Lab ↑</a></footer>
  </body>
</html>
