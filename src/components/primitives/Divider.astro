---
/**
 * Divider primitive
 * id: p-divider
 *
 * Horizontal or vertical line separator with variant styles.
 */

interface Props {
  variant?: 'solid' | 'dashed' | 'gradient' | 'circuit';
  orientation?: 'horizontal' | 'vertical';
  class?: string;
}

const { variant = 'solid', orientation = 'horizontal', class: className = '' } = Astro.props;
---

<hr class={`ec-divider ec-divider--${variant} ec-divider--${orientation} ${className}`} />

<style>
  .ec-divider {
    margin: 0;
    border: none;
    background: var(--color-surface-rule);
  }
  .ec-divider--horizontal {
    width: 100%;
    height: 1px;
  }
  .ec-divider--vertical {
    width: 1px;
    height: 100%;
    display: inline-block;
  }
  .ec-divider--solid {
    background: var(--color-surface-rule);
  }
  .ec-divider--dashed {
    background: none;
    border-top: 1px dashed var(--color-surface-rule-strong);
  }
  .ec-divider--vertical.ec-divider--dashed {
    border-top: none;
    border-left: 1px dashed var(--color-surface-rule-strong);
  }
  .ec-divider--gradient {
    height: 2px;
    background: linear-gradient(90deg,
      transparent 0%,
      var(--color-surface-rule) 20%,
      var(--color-accent-ember) 50%,
      var(--color-surface-rule) 80%,
      transparent 100%);
  }
  .ec-divider--circuit {
    height: 1px;
    background: repeating-linear-gradient(90deg,
      var(--color-accent-signal) 0px,
      var(--color-accent-signal) 8px,
      transparent 8px,
      transparent 16px);
    opacity: 0.5;
  }
</style>
