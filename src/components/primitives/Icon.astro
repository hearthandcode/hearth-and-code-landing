---
/**
 * Icon primitive
 * id: p-icon
 *
 * Inline icon element. Uses inline SVG for reliability.
 */

interface Props {
  name: string;
  size?: 'xs' | 'sm' | 'md' | 'lg' | 'xl';
  color?: string;
  class?: string;
  ariaLabel?: string;
}

const { name, size = 'md', color, class: className = '', ariaLabel } = Astro.props;

const sizes = {
  xs: '0.75rem',
  sm: '1rem',
  md: '1.25rem',
  lg: '1.5rem',
  xl: '2rem',
};

const iconPaths: Record<string, string> = {
  'check': 'M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z',
  'close': 'M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z',
  'arrow-right': 'M5 12h14m-7-7l7 7-7 7',
  'arrow-down': 'M19 9l-7 7-7-7',
  'plus': 'M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6z',
  'minus': 'M19 13H5v-2h14z',
  'chevron-down': 'M7 10l5 5 5-5z',
  'chevron-up': 'M7 14l5-5 5 5z',
  'chevron-right': 'M10 17l5-5-5-5z',
  'chevron-left': 'M14 7l-5 5 5 5z',
  'search': 'M15.5 14h-.79l-.28-.27a6.5 6.5 0 1 0-.7.7l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0a4.5 4.5 0 1 1 0-9 4.5 4.5 0 0 1 0 9z',
  'menu': 'M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z',
  'user': 'M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z',
  'info': 'M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z',
  'warning': 'M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z',
  'edit': 'M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z',
};

const path = iconPaths[name] || iconPaths['info'];
const iconSize = sizes[size];
---

<svg
  class={`ec-icon ec-icon--${size} ${className}`}
  xmlns="http://www.w3.org/2000/svg"
  width={iconSize}
  height={iconSize}
  viewBox="0 0 24 24"
  fill={color || 'currentColor'}
  aria-label={ariaLabel}
  aria-hidden={!ariaLabel ? 'true' : undefined}
  role={ariaLabel ? 'img' : undefined}
>
  <path d={path} />
</svg>

<style>
  .ec-icon {
    display: inline-block;
    vertical-align: middle;
    flex-shrink: 0;
  }
  .ec-icon--xs { width: 0.75rem; height: 0.75rem; }
  .ec-icon--sm { width: 1rem; height: 1rem; }
  .ec-icon--md { width: 1.25rem; height: 1.25rem; }
  .ec-icon--lg { width: 1.5rem; height: 1.5rem; }
  .ec-icon--xl { width: 2rem; height: 2rem; }
</style>
