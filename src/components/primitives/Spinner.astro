---
/**
 * Spinner primitive
 * id: p-spinner
 *
 * Loading indicator with size variants.
 */

interface Props {
  size?: 'sm' | 'md' | 'lg';
  variant?: 'circle' | 'dots' | 'bar';
  color?: string;
  label?: string;
  class?: string;
}

const {
  size = 'md',
  variant = 'circle',
  color,
  label = 'Loading',
  class: className = '',
} = Astro.props;

const sizes = {
  sm: '1rem',
  md: '1.5rem',
  lg: '2.5rem',
};
---

<div
  class={`ec-spinner ec-spinner--${variant} ec-spinner--${size} ${className}`}
  role="status"
  aria-label={label}
>
  {variant === 'circle' && (
    <svg
      class="ec-spinner__svg"
      width={sizes[size]}
      height={sizes[size]}
      viewBox="0 0 24 24"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <circle
        cx="12"
        cy="12"
        r="10"
        stroke={color || 'currentColor'}
        stroke-width="3"
        fill="none"
        stroke-linecap="round"
        stroke-dasharray="40 20"
      />
    </svg>
  )}
  {variant === 'dots' && (
    <span class="ec-spinner__dots" aria-hidden="true">
      <span></span><span></span><span></span>
    </span>
  )}
  {variant === 'bar' && (
    <span class="ec-spinner__bar" aria-hidden="true"></span>
  )}
  <span class="ec-visually-hidden">{label}</span>
</div>

<style>
  .ec-spinner {
    display: inline-flex;
    color: var(--color-text-secondary);
  }
  .ec-spinner__svg {
    animation: ec-spinner-rotate 1s linear infinite;
    transform-origin: center;
  }
  @keyframes ec-spinner-rotate {
    to { transform: rotate(360deg); }
  }
  .ec-spinner__dots {
    display: inline-flex;
    gap: 0.25rem;
    align-items: center;
  }
  .ec-spinner__dots span {
    width: 0.375rem;
    height: 0.375rem;
    background: currentColor;
    border-radius: 50%;
    animation: ec-spinner-bounce 1.4s ease-in-out infinite;
  }
  .ec-spinner__dots span:nth-child(2) { animation-delay: 0.2s; }
  .ec-spinner__dots span:nth-child(3) { animation-delay: 0.4s; }
  @keyframes ec-spinner-bounce {
    0%, 80%, 100% { transform: scale(0.5); opacity: 0.5; }
    40% { transform: scale(1); opacity: 1; }
  }
  .ec-spinner__bar {
    display: inline-block;
    width: 4em;
    height: 0.25em;
    background: linear-gradient(90deg, transparent, currentColor, transparent);
    background-size: 200% 100%;
    animation: ec-spinner-bar 1.5s ease-in-out infinite;
  }
  @keyframes ec-spinner-bar {
    to { background-position: -200% 0; }
  }
  .ec-visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .ec-spinner__svg,
    .ec-spinner__dots span,
    .ec-spinner__bar {
      animation: none;
    }
  }
</style>
