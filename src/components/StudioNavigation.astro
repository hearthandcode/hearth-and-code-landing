---
/** Unified navigation for all public surfaces — centered, consistent. */
interface Props {
  current?: string;
  disposition?: string;
}

const { current = '', disposition = '' } = Astro.props;

const links = [
  { label: 'Studio', href: '/', key: 'studio' },
  { label: 'About', href: '/about/', key: 'about' },
  { label: 'Mission', href: '/mission/', key: 'mission' },
  { label: 'Library', href: '/library/', key: 'library' },
  { label: 'Portfolio', href: '/portfolio/', key: 'portfolio' },
  { label: 'Dossier', href: '/dossier/', key: 'dossier' },
  { label: 'Research', href: '/research/', key: 'research' },
  { label: 'Commons', href: 'https://sacred.hearthandcode.dev', key: 'commons', ext: true },
];
---

<header class="unified-nav" aria-label="Hearth and Code">
  <nav class="unified-nav__inner">
    <a class="unified-nav__wordmark" href="/">
      Hearth <em>&amp;</em> Code
    </a>
    {disposition && <p class="unified-nav__context">{disposition}</p>}
    <ul class="unified-nav__links">
      {links.map((l) => (
        <li>
          <a href={l.href} aria-current={current === l.key ? 'page' : undefined} {...(l.ext ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
            {l.label}{l.ext && <span aria-hidden="true" class="unified-nav__ext"> ↗</span>}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style is:global>
  .unified-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid rgba(75,66,55,.5);
    background: rgba(22,20,17,.88);
    backdrop-filter: blur(8px);
    padding: 0.75rem 1.5rem;
  }
  .unified-nav__inner {
    max-width: 1080px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }
  .unified-nav__wordmark {
    font-family: "Fraunces", Georgia, serif;
    font-size: 1.15rem;
    font-weight: 600;
    color: #f1e7d2;
    text-decoration: none;
    letter-spacing: 0.02em;
  }
  .unified-nav__wordmark em {
    color: #E85B4E;
    font-style: italic;
  }
  .unified-nav__context {
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(207,193,171,.6);
    margin: 0;
  }
  .unified-nav__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.82rem;
  }
  .unified-nav__links a {
    color: rgba(207,193,171,.8);
    text-decoration: none;
    transition: color .2s ease;
  }
  .unified-nav__links a:hover,
  .unified-nav__links a[aria-current='page'] {
    color: #F4B860;
  }
  .unified-nav__ext { font-size: .8em; opacity: .7; margin-left: 2px; }
  @media(max-width:640px) {
    .unified-nav__links { gap: 0.75rem; font-size: 0.75rem; }
  }
</style>
