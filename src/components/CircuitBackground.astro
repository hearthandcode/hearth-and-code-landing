---
/**
 * CircuitBackground.astro
 *
 * Subtle circuit board pattern background with data flow particles.
 * Conveys the "Code" / agentic system aspect of the Hearth-Code duality.
 *
 * Used as background layer on hero/intro sections.
 */

interface Props {
  density?: 'low' | 'medium' | 'high';
  animated?: boolean;
  accent?: 'signal' | 'plasma' | 'ember';
}

const { density = 'low', animated = false, accent = 'signal' } = Astro.props;

const gridSize = density === 'high' ? '24px' : density === 'medium' ? '32px' : '48px';
const accentColor = accent === 'plasma' ? 'var(--color-accent-plasma, #3FE0D0)' :
                    accent === 'ember' ? 'var(--color-accent-ember, #E85B4E)' :
                    'var(--color-accent-signal, #1FB6A8)';
---

<div class:list={['ec-circuit-bg', `is-${density}`, animated && 'is-animated']} aria-hidden="true">
  <svg class="ec-circuit-bg__svg" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <pattern id={`circuit-grid-${density}`} x="0" y="0" width={gridSize} height={gridSize} patternUnits="userSpaceOnUse">
        <path
          d={`M ${gridSize} 0 L 0 0 0 ${gridSize}`}
          fill="none"
          stroke={accentColor}
          stroke-width="1"
          opacity="0.3"
        />
        <circle cx="0" cy="0" r="1.5" fill={accentColor} opacity="0.5" />
      </pattern>
      <radialGradient id={`circuit-fade-${density}`}>
        <stop offset="0%" stop-color="transparent" />
        <stop offset="100%" stop-color="var(--color-surface-primary, #161411)" stop-opacity="0.8" />
      </radialGradient>
      <mask id={`circuit-mask-${density}`}>
        <rect width="100%" height="100%" fill="url(#circuit-fade-${density})" />
      </mask>
    </defs>

    <rect width="100%" height="100%" fill={`url(#circuit-grid-${density})`} mask={`url(#circuit-mask-${density})`} />

    {animated && (
      <g class="ec-circuit-bg__particles">
        <circle cx="20%" cy="30%" r="2" fill={accentColor} class="is-particle-1" />
        <circle cx="60%" cy="50%" r="2" fill={accentColor} class="is-particle-2" />
        <circle cx="80%" cy="20%" r="2" fill={accentColor} class="is-particle-3" />
        <circle cx="40%" cy="70%" r="2" fill={accentColor} class="is-particle-4" />
      </g>
    )}
  </svg>
</div>

<style>
  .ec-circuit-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  .ec-circuit-bg__svg {
    width: 100%;
    height: 100%;
    opacity: 0.15;
  }

  .ec-circuit-bg.is-high .ec-circuit-bg__svg {
    opacity: 0.25;
  }

  .ec-circuit-bg.is-medium .ec-circuit-bg__svg {
    opacity: 0.15;
  }

  .ec-circuit-bg.is-low .ec-circuit-bg__svg {
    opacity: 0.08;
  }

  /* Animated particles */
  .ec-circuit-bg.is-animated .ec-circuit-bg__particles circle {
    animation: pulse 4s ease-in-out infinite;
  }

  .ec-circuit-bg__particles .is-particle-1 { animation-delay: 0s; }
  .ec-circuit-bg__particles .is-particle-2 { animation-delay: 1s; }
  .ec-circuit-bg__particles .is-particle-3 { animation-delay: 2s; }
  .ec-circuit-bg__particles .is-particle-4 { animation-delay: 3s; }

  @keyframes pulse {
    0%, 100% {
      opacity: 0.3;
      r: 2;
    }
    50% {
      opacity: 1;
      r: 3;
    }
  }
</style>
