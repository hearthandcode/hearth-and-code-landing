---
/**
 * Section (Testimonials) template
 * id: t-section-testimonials
 *
 * Customer/user testimonials section.
 */

import SectionContent from './SectionContent.astro';
import TestimonialCard from '../composites/TestimonialCard.astro';

interface Testimonial {
  quote: string;
  author: string;
  role?: string;
  avatarSrc?: string;
  rating?: number;
}

interface Props {
  eyebrow?: string;
  title?: string;
  lede?: string;
  testimonials: Testimonial[];
  columns?: 1 | 2 | 3;
  layout?: 'grid' | 'masonry';
  accent?: 'hearth' | 'code' | 'balanced';
  class?: string;
}

const {
  eyebrow,
  title,
  lede,
  testimonials,
  columns = 3,
  accent = 'balanced',
  class: className = '',
} = Astro.props;
---

<SectionContent eyebrow={eyebrow} title={title} lede={lede} accent={accent} class={className}>
  <div class={`ec-testimonials-grid ec-testimonials-grid--cols-${columns}`}>
    {testimonials.map((testimonial) => (
      <TestimonialCard
        quote={testimonial.quote}
        author={testimonial.author}
        role={testimonial.role}
        avatarSrc={testimonial.avatarSrc}
        rating={testimonial.rating}
      />
    ))}
  </div>
</SectionContent>

<style>
  .ec-testimonials-grid {
    display: grid;
    gap: var(--space-5);
  }
  .ec-testimonials-grid--cols-1 {
    grid-template-columns: 1fr;
    max-width: 48rem;
    margin: 0 auto;
  }
  .ec-testimonials-grid--cols-2 {
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
  }
  .ec-testimonials-grid--cols-3 {
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }
  @media (min-width: 1024px) {
    .ec-testimonials-grid--cols-2 { grid-template-columns: repeat(2, 1fr); }
    .ec-testimonials-grid--cols-3 { grid-template-columns: repeat(3, 1fr); }
  }
</style>
