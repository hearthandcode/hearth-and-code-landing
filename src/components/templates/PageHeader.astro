---
/**
 * Page Header template
 * id: t-page-header
 *
 * Standard page header with breadcrumb, title, subtitle, actions.
 */

import Breadcrumb from '../composites/Breadcrumb.astro';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  breadcrumb?: Crumb[];
  title: string;
  subtitle?: string;
  size?: 'sm' | 'md' | 'lg';
  accent?: 'hearth' | 'code' | 'balanced' | 'neutral';
  class?: string;
}

const {
  breadcrumb,
  title,
  subtitle,
  size = 'md',
  accent = 'balanced',
  class: className = '',
} = Astro.props;
---

<header class={`ec-page-header ec-page-header--${size} ec-page-header--${accent} ${className}`}>
  <div class="ec-page-header__inner">
    {breadcrumb && breadcrumb.length > 0 && (
      <div class="ec-page-header__breadcrumb">
        <Breadcrumb items={breadcrumb} />
      </div>
    )}
    <h1 class="ec-page-header__title">{title}</h1>
    {subtitle && <p class="ec-page-header__subtitle">{subtitle}</p>}
    <div class="ec-page-header__actions">
      <slot />
    </div>
  </div>
</header>

<style>
  .ec-page-header {
    padding: var(--space-8) var(--space-5) var(--space-7);
    border-bottom: 1px solid var(--color-surface-rule);
  }
  .ec-page-header__inner {
    max-width: 60rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .ec-page-header__breadcrumb {
    font-size: var(--font-size-small);
    color: var(--color-text-secondary);
  }
  .ec-page-header__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--font-weight-bold);
    line-height: 1.2;
    color: var(--color-text-display);
    letter-spacing: -0.02em;
  }
  .ec-page-header--sm .ec-page-header__title { font-size: 1.75rem; }
  .ec-page-header--md .ec-page-header__title { font-size: 2.25rem; }
  .ec-page-header--lg .ec-page-header__title { font-size: 3rem; }
  .ec-page-header--hearth .ec-page-header__title { border-left: 4px solid var(--color-accent-ember); padding-left: var(--space-4); }
  .ec-page-header--code .ec-page-header__title { border-left: 4px solid var(--color-accent-signal); padding-left: var(--space-4); }
  .ec-page-header--balanced .ec-page-header__title { border-left: 4px solid var(--color-accent-violet); padding-left: var(--space-4); }
  .ec-page-header__subtitle {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 48rem;
  }
  .ec-page-header__actions {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }
</style>
