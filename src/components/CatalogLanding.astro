---
import '../styles/orientation-landing.css';
const { surface } = Astro.props as { surface: 'library' | 'atlas' };
const library = [
['Orientation','Frame purpose, decision, source boundary, and stop condition.'],['Context packs','Select the smallest context needed for one job.'],['Goal charters','Bind scope, constraints, proof, and the next action.'],['RFC language','Use testable MUST, MAY, and IF/THEN rules where they help.'],
['Primitives','Name small reusable units: source, claim, task, receipt, return.'],['Schemas','Represent stable structure as fields people and tools can inspect.'],['Grammars','Define how primitives compose without becoming arbitrary.'],['Configuration','Keep variable policy and routing in reviewable data.'],
['Evidence ladders','Separate direct source, observation, inference, hypothesis, proposal.'],['Claim boundaries','Put maturity and limitations beside each material statement.'],['Receipts','Record what was checked, against what inputs, and what was not proved.'],['Return paths','Leave a practical route for correction or continuation.'],
['Recursive drafting','Draft a prompt, critique it, then generate narrower downstream prompts.'],['Delegation envelopes','Give agents scope, tools, no-touch boundaries, checks, and stop rules.'],['Counterevidence','Seek alternatives, missing sources, and falsifiers before deciding.'],['Power-of-two rhythm','Use 2, 4, and 8 to scan and compare, never to force reality.']];
const atlas = [
['Question → decision','Define the concrete choice an inquiry may inform.'],['Source → claim','Trace a statement to a source or mark it as inference.'],['Claim → boundary','Attach limitation, maturity, and correction while it is visible.'],['Boundary → action','Let constraints decide what may happen next.'],
['Brief → task','Turn a vague request into inputs, outputs, and verification.'],['Task → artifact','Require an inspectable result, not only a transcript.'],['Artifact → receipt','Bind an output to the checks that were actually run.'],['Receipt → return','Recover state and name the smallest useful continuation.'],
['Prompt → critique','Use a second pass to find ambiguity, risk, and missing evidence.'],['Critique → revision','Revise around the finding instead of asking for confidence.'],['Revision → experiment','Run the smallest test that could change the decision.'],['Experiment → learning','Keep result, uncertainty, and next question together.'],
['Human → agent','People supply intent, consent, and accountable judgment.'],['Agent → tool','Tools act only inside a declared capability and target boundary.'],['Tool → evidence','An execution result is observation, not automatic authority.'],['Evidence → human','Return consequential interpretation and release decisions to a person.']];
const items = surface === 'library' ? library : atlas;
const title = surface === 'library' ? 'The Library is the method book.' : 'The Atlas is the method in motion.';
const lede = surface === 'library' ? 'Sixteen public-facing techniques, in four groups of four, describe the working language behind Hearth & Code.' : 'Sixteen relation patterns show how the methods travel through real work, from inquiry to evidence and back to human judgment.';
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="theme-color" content="#1c1714"/><title>{surface === 'library' ? 'Library' : 'Atlas'} | Hearth &amp; Code</title></head><body class="orientation-body"><div class="orientation-atmosphere" aria-hidden="true"></div><header class="orientation-header"><a class="orientation-wordmark" href="/">Hearth <em>&amp;</em> Code</a><p>{surface}</p><a class="orientation-journal" href="/workbench/">Workbench →</a></header><main><section class="builder-hero"><p class="orientation-kicker">4 × 4 methodology catalogue</p><h1>{title}</h1><p class="orientation-lede">{lede}</p></section><section class="builder-introduction"><div><p class="orientation-kicker">How to read this</p><h2>{surface === 'library' ? 'Vocabulary before complexity.' : 'Relations before decoration.'}</h2></div><div class="builder-reading"><p>{surface === 'library' ? 'The Library holds named methods and primitives. It is a compact reference surface: enough detail to understand the purpose of each technique, with private prompts and operational charters kept out of view.' : 'The Atlas shows the application grammar. Each card connects two states of work, making it easier to see where an agent can assist and where a person must decide.'}</p></div></section><section class="builder-charter"><div class="orientation-section-heading"><p class="orientation-kicker">Sixteen cards / four families</p><h2>Methods designed to compose.</h2></div><ol class="builder-dimension-grid">{items.map(([name, description], index) => <li><span>{String(index + 1).padStart(2, '0')}</span><h3>{name}</h3><p>{description}</p></li>)}</ol></section><section class="builder-principle"><div><p class="orientation-kicker">A usable next move</p><h2>{surface === 'library' ? 'Pick four cards and make a reviewable loop.' : 'Follow one path and make the handoff visible.'}</h2></div><p>{surface === 'library' ? 'For a bounded agent task: frame a goal charter, select context, state the claim boundary, and leave a receipt. The technique is useful because another person can inspect and resume it.' : 'For a research decision: connect the question to a decision, distinguish source from inference, test the smallest experiment, then return the result to a human gate.'}</p></section><nav class="builder-next"><a href="/library/">Library</a><a href="/atlas/">Atlas</a></nav></main><footer class="orientation-footer"><p>Hearth &amp; Code</p><a href="/">Orientation →</a></footer></body></html>
