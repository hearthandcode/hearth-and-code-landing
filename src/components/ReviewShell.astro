---
import '../styles/review-site.css';

interface Props {
  title: string;
  description: string;
  current?: string;
  publicSite?: boolean;
}

const { title, description, current, publicSite = false } = Astro.props;
const routePrefix = publicSite ? '' : '/review';

const navigation = [
  { key: 'hearth', label: 'Hearth', href: `${routePrefix}/` },
  { key: 'research', label: 'Research', href: `${routePrefix}/research/` },
  { key: 'exocore', label: 'Exocore', href: `${routePrefix}/exocore/` },
  {
    key: 'journal',
    label: 'Field Journal',
    articleListHref: 'https://blog.hearthandcode.dev/#recent-entries',
    graphViewHref: 'https://blog.hearthandcode.dev/field/',
  },
  { key: 'ethics', label: 'AI & Ethics', href: `${routePrefix}/ethics/` },
  { key: 'lab', label: 'Lab', href: `${routePrefix}/lab/` },
  { key: 'method', label: 'Method', href: `${routePrefix}/method/` },
  { key: 'dossier', label: 'Dossier', href: `${routePrefix}/dossier/` },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {!publicSite && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#171311" />
    <title>{title} | Hearth &amp; Code{publicSite ? '' : ' review proof'}</title>
  </head>
  <body class="review-body">
    <div class="review-ambient" aria-hidden="true"></div>
    <a class="review-skip" href="#main-content">Skip to content</a>
    <div class="review-shell">
      <header class="review-header">
        <div class="review-status-rail">
          <span>{publicSite ? 'Hearth & Code / independent studio' : 'Hearth & Code / local review proof'}</span>
          <span><i aria-hidden="true"></i> {publicSite ? 'research, making, and public record' : 'full site composition'}</span>
        </div>
        <div class="review-brand-row">
          <a class="review-wordmark" href={`${routePrefix}/`}>Hearth <em>&amp;</em> Code</a>
          <p>Research, making, and a long way back into the work.</p>
        </div>
        <nav class="review-navigation" aria-label={publicSite ? 'Site navigation' : 'Review-site navigation'}>
          {navigation.map((item) => (
            item.key === 'journal' ? (
              <div class="review-journal-nav" role="group" aria-label="Field Journal reading views">
                <span>{item.label}</span>
                <a href={item.articleListHref} target="_blank" rel="noopener noreferrer">Article List <span aria-hidden="true">↗</span></a>
                <a href={item.graphViewHref} target="_blank" rel="noopener noreferrer">Graph View <span aria-hidden="true">↗</span></a>
              </div>
            ) : (
              <a href={item.href} aria-current={item.key === current ? 'page' : undefined}>
                {item.label}
              </a>
            )
          ))}
        </nav>
      </header>

      <main id="main-content">
        <slot />
      </main>

      <footer class="review-footer">
        <div>
          <p class="review-kicker">{publicSite ? 'Hearth & Code' : 'Local review only'}</p>
          <p>{publicSite ? 'An independent public surface for ongoing research, systems work, and selected creative practice. Sources, claims, and boundaries remain open to inspection and revision.' : 'This proof tests the public story, visual hierarchy, and page shape. It is not an approval of exact public copy or a production release.'}</p>
        </div>
        <div class="review-footer-links">
          <a href="https://github.com/hearthandcode" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
          <a href={`${routePrefix}/dossier/`}>Open dossier →</a>
        </div>
      </footer>
    </div>
  </body>
</html>
