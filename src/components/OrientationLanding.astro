---
import '../styles/orientation-landing.css';
import EmberCircuitArchive from './EmberCircuitArchive.astro';
import HearthNavigation from './HearthNavigation.astro';

const routes = [
  {
    number: '01',
    label: 'Orientation',
    href: '#orientation',
    description: 'Start with the practice, the work on the bench, and the paths through the site.',
  },
  {
    number: '02',
    label: 'Meet the Builder',
    href: '/builder/',
    description: 'The person accountable for the work, and the background that informs the practice.',
  },
  {
    number: '03',
    label: 'Exocore',
    href: '/exocore/',
    description: 'An evolving architecture for source-bound tools, agents, and knowledge systems that can be inspected and revised.',
  },
  {
    number: '04',
    label: 'Workbench',
    href: '/workbench/',
    description: 'Ember-stage experiments, proofpieces, and working software shown at their actual maturity.',
  },
  {
    number: '05',
    label: 'Library',
    href: '/library/',
    description: 'The patterns, sourcechains, and practical building blocks that give the work durable context.',
  },
  {
    number: '06',
    label: 'Atlas',
    href: '/atlas/',
    description: 'A connected view of projects, ideas, and the questions that run between them.',
  },
  {
    number: '07',
    label: 'Methods',
    href: '/method/',
    description: 'The return-bearing workshop: how inquiry, making, evidence, and revision stay connected.',
  },
  {
    number: '08',
    label: 'Return',
    href: '/return/',
    description: 'A place to rekindle the work, follow the Field Journal, and recover the next useful thread.',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Hearth & Code is an independent practice in software, AI, and knowledge systems." />
    <meta name="theme-color" content="#1c1714" />
    <title>Hearth &amp; Code</title>
  </head>
  <body class="orientation-body">
    <div class="orientation-atmosphere" aria-hidden="true"></div>
    <a class="orientation-skip" href="#main-content">Skip to content</a>

    <HearthNavigation current="orientation" context="Independent practice in software, AI, and knowledge systems." />

    <main id="main-content">
      <section class="orientation-hero" id="orientation" aria-labelledby="orientation-title">
        <p class="orientation-kicker">The open hearthside workbench</p>
        <div class="orientation-hero-grid">
          <div>
            <h1 id="orientation-title">A workshop for building clearer ways to think, make, and return.</h1>
            <p class="orientation-lede">Hearth &amp; Code is Scott Rallya's independent practice in software, AI, and knowledge systems: forging practical tools, documenting the sourcechain, and keeping the work human-held and easy to return to.</p>
          </div>
          <aside class="orientation-signal" aria-label="Practice signal">
            <p>At the bench</p>
            <strong>Return-bearing systems that stay legible while they change.</strong>
            <span>Research · software · agent workflows · knowledge practice</span>
          </aside>
        </div>
        <div class="orientation-actions">
          <a class="orientation-action orientation-action--primary" href="#routes">Choose a route <span aria-hidden="true">↓</span></a>
          <a class="orientation-action" href="/workbench/">See the workbench <span aria-hidden="true">→</span></a>
        </div>
        <EmberCircuitArchive />
      </section>

      <section class="orientation-principles" aria-label="How the practice works">
        <article>
          <p>01 / Kindle</p>
          <h2>Begin with a live question.</h2>
          <span>Turn curiosity into a bounded piece of work with a purpose, source, and honest stopping point.</span>
        </article>
        <article>
          <p>02 / Forge</p>
          <h2>Make something inspectable.</h2>
          <span>Tools, systems, and proofpieces should show what they do, where they came from, and what remains unproven.</span>
        </article>
        <article>
          <p>03 / Return</p>
          <h2>Leave the way back.</h2>
          <span>Bank a returnthread so another person, or a future self, can understand what happened and where to continue.</span>
        </article>
      </section>

      <section class="orientation-routes" id="routes" aria-labelledby="routes-title">
        <div class="orientation-section-heading">
          <p class="orientation-kicker">Eight routes through the work</p>
          <h2 id="routes-title">Begin anywhere. Each route has a different job.</h2>
          <p>These sections form the working map for Hearth &amp; Code. The orientation layer is the front door; the next pages deepen one part of the practice at a time.</p>
        </div>
        <ol class="orientation-route-grid">
          {routes.map((route) => (
            <li>
              <a href={route.href}>
                <span class="orientation-route-number">{route.number}</span>
                <span class="orientation-route-label">{route.label}</span>
                <span class="orientation-route-description">{route.description}</span>
                <span class="orientation-route-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ol>
      </section>

      <section class="orientation-note" aria-labelledby="note-title">
        <div>
          <p class="orientation-kicker">A note on the tools</p>
          <h2 id="note-title">The machine can extend the bench. Responsibility stays human.</h2>
        </div>
        <p>AI helps with research, drafting, and implementation. Scott remains responsible for the decisions, the boundaries, and the work shared here.</p>
      </section>
    </main>

    <footer class="orientation-footer">
      <p>Hearth &amp; Code</p>
      <a href="#orientation">Back to the workbench ↑</a>
    </footer>
  </body>
</html>
