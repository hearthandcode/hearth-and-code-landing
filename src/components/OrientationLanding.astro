---
import '../styles/orientation-landing.css';

const routes = [
  {
    number: '01',
    label: 'Orientation',
    href: '#orientation',
    description: 'Start with the practice, the work on the bench, and the paths through the site.',
  },
  {
    number: '02',
    label: 'Meet the Builder',
    href: '/builder/',
    description: 'The person accountable for the work, and the background that informs the practice.',
  },
  {
    number: '03',
    label: 'Exocore',
    href: '/review/exocore/',
    description: 'An evolving architecture for tools, agents, and knowledge systems that can be inspected and revised.',
  },
  {
    number: '04',
    label: 'Workbench',
    href: '/workbench/',
    description: 'Experiments, prototypes, and working software shown at their actual stage of development.',
  },
  {
    number: '05',
    label: 'Library',
    href: '/library/',
    description: 'The research, notes, and practical building blocks that give the work a durable context.',
  },
  {
    number: '06',
    label: 'Atlas',
    href: '/atlas/',
    description: 'A connected view of projects, ideas, and the questions that run between them.',
  },
  {
    number: '07',
    label: 'Methods',
    href: '/review/method/',
    description: 'How inquiry, implementation, evidence, and revision are kept connected in everyday work.',
  },
  {
    number: '08',
    label: 'Return',
    href: '/review/',
    description: 'A clear way to revisit the work, follow the field journal, and find the next useful thread.',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Hearth & Code is an independent practice in software, AI, and knowledge systems." />
    <meta name="theme-color" content="#1c1714" />
    <title>Hearth &amp; Code</title>
  </head>
  <body class="orientation-body">
    <div class="orientation-atmosphere" aria-hidden="true"></div>
    <a class="orientation-skip" href="#main-content">Skip to content</a>

    <header class="orientation-header">
      <a class="orientation-wordmark" href="#orientation">Hearth <em>&amp;</em> Code</a>
      <p>Independent practice in software, AI, and knowledge systems.</p>
      <a class="orientation-journal" href="https://blog.hearthandcode.dev/" target="_blank" rel="noopener noreferrer">Field Journal <span aria-hidden="true">↗</span></a>
    </header>

    <main id="main-content">
      <section class="orientation-hero" id="orientation" aria-labelledby="orientation-title">
        <p class="orientation-kicker">The open workbench</p>
        <div class="orientation-hero-grid">
          <div>
            <h1 id="orientation-title">A workshop for building clearer ways to think, make, and return.</h1>
            <p class="orientation-lede">Hearth &amp; Code is Scott Rallya's independent practice in software, AI, and knowledge systems: making practical tools, documenting the work, and keeping the path back to a useful next step visible.</p>
          </div>
          <aside class="orientation-signal" aria-label="Practice signal">
            <p>At the bench</p>
            <strong>Systems that stay legible while they change.</strong>
            <span>Research · software · agent workflows · knowledge practice</span>
          </aside>
        </div>
        <div class="orientation-actions">
          <a class="orientation-action orientation-action--primary" href="#routes">Choose a route <span aria-hidden="true">↓</span></a>
          <a class="orientation-action" href="/review/lab/">See the workbench <span aria-hidden="true">→</span></a>
        </div>
      </section>

      <section class="orientation-principles" aria-label="How the practice works">
        <article>
          <p>01 / Make</p>
          <h2>Build useful things.</h2>
          <span>Small tools, working systems, and prototypes that earn their next iteration through use.</span>
        </article>
        <article>
          <p>02 / Keep</p>
          <h2>Leave a record.</h2>
          <span>Decisions, sources, experiments, and open questions are part of the work, not its paperwork.</span>
        </article>
        <article>
          <p>03 / Return</p>
          <h2>Make re-entry easier.</h2>
          <span>Every surface should help a person understand what happened and where to continue.</span>
        </article>
      </section>

      <section class="orientation-routes" id="routes" aria-labelledby="routes-title">
        <div class="orientation-section-heading">
          <p class="orientation-kicker">Eight routes through the work</p>
          <h2 id="routes-title">Begin anywhere. Each route has a different job.</h2>
          <p>These sections form the working map for Hearth &amp; Code. The orientation layer is the front door; the next pages deepen one part of the practice at a time.</p>
        </div>
        <ol class="orientation-route-grid">
          {routes.map((route) => (
            <li>
              <a href={route.href}>
                <span class="orientation-route-number">{route.number}</span>
                <span class="orientation-route-label">{route.label}</span>
                <span class="orientation-route-description">{route.description}</span>
                <span class="orientation-route-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ol>
      </section>

      <section class="orientation-note" aria-labelledby="note-title">
        <div>
          <p class="orientation-kicker">A note on the tools</p>
          <h2 id="note-title">Tools can assist. Responsibility stays human.</h2>
        </div>
        <p>AI helps with research, drafting, and implementation. Scott remains responsible for the decisions, the boundaries, and the work shared here.</p>
      </section>
    </main>

    <footer class="orientation-footer">
      <p>Hearth &amp; Code</p>
      <a href="#orientation">Back to the workbench ↑</a>
    </footer>
  </body>
</html>
