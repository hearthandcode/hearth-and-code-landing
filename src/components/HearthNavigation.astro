---
interface Props {
  // Accept any string; validate against canonical values internally.
  // Legacy values are accepted and mapped to canonical values via aliasMap.
  current?: string;
  context: string;
}

const { current, context } = Astro.props;

// Map legacy aliases to nearest current value
const aliasMap: Record<string, string> = {
  builder: 'questions',
  exocore: 'portfolio',
  workbench: 'practice',
  library: 'portfolio',
  atlas: 'research',
  method: 'dossier',
  return: 'contact',
};

// Accept legacy `current` values by mapping through aliasMap
const resolvedCurrent = current ? (aliasMap[current] || current) : undefined;

const routes = [
  ['01', 'orientation', 'Studio',         '/'],
  ['02', 'practice',    'Practice',        '/practice/'],
  ['03', 'philosophy',  'Philosophy',      '/philosophy/'],
  ['04', 'research',    'Research',        '/research/'],
  ['05', 'portfolio',   'Portfolio',       '/portfolio/'],
  ['06', 'dossier',     'Dossier',         '/dossier/'],
  ['07', 'questions',   'Questions',       '/questions/'],
  ['08', 'contact',     'Contact',         '/correspondence/'],
] as const;
---

<header class="orientation-header">
  <div class="orientation-brand-row">
    <a class="orientation-wordmark" href="/" aria-label="Hearth and Code, return to Orientation">Hearth <em>&amp;</em> Code</a>
    <p>{context}</p>
    <a class="orientation-journal" href="/journal/">
      Field Journal <span aria-hidden="true">→</span>
    </a>
  </div>
  <nav class="hearth-navigation" aria-label="Hearth and Code rooms">
    <ol>
      {routes.map(([number, key, label, href]) => (
        <li>
          <a href={href} aria-current={resolvedCurrent === key ? 'page' : undefined}>
            <span aria-hidden="true">{number}</span>
            <strong>{label}</strong>
          </a>
        </li>
      ))}
    </ol>
  </nav>
</header>
