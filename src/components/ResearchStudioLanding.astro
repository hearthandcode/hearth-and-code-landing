---
import '../styles/tokens.css';
import '../styles/global.css';
import HearthCodeToggle from './HearthCodeToggle.astro';
import CircuitBackground from './CircuitBackground.astro';
import NavigationCard from './NavigationCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getNavigationCards, getStartPaths } from '../lib/content';

const navCards = getNavigationCards('balanced');
const startPaths = getStartPaths('balanced');
---

<BaseLayout
  title="Hearth & Code — Independent Research Studio"
  description="An independent research studio for answerable systems. Research, software, knowledge architecture, and policy thinking."
>

<!-- HERO SECTION -->
<section class="ec-presentation ec-presentation--hero" data-section="hero">
  <CircuitBackground density="medium" animated={true} accent="signal" />

  <div class="ec-presentation__inner">
    <header class="ec-hero">
      <p class="ec-eyebrow">Hearth &amp; Code</p>
      <h1 class="ec-hero__title">An independent research studio for answerable systems.</h1>
      <p class="ec-hero__lede">
        Hearth &amp; Code is my public workbench for research, software, knowledge architecture,
        and policy thinking. The goal isn't to show everything I've done. It's to make
        the work legible enough that you can question it, use it, or build on it.
      </p>
      <div class="ec-hero__toggle-row">
        <HearthCodeToggle current="balanced" />
      </div>
    </header>
  </div>
</section>

<!-- DIVIDER -->
<div class="ec-divider" aria-hidden="true"></div>

<!-- WHO RUNS IT -->
<section class="ec-presentation ec-presentation--who" data-section="who">
  <div class="ec-presentation__inner ec-presentation__inner--centered">
    <p class="ec-eyebrow">Who runs it</p>
    <h2 class="ec-presentation__title">A practice, not a platform.</h2>
    <div class="ec-who__content">
      <p class="ec-who__lede">
        I'm Scott Rallya (online: Cognitectus). I work independently on systems where
        complexity needs to stay inspectable — AI governance, knowledge architecture,
        agent coordination, and public reasoning.
      </p>
      <p class="ec-who__principle">
        The studio runs on a single principle: <strong>every consequential claim
        should have a source, a scope, and a way to be challenged.</strong>
      </p>
      <p class="ec-who__principle">
        That's the bar. Everything else follows from it. <a href="/dossier/">Read my
        working profile to see how this plays out in practice</a> — the personality
        behind the work, the methodology, and what I'm currently working on.
      </p>
    </div>
  </div>
</section>

<div class="ec-divider" aria-hidden="true"></div>

<!-- WHAT YOU'LL FIND HERE -->
<section class="ec-presentation ec-presentation--navigate" data-section="navigate">
  <CircuitBackground density="low" animated={false} accent="ember" />

  <div class="ec-presentation__inner">
    <p class="ec-eyebrow">What you'll find here</p>
    <h2 class="ec-presentation__title" id="nav-title">Eight layers of work.</h2>
    <p class="ec-presentation__lede" id="nav-disposition">
      The site is organized in eight layers, each with a different purpose and reading mode.
      Toggle the view above to see them through a Hearth or Code lens — the same paths,
      different emphasis.
    </p>

    <div class="ec-presentation__grid" id="nav-grid">
      {navCards.map((card) => (
        <NavigationCard
          href={card.href || '#'}
          title={card.title}
          description={card.description}
          emphasis={card.emphasis || 5}
          view="balanced"
        />
      ))}
    </div>
  </div>
</section>

<div class="ec-divider" aria-hidden="true"></div>

<!-- WHERE TO START -->
<section class="ec-presentation ec-presentation--start" data-section="start">
  <div class="ec-presentation__inner ec-presentation__inner--centered">
    <p class="ec-eyebrow">Where to start</p>
    <h2 class="ec-presentation__title">Three paths, depending on you.</h2>

    <div class="ec-presentation__paths" id="paths-list">
      {startPaths.map((path, idx) => (
        <article class="ec-path" data-num={idx + 1}>
          <div class="ec-path__num">{String(idx + 1).padStart(2, '0')}</div>
          <div class="ec-path__content">
            <h3 class="ec-path__title">{path.title}</h3>
            <p class="ec-path__desc">{path.description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<div class="ec-divider" aria-hidden="true"></div>

<!-- FOOTER -->
<section class="ec-presentation ec-presentation--footer" data-section="footer">
  <div class="ec-presentation__inner ec-presentation__inner--centered">
    <p class="ec-footer__text">
      This site is independently operated. No tracking. No visitor profiles.
      If something here is wrong or incomplete, <a href="/correspondence/">tell me</a> —
      correction is always welcome.
    </p>
  </div>
</section>

<style>
  /* ==========================================================================
     PRESENTATION CONTAINER
     Each section is a full-viewport "slide"
     ========================================================================== */
  .ec-presentation {
    position: relative;
    width: 100%;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-8) var(--space-7);
    overflow: hidden;
  }

  .ec-presentation__inner {
    width: 100%;
    max-width: 90rem; /* Wide for 2560x1440 */
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .ec-presentation__inner--centered {
    text-align: center;
    max-width: 60rem;
  }

  /* ==========================================================================
     DIVIDER - clear visual separator between sections
     ========================================================================== */
  .ec-divider {
    width: 100%;
    height: 2px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--color-surface-rule, #4b4237) 20%,
      var(--ember_500, #E85B4E) 50%,
      var(--color-surface-rule, #4b4237) 80%,
      transparent 100%
    );
    opacity: 0.6;
  }

  /* ==========================================================================
     HERO (Section 1)
     ========================================================================== */
  .ec-presentation--hero {
    padding-top: var(--space-8);
  }

  .ec-hero {
    max-width: 70rem;
  }

  .ec-hero .ec-eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--text_secondary, #cfc1ab);
    font-size: 0.875rem;
    margin: 0 0 var(--space-md) 0;
    opacity: 0.8;
  }

  .ec-hero__title {
    font-family: var(--font-display, Georgia, serif);
    font-size: clamp(1.75rem, 3.5vw, 3.75rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-lg) 0;
    color: var(--text_display, #faf3e2);
    white-space: nowrap;
  }

  .ec-hero__lede {
    font-size: clamp(1.125rem, 1.5vw, 1.5rem);
    line-height: 1.55;
    color: var(--text_secondary, #cfc1ab);
    margin: 0 0 var(--space-7) 0;
    max-width: 56rem;
  }

  .ec-hero__toggle-row {
    margin-top: var(--space-7);
  }

  /* ==========================================================================
     WHO (Section 2)
     ========================================================================== */
  .ec-presentation--who {
    background: linear-gradient(
      180deg,
      transparent 0%,
      rgba(232, 91, 78, 0.03) 50%,
      transparent 100%
    );
  }

  .ec-presentation--who .ec-eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--ember_400, #ED7568);
    font-size: 0.875rem;
    margin: 0 0 var(--space-md) 0;
  }

  .ec-presentation__title {
    font-family: var(--font-display, Georgia, serif);
    font-size: clamp(1.75rem, 3.5vw, 3.25rem);
    font-weight: 500;
    line-height: 1.2;
    margin: 0 0 var(--space-7) 0;
    color: var(--text_display, #faf3e2);
  }

  .ec-who__content {
    text-align: left;
    max-width: 52rem;
    margin: 0 auto;
  }

  .ec-who__lede {
    font-size: clamp(1.125rem, 1.5vw, 1.5rem);
    line-height: 1.6;
    color: var(--text_primary, #f1e7d2);
    margin: 0 0 var(--space-7) 0;
  }

  .ec-who__principle {
    font-size: clamp(1rem, 1.25vw, 1.25rem);
    line-height: 1.7;
    color: var(--text_secondary, #cfc1ab);
    margin: 0 0 var(--space-lg) 0;
  }

  .ec-who__principle a {
    color: var(--ember_400, #ED7568);
    text-decoration: none;
    border-bottom: 1px dotted var(--ember_400, #ED7568);
  }

  .ec-who__principle a:hover {
    color: var(--ember_300, #F18B7E);
    border-bottom-color: var(--ember_300, #F18B7E);
  }

  .ec-who__principle strong {
    color: var(--text_display, #faf3e2);
    font-weight: 500;
  }

  /* ==========================================================================
     NAVIGATE (Section 3)
     ========================================================================== */
  .ec-presentation--navigate {
    padding: var(--space-8) var(--space-7);
  }

  .ec-presentation--navigate .ec-eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--signal_400, #5DCBC2);
    font-size: 0.875rem;
    margin: 0 0 var(--space-md) 0;
  }

  .ec-presentation__lede {
    font-size: clamp(1rem, 1.25vw, 1.25rem);
    line-height: 1.6;
    color: var(--text_secondary, #cfc1ab);
    margin: 0 0 var(--space-8) 0;
    max-width: 60rem;
  }

  .ec-presentation__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(22rem, 1fr));
    gap: var(--space-lg);
  }

  /* ==========================================================================
     START (Section 4) - Generous spacing, full paths
     ========================================================================== */
  .ec-presentation--start {
    padding: var(--space-8) var(--space-7);
  }

  .ec-presentation--start .ec-eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--plasma_500, #3FE0D0);
    font-size: 0.875rem;
    margin: 0 0 var(--space-md) 0;
  }

  .ec-presentation__paths {
    display: flex;
    flex-direction: column;
    gap: var(--space-9); /* Maximum space between paths (6rem / 96px) */
    max-width: 64rem;
    margin: 0 auto;
    text-align: left;
    padding: var(--space-7) 0;
  }

  .ec-path {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-8);
    align-items: start;
    padding: var(--space-8) 0;
    border-top: 1px solid var(--color-surface-rule, #4b4237);
    transition: border-color 200ms;
  }

  .ec-path:last-child {
    border-bottom: 1px solid var(--color-surface-rule, #4b4237);
  }

  .ec-path:hover {
    border-top-color: var(--ember_500, #E85B4E);
  }

  .ec-path__num {
    font-family: var(--font-display, Georgia, serif);
    font-size: clamp(2.5rem, 4vw, 4rem);
    font-weight: 300;
    color: var(--ember_500, #E85B4E);
    line-height: 1;
    opacity: 0.7;
    min-width: 4rem;
    letter-spacing: -0.02em;
  }

  .ec-path__title {
    font-family: var(--font-display, Georgia, serif);
    font-size: clamp(1.5rem, 2vw, 2rem);
    font-weight: 500;
    line-height: 1.3;
    margin: 0 0 var(--space-md) 0;
    color: var(--text_display, #faf3e2);
  }

  .ec-path__desc {
    font-size: clamp(1.0625rem, 1.125vw, 1.125rem);
    line-height: 1.7;
    color: var(--text_secondary, #cfc1ab);
    margin: 0;
  }

  /* ==========================================================================
     FOOTER (Section 5)
     ========================================================================== */
  .ec-presentation--footer {
    min-height: 30vh;
    padding: var(--space-7);
  }

  .ec-footer__text {
    font-size: 0.875rem;
    color: var(--text_secondary, #cfc1ab);
    text-align: center;
    max-width: 40rem;
    margin: 0 auto;
    opacity: 0.8;
  }

  .ec-footer__text a {
    color: var(--ember_400, #ED7568);
    text-decoration: none;
    border-bottom: 1px dotted var(--ember_400, #ED7568);
  }

  .ec-footer__text a:hover {
    color: var(--ember_300, #F18B7E);
  }

  /* ==========================================================================
     RESPONSIVE
     ========================================================================== */
  @media (max-width: 768px) {
    .ec-presentation {
      padding: var(--space-7) var(--space-lg);
      min-height: auto;
    }

    .ec-hero__title {
      font-size: 1.75rem;
      white-space: normal;
    }

    .ec-presentation__title {
      font-size: 1.5rem;
    }

    .ec-presentation__grid {
      grid-template-columns: 1fr;
    }

    .ec-path {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }
  }

  /* ==========================================================================
     Hearth-Code view states
     ========================================================================== */
  :root[data-hc-view="hearth"] .ec-presentation--hero {
    background: radial-gradient(ellipse at 30% 50%, rgba(232, 91, 78, 0.06) 0%, transparent 60%);
  }

  :root[data-hc-view="code"] .ec-presentation--hero {
    background: radial-gradient(ellipse at 70% 50%, rgba(31, 182, 168, 0.06) 0%, transparent 60%);
  }

  :root[data-hc-view="balanced"] .ec-presentation--hero {
    background: radial-gradient(ellipse at center, rgba(155, 93, 229, 0.04) 0%, transparent 60%);
  }

  /* View-specific content visibility */
  :root[data-hc-view="hearth"] [data-view-only="code"] { display: none; }
  :root[data-hc-view="code"] [data-view-only="hearth"] { display: none; }
  :root[data-hc-view="balanced"] [data-view-only="hearth"],
  :root[data-hc-view="balanced"] [data-view-only="code"] { display: none; }
</style>

<script>
  // ============================================================
  // View state management
  // ============================================================

  // Initialize view from URL or localStorage
  function getView() {
    try {
      const url = new URL(window.location.href);
      const urlView = url.searchParams.get('view');
      if (urlView && ['hearth', 'code', 'balanced'].includes(urlView)) return urlView;
      const stored = localStorage.getItem('hearth-code-view');
      if (stored && ['hearth', 'code', 'balanced'].includes(stored)) return stored;
    } catch (e) {}
    return 'balanced';
  }

  function applyView(view: string) {
    document.documentElement.setAttribute('data-hc-view', view);

    // Update all toggles on page
    document.querySelectorAll('[data-toggle-root]').forEach((toggle) => {
      toggle.setAttribute('data-current', view);
      toggle.querySelectorAll('[data-segment]').forEach((seg) => {
        const segValue = seg.getAttribute('data-segment');
        if (segValue === view) {
          seg.setAttribute('aria-selected', 'true');
          seg.classList.add('is-active');
        } else {
          seg.setAttribute('aria-selected', 'false');
          seg.classList.remove('is-active');
        }
      });
    });

    // Update navigation cards data-view
    document.querySelectorAll('.ec-nav-card').forEach((card) => {
      card.setAttribute('data-view', view);
    });

    // Update navigation section content based on view
    const navTitle = document.getElementById('nav-title');
    const navDisposition = document.getElementById('nav-disposition');
    const viewContent: Record<string, { title: string; description: string }> = {
      hearth: {
        title: 'Explore by purpose',
        description: 'Each surface maps to a question about meaning, agency, or how to live and work well in the age of AI.',
      },
      code: {
        title: 'Explore by domain',
        description: 'Each surface contains technical depth: methods, architectures, code, and research with sources.',
      },
      balanced: {
        title: 'Eight layers of work.',
        description: 'Each surface offers both the philosophical context and the technical artifacts to act on it.',
      },
    };
    if (navTitle && viewContent[view]) {
      navTitle.textContent = viewContent[view].title;
    }
    if (navDisposition && viewContent[view]) {
      navDisposition.textContent = viewContent[view].description;
    }

    // Update path section content
    const pathIntro = document.querySelector('.ec-presentation--start .ec-presentation__title');
    const viewPathIntro: Record<string, string> = {
      hearth: 'Three paths, for how you want to explore.',
      code: 'Three paths, organized by depth of engagement.',
      balanced: 'Three paths, depending on you.',
    };
    if (pathIntro && viewPathIntro[view]) {
      pathIntro.textContent = viewPathIntro[view];
    }

    // Update hero lede
    const heroLede = document.querySelector('.ec-hero__lede');
    const viewHeroLede: Record<string, string> = {
      hearth: 'Hearth & Code is my public workbench — a place to share how I think, what I value, and the wisdom I\'ve gathered. I document because memory fails and writing helps me think.',
      code: 'Hearth & Code is my public workbench for research, software, knowledge architecture, and policy thinking. I build because complex systems deserve careful design.',
      balanced: 'Hearth & Code is my public workbench for research, software, knowledge architecture, and policy thinking. The goal isn\'t to show everything I\'ve done. It\'s to make the work legible enough that you can question it, use it, or build on it.',
    };
    if (heroLede && viewHeroLede[view]) {
      heroLede.textContent = viewHeroLede[view];
    }
  }

  // Listen for toggle changes
  document.addEventListener('hearth-code-view-change', (event) => {
    const view = (event as CustomEvent).detail.view;
    applyView(view);
  });

  // Handle browser back/forward
  window.addEventListener('popstate', () => {
    applyView(getView());
  });

  // Initialize on load
  applyView(getView());
</script>
</BaseLayout>
