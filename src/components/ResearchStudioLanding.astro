---
/**
 * Public Studio landing page.
 *
 * The page is intentionally an orientation surface rather than a catalogue:
 * choose a projection, understand the studio, choose a path, then inspect work.
 */
import '../styles/tokens.css';
import '../styles/global.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import HearthCodeToggle from './HearthCodeToggle.astro';
import CircuitBackground from './CircuitBackground.astro';
import NavigationCard from './NavigationCard.astro';
import { getNavigationCards } from '../lib/content';

const navigationCards = getNavigationCards('balanced').map((card) => ({
  ...card,
  // The former /practice/ route is now the public methods surface.
  href: card.href === '/practice/' ? '/methods/' : card.href,
}));

// The projections are deliberately different navigation maps, not merely
// different prose over the same links. Balanced keeps every route visible
// and foregrounds Portfolio as the synthesis of the studio's work.
const projectionMembership: Record<string, string[]> = {
  'Practice': ['code', 'balanced'],
  'Philosophy': ['hearth', 'balanced'],
  'Research': ['code', 'balanced'],
  'Portfolio': ['balanced'],
  'Dossier': ['hearth', 'balanced'],
  'Questions': ['code', 'balanced'],
  'Field Journal': ['code', 'balanced'],
  'Contact': ['hearth', 'balanced'],
};
const projectionOrder = ['Portfolio', 'Practice', 'Philosophy', 'Research', 'Dossier', 'Questions', 'Field Journal', 'Contact'];
const orderedNavigationCards = [...navigationCards].sort(
  (a, b) => projectionOrder.indexOf(a.title) - projectionOrder.indexOf(b.title),
);

const startPaths = [
  {
    href: '/philosophy/ai-literacy/',
    title: 'Understand the position',
    description: 'Read a grounded entry point into how this studio approaches AI, judgment, and public reasoning.',
    number: '01',
  },
  {
    href: '/methods/',
    title: 'Inspect the methods',
    description: 'Open the practical instruments, prompt techniques, and working records behind the research.',
    number: '02',
  },
  {
    href: '/research/',
    title: 'Follow the active work',
    description: 'See the research programs, systems, and open questions currently being developed in public.',
    number: '03',
  },
];

const studioNavLinks = [
  { label: 'Studio', href: '/' },
  { label: 'Philosophy', href: '/philosophy/' },
  { label: 'Methods', href: '/methods/' },
  { label: 'Research', href: '/research/' },
  { label: 'Portfolio', href: '/portfolio/' },
  { label: 'Dossier', href: '/dossier/' },
  { label: 'Questions', href: '/questions/' },
  { label: 'Journal', href: '/journal/' },
  { label: 'Contact', href: '/correspondence/' },
];

const currentSignals = [
  {
    eyebrow: 'Research platform',
    title: 'Exocore',
    detail: 'A local-first research workbench for source-linked investigation, governed agent roles, and human return paths.',
    href: '/exocore/',
  },
  {
    eyebrow: 'Communication medium',
    title: 'HCAN',
    detail: 'A bounded language and evaluation surface for making system claims, context, and effects inspectable.',
    href: '/hcan/',
  },
  {
    eyebrow: 'Public method library',
    title: 'Fieldcraft',
    detail: 'Working methods, field cards, and techniques for research that remains legible and revisable.',
    href: '/methods/',
  },
];
---

<BaseLayout
  title="Hearth & Code — Independent Research Studio"
  description="An independent research studio for answerable systems: research, software, knowledge architecture, and policy thinking."
>
  <a class="studio-skip" href="#studio-main">Skip to Studio content</a>
  <header class="studio-nav" data-studio-menu-root>
    <div class="studio-nav__brand-row">
      <a class="studio-nav__brand" href="/" aria-label="Hearth and Code Studio home">
        <span class="studio-nav__mark" aria-hidden="true"></span>
        <span>Hearth <em>&amp;</em> Code</span>
      </a>
      <p class="studio-nav__disposition">Independent research studio · public workbench for inspectable systems</p>
      <button class="studio-nav__menu-button" type="button" aria-expanded="false" aria-controls="studio-primary-nav" data-studio-menu-button>
        <span>Menu</span><span aria-hidden="true">+</span>
      </button>
    </div>
    <nav class="studio-nav__menu" id="studio-primary-nav" aria-label="Hearth and Code primary navigation" data-studio-menu>
      <ol>
        {studioNavLinks.map((link, index) => (
          <li>
            <a href={link.href} aria-current={link.href === '/' ? 'page' : undefined}>
              <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <strong>{link.label}</strong>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </header>
  <main class="studio" id="studio-main" data-studio-root>
    <!-- 1. Identity and projection choice -->
    <section class="studio-hero" aria-labelledby="studio-title">
      <CircuitBackground density="medium" animated={true} accent="signal" />
      <div class="studio-shell studio-hero__content">
        <p class="studio-kicker">Hearth &amp; Code · Independent research studio</p>
        <h1 id="studio-title">Answerable systems for consequential work.</h1>
        <p class="studio-hero__lede" id="studio-hero-lede">
          Research, software, knowledge architecture, and policy thinking made legible enough to inspect, question, use, and revise.
        </p>
        <div class="studio-hero__toggle">
          <HearthCodeToggle current="balanced" />
        </div>
        <p class="studio-hero__hint">Choose a projection to change the emphasis, not the underlying work.</p>
      </div>
    </section>

    <!-- 2. Projection orientation -->
    <section class="studio-section studio-section--orientation" aria-labelledby="orientation-title">
      <div class="studio-shell studio-orientation">
        <div class="studio-section__intro">
          <p class="studio-kicker" id="view-panel-eyebrow">Current projection</p>
          <h2 id="orientation-title"><span id="view-panel-title">The full studio, in one view.</span></h2>
        </div>
        <aside class="studio-orientation__panel" id="view-panel" data-view="balanced" aria-live="polite">
          <p id="view-panel-disposition">
            Hearth holds the questions of meaning and judgment. Code holds the methods and systems. The balanced view keeps both visible, so a visitor can move from a claim to its working form.
          </p>
          <div class="studio-orientation__routes" aria-label="Projection routes">
            <a id="orientation-route-1" href="/portfolio/">View the portfolio <span aria-hidden="true">↗</span></a>
            <a id="orientation-route-2" href="/dossier/">Read the dossier <span aria-hidden="true">↗</span></a>
            <a id="orientation-route-3" href="/research/">Inspect the research <span aria-hidden="true">↗</span></a>
          </div>
        </aside>
      </div>
    </section>

    <!-- 3. Audience-led start paths -->
    <section class="studio-section" aria-labelledby="start-title">
      <div class="studio-shell">
        <div class="studio-section__intro studio-section__intro--wide">
          <p class="studio-kicker">Start here</p>
          <h2 id="start-title">Three useful ways into the studio.</h2>
          <p>Choose the route that best matches the question you brought with you.</p>
        </div>
        <div class="studio-paths">
          {startPaths.map((path) => (
            <a class="studio-path" href={path.href}>
              <span class="studio-path__number">{path.number}</span>
              <span class="studio-path__body">
                <span class="studio-path__title">{path.title}</span>
                <span class="studio-path__description">{path.description}</span>
              </span>
              <span class="studio-path__arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. Site work map -->
    <section class="studio-section studio-section--map" aria-labelledby="nav-title">
      <CircuitBackground density="low" animated={false} accent="ember" />
      <div class="studio-shell studio-section__content">
        <div class="studio-section__intro studio-section__intro--wide">
          <p class="studio-kicker">Work map</p>
          <h2 id="nav-title">The full studio map.</h2>
          <p id="nav-disposition">All eight surfaces are available here; Portfolio is the synthesis route across the Hearth and Code seams.</p>
        </div>
        <div class="studio-map" id="nav-grid">
          {orderedNavigationCards.map((card) => {
            const projections = projectionMembership[card.title] || ['balanced'];
            return (
              <div
                class:list={['studio-map__item', card.title === 'Portfolio' && 'is-synthesis']}
                data-map-card
                data-projections={projections.join(' ')}
              >
                <NavigationCard
                  href={card.href || '#'}
                  title={card.title}
                  description={card.description}
                  emphasis={card.emphasis || 5}
                  view="balanced"
                />
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- 5. Concrete current signals -->
    <section class="studio-section" aria-labelledby="signal-title">
      <div class="studio-shell">
        <div class="studio-section__intro studio-section__intro--wide">
          <p class="studio-kicker">Current signal</p>
          <h2 id="signal-title">Three live bodies of work.</h2>
          <p>These are useful entry points if you want to see the studio in motion rather than only navigate its archive.</p>
        </div>
        <div class="studio-signals">
          {currentSignals.map((signal) => (
            <article class="studio-signal">
              <p class="studio-signal__eyebrow">{signal.eyebrow}</p>
              <h3>{signal.title}</h3>
              <p>{signal.detail}</p>
              <a href={signal.href}>Open {signal.title} <span aria-hidden="true">→</span></a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 6. Practice and return boundary -->
    <section class="studio-section studio-section--return" aria-labelledby="return-title">
      <div class="studio-shell studio-return">
        <p class="studio-kicker">Practice and return</p>
        <h2 id="return-title">A public surface should leave a way back.</h2>
        <p>
          This studio is independently operated, does not build visitor profiles, and treats correction as part of the work. If a claim, source, or route is incomplete, say so.
        </p>
        <div class="studio-return__actions">
          <a class="studio-action studio-action--primary" href="/correspondence/">Start a correspondence</a>
          <a class="studio-action" href="/dossier/">How the studio works</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .studio-skip { position: fixed; z-index: 1000; top: -4rem; left: 1rem; padding: 0.75rem 1rem; background: var(--color-surface-recessed); border: 1px solid var(--color-accent-plasma); color: var(--color-text-display); font: 0.75rem var(--font-mono); text-decoration: none; }
  .studio-skip:focus { top: 1rem; }
  .studio-nav { position: sticky; top: 0; z-index: var(--z-sticky); border-bottom: 1px solid var(--color-surface-rule); background: rgba(22, 20, 17, 0.96); backdrop-filter: blur(16px); }
  .studio-nav__brand-row { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 1.5rem; width: min(100% - 3rem, 90rem); min-height: 4rem; margin: auto; }
  .studio-nav__brand { display: inline-flex; align-items: baseline; gap: 0.65rem; color: var(--color-text-display); font: 700 1.25rem/1 var(--font-display); letter-spacing: -0.04em; text-decoration: none; white-space: nowrap; }
  .studio-nav__brand em { color: var(--color-accent-gold); font-style: normal; }
  .studio-nav__mark { width: 0.7rem; height: 0.7rem; border: 1px solid var(--color-accent-ember); background: linear-gradient(135deg, var(--color-accent-ember), var(--color-accent-gold)); box-shadow: var(--shadow-glow-ember); transform: rotate(45deg); }
  .studio-nav__disposition { margin: 0; color: var(--color-text-secondary); font: 0.6875rem/1.3 var(--font-mono); letter-spacing: 0.05em; text-transform: uppercase; }
  .studio-nav__menu-button { display: none; min-height: 2.25rem; padding: 0 0.75rem; border: 1px solid var(--color-surface-rule); background: transparent; color: var(--color-text-display); font: 0.75rem var(--font-mono); cursor: pointer; }
  .studio-nav__menu { border-top: 1px solid var(--color-surface-rule); }
  .studio-nav__menu ol { display: grid; grid-template-columns: repeat(9, minmax(0, 1fr)); width: min(100% - 3rem, 90rem); margin: auto; padding: 0; list-style: none; }
  .studio-nav__menu li { min-width: 0; border-right: 1px solid var(--color-surface-rule); }
  .studio-nav__menu li:first-child { border-left: 1px solid var(--color-surface-rule); }
  .studio-nav__menu a { display: grid; gap: 0.25rem; min-height: 3.75rem; padding: 0.7rem 0.75rem; color: var(--color-text-secondary); text-decoration: none; transition: background var(--motion-duration-fast), color var(--motion-duration-fast); }
  .studio-nav__menu a:hover { background: rgba(31, 182, 168, 0.1); color: var(--color-text-display); }
  .studio-nav__menu a[aria-current="page"] { background: rgba(232, 91, 78, 0.1); color: var(--color-text-display); }
  .studio-nav__menu a span { color: var(--color-accent-ember); font: 0.625rem/1 var(--font-mono); }
  .studio-nav__menu a strong { overflow: hidden; font: 500 0.8125rem/1.15 var(--font-body); text-overflow: ellipsis; white-space: nowrap; }

  .studio { background: var(--color-surface-primary); color: var(--color-text-primary); overflow: hidden; }
  .studio-shell { width: min(100% - 3rem, 76rem); margin-inline: auto; position: relative; z-index: 1; }
  .studio-kicker { margin: 0 0 0.75rem; color: var(--color-accent-gold); font: 500 0.75rem/1.25 var(--font-mono); letter-spacing: 0.14em; text-transform: uppercase; }

  .studio-hero { position: relative; min-height: min(46rem, 88vh); display: grid; align-items: center; padding: 7rem 0 5rem; border-bottom: 1px solid var(--color-surface-rule); }
  .studio-hero__content { max-width: 66rem; }
  .studio-hero h1 { max-width: 15ch; margin: 0; color: var(--color-text-display); font: 700 clamp(3rem, 7vw, 6.5rem)/0.96 var(--font-display); letter-spacing: -0.055em; }
  .studio-hero__lede { max-width: 46rem; margin: 1.5rem 0 0; color: var(--color-text-secondary); font-size: clamp(1.125rem, 2vw, 1.35rem); line-height: 1.55; }
  .studio-hero__toggle { margin-top: 2.25rem; }
  .studio-hero__hint { margin: 0.5rem 0 0; color: var(--color-text-secondary); font: 0.8125rem/1.45 var(--font-mono); }

  .studio-section { position: relative; padding: clamp(4rem, 8vw, 7rem) 0; border-bottom: 1px solid var(--color-surface-rule); }
  .studio-section--orientation { background: var(--color-surface-recessed); }
  .studio-section--map { overflow: hidden; }
  .studio-section__content { position: relative; z-index: 1; }
  .studio-section__intro { max-width: 38rem; }
  .studio-section__intro--wide { max-width: 44rem; }
  .studio-section__intro h2, .studio-return h2 { margin: 0; color: var(--color-text-display); font: 700 clamp(2rem, 4vw, 3.5rem)/1.02 var(--font-display); letter-spacing: -0.035em; }
  .studio-section__intro > p:last-child { margin: 1rem 0 0; color: var(--color-text-secondary); font-size: 1.05rem; line-height: 1.6; }

  .studio-orientation { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(20rem, 1.15fr); align-items: end; gap: clamp(2rem, 7vw, 7rem); }
  .studio-orientation__panel { padding: clamp(1.5rem, 3vw, 2.25rem); border: 1px solid var(--color-surface-rule); border-left: 3px solid var(--color-accent-violet); background: var(--color-surface-raised); box-shadow: var(--shadow-sm); }
  .studio-orientation__panel[data-view="hearth"] { border-left-color: var(--color-accent-ember); }
  .studio-orientation__panel[data-view="code"] { border-left-color: var(--color-accent-signal); }
  .studio-orientation__panel p { margin: 0; color: var(--color-text-primary); font-size: 1.0625rem; line-height: 1.6; }
  .studio-orientation__routes { display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; margin-top: 1.5rem; }
  .studio-orientation__routes a, .studio-signal a { color: var(--color-accent-signal); font: 0.8125rem/1.3 var(--font-mono); text-decoration: none; }
  .studio-orientation__routes a:hover, .studio-signal a:hover { color: var(--color-text-display); }

  .studio-paths { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; margin-top: 2.25rem; border: 1px solid var(--color-surface-rule); background: var(--color-surface-rule); }
  .studio-path { display: grid; grid-template-columns: auto 1fr auto; gap: 1rem; min-height: 13.5rem; padding: 1.5rem; background: var(--color-surface-raised); color: inherit; text-decoration: none; transition: background 160ms ease, transform 160ms ease; }
  .studio-path:hover { background: var(--color-surface-elevated); transform: translateY(-3px); }
  .studio-path__number { color: var(--color-accent-gold); font: 0.75rem/1 var(--font-mono); }
  .studio-path__body { display: flex; flex-direction: column; }
  .studio-path__title { color: var(--color-text-display); font: 700 1.45rem/1.1 var(--font-display); }
  .studio-path__description { margin-top: 0.75rem; color: var(--color-text-secondary); line-height: 1.55; }
  .studio-path__arrow { align-self: end; color: var(--color-accent-signal); font-size: 1.5rem; }

  .studio-map { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; margin-top: 2.25rem; }
  .studio-map__item :global(.ec-nav-card) { min-height: 10rem; height: 100%; box-sizing: border-box; }
  .studio-map__item.is-synthesis :global(.ec-nav-card) { border-left-color: var(--color-accent-violet); background: linear-gradient(145deg, rgba(155, 93, 229, 0.12), var(--color-surface-raised)); }
  .studio[data-studio-view="hearth"] .studio-map__item:not([data-projections~="hearth"]),
  .studio[data-studio-view="code"] .studio-map__item:not([data-projections~="code"]) { display: none; }

  .studio-signals { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 2.25rem; }
  .studio-signal { display: flex; flex-direction: column; padding: 1.5rem; border: 1px solid var(--color-surface-rule); background: var(--color-surface-raised); }
  .studio-signal__eyebrow { margin: 0; color: var(--color-accent-signal); font: 0.6875rem/1.25 var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; }
  .studio-signal h3 { margin: 1rem 0 0; color: var(--color-text-display); font: 700 1.5rem/1.1 var(--font-display); }
  .studio-signal > p:not(.studio-signal__eyebrow) { flex: 1; margin: 0.75rem 0 1.5rem; color: var(--color-text-secondary); line-height: 1.55; }

  .studio-section--return { background: linear-gradient(120deg, rgba(53, 34, 93, 0.22), var(--color-surface-primary) 55%, rgba(31, 182, 168, 0.1)); }
  .studio-return { max-width: 52rem; text-align: center; }
  .studio-return > p:not(.studio-kicker) { margin: 1.25rem auto 0; max-width: 42rem; color: var(--color-text-secondary); font-size: 1.0625rem; line-height: 1.65; }
  .studio-return__actions { display: flex; justify-content: center; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .studio-action { display: inline-flex; align-items: center; justify-content: center; min-height: 2.75rem; padding: 0 1rem; border: 1px solid var(--color-surface-rule); color: var(--color-text-display); font: 500 0.875rem/1 var(--font-body); text-decoration: none; transition: 160ms ease; }
  .studio-action:hover { border-color: var(--color-accent-signal); color: var(--color-accent-signal); }
  .studio-action--primary { border-color: var(--color-accent-signal); background: var(--color-accent-signal); color: var(--color-surface-primary); }
  .studio-action--primary:hover { background: var(--color-accent-plasma); color: var(--color-surface-primary); }

  @media (max-width: 56rem) {
    .studio-nav__brand-row { width: min(100% - 2rem, 90rem); grid-template-columns: 1fr auto; min-height: 3.75rem; }
    .studio-nav__disposition { display: none; }
    .studio-nav__menu-button { display: inline-flex; align-items: center; gap: 0.5rem; justify-content: space-between; }
    .studio-nav__menu { display: none; }
    .studio-nav[data-menu-open="true"] .studio-nav__menu { display: block; }
    .studio-nav__menu ol { grid-template-columns: repeat(2, minmax(0, 1fr)); width: 100%; }
    .studio-nav__menu li:nth-child(odd) { border-left: 1px solid var(--color-surface-rule); }
    .studio-nav__menu a { min-height: 3.25rem; }
    .studio-hero { min-height: auto; padding: 6rem 0 4rem; }
    .studio-orientation { grid-template-columns: 1fr; }
    .studio-paths, .studio-signals { grid-template-columns: 1fr; }
    .studio-map { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .studio[data-studio-view="hearth"] .studio-map,
    .studio[data-studio-view="code"] .studio-map { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .studio-path { min-height: auto; }
  }
  @media (max-width: 36rem) {
    .studio-shell { width: min(100% - 2rem, 76rem); }
    .studio-hero h1 { font-size: clamp(2.7rem, 15vw, 4rem); }
    .studio-map { grid-template-columns: 1fr; }
    .studio-hero__hint { max-width: 28ch; }
  }
</style>

<script>
  type ProjectionRoute = { href: string; label: string };
  type ProjectionCopy = {
    hero: string; eyebrow: string; title: string; detail: string;
    mapTitle: string; mapDetail: string; routes: ProjectionRoute[];
  };
  const viewCopy: Record<string, ProjectionCopy> = {
    hearth: {
      hero: 'A public workbench for questions of meaning, judgment, and how to stay human in complex systems.',
      eyebrow: 'Hearth projection',
      title: 'Meaning and judgment first.',
      detail: 'This projection foregrounds the working perspective: the questions, values, and public reasoning behind the systems. Begin with the position, understand the working profile, or return with a question or correction.',
      mapTitle: 'Hearth surfaces.',
      mapDetail: 'Philosophy, Dossier, and Contact: the perspective, the person behind the practice, and a clear path back.',
      routes: [
        { href: '/philosophy/', label: 'Read the philosophy' },
        { href: '/dossier/', label: 'Open the dossier' },
        { href: '/correspondence/', label: 'Start a correspondence' },
      ],
    },
    balanced: {
      hero: 'Research, software, knowledge architecture, and policy thinking made legible enough to inspect, question, use, and revise.',
      eyebrow: 'Current projection',
      title: 'The full studio, in one view.',
      detail: 'Hearth holds the questions of meaning and judgment. Code holds the methods and systems. The balanced view keeps both visible, so a visitor can move from a claim to its working form.',
      mapTitle: 'The full studio map.',
      mapDetail: 'All eight surfaces are available here; Portfolio is the synthesis route across the Hearth and Code seams.',
      routes: [
        { href: '/portfolio/', label: 'View the portfolio' },
        { href: '/dossier/', label: 'Read the dossier' },
        { href: '/research/', label: 'Inspect the research' },
      ],
    },
    code: {
      hero: 'A public workbench for methods, systems, and research that keeps its sources, limits, and human decision points visible.',
      eyebrow: 'Code projection',
      title: 'Methods and systems first.',
      detail: 'This projection foregrounds practical instruments, architectures, and technical research. Begin with a method, inspect the active research, or read the public working record.',
      mapTitle: 'Code surfaces.',
      mapDetail: 'Methods, Research, Questions, and Field Journal: practical instruments, active inquiry, and the public working record.',
      routes: [
        { href: '/methods/', label: 'Open the methods' },
        { href: '/research/', label: 'Inspect the research' },
        { href: '/journal/', label: 'Read the Field Journal' },
      ],
    },
  };

  function applyStudioProjection(view: string) {
    const copy = viewCopy[view] || viewCopy.balanced;
    const hero = document.getElementById('studio-hero-lede');
    const eyebrow = document.getElementById('view-panel-eyebrow');
    const title = document.getElementById('view-panel-title');
    const detail = document.getElementById('view-panel-disposition');
    const panel = document.getElementById('view-panel');
    const studio = document.querySelector<HTMLElement>('[data-studio-root]');
    const mapTitle = document.getElementById('nav-title');
    const mapDetail = document.getElementById('nav-disposition');
    if (hero) hero.textContent = copy.hero;
    if (eyebrow) eyebrow.textContent = copy.eyebrow;
    if (title) title.textContent = copy.title;
    if (detail) detail.textContent = copy.detail;
    if (panel) panel.setAttribute('data-view', view);
    if (studio) studio.setAttribute('data-studio-view', view);
    if (mapTitle) mapTitle.textContent = copy.mapTitle;
    if (mapDetail) mapDetail.textContent = copy.mapDetail;
    copy.routes.forEach((route, index) => {
      const link = document.getElementById(`orientation-route-${index + 1}`) as HTMLAnchorElement | null;
      if (!link) return;
      link.href = route.href;
      link.innerHTML = `${route.label} <span aria-hidden="true">↗</span>`;
    });
  }

  window.addEventListener('hearth-code-view-change', ((event: CustomEvent<{ view: string }>) => {
    applyStudioProjection(event.detail.view);
  }) as EventListener);

  try {
    const view = new URL(window.location.href).searchParams.get('view') || localStorage.getItem('hearth-code-view') || 'balanced';
    applyStudioProjection(view);
  } catch {
    applyStudioProjection('balanced');
  }

  const menuRoot = document.querySelector<HTMLElement>('[data-studio-menu-root]');
  const menuButton = document.querySelector<HTMLButtonElement>('[data-studio-menu-button]');
  const menu = document.querySelector<HTMLElement>('[data-studio-menu]');
  menuButton?.addEventListener('click', () => {
    const open = menuRoot?.getAttribute('data-menu-open') === 'true';
    menuRoot?.setAttribute('data-menu-open', String(!open));
    menuButton.setAttribute('aria-expanded', String(!open));
  });
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
    menuRoot?.setAttribute('data-menu-open', 'false');
    menuButton?.setAttribute('aria-expanded', 'false');
  }));
</script>
