---
import '../styles/research-studio-landing.css';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/reading-articles.css';
import '../styles/studio-room-surfaces.css';
import '../styles/ember-circuit-library.css';
import StudioNavigation from './StudioNavigation.astro';
import type { HearthsideArticle } from '../content/hearthside-articles';
interface Props { article: HearthsideArticle; }
const { article } = Astro.props;
---
<!doctype html>
<html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={article.dek}/><meta name="theme-color" content="#0e1114"/><title>{article.title} · Hearth &amp; Code</title></head>
<body class="studio-room-body studio-room-body--notes studio-article-body"><StudioNavigation current="journal" disposition="Field Journal / local article review"/>
<main id="page-main" class="reading-article"><header class="reading-article__hero"><p class="research-eyebrow">{article.code} / {article.format ?? 'Hearthside essay'} / local review projection</p><h1>{article.title}</h1><p>{article.dek}</p><div><span>{article.readTime}</span>{article.themes.map(theme => <span>{theme}</span>)}</div></header>
<section class="studio-article-reading-field"><aside class="reading-article__boundary"><strong>Review boundary</strong><p>This is a local Research Library projection. Added sections, including “An expert practice for agentic work,” are editorial proposals awaiting author review; they do not revise or republish the originating article. Treat technical guidance as a candidate until its sources, fixtures, and checks are independently reviewed.</p></aside>
<details class="reading-article__contents"><summary>Navigate this article · {article.sections.length} sections</summary><nav aria-label="Article sections"><ol>{article.sections.map((section, index) => <li><a href={`#reading-section-${index + 1}`}>{section.heading}</a></li>)}</ol></nav></details>
<article id="article-content" class="reading-article__body">{article.sections.map((section, index) => <section id={`reading-section-${index + 1}`}><h2>{section.heading}</h2>{section.paragraphs.map(paragraph => <p>{paragraph}</p>)}</section>)}</article>
<footer class="reading-article__footer"><a href="/library/">← Back to the Research Library</a></footer></section></main></body></html>
