---
/**
 * HearthCodeToggle.astro
 *
 * Three-segment toggle: Hearth | Both | Code
 * Transforms the entire page palette, density, and content emphasis.
 *
 * Persists via URL ?view= and localStorage 'hearth-code-view'.
 */

interface Props {
  current?: 'hearth' | 'code' | 'balanced';
}

const { current = 'balanced' } = Astro.props;

const segments = [
  { id: 'hearth',   label: 'Hearth',   description: 'Personal \u00b7 philosophical' },
  { id: 'balanced', label: 'Both',     description: 'Full spectrum' },
  { id: 'code',     label: 'Code',     description: 'Technical \u00b7 methods' },
] as const;
---

<div class="hearth-code-toggle" data-toggle-root data-current={current}>
  <span class="hearth-code-toggle__label">View as</span>
  <div class="hearth-code-toggle__container" role="tablist" aria-label="Hearth-Code orientation">
    {segments.map((segment) => (
      <button
        type="button"
        role="tab"
        class:list={[
          'hearth-code-toggle__segment',
          { 'is-active': segment.id === current },
        ]}
        data-segment={segment.id}
        aria-selected={segment.id === current ? 'true' : 'false'}
      >
        <span class="hearth-code-toggle__segment-label">{segment.label}</span>
        <span class="hearth-code-toggle__segment-desc">{segment.description}</span>
      </button>
    ))}
  </div>
</div>

<style>
  .hearth-code-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-md, 0.75rem);
    padding: var(--spacing-sm, 0.5rem) 0;
  }

  .hearth-code-toggle__label {
    color: var(--text_secondary, #cfc1ab);
    font-size: var(--font-size-caption, 0.8125rem);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .hearth-code-toggle__container {
    display: inline-flex;
    background: var(--surface-primary, #161411);
    border: 1px solid var(--color-surface-rule, #4b4237);
    border-radius: 9999px;
    padding: 4px;
    gap: 2px;
  }

  .hearth-code-toggle__segment {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.125rem;
    padding: 0.5rem 1rem;
    background: transparent;
    border: none;
    border-radius: 9999px;
    color: var(--text-secondary, #b89e7e);
    cursor: pointer;
    transition: all 250ms cubic-bezier(0.2, 0, 0, 1);
    font-family: inherit;
  }

  .hearth-code-toggle__segment:hover {
    color: var(--text-primary, #f1e7d2);
  }

  .hearth-code-toggle__segment.is-active {
    background: var(--surface-raised, #211d18);
    color: var(--text-display, #f1e7d2);
    font-weight: 600;
  }

  /* Active accent by orientation */
  [data-toggle-root][data-current="hearth"] .hearth-code-toggle__segment[data-segment="hearth"] {
    box-shadow: inset 0 0 0 1px var(--color-accent-ember, #E85B4E), 0 0 12px rgba(232, 91, 78, 0.35);
  }
  [data-toggle-root][data-current="code"] .hearth-code-toggle__segment[data-segment="code"] {
    box-shadow: inset 0 0 0 1px var(--color-accent-signal, #1FB6A8), 0 0 12px rgba(31, 182, 168, 0.35);
  }
  [data-toggle-root][data-current="balanced"] .hearth-code-toggle__segment[data-segment="balanced"] {
    box-shadow: inset 0 0 0 1px transparent, 0 0 8px rgba(155, 93, 229, 0.25);
  }

  .hearth-code-toggle__segment-label {
    font-size: 0.875rem;
    font-weight: 500;
  }

  .hearth-code-toggle__segment-desc {
    font-size: 0.6875rem;
    color: var(--text-secondary, #b89e7e);
    font-weight: 400;
  }

  .hearth-code-toggle__segment.is-active .hearth-code-toggle__segment-desc {
    color: var(--text-secondary, #cfc1ab);
  }
</style>

<script>
  // ============================================================
  // HearthCodeToggle - Click handlers only
  // View state management is handled by the parent page
  // ============================================================

  function initToggle() {
    const toggles = document.querySelectorAll<HTMLElement>('[data-toggle-root]');
    toggles.forEach((toggleRoot) => {
      const segments = toggleRoot.querySelectorAll<HTMLElement>('[data-segment]');
      segments.forEach((segment) => {
        if (segment.dataset.bound === 'true') return; // Prevent duplicate binding
        segment.dataset.bound = 'true';
        segment.addEventListener('click', () => {
          const view = segment.getAttribute('data-segment');
          if (!view) return;

          // Persist to URL
          try {
            const url = new URL(window.location.href);
            url.searchParams.set('view', view);
            window.history.pushState({}, '', url);
          } catch (e) {}

          // Persist to localStorage
          try {
            localStorage.setItem('hearth-code-view', view);
          } catch (e) {}

          // Update this toggle's visual state
          toggleRoot.setAttribute('data-current', view);
          segments.forEach((seg) => {
            const segValue = seg.getAttribute('data-segment');
            if (segValue === view) {
              seg.setAttribute('aria-selected', 'true');
              seg.classList.add('is-active');
            } else {
              seg.setAttribute('aria-selected', 'false');
              seg.classList.remove('is-active');
            }
          });

          // Update other toggles on page
          document.querySelectorAll('[data-toggle-root]').forEach((otherToggle) => {
            if (otherToggle !== toggleRoot) {
              otherToggle.setAttribute('data-current', view);
            }
          });

          // =====================================================
          // APPLY VIEW CHANGES DIRECTLY (inlined since
          // Astro hoists scripts and page script was missing)
          // =====================================================
          applyViewToPage(view);

          // Trigger custom event for any other listeners
          window.dispatchEvent(new CustomEvent('hearth-code-view-change', { detail: { view } }));
        });
      });
    });
  }

  /**
   * Apply view changes to page content.
   * Handles all DOM updates that should happen when view changes.
   */
  function applyViewToPage(view: string): void {
    // Update root data attribute for CSS styling
    document.documentElement.setAttribute('data-hc-view', view);

    // Update navigation cards data-view
    document.querySelectorAll('.ec-nav-card').forEach((card) => {
      card.setAttribute('data-view', view);
    });

    // Update navigation section title and disposition
    const navTitle = document.getElementById('nav-title');
    const navDisposition = document.getElementById('nav-disposition');
    const viewContent: Record<string, { title: string; description: string }> = {
      hearth: {
        title: 'Explore by purpose',
        description: 'Each surface maps to a question about meaning, agency, or how to live and work well in the age of AI.',
      },
      code: {
        title: 'Explore by domain',
        description: 'Each surface contains technical depth: methods, architectures, code, and research with sources.',
      },
      balanced: {
        title: 'Eight layers of work.',
        description: 'Each surface offers both the philosophical context and the technical artifacts to act on it.',
      },
    };
    if (navTitle && viewContent[view]) navTitle.textContent = viewContent[view].title;
    if (navDisposition && viewContent[view]) navDisposition.textContent = viewContent[view].description;

    // Update view disposition panel
    const viewPanel = document.getElementById('view-panel');
    const viewPanelEyebrow = document.getElementById('view-panel-eyebrow');
    const viewPanelTitle = document.getElementById('view-panel-title');
    const viewPanelDisposition = document.getElementById('view-panel-disposition');
    const viewPanelData: Record<string, { eyebrow: string; title: string; disposition: string }> = {
      hearth: {
        eyebrow: 'Hearth view',
        title: 'Dossier & Philosophy first',
        disposition: 'Hearth emphasizes the personal side: the working archetype and the positions. Methods and research are present but secondary. Start with who I am, then what I think.',
      },
      code: {
        eyebrow: 'Code view',
        title: 'Methods & Research first',
        disposition: 'Code emphasizes the technical side: field cards, prompt techniques, system architectures, and implementation depth. Dossier and philosophy are present but secondary. Start with how to build, then who built it.',
      },
      balanced: {
        eyebrow: 'Current view',
        title: 'Full spectrum',
        disposition: 'Each surface offers both the philosophical context and the technical artifacts to act on it.',
      },
    };
    if (viewPanel) viewPanel.setAttribute('data-view', view);
    if (viewPanelEyebrow && viewPanelData[view]) viewPanelEyebrow.textContent = viewPanelData[view].eyebrow;
    if (viewPanelTitle && viewPanelData[view]) viewPanelTitle.textContent = viewPanelData[view].title;
    if (viewPanelDisposition && viewPanelData[view]) viewPanelDisposition.textContent = viewPanelData[view].disposition;

    // Update path section title
    const pathIntro = document.querySelector('.ec-presentation--start .ec-presentation__title');
    const viewPathIntro: Record<string, string> = {
      hearth: 'Three paths, for how you want to explore.',
      code: 'Three paths, organized by depth of engagement.',
      balanced: 'Three paths, depending on you.',
    };
    if (pathIntro && viewPathIntro[view]) pathIntro.textContent = viewPathIntro[view];

    // Update hero lede
    const heroLede = document.querySelector('.ec-hero__lede');
    const viewHeroLede: Record<string, string> = {
      hearth: 'Hearth & Code is my public workbench — a place to share how I think, what I value, and the wisdom I\'ve gathered. I document because memory fails and writing helps me think.',
      code: 'Hearth & Code is my public workbench for research, software, knowledge architecture, and policy thinking. I build because complex systems deserve careful design.',
      balanced: 'Hearth & Code is my public workbench for research, software, knowledge architecture, and policy thinking. The goal isn\'t to show everything I\'ve done. It\'s to make the work legible enough that you can question it, use it, or build on it.',
    };
    if (heroLede && viewHeroLede[view]) heroLede.textContent = viewHeroLede[view];
  }

  // Listen for popstate (browser back/forward)
  window.addEventListener('popstate', () => {
    try {
      const url = new URL(window.location.href);
      const view = url.searchParams.get('view') || localStorage.getItem('hearth-code-view') || 'balanced';
      if (['hearth', 'code', 'balanced'].includes(view)) {
        applyViewToPage(view);
      }
    } catch (e) {}
  });

  // Initialize from URL or localStorage on load
  try {
    const url = new URL(window.location.href);
    const urlView = url.searchParams.get('view');
    const storedView = localStorage.getItem('hearth-code-view');
    const view = urlView || storedView || 'balanced';
    if (['hearth', 'code', 'balanced'].includes(view)) {
      applyViewToPage(view);
    }
  } catch (e) {}

  // Run on DOMContentLoaded
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initToggle);
  } else {
    initToggle();
  }
</script>
