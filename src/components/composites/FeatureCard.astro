---
/**
 * Feature Card composite
 * id: c-card-feature
 *
 * Highlighted card for showcasing features with icon, title, description, link.
 */

import Icon from '../primitives/Icon.astro';

interface Props {
  icon?: string;
  title: string;
  description: string;
  href?: string;
  accent?: 'hearth' | 'code' | 'balanced' | 'ember' | 'signal' | 'plasma' | 'violet';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const {
  icon = 'check',
  title,
  description,
  href,
  accent = 'balanced',
  size = 'md',
  class: className = '',
} = Astro.props;
---

<article class={`ec-feature-card ec-feature-card--${accent} ec-feature-card--${size} ${className}`}>
  {icon && (
    <div class="ec-feature-card__icon" aria-hidden="true">
      <Icon name={icon} size={size === 'lg' ? 'lg' : 'md'} />
    </div>
  )}
  <div class="ec-feature-card__content">
    <h3 class="ec-feature-card__title">{title}</h3>
    <p class="ec-feature-card__description">{description}</p>
    {href && (
      <a class="ec-feature-card__link" href={href}>
        Learn more <Icon name="arrow-right" size="sm" />
      </a>
    )}
  </div>
</article>

<style>
  .ec-feature-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    background: var(--color-surface-raised);
    border: 1px solid var(--color-surface-rule);
    border-radius: var(--radius-md);
    transition: border-color var(--motion-duration-fast) var(--motion-easing-default);
  }
  .ec-feature-card:hover {
    border-color: var(--color-surface-rule-strong);
  }
  .ec-feature-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-md);
    background: var(--color-surface-recessed);
    color: var(--color-text-secondary);
    flex-shrink: 0;
  }
  .ec-feature-card--hearth .ec-feature-card__icon {
    background: rgba(232, 91, 78, 0.1);
    color: var(--color-accent-ember);
  }
  .ec-feature-card--code .ec-feature-card__icon {
    background: rgba(31, 182, 168, 0.1);
    color: var(--color-accent-signal);
  }
  .ec-feature-card--balanced .ec-feature-card__icon,
  .ec-feature-card--violet .ec-feature-card__icon {
    background: rgba(155, 93, 229, 0.1);
    color: var(--color-accent-violet);
  }
  .ec-feature-card--plasma .ec-feature-card__icon {
    background: rgba(63, 224, 208, 0.1);
    color: var(--color-accent-plasma);
  }
  .ec-feature-card--ember .ec-feature-card__icon {
    background: rgba(232, 91, 78, 0.15);
    color: var(--color-accent-ember);
  }
  .ec-feature-card__title {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: var(--font-weight-medium);
    line-height: 1.3;
    margin: 0;
    color: var(--color-text-display);
  }
  .ec-feature-card--lg .ec-feature-card__title {
    font-size: 1.375rem;
  }
  .ec-feature-card__description {
    margin: 0;
    font-size: var(--font-size-body);
    line-height: 1.6;
    color: var(--color-text-secondary);
  }
  .ec-feature-card__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--font-size-small);
    font-weight: var(--font-weight-medium);
    color: var(--color-accent-ember);
    text-decoration: none;
    transition: gap var(--motion-duration-fast) var(--motion-easing-default);
  }
  .ec-feature-card__link:hover {
    gap: var(--space-2);
  }
</style>
