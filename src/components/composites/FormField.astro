---
/**
 * Form Field composite
 * id: c-form-field
 *
 * Label + input + helper text + error message wrapper.
 */

interface Props {
  label: string;
  helper?: string;
  error?: string;
  required?: boolean;
  htmlFor: string;
  class?: string;
}

const { label, helper, error, required = false, htmlFor, class: className = '' } = Astro.props;
---

<div class={`ec-form-field ${error ? 'has-error' : ''} ${className}`}>
  <label class="ec-form-field__label" for={htmlFor}>
    <span>{label}</span>
    {required && <span class="ec-form-field__required" aria-label="required">*</span>}
  </label>
  <slot />
  {helper && !error && (
    <p class="ec-form-field__helper" id={`${htmlFor}-help`}>{helper}</p>
  )}
  {error && (
    <p class="ec-form-field__error" id={`${htmlFor}-error`} role="alert">{error}</p>
  )}
</div>

<style>
  .ec-form-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .ec-form-field__label {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    font-family: var(--font-body);
    font-size: var(--font-size-small);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-primary);
  }
  .ec-form-field__required {
    color: var(--color-state-error);
  }
  .ec-form-field__helper {
    margin: 0;
    font-size: 0.75rem;
    color: var(--color-text-secondary);
  }
  .ec-form-field__error {
    margin: 0;
    font-size: 0.75rem;
    color: var(--color-state-error);
  }
</style>
