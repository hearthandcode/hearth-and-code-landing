---
/**
 * Profile Card composite
 * id: c-card-profile
 *
 * Card for displaying person/entity info with avatar.
 */

import Avatar from '../primitives/Avatar.astro';

interface Props {
  name: string;
  title?: string;
  bio?: string;
  avatarSrc?: string;
  href?: string;
  class?: string;
}

const {
  name,
  title,
  bio,
  avatarSrc,
  href,
  class: className = '',
} = Astro.props;

const Tag = href ? 'a' : 'div';
const tagProps = href ? { href } : {};
---

<Tag class={`ec-profile-card ${className}`} {...tagProps}>
  <Avatar
    src={avatarSrc}
    name={name}
    size="lg"
    variant={avatarSrc ? 'image' : 'initials'}
    alt={name}
  />
  <div class="ec-profile-card__content">
    <h3 class="ec-profile-card__name">{name}</h3>
    {title && <p class="ec-profile-card__title">{title}</p>}
    {bio && <p class="ec-profile-card__bio">{bio}</p>}
  </div>
</Tag>

<style>
  .ec-profile-card {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    padding: var(--space-5);
    background: var(--color-surface-raised);
    border: 1px solid var(--color-surface-rule);
    border-radius: var(--radius-md);
    color: var(--color-text-primary);
    text-decoration: none;
    transition: border-color var(--motion-duration-fast) var(--motion-easing-default);
  }
  a.ec-profile-card:hover {
    border-color: var(--color-surface-rule-strong);
  }
  .ec-profile-card__content {
    flex: 1;
    min-width: 0;
  }
  .ec-profile-card__name {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: var(--font-weight-medium);
    line-height: 1.3;
    margin: 0 0 0.125rem 0;
    color: var(--color-text-display);
  }
  .ec-profile-card__title {
    margin: 0;
    font-size: var(--font-size-small);
    color: var(--color-text-secondary);
  }
  .ec-profile-card__bio {
    margin: var(--space-2) 0 0 0;
    font-size: var(--font-size-small);
    line-height: 1.5;
    color: var(--color-text-secondary);
  }
</style>
