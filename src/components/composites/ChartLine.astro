---
/**
 * ChartLine - D3 line chart (re-export of new charts/LineChart)
 * Knowledge composite (k-composite): k-chart-line
 *
 * Now uses D3 for proper axis, scaling, and interpolation.
 */
import LineChart from '../knowledge/charts/LineChart.astro';
interface Point { x: number | string; y: number; }
interface Series { name: string; data: Point[]; color?: string; }
interface Props {
  series: Series[];
  height?: string;
  class?: string;
}
const { series, height = '10rem', class: className = '' } = Astro.props;
// Extract numeric height if it's a rem string
const numericHeight = height.endsWith('rem') ? parseFloat(height) * 16 : 240;
---
<LineChart series={series} height={numericHeight} class={className} />
