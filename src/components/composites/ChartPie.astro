---
/**
 * ChartPie - D3 pie chart (re-export of new charts/PieChart)
 * Knowledge composite (k-composite): k-chart-pie
 *
 * Now uses D3 for proper arc rendering and label placement.
 */
import PieChart from '../knowledge/charts/PieChart.astro';
interface Datum { label: string; value: number; color?: string; }
interface Props {
  data: Datum[];
  donut?: boolean;
  class?: string;
}
const { data, donut = false, class: className = '' } = Astro.props;
---
{donut ? (
  <PieChart data={data} class={className} />
) : (
  <PieChart data={data} class={className} />
)}
