---
/**
 * Progress composite
 * id: c-progress
 *
 * Linear or circular progress indicator.
 */

interface Props {
  value: number;
  max?: number;
  variant?: 'linear' | 'circular';
  showLabel?: boolean;
  label?: string;
  size?: 'sm' | 'md' | 'lg';
  accent?: 'ember' | 'signal' | 'violet' | 'success' | 'caution' | 'danger';
  class?: string;
}

const {
  value,
  max = 100,
  variant = 'linear',
  showLabel = false,
  label,
  size = 'md',
  accent = 'ember',
  class: className = '',
} = Astro.props;

const percent = Math.min(100, Math.max(0, (value / max) * 100));
const sizes = { sm: 'sm' as const, md: 'md' as const, lg: 'lg' as const };
---

<div class={`ec-progress ec-progress--${variant} ec-progress--${accent} ${className}`}>
  {variant === 'linear' && (
    <div class="ec-progress__track" role="progressbar" aria-valuenow={value} aria-valuemin="0" aria-valuemax={max} aria-label={label}>
      <div class="ec-progress__bar" style={`width: ${percent}%`}></div>
    </div>
  )}
  {variant === 'circular' && (
    <svg
      class={`ec-progress__circle ec-progress__circle--${size}`}
      viewBox="0 0 36 36"
      role="progressbar"
      aria-valuenow={value}
      aria-valuemin="0"
      aria-valuemax={max}
      aria-label={label}
    >
      <circle
        class="ec-progress__track-circle"
        cx="18"
        cy="18"
        r="15.9155"
        fill="none"
        stroke-width="2.5"
      />
      <circle
        class="ec-progress__bar-circle"
        cx="18"
        cy="18"
        r="15.9155"
        fill="none"
        stroke-width="2.5"
        stroke-dasharray={`${percent} 100`}
        stroke-linecap="round"
      />
    </svg>
  )}
  {showLabel && (
    <div class="ec-progress__label">
      {label || `${Math.round(percent)}%`}
    </div>
  )}
</div>

<style>
  .ec-progress__track {
    width: 100%;
    height: 0.5rem;
    background: var(--color-surface-recessed);
    border-radius: 9999px;
    overflow: hidden;
  }
  .ec-progress__bar {
    height: 100%;
    background: var(--color-accent-ember);
    border-radius: 9999px;
    transition: width var(--motion-duration-normal) var(--motion-easing-default);
  }
  .ec-progress--signal .ec-progress__bar { background: var(--color-accent-signal); }
  .ec-progress--violet .ec-progress__bar { background: var(--color-accent-violet); }
  .ec-progress--success .ec-progress__bar { background: var(--color-state-success); }
  .ec-progress--caution .ec-progress__bar { background: var(--color-state-caution); }
  .ec-progress--danger .ec-progress__bar { background: var(--color-state-error); }
  .ec-progress__circle {
    transform: rotate(-90deg);
  }
  .ec-progress__circle--sm { width: 1.5rem; height: 1.5rem; }
  .ec-progress__circle--md { width: 2.5rem; height: 2.5rem; }
  .ec-progress__circle--lg { width: 4rem; height: 4rem; }
  .ec-progress__track-circle {
    stroke: var(--color-surface-recessed);
  }
  .ec-progress__bar-circle {
    stroke: var(--color-accent-ember);
    transition: stroke-dasharray var(--motion-duration-normal) var(--motion-easing-default);
  }
  .ec-progress--signal .ec-progress__bar-circle { stroke: var(--color-accent-signal); }
  .ec-progress--violet .ec-progress__bar-circle { stroke: var(--color-accent-violet); }
  .ec-progress--success .ec-progress__bar-circle { stroke: var(--color-state-success); }
  .ec-progress--caution .ec-progress__bar-circle { stroke: var(--color-state-caution); }
  .ec-progress--danger .ec-progress__bar-circle { stroke: var(--color-state-error); }
  .ec-progress__label {
    margin-top: var(--space-2);
    font-size: var(--font-size-small);
    color: var(--color-text-secondary);
    text-align: center;
  }
</style>
