---
/**
 * Decorative only. It gives the Orientation surface an Ember Circuit Archive
 * field without carrying navigation, status, or information that a visitor
 * must be able to access in another form.
 */
---

<figure class="ember-archive-visual" aria-hidden="true">
  <svg viewBox="0 0 1200 260" focusable="false">
    <defs>
      <radialGradient id="archive-aperture" cx="50%" cy="50%" r="50%">
        <stop offset="0" stop-color="#C67BEA" stop-opacity="0.7" />
        <stop offset="0.38" stop-color="#9B5DE5" stop-opacity="0.22" />
        <stop offset="1" stop-color="#15121B" stop-opacity="0" />
      </radialGradient>
      <linearGradient id="archive-copper" x1="0" x2="1">
        <stop stop-color="#E85B4E" />
        <stop offset="0.52" stop-color="#E8923C" />
        <stop offset="1" stop-color="#F4B860" />
      </linearGradient>
      <filter id="archive-glow" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="3" result="blur" />
        <feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge>
      </filter>
    </defs>

    <path class="archive-indexes" d="M24 39h176m-176 18h103m-103 146h176m-176-18h103M36 88h66m-66 15h110m-110 15h49" />
    <path class="archive-indexes archive-indexes--right" d="M1000 39h176m-103 18h103m-176 146h176m-103-18h103m-110-97h66m-110 15h110m-49 15h49" />

    <circle class="archive-field" cx="600" cy="130" r="123" />
    <g class="archive-gear">
      <circle cx="600" cy="130" r="98" />
      <circle cx="600" cy="130" r="78" />
      <path d="M600 16v22m0 184v22M486 130h22m184 0h22M519 49l16 16m146 130l16 16M519 211l16-16m146-130l16-16" />
    </g>
    <g class="archive-aperture">
      <path d="M600 54 653 92v76l-53 38-53-38V92Z" />
      <path d="M600 76 633 99v62l-33 23-33-23V99Z" />
      <circle cx="600" cy="130" r="18" />
    </g>
    <g class="archive-circuits" filter="url(#archive-glow)">
      <path d="M202 61h115l45 45h111l48 24" />
      <path d="M202 199h115l45-45h111l48-24" />
      <path d="M679 80h99l44-44h176" />
      <path d="M679 180h99l44 44h176" />
      <circle cx="202" cy="61" r="5" /><circle cx="202" cy="199" r="5" />
      <circle class="archive-live-node" cx="521" cy="130" r="6" />
      <circle class="archive-cyan-node" cx="998" cy="36" r="5" />
    </g>
  </svg>
</figure>
