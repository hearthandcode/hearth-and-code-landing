<script>
  // Preview card tab switching - shows props / variants / states panels
  document.querySelectorAll('.ec-preview-card__tab').forEach((tab) => {
    tab.addEventListener('click', () => {
      const target = tab.getAttribute('data-target');
      const tabName = tab.getAttribute('data-preview-tab');
      if (!target || !tabName) return;

      // Update tab states within this card
      const card = tab.closest('.ec-preview-card');
      if (!card) return;
      card.querySelectorAll('.ec-preview-card__tab').forEach((t) => {
        ((t as HTMLElement).classList.toggle('is-active', t === tab);
      });

      // Show the matching panel
      card.querySelectorAll(`.ec-preview-card__panel[data-target="${target}"]`).forEach((panel) => {
        (panel as HTMLElement).hidden = panel.getAttribute('data-preview-panel') !== tabName;
      });
    });
  });

  // Hero Hearth | Code title color animation
  document.querySelectorAll('.ec-circ-hero__title-ember, .ec-circ-hero__title-code').forEach((el) => {
    const color = window.getComputedStyle(el).color;
    el.style.setProperty('--accent-glow', color + '40');
  });
</script>

