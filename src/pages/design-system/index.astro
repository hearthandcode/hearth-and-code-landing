<style>
  /* === HERO === */
  .ds-hero {
    padding: var(--space-9) var(--space-5);
    background: var(--color-surface-primary);
    border-bottom: 1px solid var(--color-surface-rule);
    position: relative;
    overflow: hidden;
  }
  .ds-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 20% 30%, rgba(232, 91, 78, 0.08), transparent 50%),
      radial-gradient(circle at 80% 70%, rgba(31, 182, 168, 0.08), transparent 50%);
    pointer-events: none;
  }
  .ds-hero__inner {
    position: relative;
    z-index: 1;
    max-width: 64rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    text-align: center;
  }
  .ds-hero__eyebrow {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-text-secondary);
  }
  .ds-hero__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-text-display);
  }
  .ds-hero__hearth { color: var(--color-accent-ember); }
  .ds-hero__code { color: var(--color-accent-signal); }
  .ds-hero__bar {
    margin: 0 0.4em;
    color: var(--color-text-secondary);
    font-weight: 300;
  }
  .ds-hero__lede {
    margin: 0;
    max-width: 40rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }
  .ds-hero__counts {
    display: flex;
    gap: var(--space-4);
    margin-top: var(--space-3);
    flex-wrap: wrap;
    justify-content: center;
  }
  .ds-count {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--space-3) var(--space-5);
    background: var(--color-surface-raised);
    border: 1px solid var(--color-surface-rule);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: border-color 150ms ease;
    min-width: 6rem;
  }
  a.ds-count:hover {
    border-color: var(--color-accent-ember);
  }
  .ds-count--total {
    background: var(--color-accent-ember);
    border-color: var(--color-accent-ember);
  }
  .ds-count--total .ds-count__value,
  .ds-count--total .ds-count__label {
    color: var(--color-surface-primary);
  }
  .ds-count__value {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    line-height: 1;
    color: var(--color-text-display);
  }
  .ds-count__label {
    margin-top: 0.25rem;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-secondary);
  }

  /* === NAV === */
  .ds-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-surface-recessed);
    border-bottom: 1px solid var(--color-surface-rule);
  }
  .ds-nav__inner {
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 var(--space-5);
    display: flex;
    gap: var(--space-5);
  }
