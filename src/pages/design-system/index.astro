---
/**
 * Design System Showcase - Ember Circuit
 * Storybook-style component gallery with isolated previews.
 * Tabs: Atoms | Molecules | Organisms | Patterns | Showcase
 */

import Layout from '../../layouts/Layout.astro';
import Button from '../../components/primitives/Button.astro';
import Input from '../../components/primitives/Input.astro';
import Icon from '../../components/primitives/Icon.astro';
import Badge from '../../components/primitives/Badge.astro';
import Tag from '../../components/primitives/Tag.astro';
import Divider from '../../components/primitives/Divider.astro';
import Label from '../../components/primitives/Label.astro';
import Tooltip from '../../components/primitives/Tooltip.astro';
import Avatar from '../../components/primitives/Avatar.astro';
import Checkbox from '../../components/primitives/Checkbox.astro';
import Radio from '../../components/primitives/Radio.astro';
import Spinner from '../../components/primitives/Spinner.astro';
import Skeleton from '../../components/primitives/Skeleton.astro';
import Card from '../../components/composites/Card.astro';
import FeatureCard from '../../components/composites/FeatureCard.astro';
import StatCard from '../../components/composites/StatCard.astro';
import ProfileCard from '../../components/composites/ProfileCard.astro';
import QuoteCard from '../../components/composites/QuoteCard.astro';
import PricingCard from '../../components/composites/PricingCard.astro';
import ProductCard from '../../components/composites/ProductCard.astro';
import TestimonialCard from '../../components/composites/TestimonialCard.astro';
import Accordion from '../../components/composites/Accordion.astro';
import Tabs from '../../components/composites/Tabs.astro';
import Breadcrumb from '../../components/composites/Breadcrumb.astro';
import Pagination from '../../components/composites/Pagination.astro';
import Stepper from '../../components/composites/Stepper.astro';
import LinkGroup from '../../components/composites/LinkGroup.astro';
import Textarea from '../../components/composites/Textarea.astro';
import Select from '../../components/composites/Select.astro';
import FormField from '../../components/composites/FormField.astro';
import SearchBar from '../../components/composites/SearchBar.astro';
import Alert from '../../components/composites/Alert.astro';
import Toast from '../../components/composites/Toast.astro';
import Progress from '../../components/composites/Progress.astro';
import EmptyState from '../../components/composites/EmptyState.astro';
import Table from '../../components/composites/Table.astro';
import TableSortable from '../../components/composites/TableSortable.astro';
import TableFilterable from '../../components/composites/TableFilterable.astro';
import ChartBar from '../../components/composites/ChartBar.astro';
import ChartLine from '../../components/composites/ChartLine.astro';
import ChartPie from '../../components/composites/ChartPie.astro';
import List from '../../components/composites/List.astro';
import ListGrid from '../../components/composites/ListGrid.astro';
import Timeline from '../../components/composites/Timeline.astro';
import Toc from '../../components/composites/Toc.astro';
import HeroCentered from '../../components/templates/HeroCentered.astro';
import HeroSplit from '../../components/templates/HeroSplit.astro';
import SectionContent from '../../components/templates/SectionContent.astro';
import SectionFeatures from '../../components/templates/SectionFeatures.astro';
import SectionCTA from '../../components/templates/SectionCTA.astro';
import SectionPricing from '../../components/templates/SectionPricing.astro';
import PageHeader from '../../components/templates/PageHeader.astro';
import PageFooter from '../../components/templates/PageFooter.astro';
import LayoutGrid from '../../components/templates/LayoutGrid.astro';
import LayoutStack from '../../components/templates/LayoutStack.astro';
import Dashboard from '../../components/templates/Dashboard.astro';
---

<Layout title="Design System · Ember Circuit" description="Storybook-style component gallery. Atoms, molecules, organisms, patterns — all isolated, all token-driven.">

<!-- EMBER CIRCUIT HERO -->
<section class="ec-circ-hero">
  <div class="ec-circ-hero__bg">
    <svg class="ec-circ-hero__circuit" viewBox="0 0 800 400" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="ec-circ-grid" width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M 40 0 L 0 0 0 40" fill="none" stroke="var(--color-accent-signal, #1FB6A8)" stroke-width="0.5" opacity="0.2"/>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#ec-circ-grid)" />
      <!-- Circuit traces -->
      <g class="ec-circ-traces" stroke="var(--color-accent-ember, #E85B4E)" fill="none" stroke-width="1.5" opacity="0.4">
        <path d="M 50 100 L 200 100 L 200 200 L 350 200" />
        <path d="M 450 200 L 600 200 L 600 100 L 750 100" />
        <path d="M 200 300 L 350 300 L 350 200" />
        <path d="M 450 300 L 600 300 L 600 200" />
      </g>
      <!-- Circuit nodes -->
      <g class="ec-circ-nodes" fill="var(--color-accent-signal, #1FB6A8)">
        <circle cx="50" cy="100" r="4" />
        <circle cx="200" cy="100" r="4" />
        <circle cx="200" cy="200" r="4" />
        <circle cx="350" cy="200" r="4" />
        <circle cx="450" cy="200" r="4" />
        <circle cx="600" cy="100" r="4" />
        <circle cx="750" cy="100" r="4" />
        <circle cx="200" cy="300" r="4" />
        <circle cx="600" cy="300" r="4" />
      </g>
    </svg>
  </div>
  <div class="ec-circ-hero__inner">
    <p class="ec-circ-hero__eyebrow">Ember Circuit Design System</p>
    <h1 class="ec-circ-hero__title">
      <span class="ec-circ-hero__title-ember">Hearth</span>
      <span class="ec-circ-hero__title-divider">|</span>
      <span class="ec-circ-hero__title-code">Code</span>
    </h1>
    <p class="ec-circ-hero__lede">
      64 components across four layers — atoms, molecules, organisms, and patterns —
      each isolated, each token-driven, each ready for inspection.
    </p>
    <div class="ec-circ-hero__stats">
      <StatCard value="12" label="Atoms" trend="flat" accent="hearth" />
      <StatCard value="32" label="Molecules" trend="up" context="+8" accent="code" />
      <StatCard value="20" label="Organisms" trend="up" context="+9" accent="balanced" />
      <StatCard value="64" label="Total" trend="up" context="Complete" accent="balanced" />
    </div>
  </div>
</section>

<!-- TABS PANEL -->
<Tabs
  tabs={[
    {
      id: 'atoms',
      label: 'Atoms',
      content: 'atoms',
    },
    {
      id: 'molecules',
      label: 'Molecules',
      content: 'molecules',
    },
    {
      id: 'organisms',
      label: 'Organisms',
      content: 'organisms',
    },
    {
      id: 'patterns',
      label: 'Patterns',
      content: 'patterns',
    },
    {
      id: 'showcase',
      label: 'Showcase',
      content: 'showcase',
    },
  ]}
  variant="pills"
/>

<style>
  /* === EMBER CIRCUIT HERO === */
  .ec-circ-hero {
    position: relative;
    padding: var(--space-9) var(--space-5);
    overflow: hidden;
    background: var(--color-surface-primary);
    border-bottom: 1px solid var(--color-surface-rule);
  }
  .ec-circ-hero__bg {
    position: absolute;
    inset: 0;
    opacity: 0.3;
    pointer-events: none;
  }
  .ec-circ-hero__circuit {
    width: 100%;
    height: 100%;
  }
  .ec-circ-hero__traces {
    animation: ec-circ-flow 20s linear infinite;
  }
  @keyframes ec-circ-flow {
    to { stroke-dashoffset: -100; }
  }
  .ec-circ-hero__nodes circle {
    animation: ec-circ-pulse 3s ease-in-out infinite;
  }
  .ec-circ-hero__nodes circle:nth-child(even) {
    animation-delay: 1.5s;
  }
  @keyframes ec-circ-pulse {
    0%, 100% { opacity: 0.4; r: 4; }
    50% { opacity: 1; r: 6; }
  }
  .ec-circ-hero__inner {
    position: relative;
    z-index: 1;
    max-width: 64rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-5);
    text-align: center;
  }
  .ec-circ-hero__eyebrow {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: var(--font-size-small);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-secondary);
  }
  .ec-circ-hero__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: var(--font-weight-bold);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-text-display);
  }
  .ec-circ-hero__title-ember { color: var(--color-accent-ember); }
  .ec-circ-hero__title-code { color: var(--color-accent-signal); }
  .ec-circ-hero__title-divider {
    margin: 0 0.5em;
    color: var(--color-text-secondary);
    font-weight: var(--font-weight-normal);
  }
  .ec-circ-hero__lede {
    margin: 0;
    max-width: 48rem;
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }
  .ec-circ-hero__stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: var(--space-4);
    width: 100%;
    max-width: 48rem;
    margin-top: var(--space-3);
  }

  /* === TAB PANEL ENHANCEMENTS === */
  .ec-tabs {
    background: var(--color-surface-recessed) !important;
    padding: var(--space-3) var(--space-5) !important;
    border-bottom: 1px solid var(--color-surface-rule) !important;
    position: sticky !important;
    top: 0 !important;
    z-index: 50 !important;
  }
  .ec-tabs__list {
    border-bottom: none !important;
    gap: var(--space-1) !important;
    justify-content: center !important;
  }
  .ec-tabs__trigger {
    padding: var(--space-2) var(--space-5) !important;
    font-size: var(--font-size-small) !important;
    text-transform: uppercase !important;
    letter-spacing: 0.05em !important;
  }

  /* === COMPONENT PREVIEW CARD === */
  .ec-preview-card {
    background: var(--color-surface-raised);
    border: 1px solid var(--color-surface-rule);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color var(--motion-duration-fast) var(--motion-easing-default);
  }
  .ec-preview-card:hover {
    border-color: var(--color-accent-ember);
  }
  .ec-preview-card__header {
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--color-surface-rule);
    background: var(--color-surface-recessed);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .ec-preview-card__title-group {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .ec-preview-card__name {
    font-family: var(--font-mono);
    font-size: var(--font-size-body);
    font-weight: var(--font-weight-medium);
    color: var(--color-accent-ember);
  }
  .ec-preview-card__type {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-secondary);
  }
  .ec-preview-card__badges {
    display: flex;
    gap: var(--space-1);
  }
  .ec-preview-card__preview {
    padding: var(--space-7);
    background: var(--color-surface-primary);
    min-height: 8rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ec-preview-card__tabs {
    border-top: 1px solid var(--color-surface-rule);
  }
  .ec-preview-card__tab-bar {
    display: flex;
    background: var(--color-surface-recessed);
    border-bottom: 1px solid var(--color-surface-rule);
  }
  .ec-preview-card__tab {
    flex: 1;
    padding: var(--space-2) var(--space-4);
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    color: var(--color-text-secondary);
    font-family: var(--font-body);
    font-size: var(--font-size-small);
    font-weight: var(--font-weight-medium);
    cursor: pointer;
    transition: all var(--motion-duration-fast) var(--motion-easing-default);
  }
  .ec-preview-card__tab:hover {
    color: var(--color-text-primary);
    background: var(--color-surface-raised);
  }
  .ec-preview-card__tab.is-active {
    color: var(--color-text-display);
    border-bottom-color: var(--color-accent-ember);
    background: var(--color-surface-raised);
  }
  .ec-preview-card__content {
    padding: 0;
  }
  .ec-preview-card__panel {
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--color-surface-rule);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-text-primary);
    background: var(--color-surface-primary);
    overflow-x: auto;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .ec-preview-card__panel:last-child { border-bottom: none; }
  .ec-preview-card__panel--variants {
    padding: var(--space-5);
    background: var(--color-surface-primary);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: center;
    justify-content: space-around;
    white-space: normal;
  }
  .ec-preview-card__panel-title {
    margin: 0 0 var(--space-3) 0;
    font-family: var(--font-body);
    font-size: var(--font-size-small);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-secondary);
    white-space: normal;
  }
  .ec-preview-card__props {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }
  .ec-preview-card__props th,
  .ec-preview-card__props td {
    text-align: left;
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--color-surface-rule);
    color: var(--color-text-primary);
    white-space: normal;
  }
  .ec-preview-card__props th {
    background: var(--color-surface-recessed);
    color: var(--color-text-secondary);
    font-weight: var(--font-weight-medium);
  }
  .ec-preview-card__props td code {
    background: var(--color-surface-recessed);
    color: var(--color-accent-ember);
    padding: 0.125rem 0.375rem;
    border-radius: 3px;
    font-size: 0.75rem;
  }

  /* === SECTION HEADERS === */
  .ec-layer-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: var(--space-9) 0 var(--space-7);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-surface-rule);
  }
  .ec-layer-header__badge {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--color-surface-raised);
    color: var(--color-accent-ember);
  }
  .ec-layer-header--hearth .ec-layer-header__badge { background: rgba(232, 91, 78, 0.15); color: var(--color-accent-ember); }
  .ec-layer-header--code .ec-layer-header__badge { background: rgba(31, 182, 168, 0.15); color: var(--color-accent-signal); }
  .ec-layer-header--organism .ec-layer-header__badge { background: rgba(155, 93, 229, 0.15); color: var(--color-accent-violet); }
  .ec-layer-header__content {
    flex: 1;
  }
  .ec-layer-header__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: var(--font-weight-bold);
    color: var(--color-text-display);
  }
  .ec-layer-header__desc {
    margin: 0.25rem 0 0 0;
    font-size: var(--font-size-small);
    color: var(--color-text-secondary);
  }
  .ec-layer-header__count {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }

  /* === COMPONENT GRID === */
  .ec-components-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }
  @media (min-width: 1024px) {
    .ec-components-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* === SHOWCASE SECTION === */
  .ec-showcase-content {
    padding: var(--space-7);
    background: var(--color-surface-primary);
    border: 1px solid var(--color-surface-rule);
    border-radius: var(--radius-md);
  }
</style>

<script>
  // Tab switching logic - re-render the tab panel based on which tab is active
  document.querySelectorAll('.ec-tabs__trigger').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      // Tabs component already handles its own state
      // We listen for which tab is active and show corresponding section
      const tabId = trigger.getAttribute('data-tab-id');
      document.querySelectorAll<HTMLElement>('.ec-layer-section'>).forEach((section) => {
        (section as HTMLElement).style.display = 'none';
      });
      const target = document.getElementById(`layer-${tabId}`);
      if (target) (target as HTMLElement).style.display = 'block';
    });
  });

  // Initialize: show the first tab's content (atoms)
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll<HTMLElement>('.ec-layer-section'>).forEach((section, idx) => {
      (section as HTMLElement).style.display = idx === 0 ? 'block' : 'none';
    });
  });
</script>

<!-- ATOMS SECTION -->
<div id="layer-atoms" class="ec-layer-section">
  <div class="ec-layer-header ec-layer-header--hearth">
    <div class="ec-layer-header__badge">
      <Icon name="circle" size="sm" />
    </div>
    <div class="ec-layer-header__content">
      <h2 class="ec-layer-header__name">Atoms</h2>
      <p class="ec-layer-header__desc">Single-purpose elements. The building blocks.</p>
    </div>
    <span class="ec-layer-header__count">12 components</span>
  </div>
  <div class="ec-components-grid">
    <!-- BUTTON -->
    <div class="ec-preview-card" id="atom-button">
      <div class="ec-preview-card__header">
        <div class="ec-preview-card__title-group">
          <span class="ec-preview-card__type">Atom · p-button</span>
          <span class="ec-preview-card__name">Button</span>
        </div>
        <div class="ec-preview-card__badges">
          <Badge variant="hearth">Primary</Badge>
          <Badge variant="code">Code</Badge>
        </div>
      </div>
      <div class="ec-preview-card__preview">
        <Button variant="primary">Primary Action</Button>
        <Button variant="secondary">Secondary</Button>
        <Button variant="ghost">Ghost</Button>
        <Button variant="danger">Danger</Button>
      </div>
      <div class="ec-preview-card__tabs">
        <div class="ec-preview-card__tab-bar">
          <button class="ec-preview-card__tab is-active" data-preview-tab="props" data-target="atom-button">Props</button>
          <button class="ec-preview-card__tab" data-preview-tab="variants" data-target="atom-button">Variants</button>
          <button class="ec-preview-card__tab" data-preview-tab="states" data-target="atom-button">States</button>
        </div>
        <div class="ec-preview-card__content">
          <div class="ec-preview-card__panel" data-preview-panel="props" data-target="atom-button">
            <table class="ec-preview-card__props">
              <tr><th>Prop</th><th>Type</th><th>Default</th></tr>
              <tr><td><code>variant</code></td><td>'primary' | 'secondary' | 'ghost' | 'danger'</td><td>'primary'</td></tr>
              <tr><td><code>size</code></td><td>'sm' | 'md' | 'lg'</td><td>'md'</td></tr>
              <tr><td><code>disabled</code></td><td>boolean</td><td>false</td></tr>
              <tr><td><code>loading</code></td><td>boolean</td><td>false</td></tr>
              <tr><td><code>href</code></td><td>string</td><td>undefined</td></tr>
            </table>
          </div>
          <div class="ec-preview-card__panel ec-preview-card__panel--variants" data-preview-panel="variants" data-target="atom-button" hidden>
            <p class="ec-preview-card__panel-title">Button Variants</p>
            <Button variant="primary" size="sm">Small Primary</Button>
            <Button variant="primary" size="md">Medium Primary</Button>
            <Button variant="primary" size="lg">Large Primary</Button>
          </div>
          <div class="ec-preview-card__panel ec-preview-card__panel--variants" data-preview-panel="states" data-target="atom-button" hidden>
            <p class="ec-preview-card__panel-title">Button States</p>
            <Button variant="primary">Default</Button>
            <Button variant="primary" disabled>Disabled</Button>
            <Button variant="primary" loading>Loading</Button>
          </div>
        </div>
      </div>
    </div>

    <!-- INPUT -->
    <div class="ec-preview-card" id="atom-input">
      <div class="ec-preview-card__header">
        <div class="ec-preview-card__title-group">
          <span class="ec-preview-card__type">Atom · p-input</span>
          <span class="ec-preview-card__name">Input</span>
        </div>
        <div class="ec-preview-card__badges">
          <Badge variant="info">7 Types</Badge>
          <Badge variant="success">Validated</Badge>
        </div>
      </div>
      <div class="ec-preview-card__preview">
        <Input type="email" placeholder="you@example.com" />
      </div>
      <div class="ec-preview-card__tabs">
        <div class="ec-preview-card__tab-bar">
          <button class="ec-preview-card__tab is-active" data-preview-tab="props" data-target="atom-input">Props</button>
          <button class="ec-preview-card__tab" data-preview-tab="variants" data-target="atom-input">Variants</button>
          <button class="ec-preview-card__tab" data-preview-tab="states" data-target="atom-input">States</button>
        </div>
        <div class="ec-preview-card__content">
          <div class="ec-preview-card__panel" data-preview-panel="props" data-target="atom-input">
            <table class="ec-preview-card__props">
              <tr><th>Prop</th><th>Type</th><th>Default</th></tr>
              <tr><td><code>type</code></td><td>'text' | 'email' | 'password' | 'number' | 'url' | 'search' | 'tel'</td><td>'text'</td></tr>
              <tr><td><code>size</code></td><td>'sm' | 'md' | 'lg'</td><td>'md'</td></tr>
              <tr><td><code>error</code></td><td>boolean</td><td>false</td></tr>
              <tr><td><code>success</code></td><td>boolean</td><td>false</td></tr>
              <tr><td><code>disabled</code></td><td>boolean</td><td>false</td></tr>
            </table>
          </div>
          <div class="ec-preview-card__panel ec-preview-card__panel--variants" data-preview-panel="variants" data-target="atom-input" hidden>
            <p class="ec-preview-card__panel-title">Input Variants</p>
            <Input type="text" placeholder="Text input" />
            <Input type="email" placeholder="Email input" />
            <Input type="password" placeholder="Password input" />
            <Input type="search" placeholder="Search input" />
          </div>
          <div class="ec-preview-card__panel ec-preview-card__panel--variants" data-preview-panel="states" data-target="atom-input" hidden>
            <p class="ec-preview-card__panel-title">Input States</p>
            <Input placeholder="Default" />
            <Input placeholder="Disabled" disabled />
            <Input placeholder="Error" error />
            <Input placeholder="Success" success />
          </div>
        </div>
      </div>
    </div>

