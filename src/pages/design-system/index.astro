---
/**
 * Design System Showcase - Ember Circuit
 *
 * Storybook-style component gallery. Each component rendered in isolation
 * inside a tile. All styling token-driven via tokens.css + global.css.
 */

import '../../styles/tokens.css';
import '../../styles/global.css';

import Layout from '../../layouts/Layout.astro';

// Atoms
import Avatar from '../../components/primitives/Avatar.astro';
import Badge from '../../components/primitives/Badge.astro';
import Button from '../../components/primitives/Button.astro';
import Checkbox from '../../components/primitives/Checkbox.astro';
import Divider from '../../components/primitives/Divider.astro';
import Icon from '../../components/primitives/Icon.astro';
import Input from '../../components/primitives/Input.astro';
import Label from '../../components/primitives/Label.astro';
import Radio from '../../components/primitives/Radio.astro';
import Skeleton from '../../components/primitives/Skeleton.astro';
import Spinner from '../../components/primitives/Spinner.astro';
import Tag from '../../components/primitives/Tag.astro';
import Tooltip from '../../components/primitives/Tooltip.astro';

// Composites
import Accordion from '../../components/composites/Accordion.astro';
import Alert from '../../components/composites/Alert.astro';
import Breadcrumb from '../../components/composites/Breadcrumb.astro';
import Card from '../../components/composites/Card.astro';
import ChartBar from '../../components/composites/ChartBar.astro';
import ChartLine from '../../components/composites/ChartLine.astro';
import ChartPie from '../../components/composites/ChartPie.astro';
import EmptyState from '../../components/composites/EmptyState.astro';
import FeatureCard from '../../components/composites/FeatureCard.astro';
import FormField from '../../components/composites/FormField.astro';
import LinkGroup from '../../components/composites/LinkGroup.astro';
import List from '../../components/composites/List.astro';
import ListGrid from '../../components/composites/ListGrid.astro';
import Pagination from '../../components/composites/Pagination.astro';
import PricingCard from '../../components/composites/PricingCard.astro';
import ProductCard from '../../components/composites/ProductCard.astro';
import ProfileCard from '../../components/composites/ProfileCard.astro';
import Progress from '../../components/composites/Progress.astro';
import QuoteCard from '../../components/composites/QuoteCard.astro';
import SearchBar from '../../components/composites/SearchBar.astro';
import Select from '../../components/composites/Select.astro';
import StatCard from '../../components/composites/StatCard.astro';
import Stepper from '../../components/composites/Stepper.astro';
import Table from '../../components/composites/Table.astro';
import TableFilterable from '../../components/composites/TableFilterable.astro';
import TableSortable from '../../components/composites/TableSortable.astro';
import Tabs from '../../components/composites/Tabs.astro';
import TestimonialCard from '../../components/composites/TestimonialCard.astro';
import Textarea from '../../components/composites/Textarea.astro';
import Timeline from '../../components/composites/Timeline.astro';
import Toast from '../../components/composites/Toast.astro';
import Toc from '../../components/composites/Toc.astro';

// Templates
import Dashboard from '../../components/templates/Dashboard.astro';
import HeaderLayout from '../../components/templates/HeaderLayout.astro';
import HeroCentered from '../../components/templates/HeroCentered.astro';
import HeroSplit from '../../components/templates/HeroSplit.astro';
import HeroVideo from '../../components/templates/HeroVideo.astro';
import LayoutGrid from '../../components/templates/LayoutGrid.astro';
import LayoutSidebar from '../../components/templates/LayoutSidebar.astro';
import LayoutStack from '../../components/templates/LayoutStack.astro';
import Modal from '../../components/templates/Modal.astro';
import NavHeader from '../../components/templates/NavHeader.astro';
import NavSidebar from '../../components/templates/NavSidebar.astro';
import PageFooter from '../../components/templates/PageFooter.astro';
import PageHeader from '../../components/templates/PageHeader.astro';
import SectionCTA from '../../components/templates/SectionCTA.astro';
import SectionContent from '../../components/templates/SectionContent.astro';
import SectionFeatures from '../../components/templates/SectionFeatures.astro';
import SectionPricing from '../../components/templates/SectionPricing.astro';
import SectionTestimonials from '../../components/templates/SectionTestimonials.astro';
import StepperLayout from '../../components/templates/StepperLayout.astro';
import TabsLayout from '../../components/templates/TabsLayout.astro';
---

<Layout title="Design System · Ember Circuit" description="Storybook-style gallery of all 64 Hearth & Code components. Atoms, molecules, organisms — isolated, token-driven, accessible.">

<!-- HERO -->
<header class="ds-hero">
  <div class="ds-hero__inner">
    <p class="ds-hero__eyebrow">Ember Circuit · Design System</p>
    <h1 class="ds-hero__title">
      <span class="ds-hero__hearth">Hearth</span>
      <span class="ds-hero__bar">|</span>
      <span class="ds-hero__code">Code</span>
    </h1>
    <p class="ds-hero__lede">
      All 64 components, rendered in isolation. Three layers — primitives, composites,
      and templates. Token-driven, accessible, production-ready.
    </p>
    <div class="ds-hero__counts">
      <a href="#atoms" class="ds-count">
        <span class="ds-count__value">12</span>
        <span class="ds-count__label">Atoms</span>
      </a>
      <a href="#composites" class="ds-count">
        <span class="ds-count__value">32</span>
        <span class="ds-count__label">Composites</span>
      </a>
      <a href="#templates" class="ds-count">
        <span class="ds-count__value">20</span>
        <span class="ds-count__label">Templates</span>
      </a>
      <span class="ds-count ds-count--total">
        <span class="ds-count__value">64</span>
        <span class="ds-count__label">Total</span>
      </span>
    </div>
  </div>
</header>

<!-- STICKY NAV -->
<nav class="ds-nav">
  <div class="ds-nav__inner">
    <a href="#atoms" class="ds-nav__link">Atoms</a>
    <a href="#composites" class="ds-nav__link">Composites</a>
    <a href="#templates" class="ds-nav__link">Templates</a>
  </div>
</nav>

<!-- ATOMS -->
<section id="atoms" class="ds-section">
  <header class="ds-section__header">
    <p class="ds-section__eyebrow">Layer 1 · Primitives</p>
    <h2 class="ds-section__title">Atoms</h2>
    <p class="ds-section__desc">12 single-purpose elements. The irreducible building blocks.</p>
  </header>

  <div class="ds-tiles">

    <figure class="ds-tile">
      <div class="ds-tile__preview">
        <Button variant="primary">Primary</Button>
        <Button variant="secondary">Secondary</Button>
        <Button variant="ghost">Ghost</Button>
        <Button variant="danger">Danger</Button>
      </div>
      <figcaption class="ds-tile__meta">
        <span class="ds-tile__id">p-button</span>
        <span class="ds-tile__name">Button</span>
      </figcaption>
    </figure>

    <figure class="ds-tile">
      <div class="ds-tile__preview">
        <Input type="email" placeholder="you@example.com" />
      </div>
      <figcaption class="ds-tile__meta">
        <span class="ds-tile__id">p-input</span>
        <span class="ds-tile__name">Input</span>
      </figcaption>
    </figure>

    <figure class="ds-tile">
      <div class="ds-tile__preview">
        <Icon name="check" size="lg" />
        <Icon name="info" size="lg" />
        <Icon name="warning" size="lg" />
        <Icon name="user" size="lg" />
        <Icon name="arrow-right" size="lg" />
      </div>
      <figcaption class="ds-tile__meta">
        <span class="ds-tile__id">p-icon</span>
        <span class="ds-tile__name">Icon</span>
      </figcaption>
    </figure>

    <figure class="ds-tile">
      <div class="ds-tile__preview">
        <Badge>Default</Badge>
        <Badge variant="success">Success</Badge>
        <Badge variant="caution">Caution</Badge>
        <Badge variant="danger">Danger</Badge>
      </div>
      <figcaption class="ds-tile__meta">
        <span class="ds-tile__id">p-badge</span>
        <span class="ds-tile__name">Badge</span>
      </figcaption>
    </figure>

    <figure class="ds-tile">
      <div class="ds-tile__preview">
        <Tag label="token" />
        <Tag label="hearth" variant="hearth" />
        <Tag label="code" variant="code" />
        <Tag label="balanced" variant="balanced" />
      </div>
      <figcaption class="ds-tile__meta">
        <span class="ds-tile__id">p-tag</span>
        <span class="ds-tile__name">Tag</span>
      </figcaption>
    </figure>

    <figure class="ds-tile">
      <div class="ds-tile__preview">
        <Divider variant="solid" />
      </div>
      <figcaption class="ds-tile__meta">
        <span class="ds-tile__id">p-divider</span>
        <span class="ds-tile__name">Divider</span>
      </figcaption>
    </figure>

    <figure class="ds-tile">
      <div class="ds-tile__preview">
        <Avatar name="SR" size="lg" />
      </div>
      <figcaption class="ds-tile__meta">
        <span class="ds-tile__id">p-avatar</span>
        <span class="ds-tile__name">Avatar</span>
      </figcaption>
    </figure>

    <figure class="ds-tile">
      <div class="ds-tile__preview">
        <Label text="Email" htmlFor="lbl-email" required />
      </div>
      <figcaption class="ds-tile__meta">
        <span class="ds-tile__id">p-label</span>
        <span class="ds-tile__name">Label</span>
      </figcaption>
    </figure>

    <figure class="ds-tile">
      <div class="ds-tile__preview">
        <Tooltip content="Tooltip helper text">Hover me</Tooltip>
      </div>
      <figcaption class="ds-tile__meta">
        <span class="ds-tile__id">p-tooltip</span>
        <span class="ds-tile__name">Tooltip</span>
      </figcaption>
    </figure>

    <figure class="ds-tile">
      <div class="ds-tile__preview">
        <Checkbox id="ds-cb" label="Subscribe" checked />
        <Checkbox id="ds-cb2" label="Unchecked" />
      </div>
      <figcaption class="ds-tile__meta">
        <span class="ds-tile__id">p-checkbox</span>
        <span class="ds-tile__name">Checkbox</span>
      </figcaption>
    </figure>

    <figure class="ds-tile">
      <div class="ds-tile__preview">
        <Radio name="ds-radio" value="a" label="Option A" checked />
        <Radio name="ds-radio" value="b" label="Option B" />
      </div>
      <figcaption class="ds-tile__meta">
        <span class="ds-tile__id">p-radio</span>
        <span class="ds-tile__name">Radio</span>
      </figcaption>
    </figure>

    <figure class="ds-tile">
      <div class="ds-tile__preview">
        <Spinner size="lg" />
      </div>
      <figcaption class="ds-tile__meta">
        <span class="ds-tile__id">p-spinner</span>
        <span class="ds-tile__name">Spinner</span>
      </figcaption>
    </figure>

    <figure class="ds-tile">
      <div class="ds-tile__preview" style="flex-direction: column; align-items: stretch; gap: 0.5rem;">
        <Skeleton variant="text" width="80%" />
        <Skeleton variant="text" width="60%" />
        <Skeleton variant="text" width="70%" />
      </div>
      <figcaption class="ds-tile__meta">
        <span class="ds-tile__id">p-skeleton</span>
        <span class="ds-tile__name">Skeleton</span>
      </figcaption>
    </figure>

  </div>
</section>

<!-- COMPOSITES -->
<section id="composites" class="ds-section">
  <header class="ds-section__header">
    <p class="ds-section__eyebrow">Layer 2 · Molecules</p>
    <h2 class="ds-section__title">Composites</h2>
    <p class="ds-section__desc">32 composed elements. Atoms arranged into functional units.</p>
  </header>

  <div class="ds-tiles">

    <figure class="ds-tile">
      <div class="ds-tile__preview">
        <FeatureCard icon="check" title="Fast" description="Built for speed and reliability." accent="hearth" />
      </div>
      <figcaption class="ds-tile__meta">
        <span class="ds-tile__id">c-feature-card</span>
        <span class="ds-tile__name">Feature Card</span>
      </figcaption>
    </figure>

    <figure class="ds-tile">
      <div class="ds-tile__preview">
        <StatCard value="98%" label="Accessibility" trend="up" context="+12%" accent="success" />
      </div>
      <figcaption class="ds-tile__meta">
        <span class="ds-tile__id">c-stat-card</span>
        <span class="ds-tile__name">Stat Card</span>
      </figcaption>
    </figure>

    <figure class="ds-tile">
      <div class="ds-tile__preview">
        <Card>
          <h3 style="margin: 0 0 0.5rem 0;">Card title</h3>
          <p style="margin: 0;">Composable surface with header, body, and footer slots.</p>
        </Card>
      </div>
      <figcaption class="ds-tile__meta">
        <span class="ds-tile__id">c-card</span>
        <span class="ds-tile__name">Card</span>
      </figcaption>
    </figure>

    <figure class="ds-tile">
      <div class="ds-tile__preview">
        <ProfileCard name="Scott Rallya" title="Hearthside Meta-Architect" />
      </div>
      <figcaption class="ds-tile__meta">
        <span class="ds-tile__id">c-profile-card</span>
        <span class="ds-tile__name">Profile Card</span>
      </figcaption>
    </figure>

    <figure class="ds-tile">
      <div class="ds-tile__preview">
        <QuoteCard quote="Every consequential claim should have a source." attribution="Hearth & Code" source="Studio Charter" />
      </div>
      <figcaption class="ds-tile__meta">
        <span class="ds-tile__id">c-quote-card</span>
        <span class="ds-tile__name">Quote Card</span>
      </figcaption>
    </figure>

    <figure class="ds-tile">
      <div class="ds-tile__preview">
        <PricingCard tier="Pro" price="$29" period="/mo" features={['Unlimited', 'Priority support']} ctaLabel="Subscribe" ctaHref="#" />
      </div>
      <figcaption class="ds-tile__meta">
        <span class="ds-tile__id">c-pricing-card</span>
        <span class="ds-tile__name">Pricing Card</span>
      </figcaption>
    </figure>

    <figure class="ds-tile">
      <div class="ds-tile__preview">
        <ProductCard title="Component Library" description="64 components built with tokens." price="Free" href="#" />
      </div>
      <figcaption class="ds-tile__meta">
        <span class="ds-tile__id">c-product-card</span>
        <span class="ds-tile__name">Product Card</span>
      </figcaption>
    </figure>

    <figure class="ds-tile">
      <div class="ds-tile__preview">
        <TestimonialCard quote="This design system transformed our workflow." author="User" role="Developer" />
      </div>
      <figcaption class="ds-tile__meta">
        <span class="ds-tile__id">c-testimonial-card</span>
        <span class="ds-tile__name">Testimonial Card</span>
      </figcaption>
    </figure>

    <figure class="ds-tile">
      <div class="ds-tile__preview" style="flex-direction: column; align-items: stretch; gap: 0.5rem;">
        <Alert variant="info">Information message</Alert>
        <Alert variant="success">Success message</Alert>
        <Alert variant="caution">Caution message</Alert>
        <Alert variant="danger">Danger message</Alert>
      </div>
      <figcaption class="ds-tile__meta">
        <span class="ds-tile__id">c-alert</span>
        <span class="ds-tile__name">Alert</span>
      </figcaption>
    </figure>

    <figure class="ds-tile">
      <div class="ds-tile__preview" style="flex-direction: column; align-items: stretch; gap: 1rem;">
        <Progress value={68} label="Wave 2" />
        <Progress value={100} label="Wave 1" />
      </div>
      <figcaption class="ds-tile__meta">
        <span class="ds-tile__id">c-progress</span>
        <span class="ds-tile__name">Progress</span>
      </figcaption>
    </figure>

    <figure class="ds-tile">
      <div class="ds-tile__preview">
        <Toast visible={true} variant="success" title="Saved!" position="bottom-right" />
      </div>
      <figcaption class="ds-tile__meta">
        <span class="ds-tile__id">c-toast</span>
        <span class="ds-tile__name">Toast</span>
      </figcaption>
    </figure>

    <figure class="ds-tile">
      <div class="ds-tile__preview" style="width: 100%;">
        <EmptyState icon="search" title="No results" description="Try adjusting your search." actionLabel="Browse all" actionHref="#" />
      </div>
      <figcaption class="ds-tile__meta">
        <span class="ds-tile__id">c-empty-state</span>
        <span class="ds-tile__name">Empty State</span>
      </figcaption>
    </figure>

    <figure class="ds-tile">
      <div class="ds-tile__preview" style="width: 100%;">
        <Accordion items={[
          { id: 'a1', title: 'Section 1', content: 'First section content.', defaultOpen: true },
          { id: 'a2', title: 'Section 2', content: 'Second section content.' },
        ]} />
      </div>
      <figcaption class="ds-tile__meta">
        <span class="ds-tile__id">c-accordion</span>
        <span class="ds-tile__name">Accordion</span>
      </figcaption>
    </figure>

    <figure class="ds-tile">
      <div class="ds-tile__preview">
        <Tabs tabs={[
          { id: 't1', label: 'Overview', content: 'Overview content' },
          { id: 't2', label: 'Details', content: 'Details content' },
          { id: 't3', label: 'Settings', content: 'Settings content' },
        ]} />
      </div>
      <figcaption class="ds-tile__meta">
        <span class="ds-tile__id">c-tabs</span>
        <span class="ds-tile__name">Tabs</span>
      </figcaption>
    </figure>

    <figure class="ds-tile">
      <div class="ds-tile__preview">
        <Breadcrumb items={[
          { label: 'Home', href: '#' },
          { label: 'Studio', href: '#' },
          { label: 'Page', href: '#' },
        ]} />
      </div>
      <figcaption class="ds-tile__meta">
        <span class="ds-tile__id">c-breadcrumb</span>
        <span class="ds-tile__name">Breadcrumb</span>
      </figcaption>
    </figure>

    <figure class="ds-tile">
      <div class="ds-tile__preview">
        <Pagination currentPage={3} totalPages={12} />
      </div>
      <figcaption class="ds-tile__meta">
        <span class="ds-tile__id">c-pagination</span>
        <span class="ds-tile__name">Pagination</span>
      </figcaption>
    </figure>

    <figure class="ds-tile">
      <div class="ds-tile__preview">
        <Stepper steps={[
          { label: 'Setup' },
          { label: 'Configure' },
          { label: 'Deploy' },
        ]} currentStep={1} />
      </div>
      <figcaption class="ds-tile__meta">
        <span class="ds-tile__id">c-stepper</span>
        <span class="ds-tile__name">Stepper</span>
      </figcaption>
    </figure>

    <figure class="ds-tile">
      <div class="ds-tile__preview">
        <LinkGroup title="Related links" links={[
          { label: 'Documentation', href: '#', description: 'Read the docs' },
          { label: 'GitHub', href: '#', description: 'View source' },
        ]} />
      </div>
      <figcaption class="ds-tile__meta">
        <span class="ds-tile__id">c-link-group</span>
        <span class="ds-tile__name">Link Group</span>
      </figcaption>
    </figure>

    <figure class="ds-tile">
      <div class="ds-tile__preview" style="width: 100%;">
        <FormField label="Email" htmlFor="ds-email" required>
          <Input id="ds-email" type="email" placeholder="you@example.com" />
        </FormField>
      </div>
      <figcaption class="ds-tile__meta">
        <span class="ds-tile__id">c-form-field</span>
        <span class="ds-tile__name">Form Field</span>
      </figcaption>
    </figure>

    <figure class="ds-tile">
      <div class="ds-tile__preview">
        <SearchBar placeholder="Search components..." />
      </div>
      <figcaption class="ds-tile__meta">
        <span class="ds-tile__id">c-search-bar</span>
        <span class="ds-tile__name">Search Bar</span>
      </figcaption>
    </figure>

    <figure class="ds-tile">
      <div class="ds-tile__preview">
        <Select options={[
          { value: 'option1', label: 'Option 1' },
          { value: 'option2', label: 'Option 2' },
          { value: 'option3', label: 'Option 3' },
        ]} placeholder="Select option" />
      </div>
      <figcaption class="ds-tile__meta">
        <span class="ds-tile__id">c-select</span>
        <span class="ds-tile__name">Select</span>
      </figcaption>
    </figure>

    <figure class="ds-tile">
      <div class="ds-tile__preview" style="width: 100%;">
        <Textarea placeholder="Enter your thoughts..." rows={3} />
      </div>
      <figcaption class="ds-tile__meta">
        <span class="ds-tile__id">c-textarea</span>
        <span class="ds-tile__name">Textarea</span>
      </figcaption>
    </figure>

    <figure class="ds-tile">
      <div class="ds-tile__preview" style="width: 100%;">
        <Table columns={[
          { key: 'name', label: 'Name' },
          { key: 'count', label: 'Count' },
        ]} data={[
          { name: 'Atoms', count: 12 },
          { name: 'Composites', count: 32 },
          { name: 'Templates', count: 20 },
        ]} striped />
      </div>
      <figcaption class="ds-tile__meta">
        <span class="ds-tile__id">c-table</span>
        <span class="ds-tile__name">Table</span>
      </figcaption>
    </figure>

    <figure class="ds-tile">
      <div class="ds-tile__preview" style="width: 100%;">
        <TableSortable columns={[
          { key: 'name', label: 'Name' },
          { key: 'role', label: 'Role' },
        ]} data={[
          { name: 'Primitives', role: 'Foundation' },
          { name: 'Composites', role: 'Composed' },
          { name: 'Templates', role: 'Pages' },
        ]} initialSort={{ key: 'name', direction: 'asc' }} />
      </div>
      <figcaption class="ds-tile__meta">
        <span class="ds-tile__id">c-table-sortable</span>
        <span class="ds-tile__name">Table Sortable</span>
      </figcaption>
    </figure>

    <figure class="ds-tile">
      <div class="ds-tile__preview" style="width: 100%;">
        <TableFilterable columns={[
          { key: 'name', label: 'Name', filterable: true },
          { key: 'count', label: 'Count', filterable: true },
        ]} data={[
          { name: 'Atoms', count: 12 },
          { name: 'Composites', count: 32 },
        ]} searchable={true} />
      </div>
      <figcaption class="ds-tile__meta">
        <span class="ds-tile__id">c-table-filterable</span>
        <span class="ds-tile__name">Table Filterable</span>
      </figcaption>
    </figure>

    <figure class="ds-tile">
      <div class="ds-tile__preview" style="width: 100%;">
        <ChartBar data={[
          { label: 'Atoms', value: 12 },
          { label: 'Composites', value: 32 },
          { label: 'Templates', value: 20 },
        ]} />
      </div>
      <figcaption class="ds-tile__meta">
        <span class="ds-tile__id">c-chart-bar</span>
        <span class="ds-tile__name">Bar Chart</span>
      </figcaption>
    </figure>

    <figure class="ds-tile">
      <div class="ds-tile__preview" style="width: 100%;">
        <ChartLine series={[
          { name: 'Atoms', color: 'var(--color-accent-ember)', data: [{ x: 1, y: 5 }, { x: 2, y: 12 }, { x: 3, y: 18 }, { x: 4, y: 32 }] },
          { name: 'Composites', color: 'var(--color-accent-signal)', data: [{ x: 1, y: 0 }, { x: 2, y: 8 }, { x: 3, y: 15 }, { x: 4, y: 28 }] },
        ]} height="10rem" />
      </div>
      <figcaption class="ds-tile__meta">
        <span class="ds-tile__id">c-chart-line</span>
        <span class="ds-tile__name">Line Chart</span>
      </figcaption>
    </figure>

    <figure class="ds-tile">
      <div class="ds-tile__preview" style="width: 100%;">
        <ChartPie data={[
          { label: 'Atoms', value: 12 },
          { label: 'Composites', value: 32 },
          { label: 'Templates', value: 20 },
        ]} donut={true} />
      </div>
      <figcaption class="ds-tile__meta">
        <span class="ds-tile__id">c-chart-pie</span>
        <span class="ds-tile__name">Pie Chart</span>
      </figcaption>
    </figure>

    <figure class="ds-tile">
      <div class="ds-tile__preview">
