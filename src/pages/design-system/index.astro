import SchemaViewer from '../../components/knowledge/composites/SchemaViewer.astro';
import NarrativeArc from '../../components/knowledge/composites/NarrativeArc.astro';
import DialogueTree from '../../components/knowledge/composites/DialogueTree.astro';
