---
/**
 * Design System Showcase — Live Previews
 *
 * Interactive React port preview with live prop controls.
 * All components from the React ports registry are rendered with
 * auto-generated controls derived from their TypeScript Props interface.
 */
import '../../styles/tokens.css';
import '../../styles/global.css';
import { readFileSync } from 'node:fs';
import Layout from '../../layouts/Layout.astro';
import { LivePreview } from '../../components/LivePreview.tsx';
import {
  componentRegistry,
  componentsByLayer,
  type ComponentConfig,
} from '../../lib/componentRegistry';

// Inline the full component CSS so it loads in <head> at SSR time.
// Bypasses Astro island CSS scoping and avoids a CSS link that
// might not load reliably on first request.
const componentCss = readFileSync('./public/ember-circuit-component.css', 'utf-8');

// Filter out components that require nested data structures that crash SSR.
// The filter then keeps everything else (109 components in the registry).
const skipComponents = new Set<string>([
  'SourceChain', 'TaskHierarchy', 'TaxonomyTree', 'GlossaryIndex',
  'AuditTrail', 'DeploymentStatus', 'EvidenceReceipt',
  'WorkflowState', 'DialogueTree', 'SynthesisSummary',
  'ConceptCard', 'ArchitectureDiagram', 'StateMachine', 'SequenceDiagram',
  'KnowledgeGraphView', 'HeroSplit', 'SectionPricing', 'SectionTestimonials',
  'TabsLayout', 'StepperLayout',
]);
const safeComponents = (cs: ComponentConfig[]) => cs.filter(
  (c) => !skipComponents.has(c.name) && c.propControls.length > 0
);

const atomsToShow = safeComponents(componentsByLayer.atoms).slice(0, 30);
const compositesToShow = safeComponents(componentsByLayer.composites).slice(0, 50);
const templatesToShow = safeComponents(componentsByLayer.templates).slice(0, 30);

// Group components by name for sectioning
function groupByName(comps: ComponentConfig[]): Map<string, ComponentConfig[]> {
  const map = new Map<string, ComponentConfig[]>();
  for (const c of comps) {
    if (!map.has(c.name)) map.set(c.name, []);
    map.get(c.name)!.push(c);
  }
  return map;
}
---

<Layout title="Design System · Live Previews · Ember Circuit" description="Interactive React port previews with live prop controls.">
  <Fragment slot="head">
    <style set:html={componentCss}></style>
  </Fragment>

  <section class="ec-live-hero">
    <div class="ec-live-hero__inner">
      <p class="ec-live-hero__eyebrow">Interactive · React Ports</p>
      <h1 class="ec-live-hero__title">Live Component Previews</h1>
      <p class="ec-live-hero__lede">
        Every Ember Circuit component rendered with <strong>interactive controls</strong>. Edit the inputs on the left and see the component update on the right.
        Auto-generated from each component's TypeScript Props interface — controls match the actual API surface.
      </p>
      <p class="ec-live-hero__counts">
        <strong>{atomsToShow.length}</strong> atoms ·
        <strong>{compositesToShow.length}</strong> composites ·
        <strong>{templatesToShow.length}</strong> templates
      </p>
    </div>
  </section>

  <section class="ec-live-section">
    {(['atoms', 'composites', 'templates'] as const).map((layer) => {
      const items = layer === 'atoms' ? atomsToShow : layer === 'composites' ? compositesToShow : templatesToShow;
      if (items.length === 0) return null;
      const grouped = groupByName(items);
      return (
        <div class="ec-live-layer">
          <h2 class="ec-live-layer__title">
            {layer.charAt(0).toUpperCase() + layer.slice(1)}s
            <span class="ec-live-layer__count">({items.length})</span>
          </h2>
          {Array.from(grouped.entries()).map(([name, comps]) => (
            <div class="ec-live-component-group">
              <h3 class="ec-live-component-group__title">{name}</h3>
              {comps.map((cfg) => (
                <LivePreview
                  client:load
                  componentName={cfg.name}
                  initialProps={cfg.defaultProps}
                  propMeta={cfg.propControls}
                />
              ))}
            </div>
          ))}
        </div>
      );
    })}
  </section>
</Layout>

<style>
  .ec-live-hero { padding: 3rem 1.5rem 2rem; background: var(--color-surface-primary); border-bottom: 1px solid var(--color-surface-rule); position: relative; overflow: hidden; }
  .ec-live-hero::before { content: ''; pointer-events: none; background: radial-gradient(900px 540px at 10% -5%, rgba(53, 34, 93, 0.5) 0, transparent 65%), radial-gradient(700px 540px at 94% 10%, rgba(11, 80, 96, 0.5) 0, transparent 68%); position: absolute; inset: 0; }
  .ec-live-hero__inner { position: relative; max-width: 64rem; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: 1rem; text-align: center; }
  .ec-live-hero__eyebrow { margin: 0; text-transform: uppercase; letter-spacing: 0.2em; font-size: 0.75rem; font-weight: 500; color: var(--color-accent-gold); }
  .ec-live-hero__title { margin: 0; font-family: var(--font-display); font-size: clamp(2rem, 5vw, 3.5rem); font-weight: bold; line-height: 1; letter-spacing: -0.03em; color: var(--color-text-display); }
  .ec-live-hero__lede { margin: 0; max-width: 48rem; font-size: 1.0625rem; line-height: 1.6; color: var(--color-text-secondary); }
  .ec-live-hero__lede strong { color: var(--color-accent-ember); font-weight: 500; }
  .ec-live-hero__counts { margin: 0.5rem 0 0 0; font-family: var(--font-mono); font-size: 0.875rem; color: var(--color-text-secondary); }
  .ec-live-hero__counts strong { color: var(--color-accent-signal); font-weight: bold; }

  .ec-live-section { max-width: 80rem; margin: 0 auto; padding: 3rem 1.5rem 6rem; display: flex; flex-direction: column; gap: 3rem; }
  .ec-live-layer { display: flex; flex-direction: column; gap: 1.5rem; }
  .ec-live-layer__title { margin: 0; font-family: var(--font-display); font-size: 1.75rem; font-weight: bold; color: var(--color-text-display); display: flex; align-items: baseline; gap: 0.5rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--color-surface-rule); }
  .ec-live-layer__count { font-family: var(--font-mono); font-size: 0.875rem; color: var(--color-accent-signal); font-weight: normal; }
  .ec-live-component-group { display: flex; flex-direction: column; gap: 0.75rem; }
  .ec-live-component-group__title { margin: 0.5rem 0 0 0; font-family: var(--font-mono); font-size: 0.875rem; color: var(--color-text-secondary); padding-left: 0.25rem; }
</style>
