---
import '../styles/tokens.css';
import '../styles/global.css';

const evidenceRecords = [
  {
    order: '01',
    kind: 'Proposed direction',
    title: 'Exocore public orientation',
    copy: 'A public-safe statement of the proposed workbench direction: local-first records, visible review, and human authority over consequential decisions.',
    status: 'proposed architecture',
    label: 'proposal',
    sourceUrl: 'https://github.com/hearthandcode/public-portfolio/blob/main/05-exocore-platform/artifacts/exocore-public-orientation.md',
  },
  {
    order: '02',
    kind: 'Research scope',
    title: 'Public-safe thesis scope',
    copy: 'A reviewable N=1 research direction examining AI as a possible cognitive scaffold, with individual observations and design hypotheses kept distinct from general findings.',
    status: 'draft methodology',
    label: 'open question',
    sourceUrl: 'https://github.com/hearthandcode/public-portfolio/blob/main/03-research-methods/public-safe-thesis-scope.md',
  },
  {
    order: '03',
    kind: 'Small implementation',
    title: 'Exocore pre-alpha orientation shell',
    copy: 'A minimal desktop orientation screen that makes the first public artifact and its deliberate implementation boundary inspectable.',
    status: 'pre-alpha',
    label: 'evidence',
    sourceUrl: 'https://github.com/hearthandcode/exocore-platform',
  },
];

const pageLayers = [
  ['Hearth', 'One human-scale orientation. No architecture inventory.'],
  ['Research', 'One live N=1 question and its scope boundary.'],
  ['Exocore', 'One proposed direction, with a path into the small evidence view.'],
  ['Dossier', 'A selected record of sources and visible maturity states.'],
  ['AI & Ethics', 'One concise personal position, without re-explaining every system rule.'],
  ['Field Journal + Lab', 'Separate public work and bounded artifacts, each on its own terms.'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Local review proof showing how Hearth and Code evidence candidates become a small public Dossier." />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#1C1714" />
    <title>Hearth & Code | Local Dossier review proof</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-shell dossier-demo-shell">
      <header class="site-header demo-header">
        <div class="signal-rail" aria-label="Local review status">
          <span>Hearth &amp; Code / local review proof</span>
          <span class="signal-status"><i class="signal-node" aria-hidden="true"></i> candidate copy only</span>
        </div>
        <div class="brand-row">
          <a class="wordmark" href="/" aria-label="Return to the landing proof">Hearth &amp; Code</a>
          <p class="brand-meta">Dossier shape<br />for local review</p>
        </div>
        <nav class="demo-nav" aria-label="Dossier demo navigation">
          <a href="#translation">How it translates</a>
          <a href="#dossier">Dossier proof</a>
          <a href="#site-shape">Site shape</a>
          <a href="/">Current landing proof</a>
        </nav>
      </header>

      <main class="demo-main" id="main-content">
        <section class="demo-hero" aria-labelledby="demo-title">
          <div class="demo-hero-copy">
            <p class="eyebrow">Local review proof / no release</p>
            <h1 id="demo-title">A public record can stay <em>small.</em></h1>
            <p>This page is a visual test of the Dossier, not a new public section full of the same language about AI, research, and agency. The private candidate records become one short threshold and three inspectable records with different jobs.</p>
            <p>The point is to let a visitor see the work's direction, research scope, and first bounded artifact without being asked to read the private authoring machinery behind them.</p>
            <div class="demo-hero-actions">
              <a class="demo-action is-primary" href="#dossier">See the Dossier proof</a>
              <a class="demo-action" href="#translation">See the copy compression</a>
            </div>
          </div>
          <aside class="demo-review-card" aria-label="Review boundary">
            <p class="card-kicker">Review boundary</p>
            <strong>Candidate copy stays visible as candidate copy.</strong>
            <ul>
              <li>Three public sources are already inspectable.</li>
              <li>The opening is a public-safe derivative awaiting your exact-copy decision.</li>
              <li>This local route is a design proof. It is not a release approval.</li>
            </ul>
          </aside>
        </section>

        <section class="demo-section" id="translation" aria-labelledby="translation-title">
          <aside class="demo-aside">
            <span class="section-number">01</span>
            <p>From private evidence selection to a small public reading surface.</p>
          </aside>
          <div class="demo-content">
            <div class="section-head">
              <h2 id="translation-title">The candidates are source records, not page sections.</h2>
              <span class="status-chip is-warm">copy discipline</span>
            </div>
            <p class="section-intro">The internal records deliberately repeat privacy screens, source treatment, claim labels, and non-claims. Readers do not need to see that governance language repeated. The final projection carries the outcome of those checks through its source links and visible maturity labels.</p>
            <div class="translation-grid">
              <article class="translation-card">
                <p class="card-kicker">Private source layer</p>
                <h3>Four candidate records</h3>
                <p>PEA-005 through PEA-008 separately protect architecture, methodology, a small implementation, and the opening threshold.</p>
                <ul>
                  <li>Source selection and rights state</li>
                  <li>Privacy exclusions and non-claims</li>
                  <li>Exact-copy approval state</li>
                </ul>
              </article>
              <article class="translation-card is-projection">
                <p class="card-kicker">Public projection layer</p>
                <h3>One opening and three records</h3>
                <p>The reader sees a small record of work in formation. Each card says what it is, where it comes from, and how far it has progressed.</p>
                <ul>
                  <li>One human orientation</li>
                  <li>Three distinct evidence functions</li>
                  <li>Visible labels instead of repeated disclaimers</li>
                </ul>
              </article>
            </div>
            <p class="demo-note"><strong>What changes in the final landing design:</strong> the Dossier becomes a compact evidence view reached from Research and Exocore. It does not become another full room in the primary navigation.</p>
          </div>
        </section>

        <section class="demo-section dossier-section" id="dossier" aria-labelledby="dossier-title">
          <aside class="demo-aside">
            <span class="section-number">02</span>
            <p>Selected public record. Candidate rendering for review.</p>
          </aside>
          <div class="demo-content">
            <div class="dossier-header">
              <div>
                <p class="eyebrow">Dossier / local proof</p>
                <h2 id="dossier-title">A selected record of work still taking shape.</h2>
              </div>
              <span class="status-chip is-warm">exact copy pending</span>
            </div>
            <div class="dossier-opening">
              <p>I am building a small, self-directed practice for exploring cognitive architecture, AI systems, and knowledge work in public. The work is experimental: the point is to make the path of learning, design, and correction inspectable, not to claim a finished product or settled truth.</p>
              <p>This Dossier is a selected record of that practice. It gathers a few artifacts and questions that can be examined directly, while leaving private material and unearned conclusions out of view.</p>
              <div class="card-meta"><span class="meta-label is-review">PEA-008 candidate opening</span><span class="meta-label">working interpretation</span></div>
            </div>

            <div class="dossier-records" aria-label="Candidate evidence records">
              {evidenceRecords.map((record) => (
                <article class="dossier-record">
                  <div class="record-head">
                    <span class="section-number">{record.order}</span>
                    <span class="meta-label">{record.kind}</span>
                  </div>
                  <h3>{record.title}</h3>
                  <p>{record.copy}</p>
                  <div class="record-footer">
                    <div class="card-meta"><span class="meta-label is-public">{record.status}</span><span class="meta-label">{record.label}</span></div>
                    <a href={record.sourceUrl}>Inspect source<span aria-hidden="true"> ↗</span></a>
                  </div>
                </article>
              ))}
            </div>
            <div class="demo-boundary">
              <p class="card-kicker">What stays out of this view</p>
              <p>Private authoring packets, personal history, raw research records, credential comparison, health material, unreviewed architecture, and any claim of a completed product or general outcome.</p>
            </div>
          </div>
        </section>

        <section class="demo-section" id="site-shape" aria-labelledby="site-shape-title">
          <aside class="demo-aside">
            <span class="section-number">03</span>
            <p>The final page gives each piece of language one job.</p>
          </aside>
          <div class="demo-content">
            <div class="section-head">
              <h2 id="site-shape-title">A site structure that does not keep reintroducing itself.</h2>
              <span class="status-chip">proposed composition</span>
            </div>
            <div class="site-shape-grid">
              {pageLayers.map(([title, copy], index) => (
                <article class:list={['site-shape-card', { 'is-dossier': title === 'Dossier' }]}>
                  <span class="section-number">{String(index + 1).padStart(2, '0')}</span>
                  <h3>{title}</h3>
                  <p>{copy}</p>
                </article>
              ))}
            </div>
            <div class="demo-note is-final">
              <strong>The intended rhythm:</strong> a visitor gets the human reason for the work once, the research question once, the Exocore direction once, and then a small evidence view when they want to inspect the record. The language earns the right to deepen as the reader chooses to go further.
            </div>
          </div>
        </section>
      </main>

      <footer class="site-footer">
        <div>
          <p class="footer-label">Hearth &amp; Code / local Dossier review proof</p>
          <p>This page renders review-only candidate copy for design inspection. It does not approve a Dossier route, release exact public wording, or change the deployed landing site.</p>
        </div>
        <nav class="footer-links" aria-label="Footer navigation">
          <a class="footer-link" href="#dossier">Return to Dossier proof</a>
          <a class="footer-link" href="/">Current landing proof</a>
        </nav>
      </footer>
    </div>
  </body>
</html>

<style>
  .dossier-demo-shell { max-width: 88rem; }

  .demo-header { position: sticky; top: 0; z-index: 10; }

  .demo-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    border-top: 1px solid var(--color-surface-rule);
  }

  .demo-nav a {
    padding: 0.82rem 1rem;
    border-right: 1px solid var(--color-surface-rule);
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: 0.67rem;
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .demo-nav a:hover { color: var(--color-accent-plasma); background: rgba(63, 224, 208, 0.06); }

  .demo-main { padding: var(--space-7) var(--space-5) var(--space-9); }

  .demo-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(19rem, 0.8fr);
    gap: 1px;
    border: 1px solid var(--color-surface-rule-strong);
    background: var(--color-surface-rule-strong);
  }

  .demo-hero-copy,
  .demo-review-card { background: var(--panel-deep); }

  .demo-hero-copy { padding: clamp(2rem, 5vw, 5.75rem); }

  .demo-hero h1 {
    max-width: 11ch;
    margin: var(--space-4) 0 var(--space-5);
    color: var(--color-text-display);
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 6.2rem);
    font-weight: 600;
    letter-spacing: -0.065em;
    line-height: 0.95;
  }

  .demo-hero h1 em { color: var(--color-accent-gold); font-style: normal; }

  .demo-hero-copy > p:not(.eyebrow) {
    max-width: 64ch;
    color: var(--color-text-secondary);
    font-size: clamp(1.02rem, 1.7vw, 1.15rem);
    line-height: var(--line-height-reading);
  }

  .demo-hero-actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-6); }

  .demo-action {
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-surface-rule-strong);
    color: var(--color-text-primary);
    font-size: 0.82rem;
    text-decoration: none;
  }

  .demo-action:hover { border-color: var(--color-accent-plasma); color: var(--color-accent-plasma); }
  .demo-action.is-primary { border-color: var(--color-accent-plasma); background: rgba(63, 224, 208, 0.1); }

  .demo-review-card { padding: clamp(1.5rem, 3vw, 3rem); }
  .demo-review-card strong { display: block; margin: var(--space-3) 0 var(--space-5); font-family: var(--font-display); font-size: 1.55rem; font-weight: 500; line-height: 1.15; }
  .demo-review-card ul,
  .translation-card ul { margin: 0; padding-left: 1.2rem; color: var(--color-text-secondary); font-size: 0.88rem; line-height: 1.7; }

  .demo-section {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    margin-top: var(--space-7);
    border: 1px solid var(--color-surface-rule-strong);
    background: var(--surface-float);
  }

  .demo-aside {
    padding: var(--space-5) var(--space-4);
    border-right: 1px solid var(--color-surface-rule);
    background: rgba(20, 17, 15, 0.94);
  }

  .demo-aside p { margin: var(--space-2) 0 0; color: var(--color-text-secondary); font-size: 0.77rem; line-height: 1.55; }
  .demo-content { min-width: 0; padding: clamp(1.5rem, 3vw, 3.5rem); }

  .translation-grid,
  .dossier-records,
  .site-shape-grid { display: grid; gap: 1px; margin-top: var(--space-6); border: 1px solid var(--color-surface-rule); background: var(--color-surface-rule); }

  .translation-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .translation-card { min-height: 16rem; padding: var(--space-5); background: var(--panel-wash); }
  .translation-card.is-projection { background: linear-gradient(145deg, rgba(31, 182, 168, 0.17), var(--panel-wash)); }
  .translation-card h3 { margin: var(--space-2) 0 var(--space-3); font-family: var(--font-display); font-size: 1.45rem; font-weight: 500; line-height: 1.1; }
  .translation-card p { color: var(--color-text-secondary); font-size: 0.91rem; line-height: 1.65; }

  .demo-note {
    margin: var(--space-6) 0 0;
    padding: var(--space-4) var(--space-5);
    border-left: 2px solid var(--color-accent-plasma);
    background: rgba(63, 224, 208, 0.055);
    color: var(--color-text-secondary);
    font-size: 0.92rem;
    line-height: 1.65;
  }

  .demo-note strong { color: var(--color-text-primary); }

  .dossier-section { border-color: rgba(63, 224, 208, 0.48); box-shadow: 0 0 3.5rem rgba(63, 224, 208, 0.06); }

  .dossier-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-5);
  }

  .dossier-header h2 {
    max-width: 13ch;
    margin: var(--space-3) 0 0;
    color: var(--color-text-display);
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.4vw, 4rem);
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 0.99;
  }

  .dossier-opening {
    max-width: 67ch;
    margin-top: var(--space-6);
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border: 1px solid rgba(63, 224, 208, 0.3);
    background: linear-gradient(135deg, rgba(63, 224, 208, 0.1), rgba(42, 35, 32, 0.84));
  }

  .dossier-opening p {
    color: var(--color-text-primary);
    font-family: var(--font-display);
    font-size: clamp(1.18rem, 2.1vw, 1.52rem);
    line-height: 1.5;
  }

  .dossier-opening p + p { margin-bottom: 0; }

  .dossier-records { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .dossier-record { display: flex; flex-direction: column; min-height: 22rem; padding: var(--space-5); background: var(--panel-deep); }
  .dossier-record:nth-child(2) { background: linear-gradient(165deg, rgba(128, 96, 255, 0.13), var(--panel-deep)); }
  .dossier-record:nth-child(3) { background: linear-gradient(165deg, rgba(232, 146, 60, 0.12), var(--panel-deep)); }
  .record-head { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); }
  .dossier-record h3 { margin: var(--space-5) 0 var(--space-3); font-family: var(--font-display); font-size: 1.55rem; font-weight: 500; line-height: 1.08; }
  .dossier-record p { color: var(--color-text-secondary); font-size: 0.91rem; line-height: 1.65; }
  .record-footer { display: grid; gap: var(--space-4); margin-top: auto; padding-top: var(--space-5); }
  .record-footer a { color: var(--color-accent-plasma); font-size: 0.83rem; text-decoration: none; }
  .record-footer a:hover { color: var(--color-accent-gold); }

  .demo-boundary {
    margin-top: var(--space-6);
    padding: var(--space-5);
    border: 1px solid var(--color-surface-rule);
    background: rgba(20, 17, 15, 0.88);
  }

  .demo-boundary p:last-child { max-width: 70ch; margin: var(--space-3) 0 0; color: var(--color-text-secondary); line-height: 1.65; }

  .site-shape-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .site-shape-card { min-height: 12rem; padding: var(--space-5); background: var(--panel-wash); }
  .site-shape-card.is-dossier { background: linear-gradient(155deg, rgba(63, 224, 208, 0.14), var(--panel-wash)); }
  .site-shape-card h3 { margin: var(--space-3) 0 var(--space-2); font-family: var(--font-display); font-size: 1.35rem; font-weight: 500; }
  .site-shape-card p { margin: 0; color: var(--color-text-secondary); font-size: 0.86rem; line-height: 1.6; }
  .demo-note.is-final { margin-bottom: 0; border-left-color: var(--color-accent-gold); background: rgba(232, 146, 60, 0.06); }

  @media (max-width: 760px) {
    .demo-header { position: static; }
    .demo-nav a { flex: 1 1 10rem; }
    .demo-hero,
    .demo-section { grid-template-columns: 1fr; }
    .demo-aside { border-right: 0; border-bottom: 1px solid var(--color-surface-rule); }
    .translation-grid,
    .dossier-records,
    .site-shape-grid { grid-template-columns: 1fr; }
    .dossier-header { display: grid; }
  }
</style>
