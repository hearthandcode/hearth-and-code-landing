---
import { getCollection, getEntry, render } from 'astro:content';
import JournalArticleLayout from '../../components/JournalArticleLayout.astro';
import ArticleContentHeading from '../../components/ArticleContentHeading.astro';
import { fieldJournalReadingMinutes } from '../../content/field-journal-expansions';
import { mdxComponents } from '../../mdx-components';

import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const entries = (await getCollection('journal')) as Array<CollectionEntry<'journal'>>;
  return entries.map((entry: CollectionEntry<'journal'>) => ({ params: { slug: entry.id }, props: { id: entry.id } }));
}

const { id } = Astro.props;
const entry = (await getEntry('journal', id)) as CollectionEntry<'journal'> | undefined;
if (!entry || entry.data.status !== 'published') return new Response('Not found', { status: 404 });
const { Content, headings } = await render(entry);
// Merge journal-specific overrides (h1) with HCAN-specific components so both
// rendering surfaces (Ember-Circuit components + article chrome) compose.
const components = { h1: ArticleContentHeading, ...mdxComponents };
---

<JournalArticleLayout
  title={entry.data.title}
  date={entry.data.published_date ?? entry.data.date}
  description={entry.data.description}
  tags={entry.data.tags ?? []}
  sources={entry.data.sources}
  headings={headings}
  labels={entry.data.labels}
  claims={entry.data.claim_map ?? []}
  featuredImage={entry.data.featured_image}
  featuredImageAlt={entry.data.featured_image_alt}
  readingTimeMinutes={fieldJournalReadingMinutes(entry.id, entry.data.reading_time_minutes)}
  slug={entry.id}
><Content components={components} /></JournalArticleLayout>
