---
import HearthNavigation from '../../components/HearthNavigation.astro';
import { PortfolioApp } from '../../components/ember-circuit/PortfolioApp';
import '../../styles/tokens.css';
import '../../styles/global.css';
import '../../styles/orientation-landing.css';
import '../../styles/ember-surface-framework.css';
import '../../styles/ember-circuit-library.css';
import '../../styles/research-studio-landing.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Hearth & Code project portfolio — six working surfaces, two bounded processes, and sixteen reference briefs."
    />
    <title>Portfolio — Hearth & Code</title>
  </head>
  <body class="studio-room-body studio-room-body--portfolio">
    <a class="studio-skip" href="#main-content">Skip to the portfolio</a>
    <HearthNavigation current="exocore" context="Working surface" />
    <main id="main-content" class="studio-room-main">
      <PortfolioApp client:load />
    </main>
  </body>
</html>
