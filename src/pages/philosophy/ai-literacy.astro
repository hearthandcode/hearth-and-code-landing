  .ec-policy-page {
    width: min(100% - 2rem, 70ch);
    margin-inline: auto;
    padding: clamp(2rem, 5vw, 4rem) 0 clamp(4rem, 8vw, 7rem);
    color: var(--color-text-primary);
  }

  .ec-policy-page .ec-page-header {
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-surface-rule);
  }

  .ec-policy-page .ec-eyebrow,
  .ec-policy-page .ec-review-note,
  .ec-policy-page .ec-revision-section {
    color: var(--color-text-secondary);
  }

  .ec-policy-page h1 {
    color: var(--color-text-display);
    font: 400 clamp(2.35rem, 7vw, 4.5rem)/1.05 var(--font-display);
    text-wrap: balance;
  }

  .ec-policy-page h2 {
    margin: 2.5rem 0 .8rem;
    color: var(--color-accent-gold);
    font: 400 clamp(1.4rem, 4vw, 1.9rem)/1.2 var(--font-display);
  }

  .ec-policy-page p,
  .ec-policy-page li { color: var(--color-text-secondary); line-height: 1.75; }
  .ec-policy-page li { margin-block: .45rem; }
  .ec-policy-page a { color: var(--color-accent-plasma); text-underline-offset: .18em; }
  .ec-policy-page a:hover { color: var(--color-text-primary); }
  .ec-policy-page ol,
  .ec-policy-page ul { padding-left: 1.35rem; }

  .ec-policy-page .ec-review-note {
    margin-top: 1.25rem;
    padding: .85rem 1rem;
    border-left: 3px solid var(--color-accent-gold);
    background: var(--color-surface-raised);
    line-height: 1.6;
  }

  .ec-policy-page .ec-meta {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: .65rem;
    margin: 1.25rem 0 0;
  }

  .ec-policy-page .ec-meta > div {
    min-width: 0;
    padding: .7rem .8rem;
    border: 1px solid var(--color-surface-rule);
    border-radius: var(--radius-md);
    background: var(--color-surface-raised);
  }

  .ec-policy-page .ec-meta dt {
    color: var(--color-text-secondary);
    font: 600 .68rem/1.4 var(--font-mono);
    letter-spacing: .04em;
    text-transform: uppercase;
  }

  .ec-policy-page .ec-meta dd {
    margin: .35rem 0 0;
    color: var(--color-text-primary);
    font-size: .9rem;
    line-height: 1.45;
  }

  .ec-policy-page .ec-meta dd.ec-status-review { color: var(--color-accent-gold); font-weight: 600; }

  .ec-policy-page .ec-callout-block,
  .ec-policy-page .ec-counterargument {
    margin: 1.5rem 0;
    padding: clamp(1rem, 3vw, 1.5rem);
    border: 1px solid var(--color-surface-rule);
    border-left: 4px solid var(--color-accent-ember);
    border-radius: var(--radius-md);
    background: var(--color-surface-raised);
  }

  .ec-policy-page .ec-counterargument {
    border-left-color: var(--color-accent-plasma);
    background: var(--color-surface-recessed);
  }

  .ec-claims-list { list-style: decimal; padding-left: 1.35rem; }
  .ec-sources-section,
  .ec-revision-section {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-surface-rule);
  }
  .ec-sources-section h2 { color: var(--color-accent-plasma); font: 600 .75rem/1.4 var(--font-mono); letter-spacing: .06em; text-transform: uppercase; }
  .ec-sources-list { padding-left: 1.35rem; font-size: .88rem; }
  .ec-sources-list li { margin-bottom: .8rem; overflow-wrap: anywhere; }
  .ec-revision-section { color: var(--color-text-secondary); font-size: .88rem; }

  @media (max-width: 36rem) {
    .ec-policy-page { width: min(100% - 1.5rem, 70ch); }
    .ec-policy-page .ec-meta { grid-template-columns: 1fr; gap: .5rem; }
  }
</style>
