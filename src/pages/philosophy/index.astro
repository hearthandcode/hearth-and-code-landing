---
/** Public Philosophy position ledger. Content is defined in philosophy-page.yaml. */
import { readFileSync } from 'node:fs';
import { parse } from 'yaml';
import '../../styles/tokens.css';
import '../../styles/global.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StudioNavigation from '../../components/StudioNavigation.astro';

// Static builds execute from the project root; keep this contract source-owned
// instead of resolving it relative to the generated prerender bundle.
const contract = parse(
  readFileSync('./src/data/philosophy-page.yaml', 'utf-8'),
);
---

<BaseLayout title={contract.page.title} description={contract.page.description}>
  <StudioNavigation current={contract.page.navigation_current} disposition="Philosophy · public positions for human judgment" />
  <main class="philosophy" id="page-main">
    <section class="philosophy-hero" aria-labelledby="philosophy-title">
      <div class="philosophy-shell">
        <p class="philosophy-kicker">{contract.hero.eyebrow}</p>
        <h1 id="philosophy-title">{contract.hero.title}</h1>
        <p class="philosophy-hero__lede">{contract.hero.lede}</p>
        <aside class="philosophy-disposition">
          <p class="philosophy-disposition__label">{contract.page.disposition.label}</p>
          <p>{contract.page.disposition.statement}</p>
          <p class="philosophy-disposition__boundary">{contract.page.disposition.boundary}</p>
        </aside>
      </div>
    </section>

    <section class="philosophy-section philosophy-section--recessed" aria-labelledby="reading-title">
      <div class="philosophy-shell">
        <header class="philosophy-intro">
          <p class="philosophy-kicker">How to read this surface</p>
          <h2 id="reading-title">A public position is a working object.</h2>
        </header>
        <div class="philosophy-principles">
          {contract.principles.map((principle: any, index: number) => (
            <article class="philosophy-principle">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{principle.title}</h3>
              <p>{principle.detail}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="philosophy-section" aria-labelledby="featured-title">
      <div class="philosophy-shell">
        <header class="philosophy-intro">
          <p class="philosophy-kicker">Featured published position</p>
          <h2 id="featured-title">Start with a complete public reading.</h2>
        </header>
        <article class="philosophy-feature">
          <div class="philosophy-feature__meta">
            <span class="philosophy-state is-published">{contract.featured_position.status_label}</span>
            <time datetime={contract.featured_position.date}>{contract.featured_position.date}</time>
            <span>{contract.featured_position.read_time}</span>
          </div>
          <div class="philosophy-feature__body">
            <div>
              <h3>{contract.featured_position.title}</h3>
              <p>{contract.featured_position.summary}</p>
              <div class="philosophy-tags">
                {contract.featured_position.domains.map((domain: string) => <span>{domain}</span>)}
              </div>
            </div>
            <a class="philosophy-action philosophy-action--primary" href={contract.featured_position.href} data-position-preview aria-controls="ai-literacy-preview">{contract.featured_position.action_label} <span aria-hidden="true">→</span></a>
          </div>
        </article>
      </div>
    </section>

    <dialog class="philosophy-preview" id="ai-literacy-preview" aria-labelledby="ai-literacy-preview-title">
      <div class="philosophy-preview__chrome">
        <p>{contract.featured_position.preview.label}</p>
        <form method="dialog"><button type="submit" aria-label="Close AI Literacy preview">Close <span aria-hidden="true">×</span></button></form>
      </div>
      <article class="philosophy-preview__article">
        <p class="philosophy-kicker">Published position · {contract.featured_position.date}</p>
        <h2 id="ai-literacy-preview-title">{contract.featured_position.title}</h2>
        <p class="philosophy-preview__lede">{contract.featured_position.preview.lede}</p>
        <div class="philosophy-preview__sections">
          {contract.featured_position.preview.sections.map((section: any, index: number) => (
            <section>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{section.title}</h3>
              {section.body.map((paragraph: string) => <p>{paragraph}</p>)}
              {section.points && (
                <ol>{section.points.map((point: string) => <li>{point}</li>)}</ol>
              )}
              {section.evidence && (
                <aside class="philosophy-preview__evidence">
                  <strong>Evidence notes</strong>
                  <ul>{section.evidence.map((note: string) => <li>{note}</li>)}</ul>
                </aside>
              )}
              {section.revision_note && <p class="philosophy-preview__revision">{section.revision_note}</p>}
            </section>
          ))}
        </div>
        <p class="philosophy-preview__boundary">{contract.featured_position.preview.boundary}</p>
        <form method="dialog" class="philosophy-preview__footer"><button type="submit">Return to Philosophy <span aria-hidden="true">←</span></button></form>
      </article>
    </dialog>

    <section class="philosophy-section philosophy-section--ledger" aria-labelledby="ledger-title">
      <div class="philosophy-shell">
        <header class="philosophy-intro philosophy-intro--wide">
          <p class="philosophy-kicker">{contract.position_ledger.title}</p>
          <h2 id="ledger-title">State is part of the claim.</h2>
          <p>{contract.position_ledger.description}</p>
        </header>
        <div class="philosophy-ledger">
          {contract.position_ledger.entries.map((entry: any) => (
            entry.href ? (
              <a class={`philosophy-ledger__entry is-${entry.state}`} href={entry.href} data-position-preview aria-controls="ai-literacy-preview">
                <div class="philosophy-ledger__state"><span class={`philosophy-state is-${entry.state}`}>{entry.state_label}</span><span aria-hidden="true">↗</span></div>
                <h3>{entry.title}</h3>
                <p>{entry.summary}</p>
                <div class="philosophy-tags">{entry.domains.map((domain: string) => <span>{domain}</span>)}</div>
              </a>
            ) : (
              <article class={`philosophy-ledger__entry is-${entry.state}`}>
                <div class="philosophy-ledger__state"><span class={`philosophy-state is-${entry.state}`}>{entry.state_label}</span><span class="philosophy-held">Held record</span></div>
                <h3>{entry.title}</h3>
                <p>{entry.summary}</p>
                <div class="philosophy-tags">{entry.domains.map((domain: string) => <span>{domain}</span>)}</div>
              </article>
            )
          ))}
        </div>
      </div>
    </section>

    <section class="philosophy-section" aria-labelledby="throughlines-title">
      <div class="philosophy-shell">
        <header class="philosophy-intro philosophy-intro--wide">
          <p class="philosophy-kicker">{contract.throughlines.title}</p>
          <h2 id="throughlines-title">Questions that recur across the work.</h2>
          <p>{contract.throughlines.description}</p>
        </header>
        <div class="philosophy-throughlines">
          {contract.throughlines.items.map((item: any) => (
            <article><h3>{item.title}</h3><p>{item.detail}</p></article>
          ))}
        </div>
      </div>
    </section>

    <section class="philosophy-section philosophy-section--recessed" aria-labelledby="connections-title">
      <div class="philosophy-shell">
        <header class="philosophy-intro philosophy-intro--wide">
          <p class="philosophy-kicker">{contract.connections.title}</p>
          <h2 id="connections-title">A position should change what we can do.</h2>
        </header>
        <div class="philosophy-connections">
          {contract.connections.items.map((item: any, index: number) => (
            <a href={item.href}>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{item.title}</h3>
              <p>{item.detail}</p>
              <strong>{item.action_label} <i aria-hidden="true">→</i></strong>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="philosophy-return" aria-labelledby="return-title">
      <div class="philosophy-shell">
        <p class="philosophy-kicker">Return boundary</p>
        <h2 id="return-title">{contract.return.title}</h2>
        <p>{contract.return.detail}</p>
        <div>
          <a class="philosophy-action philosophy-action--primary" href={contract.return.primary_action.href}>{contract.return.primary_action.label}</a>
          <a class="philosophy-action" href={contract.return.secondary_action.href}>{contract.return.secondary_action.label}</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .philosophy { background: var(--color-surface-primary); color: var(--color-text-primary); }
  .philosophy-shell { width: min(100% - 3rem, 76rem); margin-inline: auto; }
  .philosophy-kicker { margin: 0 0 0.75rem; color: var(--color-accent-gold); font: 500 0.75rem/1.25 var(--font-mono); letter-spacing: 0.14em; text-transform: uppercase; }
  .philosophy-hero { padding: clamp(5rem, 12vw, 9rem) 0 clamp(4rem, 8vw, 6rem); border-bottom: 1px solid var(--color-surface-rule); background: radial-gradient(60rem 38rem at 80% 0%, rgba(155, 93, 229, 0.14), transparent 60%); }
  .philosophy-hero h1 { max-width: 15ch; margin: 0; color: var(--color-text-display); font: 700 clamp(3rem, 7vw, 6.3rem)/0.96 var(--font-display); letter-spacing: -0.055em; }
  .philosophy-hero__lede { max-width: 47rem; margin: 1.5rem 0 0; color: var(--color-text-secondary); font-size: clamp(1.1rem, 2vw, 1.35rem); line-height: 1.55; }
  .philosophy-disposition { max-width: 54rem; margin-top: 2.5rem; padding: 1.25rem 1.5rem; border: 1px solid var(--color-surface-rule); border-left: 3px solid var(--color-accent-violet); background: rgba(33, 29, 24, 0.9); }
  .philosophy-disposition p { margin: 0; line-height: 1.6; }
  .philosophy-disposition__label { margin-bottom: 0.5rem !important; color: var(--color-accent-violet); font: 0.7rem var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; }
  .philosophy-disposition__boundary { margin-top: 0.75rem !important; color: var(--color-text-secondary); font-size: 0.9rem; }

  .philosophy-section { padding: clamp(4rem, 8vw, 7rem) 0; border-bottom: 1px solid var(--color-surface-rule); }
  .philosophy-section--recessed, .philosophy-section--ledger { background: var(--color-surface-recessed); }
  .philosophy-intro { max-width: 42rem; }
  .philosophy-intro--wide { max-width: 48rem; }
  .philosophy-intro h2, .philosophy-return h2 { margin: 0; color: var(--color-text-display); font: 700 clamp(2rem, 4vw, 3.4rem)/1.03 var(--font-display); letter-spacing: -0.035em; }
  .philosophy-intro > p:last-child { margin: 1rem 0 0; color: var(--color-text-secondary); line-height: 1.6; }

  .philosophy-principles, .philosophy-throughlines, .philosophy-connections { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; margin-top: 2.25rem; border: 1px solid var(--color-surface-rule); background: var(--color-surface-rule); }
  .philosophy-principle, .philosophy-throughlines article { padding: 1.5rem; background: var(--color-surface-raised); }
  .philosophy-principle > span, .philosophy-connections a > span { color: var(--color-accent-gold); font: 0.7rem var(--font-mono); }
  .philosophy-principle h3, .philosophy-throughlines h3, .philosophy-ledger h3, .philosophy-feature h3, .philosophy-connections h3 { margin: 1rem 0 0; color: var(--color-text-display); font: 700 1.4rem/1.1 var(--font-display); }
  .philosophy-principle p, .philosophy-throughlines p, .philosophy-ledger p, .philosophy-feature p, .philosophy-connections p { color: var(--color-text-secondary); line-height: 1.55; }

  .philosophy-feature { margin-top: 2.25rem; border: 1px solid var(--color-surface-rule-strong); border-left: 3px solid var(--color-accent-signal); background: var(--color-surface-raised); }
  .philosophy-preview { width: min(100% - 2rem, 62rem); max-height: min(80vh, 50rem); padding: 0; overflow: auto; border: 1px solid var(--color-surface-rule-strong); background: var(--color-surface-primary); color: var(--color-text-primary); box-shadow: var(--shadow-overlay); }
  .philosophy-preview::backdrop { background: rgba(4, 5, 7, 0.76); backdrop-filter: blur(5px); }
  .philosophy-preview__chrome { position: sticky; top: 0; z-index: 1; display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-surface-rule); background: rgba(22, 20, 17, 0.96); }
  .philosophy-preview__chrome p { margin: 0; color: var(--color-accent-violet); font: 0.7rem var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; }
  .philosophy-preview button { min-height: 2.25rem; padding: 0 0.7rem; border: 1px solid var(--color-surface-rule); background: transparent; color: var(--color-text-display); font: 0.75rem var(--font-mono); cursor: pointer; }
  .philosophy-preview button:hover { border-color: var(--color-accent-signal); color: var(--color-accent-signal); }
  .philosophy-preview__article { padding: clamp(1.5rem, 5vw, 4rem); }
  .philosophy-preview__article h2 { max-width: 18ch; margin: 0; color: var(--color-text-display); font: 700 clamp(2.2rem, 5vw, 4.3rem)/1 var(--font-display); letter-spacing: -0.04em; }
  .philosophy-preview__lede { max-width: 48rem; margin: 1.25rem 0 0; color: var(--color-text-secondary); font-size: 1.125rem; line-height: 1.6; }
  .philosophy-preview__sections { display: grid; gap: 1px; margin-top: 2rem; border: 1px solid var(--color-surface-rule); background: var(--color-surface-rule); }
  .philosophy-preview__sections section { padding: 1.25rem; background: var(--color-surface-raised); }
  .philosophy-preview__sections span { color: var(--color-accent-gold); font: 0.7rem var(--font-mono); }
  .philosophy-preview__sections h3 { margin: 0.6rem 0 0; color: var(--color-text-display); font: 700 1.35rem/1.1 var(--font-display); }
  .philosophy-preview__sections p, .philosophy-preview__boundary { margin: 0.75rem 0 0; color: var(--color-text-secondary); line-height: 1.6; }
  .philosophy-preview__sections ol { display: grid; gap: 0.45rem; margin: 1rem 0 0; padding-left: 1.35rem; color: var(--color-text-primary); line-height: 1.5; }
  .philosophy-preview__evidence { margin-top: 1rem; padding: 0.9rem 1rem; border-left: 2px solid var(--color-accent-signal); background: rgba(31, 182, 168, 0.07); }
  .philosophy-preview__evidence strong { color: var(--color-accent-signal); font: 0.7rem var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; }
  .philosophy-preview__evidence ul { display: grid; gap: 0.35rem; margin: 0.65rem 0 0; padding-left: 1.1rem; color: var(--color-text-secondary); font-size: 0.875rem; line-height: 1.45; }
  .philosophy-preview__revision { color: var(--color-accent-violet) !important; font-size: 0.875rem; }
  .philosophy-preview__boundary { padding-left: 1rem; border-left: 2px solid var(--color-accent-violet); font-size: 0.9rem; }
  .philosophy-preview__footer { display: flex; justify-content: flex-end; margin-top: 2rem; }
  .philosophy-feature__meta { display: flex; gap: 0.75rem; flex-wrap: wrap; padding: 1rem 1.5rem; border-bottom: 1px solid var(--color-surface-rule); color: var(--color-text-secondary); font: 0.7rem var(--font-mono); }
  .philosophy-feature__body { display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 2rem; padding: clamp(1.5rem, 4vw, 2.5rem); }
  .philosophy-feature h3 { font-size: clamp(1.75rem, 3vw, 2.6rem); }
  .philosophy-feature p { max-width: 44rem; font-size: 1.0625rem; }
  .philosophy-state { display: inline-flex; width: max-content; padding: 0.25rem 0.5rem; border: 1px solid currentColor; font: 0.65rem/1 var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; }
  .is-published { color: var(--color-accent-signal); } .is-developing { color: var(--color-accent-gold); } .is-concept { color: var(--color-accent-violet); }
  .philosophy-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 1rem; }
  .philosophy-tags span { padding: 0.2rem 0.4rem; border: 1px solid var(--color-surface-rule); color: var(--color-text-secondary); font: 0.65rem var(--font-mono); }

  .philosophy-ledger { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 2.25rem; }
  .philosophy-ledger__entry { display: flex; flex-direction: column; min-height: 19rem; padding: 1.5rem; border: 1px solid var(--color-surface-rule); background: var(--color-surface-raised); color: inherit; text-decoration: none; }
  a.philosophy-ledger__entry:hover { border-color: var(--color-accent-signal); background: rgba(31, 182, 168, 0.06); }
  .philosophy-ledger__state { display: flex; justify-content: space-between; gap: 0.75rem; align-items: center; color: var(--color-text-secondary); font: 0.8rem var(--font-mono); }
  .philosophy-held { color: var(--color-text-secondary); font-size: 0.7rem; font-style: italic; }
  .philosophy-ledger__entry .philosophy-tags { margin-top: auto; }

  .philosophy-connections a { display: block; min-height: 16rem; padding: 1.5rem; background: var(--color-surface-raised); color: inherit; text-decoration: none; }
  .philosophy-connections a:hover { background: rgba(31, 182, 168, 0.08); }
  .philosophy-connections strong { display: block; margin-top: 1.5rem; color: var(--color-accent-signal); font: 0.75rem var(--font-mono); }
  .philosophy-connections i { font-size: 1.1rem; font-style: normal; }

  .philosophy-return { padding: clamp(4rem, 9vw, 7rem) 0; text-align: center; background: linear-gradient(120deg, rgba(155, 93, 229, 0.18), var(--color-surface-primary) 60%, rgba(31, 182, 168, 0.1)); }
  .philosophy-return .philosophy-shell { max-width: 52rem; }
  .philosophy-return > .philosophy-shell > p:not(.philosophy-kicker) { max-width: 42rem; margin: 1.25rem auto 0; color: var(--color-text-secondary); line-height: 1.65; }
  .philosophy-return .philosophy-kicker { text-align: center; }
  .philosophy-return > .philosophy-shell > div { display: flex; justify-content: center; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .philosophy-action { display: inline-flex; align-items: center; justify-content: center; min-height: 2.75rem; padding: 0 1rem; border: 1px solid var(--color-surface-rule); color: var(--color-text-display); font: 500 0.875rem var(--font-body); text-decoration: none; }
  .philosophy-action:hover { border-color: var(--color-accent-signal); color: var(--color-accent-signal); }
  .philosophy-action--primary { border-color: var(--color-accent-signal); background: var(--color-accent-signal); color: var(--color-surface-primary); }
  .philosophy-action--primary:hover { background: var(--color-accent-plasma); color: var(--color-surface-primary); }

  @media (max-width: 56rem) {
    .philosophy-principles, .philosophy-throughlines, .philosophy-connections, .philosophy-ledger { grid-template-columns: 1fr; }
    .philosophy-feature__body { grid-template-columns: 1fr; align-items: start; }
    .philosophy-feature__body .philosophy-action { justify-self: start; }
  }
  @media (max-width: 36rem) { .philosophy-shell { width: min(100% - 2rem, 76rem); } .philosophy-hero h1 { font-size: clamp(2.75rem, 15vw, 4rem); } }
</style>

<script>
  const preview = document.getElementById('ai-literacy-preview') as HTMLDialogElement | null;
  document.querySelectorAll<HTMLAnchorElement>('[data-position-preview]').forEach((trigger) => {
    trigger.addEventListener('click', (event) => {
      if (!preview || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      preview.showModal();
    });
  });
</script>
