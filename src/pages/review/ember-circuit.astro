---
import '../../styles/ember-circuit-review.css';
import '../../styles/research-lab.css';
import '../../styles/ember-research-system.css';
import '../../styles/ember-surface-framework.css';
import HearthNavigation from '../../components/HearthNavigation.astro';

type Mark = [string, string, string, string, string[], number[][]];

const marks: Mark[] = [
  ['Open Index','Advance','One spine organizes three entries and an open next point.','May read as E, menu, shelf, or circuit bus.',['M12 10V54M12 14H46M12 32H42M12 50H44'],[[56,50]]],
  ['Return Folio','Advance','An open folio keeps a documented route back to the record.','May read as a generic book or heart.',['M4 16Q18 10 28 18Q38 10 48 16V48Q38 42 28 50Q18 42 4 48Z','M28 18V50M28 50H48'],[[60,50]]],
  ['Atlas Window','Hold','Three fields leave an open region for a named route.','May read as an app grid or dashboard.',['M8 8H28V28H8ZM36 8H56V28H36ZM8 36H28V56H8','M36 56V46Q36 36 46 36H52'],[[58,36]]],
  ['Evidence Spine','Advance','A source spine keeps three entries visible and returns to one endpoint.','May read as F, timeline, or circuit bus.',['M22 10V46Q22 54 30 54H48M22 16H46M22 28H40M22 40H46'],[[52,54]]],
  ['Source Joinery','Hold','Two inputs enter a shared joint while remaining separate.','May imply partners, a team, network, H, or plug.',['M10 18H26Q32 18 32 24V48M54 18H38Q32 18 32 24','M10 46H20Q26 46 26 40V30M54 46H44Q38 46 38 40V30'],[[10,18],[54,46]]],
  ['Catalog Stack','Hold','Three offset records preserve lineage around one selected item.','May read as files, database, archive, or browser windows.',['M14 18H46V50H14ZM20 12H52V44M26 6H58V38','M14 34H30'],[[36,34]]],
  ['Open Register','Compare','An open register keeps entries visible and lets one relation leave.','May read as code, menu, circuit board, or external link.',['M48 10H14V54H48M14 20H26M14 32H32M14 44H26','M42 26V38H54'],[[56,38]]],
  ['Circuit Hearth','Reject','An open enclosure places a register around one central node.','Reads as fireplace, building, temple, device, or lab insignia.',['M10 50V28Q10 12 26 12H38Q54 12 54 28V50','M20 50V32H44V50M20 38H44'],[[32,28]]]
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="description" content="Local candidate review proof for the Hearth & Code Ember Circuit visualization theme." />
  <link rel="icon" href="data:," />
  <title>Hearth & Code — Ember Circuit theme study (candidate)</title>
</head>
<body class="research-body research-body--review ec-body ember-surface">
  <a class="research-skip" href="#main-content">Skip to the review proof</a>
  <HearthNavigation context="Ember Circuit / local theme review" />
  <main id="main-content" class="research-main ec-review">
    <article>
      <header class="ec-intro">
        <p class="ec-kicker">Candidate visualization grammar · version 0.1</p>
        <h1>Ember Circuit turns research structure into a visible reading path.</h1>
        <p class="ec-lede">This page tests a proposed Hearth &amp; Code theme. Warmth marks human ownership and return; circuitry names literal relations among questions, sources, small proofs, evidence, and correction. It is not a product, scientific credential, final logo, or capability claim.</p>
        <dl class="ec-meta">
          <div><dt>Surface</dt><dd>Local review route</dd></div>
          <div><dt>Structure</dt><dd>4 families · 8 specimens</dd></div>
          <div><dt>Runtime</dt><dd>Static HTML and CSS</dd></div>
          <div><dt>Selection</dt><dd>No final direction</dd></div>
        </dl>
        <nav class="ec-nav" aria-labelledby="contents-title">
          <p id="contents-title">Review by family</p>
          <ol><li><a href="#foundation">01 Foundation</a></li><li><a href="#interface">02 Interface</a></li><li><a href="#knowledge">03 Knowledge</a></li><li><a href="#identity">04 Identity</a></li></ol>
        </nav>
      </header>

      <section id="foundation" class="ec-family" aria-labelledby="foundation-title">
        <header><p class="ec-index">Family 01 / 04</p><h2 id="foundation-title">Foundation</h2><p>Color and type establish a calm editorial base before circuitry appears.</p></header>
        <div class="ec-grid">
          <article class="ec-card" aria-labelledby="color-title">
            <p class="ec-label">Specimen 01</p><h3 id="color-title">Color and contrast</h3><p>Semantic roles stay literal. Status is repeated in words or shape.</p>
            <dl class="ec-swatches">
              <div class="cream"><dt>Cream on primary</dt><dd>14.52:1 · body text</dd></div>
              <div class="ember"><dt>Ember on primary</dt><dd>7.28:1 · human selection</dd></div>
              <div class="signal"><dt>Signal on primary</dt><dd>10.82:1 · links and computation</dd></div>
              <div class="error"><dt>Error boundary</dt><dd>Forge border + literal label</dd></div>
              <div class="rejected plasma"><dt>Plasma / cream</dt><dd>1.34:1 · rejected normal text</dd></div>
              <div class="rejected ember-paper"><dt>Ember / cream</dt><dd>1.99:1 · rejected normal text</dd></div>
              <div class="rejected forge-paper"><dt>Forge / cream</dt><dd>3.58:1 · rejected normal text</dd></div>
            </dl>
          </article>
          <article class="ec-card" aria-labelledby="type-title">
            <p class="ec-label">Specimen 02</p><h3 id="type-title">Typography and scale</h3>
            <p class="ec-display">Questions need room to breathe.</p>
            <p>Explanation stays direct, source-aware, and comfortable across a measured line.</p>
            <p class="ec-mono">STATE / EXPERIMENTAL · UPDATED / 2026-08-11</p>
            <dl class="ec-triplet"><div><dt>Meaning</dt><dd>System serif</dd></div><div><dt>Explanation</dt><dd>System sans</dd></div><div><dt>State</dt><dd>System monospace</dd></div></dl>
          </article>
        </div>
      </section>

      <section id="interface" class="ec-family" aria-labelledby="interface-title">
        <header><p class="ec-index">Family 02 / 04</p><h2 id="interface-title">Interface</h2><p>Actions, evidence, and limits remain clear without animation, color, or JavaScript.</p></header>
        <div class="ec-grid">
          <article class="ec-card ec-light" aria-labelledby="actions-title">
            <p class="ec-label">Specimen 03</p><h3 id="actions-title">Actions and focus</h3><p>Descriptive controls use generous targets and adaptive focus.</p>
            <div class="ec-actions"><a class="ec-button primary" href="#evidence-title">Inspect the evidence pattern</a><button class="ec-button" disabled>Public release unavailable</button></div>
            <p class="ec-note">The unavailable state is literal and cannot receive focus.</p>
          </article>
          <article class="ec-card" aria-labelledby="evidence-title">
            <p class="ec-label">Specimen 04</p><h3 id="evidence-title">Evidence and status</h3>
            <p class="ec-status"><span aria-hidden="true">◇</span> Experimental · Candidate</p>
            <p>A static page tests whether the grammar can explain itself without live telemetry.</p>
            <dl class="ec-evidence"><div><dt>Type</dt><dd>Local visual proof</dd></div><div><dt>Maturity</dt><dd>Experimental candidate</dd></div><div><dt>Evidence</dt><dd>Rendered HTML, CSS, and comparison captures</dd></div><div><dt>Limitation</dt><dd>No reader study, release, or final mark</dd></div><div><dt>Updated</dt><dd>2026-08-11</dd></div><div><dt>Correction</dt><dd>Return findings to human review</dd></div></dl>
          </article>
        </div>
      </section>

      <section id="knowledge" class="ec-family" aria-labelledby="knowledge-title">
        <header><p class="ec-index">Family 03 / 04</p><h2 id="knowledge-title">Knowledge</h2><p>The Library holds reviewed records. The Atlas reveals named relations among the same records.</p></header>
        <div class="ec-grid">
          <article class="ec-card" aria-labelledby="library-title">
            <p class="ec-label">Specimen 05</p><h3 id="library-title">Library index</h3>
            <ol class="ec-library"><li><a href="#atlas-title"><span>Question record</span><small>Research note · current</small></a></li><li><a href="#evidence-title"><span>Small proof</span><small>Implementation · experimental</small></a></li><li><a href="#marks-title"><span>Visual comparison</span><small>Design study · candidate</small></a></li><li><a href="#main-content"><span>Return note</span><small>Review route · available here</small></a></li></ol>
          </article>
          <article class="ec-card" aria-labelledby="atlas-title">
            <p class="ec-label">Specimen 06</p><h3 id="atlas-title">Atlas relation</h3>
            <figure class="ec-atlas"><svg viewBox="0 0 640 260" aria-hidden="true" focusable="false"><path d="M80 60H240v60h150v70h170M560 190v45H80V60"/><rect x="40" y="34" width="110" height="52" rx="8"/><rect x="210" y="94" width="110" height="52" rx="8"/><rect x="360" y="164" width="110" height="52" rx="8"/><rect x="520" y="164" width="80" height="52" rx="8"/></svg><figcaption>The decorative circuit mirrors the four written relations below.</figcaption></figure>
            <ol class="ec-relations"><li>A source informs a question.</li><li>The question directs a small proof.</li><li>The proof produces evidence and limits.</li><li>Review returns corrections to the record.</li></ol>
          </article>
        </div>
      </section>

      <section id="identity" class="ec-family" aria-labelledby="identity-title">
        <header><p class="ec-index">Family 04 / 04</p><h2 id="identity-title">Identity</h2><p>Hearth &amp; Code remains the master brand. Theme and symbols remain subordinate candidates.</p></header>
        <div class="ec-grid">
          <article class="ec-card" aria-labelledby="lockup-title">
            <p class="ec-label">Specimen 07</p><h3 id="lockup-title">Master brand and theme lockup</h3>
            <figure class="ec-lockup"><svg viewBox="0 0 96 96" aria-hidden="true" focusable="false"><path d="M18 20v56h24M18 48h22M78 20v56H54M78 48H56"/><circle cx="48" cy="48" r="7"/></svg><figcaption><strong>Hearth &amp; Code</strong><span>Ember Circuit · candidate visualization theme</span></figcaption></figure>
            <p>The symbol is decorative. It identifies no product, platform, or capability.</p>
          </article>
          <article class="ec-card ec-marks" aria-labelledby="marks-title">
            <p class="ec-label">Specimen 08</p><h3 id="marks-title">Eight-mark comparison</h3><p>Advance means test further, not selected.</p>
            <ol class="ec-mark-grid">
              {marks.map((mark, index) => <li class={'ec-mark ' + mark[1].toLowerCase()}><figure><div class="ec-mark-sample">{[16,24,32,48,64].map(size => <span><svg viewBox="0 0 64 64" style={'inline-size:' + size + 'px'} aria-hidden="true" focusable="false">{mark[4].map(path => <path d={path}/>)}{mark[5].map(node => <circle cx={node[0]} cy={node[1]} r="4"/>)}</svg><small>{size}</small></span>)}</div><figcaption><span class="ec-number">{String(index + 1).padStart(2,'0')}</span><strong>{mark[0]}</strong><span class="ec-mark-status">{mark[1]}</span><span>{mark[2]}</span><small>Alternate reading: {mark[3]}</small></figcaption></figure></li>)}
            </ol>
          </article>
        </div>
      </section>
    </article>
  </main>
  <footer class="research-footer ec-footer"><span>Hearth &amp; Code · local design review</span><span>Candidate · unselected · not released</span><a href="#main-content">Return to the beginning ↑</a></footer>
</body>
</html>
