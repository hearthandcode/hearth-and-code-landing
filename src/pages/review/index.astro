---
import ReviewShell from '../../components/ReviewShell.astro';
import BuilderReturn from '../../components/meet-builder/BuilderReturn.astro';
import CurrentSignal from '../../components/meet-builder/CurrentSignal.astro';
import KnowledgeAtlas from '../../components/meet-builder/KnowledgeAtlas.astro';
import KnowledgeLibrary from '../../components/meet-builder/KnowledgeLibrary.astro';
import PublicEvidence from '../../components/meet-builder/PublicEvidence.astro';
import ResearchLab from '../../components/meet-builder/ResearchLab.astro';
import ResearchLoop from '../../components/meet-builder/ResearchLoop.astro';
import ThresholdHero from '../../components/meet-builder/ThresholdHero.astro';
import '../../styles/meet-builder.css';
import { emberCircuitModules, moduleFragments } from '../../data/meet-builder';

const { publicSite = false } = Astro.props;
---

<ReviewShell
  title="Meet the Builder"
  description="Hearth & Code is a one-person research and creative-technology practice testing tools, methods, and connected knowledge work."
  current="hearth"
  publicSite={publicSite}
>
  <article class="meet-builder" data-ec-system="editorial-circuit" data-ec-module-count={emberCircuitModules.length} data-ec-scale="binary-editorial">
    <ThresholdHero />

    <nav class="meet-contents" aria-label="On this page">
      <span>On this page</span>
      <a href={`#${moduleFragments.investigations}`}>Current investigations</a>
      <a href={`#${moduleFragments.library}`}>Knowledge library</a>
      <a href={`#${moduleFragments.method}`}>Methods and evidence</a>
      <a href={`#${moduleFragments.return}`}>Builder and return</a>
    </nav>

    <ResearchLab />
    <CurrentSignal publicSite={publicSite} />
    <PublicEvidence publicSite={publicSite} />
    <KnowledgeLibrary publicSite={publicSite} />
    <KnowledgeAtlas />
    <ResearchLoop publicSite={publicSite} />
    <BuilderReturn publicSite={publicSite} />
  </article>
</ReviewShell>
