---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import HearthNavigation from '../../components/HearthNavigation.astro';
import { hearthsideArticles } from '../../content/hearthside-articles';
import { fieldcraftLibrary } from '../../data/fieldcraft';
import '../../styles/tokens.css';
import '../../styles/global.css';
import '../../styles/ember-circuit-library.css';

const journal = (await getCollection('journal')) as CollectionEntry<'journal'>[];
const articles = [
  ...hearthsideArticles.map((article) => ({ code: article.code, format: article.format ?? 'Hearthside essay', title: article.title, dek: article.dek, readTime: article.readTime, themes: article.themes, href: `/notes/${article.slug}/` })),
  ...journal.map((entry, index) => ({ code: `FJ-${String(index + 1).padStart(2, '0')}`, format: 'Field Journal', title: entry.data.title, dek: entry.data.description, readTime: `${entry.data.reading_time_minutes ?? 8} min read`, themes: entry.data.tags ?? entry.data.labels, href: `/journal/${entry.id}/` })),
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="The Hearth & Code Research Library: essays, Field Journal entries, fieldcraft methods, and the adjacent sacred commons." />
    <meta name="theme-color" content="#161411" />
    <title>Research Library · Hearth & Code</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,300..900&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <style is:inline>
      /* Library page — unified token system (DESIGN-SYSTEM.md) */
      :root {
        --color-surface-primary: #161411;
        --color-surface-raised: #211d18;
        --color-surface-recessed: #0e1114;
        --color-surface-rule: #4b4237;
        --color-surface-rule-strong: #6e5d4b;
        --color-text-primary: #f1e7d2;
        --color-text-secondary: #cfc1ab;
        --color-text-display: #f1e7d2;
        --color-accent-ember: #E85B4E;
        --color-accent-gold: #F4B860;
        --color-accent-plasma: #3FE0D0;
        --font-display: "Fraunces", Georgia, serif;
        --font-body: "Inter", system-ui, sans-serif;
        --font-mono: "JetBrains Mono", ui-monospace, monospace;
        --space-4: 1rem;
        --space-5: 1.5rem;
        --space-6: 2rem;
        --space-7: 3rem;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body {
        background: var(--color-surface-primary);
        color: var(--color-text-primary);
        font-family: var(--font-body);
        line-height: 1.6;
        min-height: 100vh;
      }
      /* Hero */
      .library-hero {
        text-align: center;
        padding: 4.5rem var(--space-5) var(--space-6);
        max-width: 680px;
        margin: 0 auto;
      }
      .library-hero__eyebrow {
        font-size: 0.72rem;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--color-accent-gold);
        opacity: 0.7;
        margin-bottom: var(--space-4);
      }
      .library-hero h1 {
        font-family: var(--font-display);
        font-size: clamp(2.4rem, 6vw, 3.5rem);
        font-weight: 500;
        color: var(--color-text-display);
        margin-bottom: var(--space-4);
        line-height: 1.1;
      }
      .library-hero__lede {
        color: var(--color-text-secondary);
        font-size: 0.95rem;
        line-height: 1.75;
      }
      /* Content grid */
      .library-content {
        max-width: 1080px;
        margin: 0 auto;
        padding: 0 var(--space-5) var(--space-7);
      }
      .library-section-label {
        font-size: 0.68rem;
        letter-spacing: 0.24em;
        text-transform: uppercase;
        color: var(--color-accent-ember);
        opacity: 0.85;
        margin-bottom: var(--space-4);
        padding-top: var(--space-6);
        border-top: 1px solid var(--color-surface-rule);
      }
      .library-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: var(--space-4);
      }
      .library-card {
        border: 1px solid var(--color-surface-rule);
        border-radius: 12px;
        padding: var(--space-5);
        background: var(--color-surface-raised);
        text-decoration: none;
        color: inherit;
        transition: border-color 0.2s ease;
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
      }
      .library-card:hover { border-color: var(--color-surface-rule-strong); }
      .library-card__format {
        font-size: 0.68rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--color-accent-gold);
        opacity: 0.7;
      }
      .library-card__title {
        font-family: var(--font-display);
        font-size: 1.1rem;
        font-weight: 500;
        color: var(--color-text-display);
        line-height: 1.3;
      }
      .library-card__dek {
        font-size: 0.85rem;
        color: var(--color-text-secondary);
        line-height: 1.6;
      }
      .library-card__meta {
        font-size: 0.75rem;
        color: var(--color-text-secondary);
        opacity: 0.6;
        margin-top: auto;
      }
      /* Adjacent corridors */
      .library-adjacent {
        margin-top: var(--space-7);
        padding-top: var(--space-6);
        border-top: 1px solid var(--color-surface-rule);
      }
      .library-adjacent h2 {
        font-family: var(--font-display);
        font-weight: 500;
        color: var(--color-accent-gold);
        font-size: 1.4rem;
        margin-bottom: var(--space-4);
      }
      .adjacent-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: var(--space-4);
      }
      .adjacent-card {
        border: 1px solid rgba(184,145,46,.18);
        border-radius: 12px;
        padding: var(--space-5);
        color: var(--color-text-primary);
        text-decoration: none;
        transition: border-color 0.2s ease;
      }
      .adjacent-card:hover { border-color: rgba(184,145,46,.4); }
      .adjacent-card strong {
        color: var(--color-accent-gold);
        display: block;
        margin-bottom: var(--space-2);
        font-family: var(--font-display);
        font-weight: 500;
        font-size: 1rem;
      }
      .adjacent-card span { font-size: 0.85rem; color: var(--color-text-secondary); line-height: 1.6; }
      /* Navigation */
      .library-nav {
        display: flex;
        justify-content: center;
        gap: var(--space-5);
        padding: var(--space-6);
        border-top: 1px solid var(--color-surface-rule);
        margin-top: var(--space-7);
        font-size: 0.85rem;
      }
      .library-nav a { color: var(--color-text-secondary); text-decoration: none; }
      .library-nav a:hover { color: var(--color-accent-gold); }
    </style>
  </head>
  <body>
    <HearthNavigation current="library" context="Research Library · warmth you can verify" />
    <main id="main-content">
      <header class="library-hero">
        <p class="library-hero__eyebrow">the receipts tradition · warmth you can verify</p>
        <h1>Research Library</h1>
        <p class="library-hero__lede">
          Essays, Field Journal entries, and fieldcraft methods from the Hearth &amp; Code
          studio — every claim labeled, every artifact traceable. Reading before
          commitment is always free.
        </p>
      </header>

      <div class="library-content">
        <p class="library-section-label">Hearthside essays &amp; Field Journal</p>
        <div class="library-grid">
          {articles.map((a) => (
            <a href={a.href} class="library-card">
              <span class="library-card__format">{a.format} · {a.code}</span>
              <span class="library-card__title">{a.title}</span>
              {a.dek && <span class="library-card__dek">{a.dek}</span>}
              <span class="library-card__meta">{a.readTime}</span>
            </a>
          ))}
        </div>

        {fieldcraftLibrary?.length > 0 && (
          <>
            <p class="library-section-label">Fieldcraft methods</p>
            <div class="library-grid">
              {fieldcraftLibrary.map((f) => (
                <a href={f.href} class="library-card">
                  <span class="library-card__format">Fieldcraft</span>
                  <span class="library-card__title">{f.title}</span>
                  {f.dek && <span class="library-card__dek">{f.dek}</span>}
                </a>
              ))}
            </div>
          </>
        )}

        <section class="library-adjacent" aria-labelledby="adjacent-title">
          <p class="library-section-label" style="border-top:none;padding-top:0;">Adjacent corridors</p>
          <h2 id="adjacent-title">From the Sacred Commons &amp; the Record</h2>
          <div class="adjacent-grid">
            <a href="https://sacred.hearthandcode.dev/ethics" class="adjacent-card">
              <strong>The Alignment You Already Have</strong>
              <span>The ethics wing — charter, invocation, and the eight-section essay that began the public record.</span>
            </a>
            <a href="https://sacred.hearthandcode.dev/ethics/alignment" class="adjacent-card">
              <strong>The Algorithm Has No Category for Prayer</strong>
              <span>Kali, copypasta, and the moderation of sacred repetition — the essay at the heart of the case.</span>
            </a>
            <a href="https://sacred.hearthandcode.dev/school" class="adjacent-card">
              <strong>The Mystery School</strong>
              <span>A free-forever school of the science of the sacred — the commons in motion.</span>
            </a>
            <a href="/dossier/" class="adjacent-card">
              <strong>The Extended Mind, Implemented</strong>
              <span>TEVV-mapped method paper — the governed scaffold as inspectable instrument.</span>
            </a>
          </div>
        </section>
      </div>

      <nav class="library-nav" aria-label="Continue">
        <a href="/">← The Hearth</a>
        <a href="/portfolio/">Portfolio</a>
        <a href="/dossier/">Dossier</a>
        <a href="https://sacred.hearthandcode.dev">The Sacred Commons →</a>
      </nav>
    </main>
  </body>
</html>
