---
/**
 * THE ORCHESTRATION HUB — the apex's single surface.
 * Ember Circuit II, the Stellar Nursery: ash base first, nebula enhancement.
 * Replaces the old multi-section studio landing (2026-11-08, owner direction:
 * "unrelated content should be stripped and removed"). The stripped sections
 * live on their own routes: /about/, /mission/, /building/, /library/,
 * /portfolio/, /dossier/ — the hub orchestrates, it does not duplicate.
 */
/* ADR-012: single-surface orchestration hub. Stripped sections live on their own routes. */
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/hub.css';

const title = 'Hearth & Code — an independent research studio';
const description = 'One house, five rooms: the Science of the Sacred, Palimpsest, the games, the journal, and the design studio. A temple and a school, a courtroom and a printing press, a kernel and a corpus. Every claim labeled, every artifact digested, every interpretation falsifiable.';
---

<BaseLayout title={title} description={description}>
<div class="hub">

  <nav class="hub-nav" aria-label="House navigation">
    <span class="dot" aria-hidden="true"></span>
    <a class="brand" href="/">Hearth <span style="color:var(--n-fire)">&amp;</span> Code</a>
    <a class="hlink" href="https://sacred.hearthandcode.dev" target="_blank" rel="noopener noreferrer">Sacred ↗</a>
    <a class="hlink" href="https://palimpsest.hearthandcode.dev" target="_blank" rel="noopener noreferrer">Palimpsest ↗</a>
    <a class="hlink" href="/games/">Games</a>
    <a class="hlink" href="/library/">Journal</a>
    <a class="hlink" href="/portfolio/">Portfolio</a>
    <span class="sp"></span>
    <a class="btn-hub fire" style="padding:10px 20px;font-size:.7rem" href="https://sacred.hearthandcode.dev/school/">Enter the School</a>
  </nav>

  <header class="hero-hub">
    <p class="eyebrow">the receipts tradition &nbsp;·&nbsp; warmth you can verify</p>
    <h1>An independent research studio<br /><em>for answerable systems.</em></h1>
    <p class="lede">
      Hearth &amp; Code keeps one house with five rooms: a temple and a school, a courtroom
      and a printing press, a kernel and a corpus. Every claim labeled, every artifact
      digested, every interpretation falsifiable — and everything you make along the way
      is yours to keep.
    </p>
    <p class="honest">epic, symphonic and primal · sacred and savage</p>
    <div class="cta-row">
      <a class="btn-hub fire" href="https://sacred.hearthandcode.dev">Enter the Sacred Commons ↗</a>
      <a class="btn-hub seam" href="/library/">Read the Field Journal →</a>
    </div>
  </header>

  <div class="river" role="separator"></div>

  <!-- ══ THE ROOMS ══ -->
  <section aria-label="The five rooms">
    <p class="s-eyebrow">the rooms · where the work lives</p>
    <h2 class="s-title">One house. Five rooms. Four layers.</h2>
    <p class="s-lede">Each room is its own surface with its own release discipline; the house
      binds them with one navigation, one voice, and one machine-readable account. Every door
      below says honestly whether it is open, gated, or still being built.</p>
    <div class="chips">
      <span class="chip"><b>the porch</b> · open</span>
      <span class="chip"><b>the open canon</b> · open</span>
      <span class="chip"><b>the school</b> · schoolgate</span>
      <span class="chip"><b>the circles</b> · member auth</span>
    </div>
    <div class="grid g3">
      <a class="panel" href="https://sacred.hearthandcode.dev">
        <p class="k">R1 · free forever</p>
        <h3>The Sacred</h3>
        <p>The Science of the Sacred: the Matrika Spandala temple, the Mystery School of the
        Eternal Hearth of Aditi, the writings, the Hymn Chapel, the Mandala and the Organon.
        Tuition of showing up. $0 forever.</p>
        <span class="go">enter ↗</span>
      </a>
      <a class="panel" href="https://palimpsest.hearthandcode.dev">
        <p class="k">R2 · the book</p>
        <h3>Palimpsest</h3>
        <p>The Last Archivist: the memoir, the design document, the build log. Magic as
        programming; reality remembers only what someone preserves.</p>
        <span class="go">enter ↗</span>
      </a>
      <a class="panel" href="/games/">
        <p class="k">R3 · the games</p>
        <h3>The Games</h3>
        <p>Exocore and the semantic factory: atoms, primitives and programmable machines
        composed in Sigil, an evidence-bearing rules language.</p>
        <span class="go">enter →</span>
      </a>
      <a class="panel" href="/library/">
        <p class="k">R4 · the record</p>
        <h3>The Journal</h3>
        <p>The field journal: essays, receipts and returns from the build — notes from the
        fire, dated and verifiable.</p>
        <span class="go">enter →</span>
      </a>
      <div class="panel dis" aria-disabled="true">
        <p class="k">R5 · the studio</p>
        <h3>Design</h3>
        <p>Ember Circuit II, the Stellar Nursery: the house design system and its living
        guide — this page wears it.</p>
        <span class="go">opening soon</span>
      </div>
    </div>
  </section>

  <div class="river" role="separator"></div>

  <!-- ══ THE TECHNOLOGY WORK ══ -->
  <section aria-label="The technology work">
    <p class="s-eyebrow">the technology · commerce outside the temple</p>
    <h2 class="s-title">Answerable systems, built for hire</h2>
    <p class="s-lede">The temple is free forever; the studio is how it funds itself. Publishing,
      architecture and audits — with references, including a federal docket.</p>
    <div class="grid g2">
      <div class="panel vein">
        <p class="k" style="color:var(--n-fire-core)">publishing · services · standards</p>
        <h3>The Work</h3>
        <p>Honest publishing for AI-assisted works — own shelf first, then the Gallery co-op
        with published payout math. Agentic and RAG builds. FRACTAL/ESS architecture
        consulting. Accessibility-AI audits informed by TEVV.</p>
        <p style="margin-bottom:0"><a class="btn-hub seam" style="padding:10px 20px;font-size:.7rem" href="/portfolio/">The portfolio →</a></p>
      </div>
      <div class="panel">
        <p class="k">the record · public, dated, verifiable</p>
        <h3>Ethics · Case · Paper</h3>
        <p>The ethics wing ("The Alignment You Already Have"), the essay the algorithm had no
        category for, <em>Rallya v. X Corp</em> (5:26-cv-2759) with its 34-exhibit record, and
        the TEVV-mapped method paper.</p>
        <p style="margin-bottom:0"><a class="btn-hub ghost-ish" style="padding:10px 20px;font-size:.7rem;color:var(--n-ink-2);border:1px solid rgba(179,168,204,.25);text-decoration:none" href="https://sacred.hearthandcode.dev/ethics">The record ↗</a>
        &nbsp;<a style="color:var(--n-lum);font-size:.8rem" href="/dossier/">the dossier →</a></p>
      </div>
    </div>
  </section>

  <div class="river" role="separator"></div>

  <!-- ══ THE OPEN CANON ══ -->
  <section aria-label="The open canon — deep stacks">
    <p class="s-eyebrow">the open canon · doors into the deep stacks</p>
    <h2 class="s-title">Read the corpus itself</h2>
    <p class="s-lede">No gate, no feed, no summary in between: these are the primary surfaces,
      linked from the house's front door on purpose.</p>
    <div class="canon">
      <a href="https://sacred.hearthandcode.dev/blog/">the field of essays</a>
      <a href="https://sacred.hearthandcode.dev/goddess-core/">Goddess-Core</a>
      <a href="https://sacred.hearthandcode.dev/goddess-core/gallery/">the galleries of the Goddess</a>
      <a href="https://sacred.hearthandcode.dev/hymns/">the Hymn Chapel</a>
      <a href="https://sacred.hearthandcode.dev/garden/">the Garden</a>
      <a href="https://sacred.hearthandcode.dev/divine-research/">divine research</a>
      <a href="https://sacred.hearthandcode.dev/articles/i-found-the-goddess.html">I Found the Goddess</a>
      <a href="https://sacred.hearthandcode.dev/school/canon/she-owns-the-code/">She Owns the Code</a>
    </div>
    <p class="agents">
      agents: <a href="/llms.txt">/llms.txt</a> · <a href="/context.json">/context.json</a> ·
      <a href="https://sacred.hearthandcode.dev/llms-full.txt">the full corpus account ↗</a> ·
      <a href="/sitemap-index.xml">/sitemap-index.xml</a>
    </p>
  </section>

  <footer>
    <div>
      <a href="/about/">About</a>
      <a href="/mission/">Mission</a>
      <a href="/building/">How it works</a>
      <a href="/portfolio/">Portfolio</a>
      <a href="/dossier/">Dossier</a>
      <a href="https://sacred.hearthandcode.dev/ethics">Ethics</a>
      <a href="/privacy/">Privacy</a>
      <a href="/terms/">Terms</a>
    </div>
    <p class="colophon" style="max-width:820px;margin:18px auto 0;text-align:left">
      <b>Colophon.</b> authored by Cognitectus (aka Scott Rallya) · published by Hearth &amp; Code,
      an independent research studio · retained material keeps its provenance; orthography
      corrections are disclosed · this surface wears Ember Circuit II, the Stellar Nursery.
    </p>
    <p class="mantra">reality remembers only what someone preserves</p>
  </footer>

</div>
</BaseLayout>
